/** tcstate: the shared type-checker state and its accessors. TypeChecker is the
 *  central record every type pass file threads; the structs here are the small
 *  side records it holds, and the accessors lower a written type, emit a diagnostic
 *  under the suppression gate, and manage the current generic scope. */

@paradigm procedural

@import std.vector
@import std.map
@import std.functional.maybe
@import ast
@import diag
@import ty
@import tysigs
@import summary

/** A function's frame-view escape summary as the type pass reads it: whether it is
 *  empty, which parameter or return its result aliases, which parameters it reads
 *  through, its sink and collect-sink parameter masks, and the encoded flow edges. */
export struct SummaryHandle { empty: bool, returns_alias: int64, reads_through: int64, sinks: int64, collect_sinks: int64, flows: string }
/** The element type recorded for a mut tuple binding, kept so a later reassignment
 *  can be width-checked against the member it replaces. */
export struct MutTupleEntry { ty: int64 }
/** The sink and collect-sink parameter masks a lambda binding carries, so a call
 *  through the binding knows which arguments the lambda stores. */
export struct LambdaSinkBind { sinks: int64, collect: int64 }
/** A provenance edge for a flow diagnostic: the destination span and the source and
 *  destination slots the value flowed between. */
export struct FlowProv { lo: int64, hi: int64, src: int64, dst: int64 }
/** A bound error's span and whether its must-handle obligation is still pending, the
 *  per-name record the error-handling check walks. */
export struct ErrBind { lo: int64, hi: int64, pending: bool }
/** A named error still awaiting discharge, paired with the span that raised it, for
 *  the end-of-scope must-handle report. */
export struct PendingErr { name: string, lo: int64, hi: int64 }

/** The ownership tag for a value this scope owns and must release. */
export func own_owner() -> int64 { return 1 }
/** The ownership tag for a value borrowed from elsewhere, not released here. */
export func own_borrow() -> int64 { return 2 }
/** The ownership tag for a value already moved out, whose further use is refused. */
export func own_moved() -> int64 { return 3 }

/** The central type-checker state every type pass file threads: the arena and
 *  signature tables it resolves against, the per-scope name, ownership, mutability,
 *  and escape maps it pushes and pops, the current function context (return type,
 *  generics, `using` allocator), and the escape summaries and diagnostic sink. */
export struct TypeChecker {
    ast: *Ast,
    ty: *TyArena,
    sigtab: *TypeSigs,
    sigs: *Map<string, FnSig>,
    async_fns: *Map<string, int64>,
    ifaces: *Map<string, int64>,
    enums: *Map<string, EnumSig>,
    variant_payloads: *Map<string, VariantSig>,
    variant_payloads_by_enum: *Map<string, VariantSig>,
    structs: *Map<string, StructSig>,
    iface_methods: *Map<string, MethodList>,
    impls: *Map<string, int64>,
    raw_sigs: *Map<string, TyList>,
    embed_fields: *Map<string, TyList>,
    scopes: *Vector<*Map<string, int64>>,
    owns: *Vector<*Map<string, int64>>,
    muts: *Vector<*Map<string, int64>>,
    err_binds: *Vector<*Map<string, ErrBind>>,
    esc_slices: *Vector<*Map<string, int64>>,
    esc_closures: *Vector<*Map<string, int64>>,
    iface_binds: *Vector<*Map<string, string>>,
    enum_binds: *Vector<*Map<string, string>>,
    slice_iface_elem: *Vector<*Map<string, int64>>,
    // Per-scope name to AST type id, recorded for annotated bindings and params.
    // The surface arena erases a named type's generic args (Vector and Map keep
    // theirs only in the AST), so a container for over a binder needs the binder's
    // AST type to recover its element type and classify a nested container loop.
    binding_ast_ty: *Vector<*Map<string, int64>>,
    alias_edges: *Vector<*Map<string, string>>,
    branch_depth: int64,
    loop_depth: int64,
    suppress: int64,
    in_async: bool,
    in_method: bool,
    cur_generics: *Map<string, int64>,
    cur_ret: int64,
    cur_raw_ret: int64,
    // The AST type id of the current function's return, kept because a bare type
    // parameter return lowers to ty_unknown (indistinguishable from any hole): the
    // return-match borrow check consults the written node to see it is a T. Saved and
    // restored across a lambda body, whose own return is never generic.
    cur_ret_ast: int64,
    // The name the current function's `using` allocator parameter binds, empty
    // when the function has none. Bare alloc and free resolve the ambient
    // allocator through this name, so a binding that rebinds it is refused.
    cur_allocator: string,
    future_elems: *Map<string, int64>,
    types_only: bool,
    summaries: *Map<string, SummaryHandle>,
    method_summaries: *Map<string, SummaryHandle>,
    method_params: *Map<string, TyList>,
    iface_method_params: *Map<string, TyList>,
    lambda_returns: *Map<string, int64>,
    lambda_sinks: *Map<string, int64>,
    lambda_collect_sinks: *Map<string, int64>,
    lambda_sink_binds: *Vector<*Map<string, LambdaSinkBind>>,
    lambda_capture_flows: *Map<string, string>,
    lambda_capture_binds: *Vector<*Map<string, string>>,
    resolvable_fn_binds: *Map<string, string>,
    cur_params: *Map<string, int64>,
    cur_param_index: *Map<string, int64>,
    ptr_param_borrows: *Vector<*Map<string, int64>>,
    flow_prov: *Map<string, FlowProv>,
    mut_tuple_types: *Map<string, MutTupleEntry>,
    match_own: *Map<int64, int64>,
    // Per-member ownership of a tuple binding, keyed by "name#index". A `pair := (x, 1)`
    // over a borrowed x records member 0 as a borrow so a later `y, n := pair` destructure
    // hands y that borrow rather than the owner default, closing the launder a borrow
    // takes through a tuple binding. Surface-only; the ground pass never writes.
    tuple_member_own: *Map<string, int64>,
    // Records which for statements iterate a std container: the sk_for stmt id maps
    // to its class (1 vector, 2 map keys, 3 map key/value pairs). The surface pass
    // classifies and records; the pre-mono rewrite consumes it. Empty on a module
    // that iterates no container.
    for_iters: *Map<int64, int64>,
    // For each classified container for whose iterand AST type was recovered, the
    // sk_for stmt id maps to that iterand AST type id. The rewrite annotates the
    // container binding with it so mono can instantiate the accessor generics when
    // the iterand is a struct field or a call whose type mono cannot re-infer.
    for_iter_asts: *Map<int64, int64>,
    match_ctx: int64,
    summary: SummaryHandle,
    sum_tables: *SumTables,
    errors: *Vector<SpanDiagnostic>,
}

/** The third argument is mono's raw future table (mangled Future$T name -> the
 *  element's ground AST type id). It is lowered into this pass's arena before
 *  signatures are collected, so the sig-collection unmangle sees a populated
 *  table exactly as stage0 sets future_elems before collect_sigs. The surface
 *  pass passes an empty table, so future_elems stays empty and every unmangle is
 *  a no-op there. */
export func tc_new(a: *Ast, types_only: bool, future_table: *Map<string, int64>) -> *TypeChecker {
    ta: *TyArena = ty_arena_new()
    future_elems: *Map<string, int64> = alloc(map_new())
    no_gens: *Map<string, int64> = alloc(map_new())
    fkeys: *Vector<string> = map_keys(future_table)
    mut fi: int64 = 0
    while fi < vec_len(fkeys) {
        fk: string = vec_get(fkeys, fi)
        fastty: int64 = unwrap_or(map_get(future_table, fk), -1)
        map_put(future_elems, fk, lower(ta, a, fastty, no_gens))
        fi = fi + 1
    }
    sigs: *TypeSigs = tysigs_new(a, ta, future_elems)
    collect_sigs(sigs)
    scopes: *Vector<*Map<string, int64>> = alloc(vec_new())
    owns: *Vector<*Map<string, int64>> = alloc(vec_new())
    muts: *Vector<*Map<string, int64>> = alloc(vec_new())
    err_binds: *Vector<*Map<string, ErrBind>> = alloc(vec_new())
    esc_slices: *Vector<*Map<string, int64>> = alloc(vec_new())
    esc_closures: *Vector<*Map<string, int64>> = alloc(vec_new())
    iface_binds: *Vector<*Map<string, string>> = alloc(vec_new())
    enum_binds: *Vector<*Map<string, string>> = alloc(vec_new())
    slice_iface_elem: *Vector<*Map<string, int64>> = alloc(vec_new())
    binding_ast_ty: *Vector<*Map<string, int64>> = alloc(vec_new())
    alias_edges: *Vector<*Map<string, string>> = alloc(vec_new())
    summaries: *Map<string, SummaryHandle> = alloc(map_new())
    method_summaries: *Map<string, SummaryHandle> = alloc(map_new())
    lambda_returns: *Map<string, int64> = alloc(map_new())
    lambda_sinks: *Map<string, int64> = alloc(map_new())
    lambda_collect_sinks: *Map<string, int64> = alloc(map_new())
    lambda_sink_binds: *Vector<*Map<string, LambdaSinkBind>> = alloc(vec_new())
    lambda_capture_flows: *Map<string, string> = alloc(map_new())
    lambda_capture_binds: *Vector<*Map<string, string>> = alloc(vec_new())
    resolvable_fn_binds: *Map<string, string> = alloc(map_new())
    cur_params: *Map<string, int64> = alloc(map_new())
    cur_param_index: *Map<string, int64> = alloc(map_new())
    ptr_param_borrows: *Vector<*Map<string, int64>> = alloc(vec_new())
    flow_prov: *Map<string, FlowProv> = alloc(map_new())
    mut_tuple_types: *Map<string, MutTupleEntry> = alloc(map_new())
    match_own: *Map<int64, int64> = alloc(map_new())
    tuple_member_own: *Map<string, int64> = alloc(map_new())
    for_iters: *Map<int64, int64> = alloc(map_new())
    for_iter_asts: *Map<int64, int64> = alloc(map_new())
    cur_generics: *Map<string, int64> = alloc(map_new())
    errors: *Vector<SpanDiagnostic> = alloc(vec_new())
    return alloc(TypeChecker {
        ast: a,
        ty: ta,
        sigtab: sigs,
        sigs: (*sigs).fns,
        async_fns: (*sigs).async_fns,
        ifaces: (*sigs).ifaces,
        enums: (*sigs).enums,
        variant_payloads: (*sigs).variant_payloads,
        variant_payloads_by_enum: (*sigs).variant_payloads_by_enum,
        structs: (*sigs).structs,
        iface_methods: (*sigs).iface_methods,
        impls: (*sigs).impls,
        raw_sigs: (*sigs).raw_sigs,
        embed_fields: (*sigs).embed_fields,
        scopes: scopes,
        owns: owns,
        muts: muts,
        err_binds: err_binds,
        esc_slices: esc_slices,
        esc_closures: esc_closures,
        iface_binds: iface_binds,
        enum_binds: enum_binds,
        slice_iface_elem: slice_iface_elem,
        binding_ast_ty: binding_ast_ty,
        alias_edges: alias_edges,
        branch_depth: 0,
        loop_depth: 0,
        suppress: 0,
        in_async: false,
        in_method: false,
        cur_generics: cur_generics,
        cur_ret: ty_unit(ta),
        cur_raw_ret: ty_unit(ta),
        cur_ret_ast: -1,
        cur_allocator: "",
        future_elems: future_elems,
        types_only: types_only,
        summaries: summaries,
        method_summaries: method_summaries,
        method_params: (*sigs).method_params,
        iface_method_params: (*sigs).iface_method_params,
        lambda_returns: lambda_returns,
        lambda_sinks: lambda_sinks,
        lambda_collect_sinks: lambda_collect_sinks,
        lambda_sink_binds: lambda_sink_binds,
        lambda_capture_flows: lambda_capture_flows,
        lambda_capture_binds: lambda_capture_binds,
        resolvable_fn_binds: resolvable_fn_binds,
        cur_params: cur_params,
        cur_param_index: cur_param_index,
        ptr_param_borrows: ptr_param_borrows,
        flow_prov: flow_prov,
        mut_tuple_types: mut_tuple_types,
        match_own: match_own,
        tuple_member_own: tuple_member_own,
        for_iters: for_iters,
        for_iter_asts: for_iter_asts,
        match_ctx: 0,
        summary: SummaryHandle { empty: true, returns_alias: 0, reads_through: 0, sinks: 0, collect_sinks: 0, flows: "" },
        sum_tables: sum_tables_new(a),
        errors: errors,
    })
}

/** Records a diagnostic at span [lo, hi), unless diagnostics are suppressed, the one
 *  seam every type-pass error flows through so the suppression gate is honored once.
 *  @param tc the type checker to record against
 *  @param msg the diagnostic message
 *  @param lo the span start byte offset
 *  @param hi the span end byte offset */
export func tc_emit(tc: *TypeChecker, msg: string, lo: int64, hi: int64) -> void {
    if (*tc).suppress > 0 {
        return
    }
    vec_push((*tc).errors, span_diag(lo, hi, msg))
}

/** Refuses a binding that shadows the ambient allocator a `using` parameter binds.
 *  Inside a function with a `using` allocator the bare alloc and free resolve
 *  through that parameter's name; a binding of the same name, whether at the top
 *  level or in a nested block, would redirect allocation to an unrelated value: a
 *  segfault when it is not an allocator, a silently wrong allocator when it is.
 *  The name is reserved for the whole function body, so any rebinding stops here. */
export func reject_alloc_shadow(tc: *TypeChecker, name: string, lo: int64, hi: int64) -> void {
    if str_len((*tc).cur_allocator) == 0 { return }
    if !str_eq(name, (*tc).cur_allocator) { return }
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "cannot shadow the allocator parameter '")
    sb_push(b, name)
    sb_push(b, "'; alloc and free in this function resolve through it, so rename this binding")
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    tc_emit(tc, out, lo, hi)
}

/** The "lo:hi" string that keys a span in the checker's per-name maps.
 *  @param lo the span start byte offset
 *  @param hi the span end byte offset
 *  @return the "lo:hi" key */
export func span_key(lo: int64, hi: int64) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push_int(b, lo)
    sb_push_char(b, 58)
    sb_push_int(b, hi)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

/** Lowers a written AST type to its checker type id, fixing signatures and
 *  unmangling a future element, the normal way a type pass turns a written type into
 *  the id it reasons about.
 *  @param tc the type checker whose generic scope and tables the lowering uses
 *  @param ast_ty the AST node id of the written type
 *  @return the lowered, fixed, unmangled type id */
export func tc_type(tc: *TypeChecker, ast_ty: int64) -> int64 {
    mut id: int64 = lower((*tc).ty, (*tc).ast, ast_ty, (*tc).cur_generics)
    id = fix((*tc).sigtab, id)
    return unmangle((*tc).ty, id, (*tc).future_elems)
}

/** Lowers a written AST type without the signature fix or future unmangle, the raw
 *  form used where the later normalization would be wrong.
 *  @param tc the type checker whose generic scope the lowering uses
 *  @param ast_ty the AST node id of the written type
 *  @return the lowered type id before fixing and unmangling */
export func tc_raw_type(tc: *TypeChecker, ast_ty: int64) -> int64 {
    return lower((*tc).ty, (*tc).ast, ast_ty, (*tc).cur_generics)
}

/** Sets the current generic type parameters in scope from a parameter list slice, so
 *  a bare type name in the body lowers as a generic rather than a concrete type.
 *  @param tc the type checker whose generic scope is replaced
 *  @param off the start index of the generic parameter names in the AST kids array
 *  @param len the count of generic parameter names */
export func set_cur_generics(tc: *TypeChecker, off: int64, len: int64) -> void {
    a: *Ast = (*tc).ast
    g: *Map<string, int64> = alloc(map_new())
    mut i: int64 = 0
    while i < len {
        map_put(g, ast_name(a, vec_get((*a).kids, off + i)), 1)
        i = i + 1
    }
    (*tc).cur_generics = g
}
