// tclet: let binding forms for the type checker.

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import ast
@import ty
@import tysigs
@import tcstate
@import tcscope
@import tcfit
@import tcexpr
@import tciface
@import tcown
@import tcesc
@import tcesccap
@import tcesc3
@import tcfor

func lit_hex_val(b: int64) -> int64 {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 97 && b <= 102 { return b - 87 }
    if b >= 65 && b <= 70 { return b - 55 }
    return 0
}

func utf8_width_of(cp: int64) -> int64 {
    if cp < 128 { return 1 }
    if cp < 2048 { return 2 }
    if cp < 65536 { return 3 }
    return 4
}

// The decoded byte length of a string literal body in its canonical interned
// form, where every non printable scalar sits as a \u{hex} escape and every
// printable byte sits raw. Mirrors the codegen decoder's walk exactly, so the
// length the checker approves is the length the initializer copies.
func str_lit_byte_len(text: string) -> int64 {
    mut count: int64 = 0
    mut i: int64 = 0
    while i < str_len(text) {
        mut consumed: bool = false
        if text[i] == 92 && i + 3 < str_len(text) && text[i + 1] == 117 && text[i + 2] == 123 {
            mut p: int64 = i + 3
            mut cp: int64 = 0
            mut scanning: bool = true
            while scanning {
                if p >= str_len(text) { scanning = false }
                else if text[p] == 125 { scanning = false }
                else {
                    cp = cp * 16 + lit_hex_val(text[p])
                    p++
                }
            }
            if p < str_len(text) {
                count += utf8_width_of(cp)
                i = p + 1
                consumed = true
            }
        }
        if !consumed {
            count++
            i++
        }
    }
    return count
}

func char_lit_len_msg(have: int64, want: int64) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "the string literal has ")
    sb_push_int(b, have)
    sb_push(b, " byte(s); the annotation says char[")
    sb_push_int(b, want)
    sb_push_char(b, 93)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

// `s: char[N] = "lit"`: a string literal initializes a char array when its
// byte length is exactly N, with no NUL appended and no padding. Only a
// literal converts; a string typed value never does, so the rule lives at the
// let and assign sites where the expression is in hand, not in the type
// compatibility relation. Returns true when the target is a char array and
// the value is a string literal, having emitted the byte count reject on a
// length mismatch, so the caller skips its generic mismatch error.
export func check_char_array_lit(tc: *TypeChecker, target: int64, value_id: int64) -> bool {
    n: TyNode = ty_get((*tc).ty, target)
    if n.kind != tyk_array() { return false }
    en: TyNode = ty_get((*tc).ty, n.a)
    if en.kind != tyk_char() { return false }
    a: *Ast = (*tc).ast
    e: ExprNode = vec_get((*a).exprs, value_id)
    if e.kind != xk_str() { return false }
    have: int64 = str_lit_byte_len(ast_name(a, e.a))
    if have != n.w {
        tc_emit(tc, char_lit_len_msg(have, n.w), e.lo, e.hi)
    }
    return true
}

func annot_mismatch_msg(name: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push_char(b, 39)
    sb_push(b, name)
    sb_push(b, "' has a type annotation that does not match its value")
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

func is_zero_arg_alloc(tc: *TypeChecker, expr: int64) -> bool {
    a: *Ast = (*tc).ast
    e: ExprNode = vec_get((*a).exprs, expr)
    if e.kind != xk_call() || e.c != 0 { return false }
    f: ExprNode = vec_get((*a).exprs, e.a)
    if f.kind != xk_ident() { return false }
    name: string = ast_name(a, f.a)
    return str_eq(name, "alloc") && !sig_has_fn((*tc).sigtab, name)
}

func alloc_annot_ty(tc: *TypeChecker, bind: BindNode, value: ExprNode) -> int64 {
    if bind.ty >= 0 {
        reject_iface_targ_annot(tc, bind.ty, value.lo, value.hi)
        lt: int64 = tc_type(tc, bind.ty)
        n: TyNode = ty_get((*tc).ty, lt)
        if n.kind != tyk_ptr() {
            tc_emit(tc, "alloc() with no value takes its size from a pointer annotation; write p: *T = alloc()", value.lo, value.hi)
        }
        return lt
    }
    tc_emit(tc, "alloc() with no value needs a pointer type annotation to size the allocation; write p: *T = alloc()", value.lo, value.hi)
    return ty_unknown((*tc).ty)
}

func declare_one(tc: *TypeChecker, b: BindNode, tyid: int64, mutable: bool, value_lo: int64, value_hi: int64) -> void {
    a: *Ast = (*tc).ast
    name: string = ast_name(a, b.name)
    reject_alloc_shadow(tc, name, value_lo, value_hi)
    reject_builtin_binding(tc, name, tyid, false, value_lo, value_hi)
    reject_enum_name_binding(tc, name, value_lo, value_hi)
    declare(tc, name, tyid)
    set_esc(tc, name, false, false)
    if mutable { declare_mut(tc, name) }
    n: TyNode = ty_get((*tc).ty, tyid)
    if n.kind == tyk_error() { declare_err(tc, name, value_lo, value_hi) }
}

// Which enum a binding holds, recorded because the value's own type does not say: a
// constructor and a field read of an enum both infer unknown on the surface. Both
// constructor forms count, the call form for a variant with a payload and the bare
// qualified name for one without; a copy of a name inherits what that name recorded;
// and a read out of a place carries the place's declared type. A mut binding records
// nothing at all, because an assignment may replace its value with another enum's
// (that assignment is a separate hole, and a stale record here would answer for the
// value that was overwritten).
func record_enum_bind(tc: *TypeChecker, name: string, value: int64, mutable: bool) -> void {
    if mutable { return }
    a: *Ast = (*tc).ast
    e: ExprNode = vec_get((*a).exprs, value)
    enums: *Map<string, EnumSig> = (*tc).enums
    mut base_id: int64 = -1
    if e.kind == xk_call() {
        callee: ExprNode = vec_get((*a).exprs, e.a)
        if callee.kind == xk_field() { base_id = callee.a }
    } else if e.kind == xk_field() {
        base_id = e.a
    }
    if base_id >= 0 {
        base: ExprNode = vec_get((*a).exprs, base_id)
        if base.kind == xk_ident() {
            en: string = ast_name(a, base.a)
            if map_has(enums, en) {
                declare_enum_bind(tc, name, en)
                return
            }
        }
    }
    if e.kind == xk_call() { return }
    if e.kind == xk_ident() {
        sname: string = ast_name(a, e.a)
        // The binder is already declared by the time the value is read, so a binding
        // that names itself must ask the scope outside its own or it would find the
        // name it is defining and answer with nothing.
        mut src: string = ""
        if str_eq(sname, name) {
            src = enum_bind_name_outer(tc, sname)
        } else {
            src = enum_bind_name(tc, sname)
        }
        if str_len(src) > 0 { declare_enum_bind(tc, name, src) }
        return
    }
    if e.kind == xk_field() || e.kind == xk_index() || (e.kind == xk_unary() && e.a == uop_deref()) {
        ct: int64 = chain_ty(tc, value)
        cn: TyNode = ty_get((*tc).ty, ct)
        if cn.kind == tyk_named() {
            cname: string = ty_name((*tc).ty, ct)
            if map_has(enums, cname) { declare_enum_bind(tc, name, cname) }
        }
    }
}

func record_mut_tuple(tc: *TypeChecker, stmt: StmtNode, bind: BindNode, tyid: int64) -> void {
    if (*tc).types_only { return }
    if (stmt.d & 1) == 0 { return }
    if bind.ty >= 0 { return }
    a: *Ast = (*tc).ast
    val: ExprNode = vec_get((*a).exprs, stmt.c)
    if val.kind != xk_tuple() { return }
    mut has_array: bool = false
    for i in 0..val.b {
        m: ExprNode = vec_get((*a).exprs, vec_get((*a).kids, val.a + i))
        if m.kind == xk_array() { has_array = true }
    }
    if !has_array { return }
    map_put((*tc).mut_tuple_types, span_key(val.lo, val.hi), MutTupleEntry { ty: tyid })
}

func tuple_member_key(name: string, i: int64) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, name)
    sb_push_char(b, 35)
    sb_push_int(b, i)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

func member_key_cat(prefix: string, suffix: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, prefix)
    sb_push(b, suffix)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

// Copies the recorded ownership subtree rooted at src_prefix (the leaf key itself and every
// key under src_prefix#...) to dst_prefix. A rebind q := pair or a destructure binder thus
// inherits the borrow records the source tuple binding held, at every nesting depth. The #
// separator keeps a prefix from matching a longer sibling name.
func copy_member_subtree(tc: *TypeChecker, src_prefix: string, dst_prefix: string) -> void {
    m: *Map<string, int64> = (*tc).tuple_member_own
    keys: *Vector<string> = map_keys(m)
    pfx: string = member_key_cat(src_prefix, "#")
    plen: int64 = str_len(src_prefix)
    for k in keys {
        if str_eq(k, src_prefix) {
            map_put(m, dst_prefix, unwrap_or(map_get(m, k), own_borrow()))
        } else if starts_with(k, pfx) {
            rest: string = substring(k, plen, str_len(k))
            map_put(m, member_key_cat(dst_prefix, rest), unwrap_or(map_get(m, k), own_borrow()))
        }
    }
}

// The ownership a tuple literal member that names a value hands to whatever takes it back
// out, the one place both member walks below ask. A name that owns hands a borrow, not its
// ownership: the source name still owns the allocation and still frees it, so a binder that
// took the member as an owner would free a pointer with a live owner, the double free the
// single binding refuses as the copy of an owner. `move(p)` in the member position is the
// transfer spelling, a call rather than a name, so it never reaches here and the binder it
// feeds owns what was handed over. A name that borrows hands the borrow along, a moved name
// hands its moved tag, and a name with no ownership record hands nothing.
func member_ident_own(tc: *TypeChecker, name: string) -> int64 {
    o: int64 = own_of(tc, name)
    if o == own_owner() { return own_borrow() }
    return o
}

// Records the per-member ownership of a tuple literal recursively, so a borrowed leaf at any
// nesting depth is remembered under its path key (name#i, name#i#j, ...). A nested tuple
// member recurses so a launder through ((p, 1), 2) survives the inner destructure; an
// identifier that owns or borrows, and a borrowed match member, each record a borrowed leaf;
// a fresh member records nothing and keeps the destructure default. A branching member,
// a match or an if used as a value, reads the verdict its own walk stored. Surface-only.
func record_member_own_rec(tc: *TypeChecker, prefix: string, value: ExprNode) -> void {
    if value.kind != xk_tuple() { return }
    a: *Ast = (*tc).ast
    for i in 0..value.b {
        mid: int64 = vec_get((*a).kids, value.a + i)
        me: ExprNode = vec_get((*a).exprs, mid)
        key: string = tuple_member_key(prefix, i)
        if me.kind == xk_tuple() {
            record_member_own_rec(tc, key, me)
        } else if me.kind == xk_ident() {
            if member_ident_own(tc, ast_name(a, me.a)) == own_borrow() {
                map_put((*tc).tuple_member_own, key, own_borrow())
            }
        } else if me.kind == xk_match() || me.kind == xk_ifexpr() {
            mv: int64 = match_own_of(tc, mid)
            if mv == own_borrow() { map_put((*tc).tuple_member_own, key, own_borrow()) }
        }
    }
}

// Records a tuple binding's member ownership so a later destructure propagates a borrow. A
// tuple literal value records its members recursively; a bound tuple name (q := pair) copies
// the source's recorded subtree so the rebind carries the launder forward.
func record_tuple_member_own(tc: *TypeChecker, name: string, value: ExprNode) -> void {
    if (*tc).types_only { return }
    if value.kind == xk_tuple() {
        record_member_own_rec(tc, name, value)
    } else if value.kind == xk_ident() {
        copy_member_subtree(tc, ast_name((*tc).ast, value.a), name)
    }
}

// Marks every member a `ref` binding could later be destructured into as a borrow.
// The word declares the whole value a view of what the source still owns, so a binder
// that holds a tuple carries the borrow down its member paths and a later `x, y := a`
// inherits it through the same `name#i` keys a laundered tuple literal writes. The walk
// is type driven rather than value driven, so the tuple literal spelling and the bound
// name spelling both reach it, and a member with no ownership to track records nothing.
// Surface only, like every other ownership record here.
func record_ref_member_borrows(tc: *TypeChecker, prefix: string, tyid: int64) -> void {
    if (*tc).types_only { return }
    n: TyNode = ty_get((*tc).ty, tyid)
    if n.kind != tyk_tuple() { return }
    for i in 0..n.len {
        mt: int64 = vec_get((*(*tc).ty).kids, n.off + i)
        key: string = tuple_member_key(prefix, i)
        if is_managed_ty(tc, mt) { map_put((*tc).tuple_member_own, key, own_borrow()) }
        record_ref_member_borrows(tc, key, mt)
    }
}

func is_enum_ctor_call(tc: *TypeChecker, expr_id: int64) -> bool {
    a: *Ast = (*tc).ast
    e: ExprNode = vec_get((*a).exprs, expr_id)
    if e.kind != xk_call() { return false }
    callee: ExprNode = vec_get((*a).exprs, e.a)
    if callee.kind != xk_field() { return false }
    base: ExprNode = vec_get((*a).exprs, callee.a)
    if base.kind != xk_ident() { return false }
    enums: *Map<string, EnumSig> = (*tc).enums
    return map_has(enums, ast_name(a, base.a))
}

func tuple_has_error(tc: *TypeChecker, tyid: int64) -> bool {
    n: TyNode = ty_get((*tc).ty, tyid)
    if n.kind != tyk_tuple() { return false }
    for i in 0..n.len {
        mt: TyNode = ty_get((*tc).ty, vec_get((*(*tc).ty).kids, n.off + i))
        if mt.kind == tyk_error() { return true }
    }
    return false
}

func single_bind(tc: *TypeChecker, stmt: StmtNode, vt: int64) -> void {
    a: *Ast = (*tc).ast
    b: BindNode = vec_get((*a).binds, vec_get((*a).kids, stmt.a))
    value: ExprNode = vec_get((*a).exprs, stmt.c)
    mut tyid: int64 = vt
    if b.ty >= 0 {
        reject_iface_targ_annot(tc, b.ty, value.lo, value.hi)
        lt: int64 = tc_type(tc, b.ty)
        // A counted loop's bound binding is judged by the loop head's own rule, not by
        // annotation compatibility. compat lets a char, a rune, and a literal of any
        // width stand in for an int64, so a bound laundered through a generic would pass
        // the `int64` annotation the rewrite wrote and reach codegen counting over it.
        // This is also what keeps the synthesized binding name out of the diagnostic: the
        // caret sits on the bound the source holds and the sentence is the loop head's.
        if (stmt.d & let_range_bound()) != 0 {
            judge_range_bound(tc, stmt.c, vt)
        } else if !compat((*tc).ty, lt, vt) && !check_char_array_lit(tc, lt, stmt.c) {
            tc_emit(tc, annot_mismatch_msg(ast_name(a, b.name)), value.lo, value.hi)
        }
        check_lit_fits_target(tc, stmt.c, lt)
        tyid = lt
        declare_binding_ast(tc, ast_name(a, b.name), b.ty)
        raw: int64 = tc_raw_type(tc, b.ty)
        check_conformance(tc, raw, vt, value.lo, value.hi)
        check_covariance_deep(tc, raw, vt, stmt.c, value.lo, value.hi)
        rn: TyNode = ty_get((*tc).ty, raw)
        ifaces: *Map<string, int64> = (*tc).ifaces
        if rn.kind == tyk_named() && map_has(ifaces, ty_name((*tc).ty, raw)) {
            declare_iface_bind(tc, ast_name(a, b.name), ty_name((*tc).ty, raw))
        }
        if rn.kind == tyk_slice() {
            el: TyNode = ty_get((*tc).ty, rn.a)
            if el.kind == tyk_named() && map_has(ifaces, ty_name((*tc).ty, rn.a)) {
                declare_slice_iface(tc, ast_name(a, b.name), raw)
            }
        }
    } else {
        tyid = harden((*tc).ty, vt)
    }
    declare_one(tc, b, tyid, (stmt.d & 1) != 0, value.lo, value.hi)
    // A match or if value bound with an inferred type carries only the surface wildcard
    // here, so is_managed_ty cannot see it is managed; consult the ownership verdict the
    // branch walk stored so a borrowed result recorded under the binding rejects a later
    // free, exactly as an annotated managed binding already does. Without this an inferred
    // `x := match` or `x := if c { p } else { q }` whose branches borrow launders the borrow
    // and frees a pointer the subject still owns.
    mut want_own: bool = is_managed_ty(tc, tyid)
    branching_value: bool = value.kind == xk_match() || value.kind == xk_ifexpr()
    if !want_own && branching_value && !(*tc).types_only && match_own_of(tc, stmt.c) >= 0 {
        want_own = true
    }
    // A generic binding whose value is a name that already carries an ownership record
    // inherits it: `y := x` over a borrowed type-parameter x must keep y a borrow so a
    // later free(y) rejects the launder, exactly as the concrete `y := x` over a managed
    // x already does through is_managed_ty. An annotation that names a type parameter is
    // the same unprovable case. classify_value_own reads own_of(src) below, so a scalar x
    // with no record adds nothing and a copied owner still faults as a copy.
    if !want_own && !(*tc).types_only && value.kind == xk_ident() && own_of(tc, ast_name(a, value.a)) != 0 {
        want_own = true
    }
    if !want_own && !(*tc).types_only && is_typaram_ast(tc, b.ty) {
        want_own = true
    }
    if want_own {
        declare_own(tc, ast_name(a, b.name), binding_own(tc, stmt, value, vt, tyid))
    }
    record_enum_bind(tc, ast_name(a, b.name), stmt.c, (stmt.d & 1) != 0)
    record_mut_tuple(tc, stmt, b, tyid)
    record_tuple_member_own(tc, ast_name(a, b.name), value)
    // `ref t := pair` borrows the whole value, members included, so a later destructure
    // of t reads a borrow rather than the owner default.
    if (stmt.d & 2) != 0 { record_ref_member_borrows(tc, ast_name(a, b.name), tyid) }
    link_binding_aliases(tc, ast_name(a, b.name), stmt.c, false)
    esc: EscPair = value_escape(tc, stmt.c)
    set_esc(tc, ast_name(a, b.name), esc.slice, esc.closure)
    record_lambda_let(tc, ast_name(a, b.name), stmt.c)
    record_ptr_borrows(tc, ast_name(a, b.name), stmt.c, tyid)
}

func destructure_bind(tc: *TypeChecker, stmt: StmtNode, vt: int64) -> void {
    a: *Ast = (*tc).ast
    value: ExprNode = vec_get((*a).exprs, stmt.c)
    n: TyNode = ty_get((*tc).ty, vt)
    parts: *Vector<int64> = alloc(vec_new())
    if n.kind == tyk_tuple() && n.len == stmt.b {
        for i in 0..n.len {
            vec_push(parts, vec_get((*(*tc).ty).kids, n.off + i))
        }
    } else if n.kind == tyk_unknown() {
        for j in 0..stmt.b {
            vec_push(parts, ty_unknown((*tc).ty))
        }
    } else {
        tc_emit(tc, "destructuring binding expects a tuple of matching arity", value.lo, value.hi)
        for k in 0..stmt.b {
            vec_push(parts, ty_unknown((*tc).ty))
        }
    }
    for m in 0..stmt.b {
        b: BindNode = vec_get((*a).binds, vec_get((*a).kids, stmt.a + m))
        mut tyid: int64 = vec_get(parts, m)
        if b.ty >= 0 {
            reject_iface_targ_annot(tc, b.ty, value.lo, value.hi)
            lt: int64 = tc_type(tc, b.ty)
            // The annotation must match the tuple member it binds; without
            // this check a mismatched binder reaches codegen, which stores the
            // member as the annotated type.
            pn: TyNode = ty_get((*tc).ty, tyid)
            if pn.kind != tyk_unknown() && !compat((*tc).ty, lt, tyid) {
                tc_emit(tc, annot_mismatch_msg(ast_name(a, b.name)), value.lo, value.hi)
            }
            // A tuple literal member is written straight into this binder, so it
            // ranges against the binder's annotation exactly as `n: uint8 = 256`
            // does. The member type the arity branch above derived is the literal's
            // own width 0 type, which adapts to anything, so without this the
            // written value truncates into the binder in codegen.
            if value.kind == xk_tuple() && value.b == stmt.b {
                check_lit_fits_target(tc, vec_get((*a).kids, value.a + m), lt)
            }
            tyid = lt
        } else {
            tyid = harden((*tc).ty, tyid)
        }
        declare_one(tc, b, tyid, (stmt.d & 1) != 0, value.lo, value.hi)
        // A tuple member that is a branching expression, a match or an if used as a value,
        // takes the ownership verdict its branches agreed on, not an unconditional owner: a
        // borrowed extraction laundered through a destructure keeps its borrow so the freed
        // member rejects. The member type may be the surface wildcard, so a recorded verdict
        // enters the ownership record even when is_managed_ty cannot see the part is managed,
        // mirroring the single-binding path.
        mut own_member: int64 = -1
        binder_name: string = ast_name(a, b.name)
        if value.kind == xk_tuple() && value.b == stmt.b && !(*tc).types_only {
            member_id: int64 = vec_get((*a).kids, value.a + m)
            mem: ExprNode = vec_get((*a).exprs, member_id)
            if mem.kind == xk_match() || mem.kind == xk_ifexpr() {
                mv: int64 = match_own_of(tc, member_id)
                if mv >= 0 { own_member = mv }
            } else if mem.kind == xk_ident() {
                // A member that names a borrowed value hands the destructure binder that
                // borrow, not the owner default, so `y, n := (x, 1)` over a borrowed x
                // keeps y a borrow and a later free(y) rejects the launder. A member that
                // names an owner hands a borrow too, since the source keeps the ownership
                // it had; `y, n := (move(x), 1)` is how the ownership comes along.
                mo: int64 = member_ident_own(tc, ast_name(a, mem.a))
                if mo != 0 { own_member = mo }
            } else if mem.kind == xk_tuple() {
                // A nested tuple member records its own subtree under the binder, so a
                // further destructure of the binder still reaches a buried borrow.
                record_member_own_rec(tc, binder_name, mem)
            }
        } else if value.kind == xk_ident() && !(*tc).types_only {
            // Destructuring a tuple binding by name copies the member's recorded subtree
            // onto the binder (leaf and nested), so a borrow laundered through
            // `pair := (x, 1); y, n := pair` or a deeper nesting still reaches the freed
            // binder.
            copy_member_subtree(tc, tuple_member_key(ast_name(a, value.a), m), binder_name)
            tmo: *Map<string, int64> = (*tc).tuple_member_own
            if map_has(tmo, binder_name) { own_member = unwrap_or(map_get(tmo, binder_name), -1) }
        }
        // `ref a, b := pair` declares every binder a borrow of what the value already
        // owns, the destructuring reading of the word the single binding honors through
        // binding_own. Without this the marker parsed into the statement flags and
        // vanished here, so a binder that inherited a member's owner record freed a
        // pointer the source still owns. A binder with no ownership to track, a scalar
        // among them, stays inert exactly as `ref n := 7` does: the borrow is written
        // only where this walk would have written a record anyway.
        mut own_tag: int64 = own_member
        if (stmt.d & 2) != 0 {
            if is_managed_ty(tc, tyid) || own_member >= 0 { own_tag = own_borrow() }
        }
        if is_managed_ty(tc, tyid) {
            mut own_v: int64 = own_owner()
            if own_tag >= 0 { own_v = own_tag }
            declare_own(tc, ast_name(a, b.name), own_v)
        } else if own_tag >= 0 {
            declare_own(tc, ast_name(a, b.name), own_tag)
        }
        if (stmt.d & 2) != 0 { record_ref_member_borrows(tc, binder_name, tyid) }
    }
    if value.kind == xk_tuple() && value.b == stmt.b {
        for n in 0..stmt.b {
            b2: BindNode = vec_get((*a).binds, vec_get((*a).kids, stmt.a + n))
            member_id: int64 = vec_get((*a).kids, value.a + n)
            esc: EscPair = value_escape(tc, member_id)
            set_esc(tc, ast_name(a, b2.name), esc.slice, esc.closure)
            link_binding_aliases(tc, ast_name(a, b2.name), member_id, false)
            record_ptr_borrow_member(tc, ast_name(a, b2.name), member_id)
        }
    } else {
        whole: EscPair = value_escape(tc, stmt.c)
        for q in 0..stmt.b {
            b3: BindNode = vec_get((*a).binds, vec_get((*a).kids, stmt.a + q))
            part: int64 = vec_get(parts, q)
            if (whole.slice || whole.closure) && member_carries_view(tc, part) {
                set_esc(tc, ast_name(a, b3.name), whole.slice, whole.closure)
            }
            if links_as_alias(tc, part) {
                link_binding_aliases(tc, ast_name(a, b3.name), stmt.c, false)
            }
        }
    }
}

export func check_let(tc: *TypeChecker, stmt: StmtNode) -> void {
    a: *Ast = (*tc).ast
    value: ExprNode = vec_get((*a).exprs, stmt.c)
    if is_zero_arg_alloc(tc, stmt.c) && stmt.b == 1 {
        b0: BindNode = vec_get((*a).binds, vec_get((*a).kids, stmt.a))
        tyid: int64 = alloc_annot_ty(tc, b0, value)
        declare_one(tc, b0, tyid, (stmt.d & 1) != 0, value.lo, value.hi)
        if is_managed_ty(tc, tyid) {
            declare_own(tc, ast_name(a, b0.name), own_owner())
        }
        return
    }
    // A managed-typed single binding hints the branch verdict: a match or if value bound to
    // a managed annotation is ownership-relevant even when no branch resolves managed on its
    // own (a single unresolved payload binder over a locally allocated subject), so the copy
    // spelling of an extraction still rejects. The branch walk captures and clears the hint.
    if stmt.b == 1 && !(*tc).types_only && (value.kind == xk_match() || value.kind == xk_ifexpr()) {
        b_hint: BindNode = vec_get((*a).binds, vec_get((*a).kids, stmt.a))
        if b_hint.ty >= 0 && is_managed_ty(tc, tc_type(tc, b_hint.ty)) { (*tc).match_ctx = 1 }
    }
    vt: int64 = infer_expr(tc, stmt.c)
    (*tc).match_ctx = 0
    vn: TyNode = ty_get((*tc).ty, vt)
    if (stmt.d & 2) != 0 && vn.kind == tyk_collector() {
        tc_emit(tc, "a collected value is not borrowed with ref; copy it directly", value.lo, value.hi)
    }
    if stmt.b == 1 && !(*tc).types_only && value.kind == xk_call() && !is_enum_ctor_call(tc, stmt.c) && tuple_has_error(tc, vt) {
        tc_emit(tc, "a fallible result must be destructured; bind the value and the error, as in `v, e := f()`", value.lo, value.hi)
    }
    if stmt.b == 1 {
        single_bind(tc, stmt, vt)
    } else {
        destructure_bind(tc, stmt, vt)
    }
}
