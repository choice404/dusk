// tcexpr: expression inference for the S3a type layer.

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
@import ast
@import ty
@import tysigs
@import tcstate
@import tcscope
@import tcbin
@import tccall
@import tciface
@import tcmatch
@import tcown
@import tcesc
@import tcesc2
@import tcesccap
@import tcexprprep
@import tcesc3

func arm_diverges(a: *Ast, block_id: int64) -> bool {
    return block_diverges(a, block_id)
}

// A representative expr id inside an arm's last statement, to carry the every-arm-yields
// caret; -1 when the last statement holds no expression (an empty block), in which case
// the caller falls back to the scrutinee.
func arm_tail_span_expr(a: *Ast, block_id: int64) -> int64 {
    b: BlockNode = vec_get((*a).blocks, block_id)
    if b.len == 0 { return -1 }
    s: StmtNode = vec_get((*a).stmts, vec_get((*a).kids, b.off + b.len - 1))
    if s.kind == sk_if() || s.kind == sk_while() || s.kind == sk_expr() { return s.a }
    if s.kind == sk_return() || s.kind == sk_defer() || s.kind == sk_match() { return s.a }
    if s.kind == sk_assign() { return s.a }
    if s.kind == sk_for() || s.kind == sk_assign_op() { return s.b }
    if s.kind == sk_let() { return s.c }
    return -1
}

// Walk a match expression's arms and, with each arm scope live, derive its two
// per-arm judgments. On the ground pass (types_only) the arm tails must agree on
// type: their inferred types are compared pairwise, and a width- or kind-mismatched
// arm faults, which retires the first-resolvable-arm-wins result-typing miscompile at
// check time so codegen's take-first result slot rests on a checker guarantee. On the
// surface pass the managed-pointer arms produce the ownership verdict (Algorithm M 5-6),
// judged here rather than after the scopes pop so an arm-local fresh owner classifies as
// the move out it is; the aggregate lands in match_own keyed by the match expr id for the
// binding, destructure, free/move, and return-position checks to read. The tail type is
// re-inferred under suppress so the second walk adds no diagnostic and no fresh fault.
func walk_match_expr(tc: *TypeChecker, id: int64, e: ExprNode) -> int64 {
    ctx: int64 = (*tc).match_ctx
    (*tc).match_ctx = 0
    st: int64 = infer_expr(tc, e.a)
    scrut_esc: EscPair = value_escape(tc, e.a)
    a: *Ast = (*tc).ast
    (*tc).branch_depth = (*tc).branch_depth + 1
    mut subj_own: int64 = own_borrow()
    if !(*tc).types_only { subj_own = match_subject_own(tc, e.a) }
    mut ref_ty: int64 = -1
    mut disagreed: bool = false
    // Ownership judgments are collected per value-yielding arm with the arm scope live,
    // then finalized after the loop once the match is confirmed managed: the copy fault
    // and the aggregate verdict emit only for a managed-pointer match, so a scalar match
    // never fabricates a spurious ownership fault. any_managed is the managed evidence
    // (a resolvable managed arm); ctx == 1 is the managed binding context hint that also
    // covers a single unresolved payload arm bound to a managed annotation.
    own_vals: *Vector<int64> = alloc(vec_new())
    copy_faults: *Vector<int64> = alloc(vec_new())
    own_tails: *Vector<int64> = alloc(vec_new())
    mut any_managed: bool = false
    // Surface-pass evidence that an arm extracts a generic payload binder whose managed
    // status is unprovable until mono grounds it. Without it a bind such as `x := match
    // *c { Has(p) => p }` over a borrowed generic subject records no verdict, and the
    // free/return check downstream reads the owner default and launders the borrow.
    mut any_unprovable: bool = false
    mut i: int64 = 0
    while i < e.c {
        arm: ArmNode = vec_get((*a).arms, vec_get((*a).kids, e.b + i))
        push_scope(tc)
        bind_match_arm(tc, arm.pat, st, e.a)
        bind_match_arm_escape(tc, arm.pat, e.a, scrut_esc)
        // A nested match tail in a managed context (a managed annotation, ctx == 1, or an
        // owned subject) must run its own ownership judgment so a verdict is recorded even
        // when its tails name an outer payload binder or its payload type is a generic hole on
        // the surface pass; without the hint the inner match records nothing and a borrow or an
        // owner copy launders outward. The hint is set around the diagnostic walk so the inner
        // copy fault emits, and around the suppressed re-infer so the verdict is recorded even
        // if a leading match statement consumed the first hint.
        mut nest_hint: bool = false
        if !(*tc).types_only && (ctx == 1 || subj_own == own_owner()) {
            pk: int64 = match_arm_tail(a, arm.body)
            if pk >= 0 {
                pkx: ExprNode = vec_get((*a).exprs, pk)
                if pkx.kind == xk_match() { nest_hint = true }
            }
        }
        if nest_hint { (*tc).match_ctx = 1 }
        check_block_no_scope(tc, arm.body)
        if nest_hint { (*tc).match_ctx = 0 }
        tail_id: int64 = match_arm_tail(a, arm.body)
        if tail_id < 0 && !(*tc).types_only && !arm_diverges(a, arm.body) {
            mut sp: int64 = arm_tail_span_expr(a, arm.body)
            if sp < 0 { sp = e.a }
            spx: ExprNode = vec_get((*a).exprs, sp)
            tc_emit(tc, "every arm of a match expression must yield a value or return", spx.lo, spx.hi)
        }
        if tail_id >= 0 {
            if nest_hint { (*tc).match_ctx = 1 }
            (*tc).suppress = (*tc).suppress + 1
            at: int64 = infer_expr(tc, tail_id)
            (*tc).suppress = (*tc).suppress - 1
            if nest_hint { (*tc).match_ctx = 0 }
            if (*tc).types_only {
                atn: TyNode = ty_get((*tc).ty, at)
                if atn.kind != tyk_unknown() && !disagreed {
                    if ref_ty < 0 {
                        ref_ty = at
                    } else if !compat((*tc).ty, ref_ty, at) {
                        tailx: ExprNode = vec_get((*a).exprs, tail_id)
                        tc_emit(tc, "the arms of a match expression must agree on type", tailx.lo, tailx.hi)
                        disagreed = true
                    }
                }
            } else {
                if arm_tail_managed(tc, e.a, arm.pat, tail_id, at) { any_managed = true }
                if arm_tail_unprovable(tc, e.a, arm.pat, tail_id) { any_unprovable = true }
                vec_push(own_vals, arm_own_value(tc, arm.pat, tail_id, subj_own, at))
                vec_push(copy_faults, arm_copy_fault(tc, arm.pat, tail_id, subj_own))
                vec_push(own_tails, tail_id)
            }
        }
        pop_scope(tc)
        i = i + 1
    }
    (*tc).branch_depth = (*tc).branch_depth - 1
    check_match_arm_lambdas(tc, e)
    check_match_scrutinee(tc, st, e.a, e.b, e.c)
    if !(*tc).types_only && (ctx == 1 || any_managed || any_unprovable) {
        finalize_match_own(tc, id, own_vals, copy_faults, own_tails)
    }
    // On the ground pass the arms have concrete types, so a match yields the type they
    // agreed on rather than the surface wildcard. This lets a match used as another match's
    // arm tail enter the outer agreement check, and a match bound or passed against an
    // annotation get the same width and type comparison any other value does. A surface
    // match, or a ground match whose arms disagreed, stays unknown so the disagreement is
    // reported once and nothing downstream cascades on it.
    if (*tc).types_only && !disagreed && ref_ty >= 0 { return ref_ty }
    return ty_unknown((*tc).ty)
}

// Emit the deferred ownership faults of a confirmed-managed match and store its verdict.
// Each recorded copy fault becomes the standard owner-copy diagnostic; the arms must agree
// on ownership, faulting the first arm that disagrees with the running verdict; the
// aggregate (owner if every arm owns, borrow if every arm borrows, else the first) lands in
// match_own for the binding, destructure, free/move, and return checks to read.
func finalize_match_own(tc: *TypeChecker, id: int64, own_vals: *Vector<int64>, copy_faults: *Vector<int64>, own_tails: *Vector<int64>) -> void {
    a: *Ast = (*tc).ast
    mut i: int64 = 0
    while i < vec_len(copy_faults) {
        cf: int64 = vec_get(copy_faults, i)
        if cf >= 0 {
            ce: ExprNode = vec_get((*a).exprs, cf)
            tc_emit(tc, "cannot copy an owning pointer; bind a `ref` alias or `move` it", ce.lo, ce.hi)
        }
        i = i + 1
    }
    mut verdict: int64 = -1
    mut mixed: bool = false
    mut j: int64 = 0
    while j < vec_len(own_vals) {
        v: int64 = vec_get(own_vals, j)
        if verdict < 0 {
            verdict = v
        } else if v != verdict && !mixed {
            mixed = true
            me: ExprNode = vec_get((*a).exprs, vec_get(own_tails, j))
            tc_emit(tc, "the arms of a match expression must agree on ownership of its result", me.lo, me.hi)
        }
        j = j + 1
    }
    mut vv: int64 = own_owner()
    if verdict >= 0 { vv = verdict }
    set_match_own(tc, id, vv)
}

export func infer_expr(tc: *TypeChecker, id: int64) -> int64 {
    a: *Ast = (*tc).ast
    e: ExprNode = vec_get((*a).exprs, id)
    if e.kind == xk_int() {
        mut w: int64 = 0
        mut unsigned: bool = false
        if e.b >= 0 {
            w = int_suffix_width(ast_name(a, e.b))
            unsigned = int_suffix_unsigned(ast_name(a, e.b))
        }
        if w != 0 { check_suffix_value_fits(tc, e.a, w, unsigned, e.lo, e.hi) }
        if unsigned { return ty_uint((*tc).ty, w) }
        return ty_int((*tc).ty, w)
    }
    if e.kind == xk_float() {
        mut fw: int64 = 0
        if e.b >= 0 { fw = float_suffix_width(ast_name(a, e.b)) }
        return ty_float((*tc).ty, fw)
    }
    if e.kind == xk_bool() { return ty_bool((*tc).ty) }
    if e.kind == xk_char() { return ty_char((*tc).ty) }
    if e.kind == xk_rune() { return ty_rune((*tc).ty) }
    if e.kind == xk_str() { return ty_str((*tc).ty) }
    if e.kind == xk_ident() {
        name: string = ast_name(a, e.a)
        check_ident_move_use(tc, name, e.lo, e.hi)
        asyncs: *Map<string, int64> = (*tc).async_fns
        if map_has(asyncs, name) && !is_local(tc, name) {
            bmsg: *StringBuilder = alloc(sb_new())
            sb_push_char(bmsg, 39)
            sb_push(bmsg, name)
            sb_push(bmsg, "' is async; call it with await or start it with async_run")
            outmsg: string = substring(sb_cstr(bmsg), 0, sb_size(bmsg))
            sb_free(bmsg)
            free(bmsg)
            tc_emit(tc, outmsg, e.lo, e.hi)
        }
        if !is_local(tc, name) && !sig_has_fn((*tc).sigtab, name) {
            en: string = variant_owner((*tc).sigtab, name)
            if str_len(en) > 0 {
                tc_emit(tc, ident_variant_value_msg(en, name), e.lo, e.hi)
            }
        }
        // A variadic foreign taken as a value would call through a thunk that
        // cannot carry the vararg call type, so the indirect call would drop
        // the C variadic ABI contract. Direct calls never reach this arm; the
        // call path resolves a top level callee through lookup instead.
        if !is_local(tc, name) && sig_is_variadic_foreign((*tc).sigtab, name) {
            vbmsg: *StringBuilder = alloc(sb_new())
            sb_push_char(vbmsg, 39)
            sb_push(vbmsg, name)
            sb_push(vbmsg, "' is a variadic foreign function; call it directly, it cannot be taken as a value")
            voutmsg: string = substring(sb_cstr(vbmsg), 0, sb_size(vbmsg))
            sb_free(vbmsg)
            free(vbmsg)
            tc_emit(tc, voutmsg, e.lo, e.hi)
        }
        // A foreign function that passes a struct by value taken as a value would
        // call through a funcval thunk that uses the plain struct type and drops
        // the System V register or byval coercion, silently miscompiling the
        // call. Direct calls resolve the callee through lookup and never reach
        // this arm.
        if !is_local(tc, name) && foreign_takes_struct(tc, name) {
            sbmsg: *StringBuilder = alloc(sb_new())
            sb_push_char(sbmsg, 39)
            sb_push(sbmsg, name)
            sb_push(sbmsg, "' is a foreign function that passes a struct by value; call it directly, it cannot be taken as a value")
            soutmsg: string = substring(sb_cstr(sbmsg), 0, sb_size(sbmsg))
            sb_free(sbmsg)
            free(sbmsg)
            tc_emit(tc, soutmsg, e.lo, e.hi)
        }
        // A foreign function that takes a C callback taken as a value would call
        // through a funcval thunk that passes the callback as a `{ptr, fn}`
        // closure, dropping the bare C function pointer ABI. Direct calls resolve
        // the callee through lookup and never reach this arm.
        if !is_local(tc, name) && foreign_takes_callback(tc, name) {
            cbmsg: *StringBuilder = alloc(sb_new())
            sb_push_char(cbmsg, 39)
            sb_push(cbmsg, name)
            sb_push(cbmsg, "' is a foreign function that takes a C callback; call it directly, it cannot be taken as a value")
            coutmsg: string = substring(sb_cstr(cbmsg), 0, sb_size(cbmsg))
            sb_free(cbmsg)
            free(cbmsg)
            tc_emit(tc, coutmsg, e.lo, e.hi)
        }
        return lookup(tc, name)
    }
    if e.kind == xk_unary() {
        t: int64 = infer_expr(tc, e.b)
        return check_unary(tc, e.a, t, e.lo, e.hi)
    }
    if e.kind == xk_binary() {
        lt: int64 = infer_expr(tc, e.b)
        rt: int64 = infer_expr(tc, e.c)
        res: int64 = check_binary(tc, e.a, lt, rt, e.lo, e.hi)
        // A bare literal operand takes the other operand's type, the one place a
        // literal reaches a narrow width with no annotation to range it.
        check_operand_lit_fits(tc, e.a, e.b, e.c, lt, rt)
        if e.a == bop_shl() || e.a == bop_shr() { check_shift_amount(tc, e.c, res, e.lo, e.hi) }
        if e.a == bop_pow() { check_pow_exponent(tc, lt, rt, e.c, e.lo, e.hi) }
        return res
    }
    if e.kind == xk_call() {
        enforce_call_escape(tc, e.a, e.b, e.c, e.lo, e.hi)
        return infer_call(tc, e.a, e.b, e.c)
    }
    if e.kind == xk_field() {
        base_ty: int64 = infer_expr(tc, e.a)
        fname: string = ast_name(a, e.b)
        bn: TyNode = ty_get((*tc).ty, base_ty)
        if bn.kind == tyk_array() {
            if str_eq(fname, "len") { return ty_int((*tc).ty, 64) }
            tc_emit(tc, array_field_msg(fname), e.lo, e.hi)
            return ty_unknown((*tc).ty)
        }
        if bn.kind == tyk_error() {
            if str_eq(fname, "message") { return ty_str((*tc).ty) }
            tc_emit(tc, error_field_msg(fname), e.lo, e.hi)
            return ty_str((*tc).ty)
        }
        return ty_unknown((*tc).ty)
    }
    if e.kind == xk_index() {
        base_ty2: int64 = infer_expr(tc, e.a)
        it0: int64 = infer_expr(tc, e.b)
        idx: ExprNode = vec_get((*a).exprs, e.b)
        bn2: TyNode = ty_get((*tc).ty, base_ty2)
        // An index is an int64 offset, so an unsigned one is refused rather than
        // handed to a widening that must pick its extension by a signedness the
        // index position never states. A range answers unknown here; its two ends
        // are checked in the range arm, where they are inferred.
        check_index_signedness(tc, it0, idx.lo, idx.hi)
        if idx.kind == xk_range() {
            // A range slice validates against its base's length, and a raw
            // pointer has none: the fat slice it would mint claims a length no
            // backing vouches for. Index reads through the raw pointer stay
            // legal; only the range form is refused.
            mut lengthless: bool = bn2.kind == tyk_rawptr()
            if bn2.kind == tyk_ptr() {
                pin: TyNode = ty_get((*tc).ty, bn2.a)
                if pin.kind == tyk_unit() { lengthless = true }
            }
            if lengthless {
                tc_emit(tc, "cannot take a range slice of a raw pointer; it has no length to check the range against", e.lo, e.hi)
            }
            return ty_slice((*tc).ty, elem_of((*tc).ty, base_ty2))
        }
        if bn2.kind == tyk_slice() || bn2.kind == tyk_array() || bn2.kind == tyk_str() || bn2.kind == tyk_collector() || bn2.kind == tyk_unknown() {
            return elem_of((*tc).ty, base_ty2)
        }
        // Stage0 currently leaves non-indexable scalar indexing permissive here;
        // this stays aligned rather than inventing a new diagnostic in S3a.
        return ty_unknown((*tc).ty)
    }
    if e.kind == xk_range() {
        rlo: int64 = infer_expr(tc, e.a)
        rhi: int64 = infer_expr(tc, e.b)
        check_index_signedness(tc, rlo, e.lo, e.hi)
        check_index_signedness(tc, rhi, e.lo, e.hi)
        return ty_unknown((*tc).ty)
    }
    if e.kind == xk_tuple() { return infer_tuple(tc, e.a, e.b) }
    if e.kind == xk_array() { return infer_array(tc, e.a, e.b) }
    if e.kind == xk_struct_lit() {
        name2: string = ast_name(a, e.a)
        check_struct_lit(tc, name2, e.b, e.c, e.lo, e.hi)
        // A surface `Future { ... }` literal carries no element in its words, so it
        // infers as a future of an unknown element, compatible with any Future<T>.
        // On the ground AST mono has mangled the literal to `Future$T`, so unmangle
        // restores the future shape the async call and annotation both carry; a
        // plain struct name passes through untouched.
        if str_eq(name2, "Future") { return ty_future((*tc).ty, ty_unknown((*tc).ty)) }
        return unmangle((*tc).ty, named_ty((*tc).ty, name2), (*tc).future_elems)
    }
    if e.kind == xk_lambda() { return infer_lambda_sig(tc, e) }
    if e.kind == xk_match() {
        return walk_match_expr(tc, id, e)
    }
    if e.kind == xk_do() {
        mut i: int64 = 0
        while i < e.c {
            d: DoBindNode = vec_get((*a).do_binds, vec_get((*a).kids, e.b + i))
            infer_expr(tc, d.expr)
            i = i + 1
        }
        return ty_unknown((*tc).ty)
    }
    if e.kind == xk_await() {
        infer_expr(tc, e.a)
        if !(*tc).types_only {
            tc_emit(tc, "'await' cannot appear mid-expression; give the awaited value a name, as in v, e := await f", e.lo, e.hi)
        }
        return ty_unknown((*tc).ty)
    }
    if e.kind == xk_fstr() {
        // The kids alternate chunk (even) and hole (odd). Each chunk is a plain
        // string that needs no check; each hole is inferred and must be printable by
        // the same rule the format placeholder enforces, so an enum, a pointer, or a
        // void value is rejected here with the printable-set diagnostic. The result
        // is a string, the concat class, with no ownership or paradigm obligation.
        mut fi: int64 = 1
        while fi < e.b {
            kid_id: int64 = vec_get((*a).kids, e.a + fi)
            ht: int64 = infer_expr(tc, kid_id)
            kide: ExprNode = vec_get((*a).exprs, kid_id)
            check_printable(tc, ht, kide.lo, kide.hi)
            fi = fi + 2
        }
        return ty_str((*tc).ty)
    }
    if e.kind == xk_sizeof_type() { return ty_int((*tc).ty, 64) }
    if e.kind == xk_collect() {
        inner: int64 = tc_type(tc, e.a)
        actual: int64 = infer_expr(tc, e.b)
        arg: ExprNode = vec_get((*a).exprs, e.b)
        if !compat((*tc).ty, inner, actual) {
            tc_emit(tc, "the collected value's type does not match the collector element type", arg.lo, arg.hi)
        }
        check_lit_fits_target(tc, e.b, inner)
        check_collect_mint(tc, e, inner)
        return ty_collector((*tc).ty, inner)
    }
    return ty_unknown((*tc).ty)
}
