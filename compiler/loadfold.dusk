// loadfold: arena mechanics for the P4 loader: span shifting, item copying, and
// qualified module call folding.

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
@import ast
@import diag

export func load_shift_module(a: *Ast, base: int64) -> void {
    if base == 0 {
        return
    }
    items: *Vector<ItemNode> = (*a).items
    mut i: int64 = 0
    while i < vec_len(items) {
        it: ItemNode = vec_get(items, i)
        if it.kind == ik_func() {
            f: FuncNode = vec_get((*a).funcs, it.id)
            shift_block(a, f.body, base)
        } else if it.kind == ik_impl() {
            im: ImplNode = vec_get((*a).impls, it.id)
            mut j: int64 = 0
            while j < im.methods_len {
                mf: FuncNode = vec_get((*a).funcs, vec_get((*a).kids, im.methods_off + j))
                shift_block(a, mf.body, base)
                j = j + 1
            }
        }
        i = i + 1
    }
}

func shift_block(a: *Ast, id: int64, base: int64) -> void {
    b: BlockNode = vec_get((*a).blocks, id)
    mut i: int64 = 0
    while i < b.len {
        shift_stmt(a, vec_get((*a).kids, b.off + i), base)
        i = i + 1
    }
}

func shift_stmt(a: *Ast, id: int64, base: int64) -> void {
    s: StmtNode = vec_get((*a).stmts, id)
    if s.kind == sk_let() {
        shift_expr(a, s.c, base)
    } else if s.kind == sk_assign() {
        shift_expr(a, s.a, base)
        shift_expr(a, s.b, base)
    } else if s.kind == sk_assign_op() {
        shift_expr(a, s.b, base)
        shift_expr(a, s.c, base)
    } else if s.kind == sk_return() {
        if s.a >= 0 {
            shift_expr(a, s.a, base)
        }
    } else if s.kind == sk_defer() {
        shift_expr(a, s.a, base)
    } else if s.kind == sk_if() {
        shift_expr(a, s.a, base)
        shift_block(a, s.b, base)
        if s.c >= 0 {
            shift_block(a, s.c, base)
        }
    } else if s.kind == sk_break() || s.kind == sk_continue() {
        vec_set((*a).stmts, id, StmtNode { kind: s.kind, a: s.a + base, b: s.b + base, c: 0, d: 0 })
    } else if s.kind == sk_while() {
        shift_expr(a, s.a, base)
        shift_block(a, s.b, base)
    } else if s.kind == sk_for() {
        shift_expr(a, s.b, base)
        shift_block(a, s.c, base)
    } else if s.kind == sk_match() {
        shift_match(a, s.a, s.b, s.c, base)
    } else {
        shift_expr(a, s.a, base)
    }
}

func shift_match(a: *Ast, scrut: int64, off: int64, len: int64, base: int64) -> void {
    shift_expr(a, scrut, base)
    mut i: int64 = 0
    while i < len {
        arm: ArmNode = vec_get((*a).arms, vec_get((*a).kids, off + i))
        shift_block(a, arm.body, base)
        i = i + 1
    }
}

func shift_expr(a: *Ast, id: int64, base: int64) -> void {
    exprs: *Vector<ExprNode> = (*a).exprs
    mut e: ExprNode = vec_get(exprs, id)
    e.lo = e.lo + base
    e.hi = e.hi + base
    if e.kind == xk_unary() {
        shift_expr(a, e.b, base)
    } else if e.kind == xk_binary() {
        shift_expr(a, e.b, base)
        shift_expr(a, e.c, base)
    } else if e.kind == xk_call() {
        shift_expr(a, e.a, base)
        mut i: int64 = 0
        while i < e.c {
            shift_expr(a, vec_get((*a).kids, e.b + i), base)
            i = i + 1
        }
    } else if e.kind == xk_field() {
        shift_expr(a, e.a, base)
    } else if e.kind == xk_index() {
        shift_expr(a, e.a, base)
        shift_expr(a, e.b, base)
    } else if e.kind == xk_range() {
        shift_expr(a, e.a, base)
        shift_expr(a, e.b, base)
    } else if e.kind == xk_tuple() {
        shift_expr_slice(a, e.a, e.b, base)
    } else if e.kind == xk_array() {
        shift_expr_slice(a, e.a, e.b, base)
    } else if e.kind == xk_fstr() {
        shift_expr_slice(a, e.a, e.b, base)
    } else if e.kind == xk_struct_lit() {
        mut j: int64 = 0
        while j < e.c {
            shift_expr(a, vec_get((*a).kids, e.b + j + 1), base)
            j = j + 2
        }
    } else if e.kind == xk_lambda() {
        shift_block(a, e.d, base)
    } else if e.kind == xk_match() {
        shift_match(a, e.a, e.b, e.c, base)
    } else if e.kind == xk_incdec() {
        // d is the operator token's low byte, a span like lo and hi, so it shifts with
        // them; left where it was, a diagnostic against an imported increment would
        // point into another file's text.
        e.d = e.d + base
        shift_expr(a, e.a, base)
    } else if e.kind == xk_ifexpr() {
        shift_expr(a, e.a, base)
        shift_block(a, e.b, base)
        shift_block(a, e.c, base)
    } else if e.kind == xk_do() {
        mut k: int64 = 0
        while k < e.c {
            d: DoBindNode = vec_get((*a).do_binds, vec_get((*a).kids, e.b + k))
            shift_expr(a, d.expr, base)
            k = k + 1
        }
    } else if e.kind == xk_await() {
        shift_expr(a, e.a, base)
    } else if e.kind == xk_collect() {
        shift_expr(a, e.b, base)
    }
    vec_set(exprs, id, e)
}

func shift_expr_slice(a: *Ast, off: int64, len: int64, base: int64) -> void {
    mut i: int64 = 0
    while i < len {
        shift_expr(a, vec_get((*a).kids, off + i), base)
        i = i + 1
    }
}

func flatten_path(a: *Ast, id: int64) -> (string, bool) {
    e: ExprNode = vec_get((*a).exprs, id)
    if e.kind == xk_ident() {
        return (ast_name(a, e.a), true)
    }
    if e.kind == xk_field() {
        p, ok := flatten_path(a, e.a)
        if !ok {
            return ("", false)
        }
        b: *StringBuilder = alloc(sb_new())
        sb_push(b, p)
        sb_push_char(b, 46)
        sb_push(b, ast_name(a, e.b))
        out: string = substring(sb_cstr(b), 0, sb_size(b))
        sb_free(b)
        free(b)
        return (out, true)
    }
    return ("", false)
}

func private_msg(leaf: string, prefix: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push_char(b, 39)
    sb_push(b, leaf)
    sb_push(b, "' is private to module '")
    sb_push(b, prefix)
    sb_push_char(b, 39)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

// The context one fold pass carries: the module namespaces a qualified call may name,
// their export sets, the file table a diagnostic resolves against, the diagnostics
// collected so far, and the stack of names bound in the function being folded. The
// binding stack is what keeps a local from being read as a module: in a function whose
// parameter is named json, `json.parse()` is a method call on that parameter, and only
// the binding tells it apart from a call into an imported json module. The record holds
// pointers, so a copy passed down shares the one stack every scope pushes onto.
struct FoldCtx {
    ns: *Map<string, int64>,
    exports: *Map<string, *Map<string, int64>>,
    files: *Vector<FileSrc>,
    errors: *Vector<LoadDiag>,
    bound: *Vector<*Map<string, int64>>,
}

func fold_new_set() -> *Map<string, int64> {
    return alloc(map_new())
}

func fold_push_scope(fc: FoldCtx) -> void {
    vec_push(fc.bound, fold_new_set())
}

func fold_pop_scope(fc: FoldCtx) -> void {
    b: *Vector<*Map<string, int64>> = fc.bound
    (*b).len = (*b).len - 1
}

// Binds one name in the innermost scope. The stack is read into an annotated local
// first, the idiom every walker here uses: a generic field read inline leaves the
// element type unpinned and the call cannot infer it.
func fold_bind_text(fc: FoldCtx, name: string) -> void {
    b: *Vector<*Map<string, int64>> = fc.bound
    map_put(vec_get(b, vec_len(b) - 1), name, 1)
}

func fold_bind(fc: FoldCtx, a: *Ast, name: int64) -> void {
    if name < 0 {
        return
    }
    fold_bind_text(fc, ast_name(a, name))
}

// Whether a name is bound by anything the function itself introduced. Any scope on the
// stack counts, since an outer binding is just as much a shadow of a module name as an
// inner one.
func fold_is_bound(fc: FoldCtx, name: string) -> bool {
    b: *Vector<*Map<string, int64>> = fc.bound
    mut i: int64 = 0
    while i < vec_len(b) {
        if map_has(vec_get(b, i), name) {
            return true
        }
        i = i + 1
    }
    return false
}

// The leftmost name of a dotted path, the one a local binding can shadow. The name is
// the interner's own text, so nothing is allocated to answer this.
func path_root_name(a: *Ast, id: int64) -> (string, bool) {
    e: ExprNode = vec_get((*a).exprs, id)
    if e.kind == xk_ident() {
        return (ast_name(a, e.a), true)
    }
    if e.kind == xk_field() {
        return path_root_name(a, e.a)
    }
    return ("", false)
}

// Binds every name a pattern introduces over its arm body: a variant pattern's payload
// binders, and an identifier pattern's own name, which binds the whole scrutinee when it
// is not a variant of the enum.
func fold_bind_pattern(fc: FoldCtx, a: *Ast, id: int64) -> void {
    p: PatternNode = vec_get((*a).patterns, id)
    if p.kind == pk_ident() {
        fold_bind(fc, a, p.a)
    } else if p.kind == pk_variant() {
        mut i: int64 = 0
        while i < p.c {
            fold_bind(fc, a, vec_get((*a).kids, p.b + i))
            i = i + 1
        }
    }
}

func fold_expr_slice(a: *Ast, off: int64, len: int64, fc: FoldCtx) -> void {
    mut i: int64 = 0
    while i < len {
        fold_expr(a, vec_get((*a).kids, off + i), fc)
        i = i + 1
    }
}

func fold_match(a: *Ast, scrut: int64, off: int64, len: int64, fc: FoldCtx) -> void {
    fold_expr(a, scrut, fc)
    mut i: int64 = 0
    while i < len {
        arm: ArmNode = vec_get((*a).arms, vec_get((*a).kids, off + i))
        fold_push_scope(fc)
        fold_bind_pattern(fc, a, arm.pat)
        fold_block(a, arm.body, fc)
        fold_pop_scope(fc)
        i = i + 1
    }
}

func fold_block(a: *Ast, id: int64, fc: FoldCtx) -> void {
    fold_push_scope(fc)
    b: BlockNode = vec_get((*a).blocks, id)
    mut i: int64 = 0
    while i < b.len {
        fold_stmt(a, vec_get((*a).kids, b.off + i), fc)
        i = i + 1
    }
    fold_pop_scope(fc)
}

// Binds the names a let introduces, after its value has been folded: the value cannot
// see the binder, so a `json := json.core.load()` still folds the module call on its
// right and shadows the module for everything after it.
func fold_bind_let(a: *Ast, s: StmtNode, fc: FoldCtx) -> void {
    mut i: int64 = 0
    while i < s.b {
        bn: BindNode = vec_get((*a).binds, vec_get((*a).kids, s.a + i))
        fold_bind(fc, a, bn.name)
        i = i + 1
    }
}

func fold_stmt(a: *Ast, id: int64, fc: FoldCtx) -> void {
    s: StmtNode = vec_get((*a).stmts, id)
    if s.kind == sk_let() {
        fold_expr(a, s.c, fc)
        fold_bind_let(a, s, fc)
    } else if s.kind == sk_assign() {
        fold_expr(a, s.a, fc)
        fold_expr(a, s.b, fc)
    } else if s.kind == sk_assign_op() {
        fold_expr(a, s.b, fc)
        fold_expr(a, s.c, fc)
    } else if s.kind == sk_return() {
        if s.a >= 0 {
            fold_expr(a, s.a, fc)
        }
    } else if s.kind == sk_defer() {
        fold_expr(a, s.a, fc)
    } else if s.kind == sk_if() {
        fold_expr(a, s.a, fc)
        fold_block(a, s.b, fc)
        if s.c >= 0 {
            fold_block(a, s.c, fc)
        }
    } else if s.kind == sk_break() || s.kind == sk_continue() {
    } else if s.kind == sk_while() {
        fold_expr(a, s.a, fc)
        fold_block(a, s.b, fc)
    } else if s.kind == sk_for() {
        fold_expr(a, s.b, fc)
        fold_push_scope(fc)
        fold_bind(fc, a, s.a)
        // The optional second binder rides in d as the interned name plus one, so a
        // `for k, v in m` shadows a module named v over the loop body too.
        if s.d != 0 {
            fold_bind(fc, a, s.d - 1)
        }
        fold_block(a, s.c, fc)
        fold_pop_scope(fc)
    } else if s.kind == sk_match() {
        fold_match(a, s.a, s.b, s.c, fc)
    } else {
        fold_expr(a, s.a, fc)
    }
}

// Folds a qualified module call into a bare call on the merged module's flat namespace,
// and reports a leaf the named module does not export. The rewrite fires only when the
// path's root is a module name that nothing in the function has bound: a parameter, a
// let, a loop binder, an arm binder, a lambda parameter, or a do binder named for a
// module shadows it, and the call stays the method call it reads as. Without that test a
// `func show(json: Doc) { json.parse() }` in a file that imports json.core became a call
// to that module's free `parse`, silently, with a clean check and the wrong value at run
// time.
func fold_call_callee(a: *Ast, e: ExprNode, callee_id: int64, fc: FoldCtx) -> void {
    mut callee: ExprNode = vec_get((*a).exprs, callee_id)
    if callee.kind != xk_field() {
        return
    }
    prefix, ok := flatten_path(a, callee.a)
    if !ok {
        return
    }
    nsmap: *Map<string, int64> = fc.ns
    if !map_has(nsmap, prefix) {
        return
    }
    root, rooted := path_root_name(a, callee.a)
    if rooted {
        if fold_is_bound(fc, root) {
            return
        }
    }
    leaf: string = ast_name(a, callee.b)
    exmap: *Map<string, *Map<string, int64>> = fc.exports
    if map_has(exmap, prefix) {
        empty: *Map<string, int64> = alloc(map_new())
        ex: *Map<string, int64> = unwrap_or(map_get(exmap, prefix), empty)
        if !map_has(ex, leaf) {
            msg: string = private_msg(leaf, prefix)
            vec_push(fc.errors, load_diag_global(fc.files, e.lo, e.hi, msg))
        }
    }
    callee.kind = xk_ident()
    callee.a = callee.b
    vec_set((*a).exprs, callee_id, callee)
}

// Binds every name a do block introduces, then folds each step's expression. Every
// binder is in scope for the whole block, the same over-approximation the privatizer
// makes: binding more names can only leave a qualified call unfolded, never fold one
// that should have stayed a method call.
func fold_do(a: *Ast, e: ExprNode, fc: FoldCtx) -> void {
    fold_push_scope(fc)
    mut i: int64 = 0
    while i < e.c {
        d: DoBindNode = vec_get((*a).do_binds, vec_get((*a).kids, e.b + i))
        if d.name >= 0 {
            fold_bind(fc, a, d.name)
        }
        i = i + 1
    }
    mut j: int64 = 0
    while j < e.c {
        d2: DoBindNode = vec_get((*a).do_binds, vec_get((*a).kids, e.b + j))
        fold_expr(a, d2.expr, fc)
        j = j + 1
    }
    fold_pop_scope(fc)
}

func fold_lambda(a: *Ast, e: ExprNode, fc: FoldCtx) -> void {
    fold_push_scope(fc)
    mut i: int64 = 0
    while i < e.b {
        pn: ParamNode = vec_get((*a).params, vec_get((*a).kids, e.a + i))
        fold_bind(fc, a, pn.name)
        i = i + 1
    }
    fold_block(a, e.d, fc)
    fold_pop_scope(fc)
}

func fold_expr(a: *Ast, id: int64, fc: FoldCtx) -> void {
    e: ExprNode = vec_get((*a).exprs, id)
    if e.kind == xk_call() {
        fold_expr(a, e.a, fc)
        fold_expr_slice(a, e.b, e.c, fc)
        fold_call_callee(a, e, e.a, fc)
    } else if e.kind == xk_unary() {
        fold_expr(a, e.b, fc)
    } else if e.kind == xk_binary() {
        fold_expr(a, e.b, fc)
        fold_expr(a, e.c, fc)
    } else if e.kind == xk_field() {
        fold_expr(a, e.a, fc)
    } else if e.kind == xk_index() {
        fold_expr(a, e.a, fc)
        fold_expr(a, e.b, fc)
    } else if e.kind == xk_range() {
        fold_expr(a, e.a, fc)
        fold_expr(a, e.b, fc)
    } else if e.kind == xk_tuple() {
        fold_expr_slice(a, e.a, e.b, fc)
    } else if e.kind == xk_array() {
        fold_expr_slice(a, e.a, e.b, fc)
    } else if e.kind == xk_fstr() {
        fold_expr_slice(a, e.a, e.b, fc)
    } else if e.kind == xk_struct_lit() {
        mut i: int64 = 0
        while i < e.c {
            fold_expr(a, vec_get((*a).kids, e.b + i + 1), fc)
            i = i + 2
        }
    } else if e.kind == xk_lambda() {
        fold_lambda(a, e, fc)
    } else if e.kind == xk_match() {
        fold_match(a, e.a, e.b, e.c, fc)
    } else if e.kind == xk_incdec() {
        fold_expr(a, e.a, fc)
    } else if e.kind == xk_ifexpr() {
        fold_expr(a, e.a, fc)
        fold_block(a, e.b, fc)
        fold_block(a, e.c, fc)
    } else if e.kind == xk_do() {
        fold_do(a, e, fc)
    } else if e.kind == xk_await() {
        fold_expr(a, e.a, fc)
    } else if e.kind == xk_collect() {
        fold_expr(a, e.b, fc)
    }
}

// Folds one function body with its parameters bound, so a parameter named for a module
// shadows that module inside it. self is bound for a method for the same reason: the
// receiver is a value, whatever a directory beside the file is called.
func fold_func(a: *Ast, id: int64, is_method: bool, fc: FoldCtx) -> void {
    f: FuncNode = vec_get((*a).funcs, id)
    fold_push_scope(fc)
    if is_method {
        fold_bind_text(fc, "self")
    }
    mut i: int64 = 0
    while i < f.params_len {
        pn: ParamNode = vec_get((*a).params, vec_get((*a).kids, f.params_off + i))
        fold_bind(fc, a, pn.name)
        i = i + 1
    }
    fold_block(a, f.body, fc)
    fold_pop_scope(fc)
}

export func load_fold_qualified_calls(a: *Ast, ns: *Map<string, int64>, exports: *Map<string, *Map<string, int64>>, files: *Vector<FileSrc>, errors: *Vector<LoadDiag>) -> void {
    bound: *Vector<*Map<string, int64>> = alloc(vec_new())
    fc: FoldCtx = FoldCtx { ns: ns, exports: exports, files: files, errors: errors, bound: bound }
    items: *Vector<ItemNode> = (*a).items
    mut i: int64 = 0
    while i < vec_len(items) {
        it: ItemNode = vec_get(items, i)
        if it.kind == ik_func() {
            fold_func(a, it.id, false, fc)
        } else if it.kind == ik_impl() {
            im: ImplNode = vec_get((*a).impls, it.id)
            mut j: int64 = 0
            while j < im.methods_len {
                fold_func(a, vec_get((*a).kids, im.methods_off + j), true, fc)
                j = j + 1
            }
        }
        i = i + 1
    }
}
