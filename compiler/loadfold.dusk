/** loadfold: arena mechanics for the P4 loader: span shifting and qualified module call
 *  folding. A qualified call names a module by a dotted prefix, and the fold rewrites it
 *  into a call on the merged module's flat namespace. Since 1.14.1 that namespace is not
 *  flat by name alone: a dependency's exports carry the alias its importer pinned, so the
 *  fold has to know which package a prefix belongs to and which of its exports the scoping
 *  actually moved. Both come in as a FoldNs, one built from the calling file's own imports
 *  and one from every import in the program, and the file's own is asked first. */

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
@import ast
@import diag

export func load_shift_module(a: *Ast, base: int64) -> void {
    if base == 0 {
        return
    }
    items: *Vector<ItemNode> = (*a).items
    for it in items {
        if it.kind == ik_func() {
            f: FuncNode = vec_get((*a).funcs, it.id)
            shift_block(a, f.body, base)
        } else if it.kind == ik_impl() {
            im: ImplNode = vec_get((*a).impls, it.id)
            mut j: int64 = 0
            while j < im.methods_len {
                mf: FuncNode = vec_get((*a).funcs, vec_get((*a).kids, im.methods_off + j))
                shift_block(a, mf.body, base)
                j++
            }
        }
    }
}

func shift_block(a: *Ast, id: int64, base: int64) -> void {
    b: BlockNode = vec_get((*a).blocks, id)
    mut i: int64 = 0
    while i < b.len {
        shift_stmt(a, vec_get((*a).kids, b.off + i), base)
        i++
    }
}

func shift_stmt(a: *Ast, id: int64, base: int64) -> void {
    s: StmtNode = vec_get((*a).stmts, id)
    if s.kind == sk_let() {
        shift_expr(a, s.c, base)
    } else if s.kind == sk_assign() {
        shift_expr(a, s.a, base)
        shift_expr(a, s.b, base)
    } else if s.kind == sk_assign_op() {
        shift_expr(a, s.b, base)
        shift_expr(a, s.c, base)
    } else if s.kind == sk_return() {
        if s.a >= 0 {
            shift_expr(a, s.a, base)
        }
    } else if s.kind == sk_defer() {
        shift_expr(a, s.a, base)
    } else if s.kind == sk_if() {
        shift_expr(a, s.a, base)
        shift_block(a, s.b, base)
        if s.c >= 0 {
            shift_block(a, s.c, base)
        }
    } else if s.kind == sk_break() || s.kind == sk_continue() {
        vec_set((*a).stmts, id, StmtNode { kind: s.kind, a: s.a + base, b: s.b + base, c: 0, d: 0 })
    } else if s.kind == sk_while() {
        shift_expr(a, s.a, base)
        shift_block(a, s.b, base)
    } else if s.kind == sk_for() {
        shift_expr(a, s.b, base)
        shift_block(a, s.c, base)
    } else if s.kind == sk_match() {
        shift_match(a, s.a, s.b, s.c, base)
    } else {
        shift_expr(a, s.a, base)
    }
}

func shift_match(a: *Ast, scrut: int64, off: int64, len: int64, base: int64) -> void {
    shift_expr(a, scrut, base)
    mut i: int64 = 0
    while i < len {
        arm: ArmNode = vec_get((*a).arms, vec_get((*a).kids, off + i))
        shift_block(a, arm.body, base)
        i++
    }
}

func shift_expr(a: *Ast, id: int64, base: int64) -> void {
    exprs: *Vector<ExprNode> = (*a).exprs
    mut e: ExprNode = vec_get(exprs, id)
    e.lo += base
    e.hi += base
    if e.kind == xk_unary() {
        shift_expr(a, e.b, base)
    } else if e.kind == xk_binary() {
        shift_expr(a, e.b, base)
        shift_expr(a, e.c, base)
    } else if e.kind == xk_call() {
        shift_expr(a, e.a, base)
        mut i: int64 = 0
        while i < e.c {
            shift_expr(a, vec_get((*a).kids, e.b + i), base)
            i++
        }
    } else if e.kind == xk_field() {
        shift_expr(a, e.a, base)
    } else if e.kind == xk_index() {
        shift_expr(a, e.a, base)
        shift_expr(a, e.b, base)
    } else if e.kind == xk_range() {
        shift_expr(a, e.a, base)
        shift_expr(a, e.b, base)
    } else if e.kind == xk_tuple() {
        shift_expr_slice(a, e.a, e.b, base)
    } else if e.kind == xk_array() {
        shift_expr_slice(a, e.a, e.b, base)
    } else if e.kind == xk_fstr() {
        shift_expr_slice(a, e.a, e.b, base)
    } else if e.kind == xk_struct_lit() {
        mut j: int64 = 0
        while j < e.c {
            shift_expr(a, vec_get((*a).kids, e.b + j + 1), base)
            j += 2
        }
    } else if e.kind == xk_lambda() {
        shift_block(a, e.d, base)
    } else if e.kind == xk_match() {
        shift_match(a, e.a, e.b, e.c, base)
    } else if e.kind == xk_incdec() {
        // d is the operator token's low byte, a span like lo and hi, so it shifts with
        // them; left where it was, a diagnostic against an imported increment would
        // point into another file's text.
        e.d += base
        shift_expr(a, e.a, base)
    } else if e.kind == xk_ifexpr() {
        shift_expr(a, e.a, base)
        shift_block(a, e.b, base)
        shift_block(a, e.c, base)
    } else if e.kind == xk_do() {
        mut k: int64 = 0
        while k < e.c {
            d: DoBindNode = vec_get((*a).do_binds, vec_get((*a).kids, e.b + k))
            shift_expr(a, d.expr, base)
            k++
        }
    } else if e.kind == xk_await() {
        shift_expr(a, e.a, base)
    } else if e.kind == xk_collect() {
        shift_expr(a, e.b, base)
    }
    vec_set(exprs, id, e)
}

func shift_expr_slice(a: *Ast, off: int64, len: int64, base: int64) -> void {
    mut i: int64 = 0
    while i < len {
        shift_expr(a, vec_get((*a).kids, off + i), base)
        i++
    }
}

func flatten_path(a: *Ast, id: int64) -> (string, bool) {
    e: ExprNode = vec_get((*a).exprs, id)
    if e.kind == xk_ident() {
        return (ast_name(a, e.a), true)
    }
    if e.kind == xk_field() {
        p, ok := flatten_path(a, e.a)
        if !ok {
            return ("", false)
        }
        b: *StringBuilder = alloc(sb_new())
        sb_push(b, p)
        sb_push_char(b, 46)
        sb_push(b, ast_name(a, e.b))
        out: string = substring(sb_cstr(b), 0, sb_size(b))
        sb_free(b)
        free(b)
        return (out, true)
    }
    return ("", false)
}

func private_msg(leaf: string, prefix: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push_char(b, 39)
    sb_push(b, leaf)
    sb_push(b, "' is private to module '")
    sb_push(b, prefix)
    sb_push_char(b, 39)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

// The context one fold pass carries: the module namespaces a qualified call may name,
// their export sets, the file table a diagnostic resolves against, the diagnostics
// collected so far, and the stack of names bound in the function being folded. The
// binding stack is what keeps a local from being read as a module: in a function whose
// parameter is named json, `json.parse()` is a method call on that parameter, and only
// the binding tells it apart from a call into an imported json module. The record holds
// pointers, so a copy passed down shares the one stack every scope pushes onto.
struct FoldCtx {
    ns: *Map<string, int64>,
    exports: *Map<string, *Map<string, int64>>,
    own: FoldNs,
    all: FoldNs,
    files: *Vector<FileSrc>,
    errors: *Vector<LoadDiag>,
    bound: *Vector<*Map<string, int64>>,
    // The coverage record the rename pass keeps, shared so a fold that abandons the path
    // in front of a qualified call can say it reached those nodes. Folding a.b() leaves
    // the `a` the path was rooted at unreferenced in the arena, and the rename walk after
    // it can never reach a node nothing points at.
    seen: *Vector<int64>,
    mark: bool,
    // Every callee node this fold rewrote, so the rename pass after it knows the
    // identifier standing there is the qualified form's answer rather than a bare word the
    // file wrote and the scope still has to judge.
    folded_at: *Vector<int64>,
    // Every leaf the fold turned into a bare identifier in this file. A name a package
    // could not scope, a C symbol among them, folds to the spelling it was declared under,
    // and the rename pass after this one must not then read that identifier as a name
    // nothing put in scope.
    resolved: *Map<string, int64>,
}

/** What a dotted module prefix folds to. suffix is the package scope the module belongs
 *  to, empty for the root project and the standard library; moving is the set of that
 *  module's exports the scope actually renamed, so a name the rename could not move, a C
 *  symbol or the do protocol pair, folds to its bare spelling the way it always did. One
 *  of these is built per file from that file's own imports and one globally from every
 *  import in the program, and the file's own is asked first. */
export struct FoldNs {
    suffix: *Map<string, string>,
    moving: *Map<string, *Map<string, int64>>,
}

/** An empty prefix scope, the one a file with no import of its own carries. */
export func fold_ns_new() -> FoldNs {
    suffix: *Map<string, string> = alloc(map_new())
    moving: *Map<string, *Map<string, int64>> = alloc(map_new())
    return FoldNs { suffix: suffix, moving: moving }
}

/** The suffix a prefix takes when two imports disagree about which module it names. No
 *  alias can spell it, so it can only ever have been written here. */
func fold_ns_ambiguous() -> string {
    return "?"
}

// Records one dotted prefix as naming a module in a given package scope. A prefix already
// recorded under a different suffix names two modules, which nothing but the importing
// file's own import can tell apart, so it is marked and the fold refuses it there.
func fold_ns_put_one(t: FoldNs, prefix: string, suffix: string, moving: *Map<string, int64>) -> void {
    if map_has(t.suffix, prefix) {
        prior: string = unwrap_or(map_get(t.suffix, prefix), "")
        if !str_eq(prior, suffix) {
            map_put(t.suffix, prefix, fold_ns_ambiguous())
        }
    } else {
        map_put(t.suffix, prefix, suffix)
    }
    if map_has(t.moving, prefix) {
        empty: *Map<string, int64> = fold_new_set()
        target: *Map<string, int64> = unwrap_or(map_get(t.moving, prefix), empty)
        keys: *Vector<string> = map_keys(moving)
        mut i: int64 = 0
        while i < vec_len(keys) {
            map_put(target, vec_get(keys, i), 1)
            i++
        }
        vec_free(keys)
        free(keys)
    } else {
        target2: *Map<string, int64> = fold_new_set()
        map_put(t.moving, prefix, target2)
        keys2: *Vector<string> = map_keys(moving)
        mut j: int64 = 0
        while j < vec_len(keys2) {
            map_put(target2, vec_get(keys2, j), 1)
            j++
        }
        vec_free(keys2)
        free(keys2)
    }
}

/** Records a module path and every dotted prefix of it as naming a module in one package
 *  scope, the same widening load_add_namespace does for the namespace table itself: an
 *  import of maybe.core leaves both maybe and maybe.core folding into that package, which
 *  is what a qualified call through either spelling has always reached. */
export func fold_ns_add(t: FoldNs, modpath: string, suffix: string, moving: *Map<string, int64>) -> void {
    b: *StringBuilder = alloc(sb_new())
    mut i: int64 = 0
    while modpath[i] != 0 {
        if modpath[i] == 46 {
            if sb_size(b) > 0 {
                prefix: string = substring(sb_cstr(b), 0, sb_size(b))
                fold_ns_put_one(t, prefix, suffix, moving)
            }
            sb_push_char(b, 46)
        } else {
            sb_push_char(b, modpath[i])
        }
        i++
    }
    if sb_size(b) > 0 {
        full: string = substring(sb_cstr(b), 0, sb_size(b))
        fold_ns_put_one(t, full, suffix, moving)
    }
    sb_free(b)
    free(b)
}

func fold_new_set() -> *Map<string, int64> {
    return alloc(map_new())
}

func fold_push_scope(fc: FoldCtx) -> void {
    vec_push(fc.bound, fold_new_set())
}

func fold_pop_scope(fc: FoldCtx) -> void {
    b: *Vector<*Map<string, int64>> = fc.bound
    (*b).len--
}

// Binds one name in the innermost scope. The stack is read into an annotated local
// first, the idiom every walker here uses: a generic field read inline leaves the
// element type unpinned and the call cannot infer it.
func fold_bind_text(fc: FoldCtx, name: string) -> void {
    b: *Vector<*Map<string, int64>> = fc.bound
    map_put(vec_get(b, vec_len(b) - 1), name, 1)
}

func fold_bind(fc: FoldCtx, a: *Ast, name: int64) -> void {
    if name < 0 {
        return
    }
    fold_bind_text(fc, ast_name(a, name))
}

// Whether a name is bound by anything the function itself introduced. Any scope on the
// stack counts, since an outer binding is just as much a shadow of a module name as an
// inner one.
func fold_is_bound(fc: FoldCtx, name: string) -> bool {
    b: *Vector<*Map<string, int64>> = fc.bound
    mut i: int64 = 0
    while i < vec_len(b) {
        if map_has(vec_get(b, i), name) {
            return true
        }
        i++
    }
    return false
}

// The leftmost name of a dotted path, the one a local binding can shadow. The name is
// the interner's own text, so nothing is allocated to answer this.
func path_root_name(a: *Ast, id: int64) -> (string, bool) {
    e: ExprNode = vec_get((*a).exprs, id)
    if e.kind == xk_ident() {
        return (ast_name(a, e.a), true)
    }
    if e.kind == xk_field() {
        return path_root_name(a, e.a)
    }
    return ("", false)
}

// Binds every name a pattern introduces over its arm body: a variant pattern's payload
// binders, and an identifier pattern's own name, which binds the whole scrutinee when it
// is not a variant of the enum.
func fold_bind_pattern(fc: FoldCtx, a: *Ast, id: int64) -> void {
    p: PatternNode = vec_get((*a).patterns, id)
    if p.kind == pk_ident() {
        fold_bind(fc, a, p.a)
    } else if p.kind == pk_variant() {
        mut i: int64 = 0
        while i < p.c {
            fold_bind(fc, a, vec_get((*a).kids, p.b + i))
            i++
        }
    }
}

func fold_expr_slice(a: *Ast, off: int64, len: int64, fc: FoldCtx) -> void {
    mut i: int64 = 0
    while i < len {
        fold_expr(a, vec_get((*a).kids, off + i), fc)
        i++
    }
}

func fold_match(a: *Ast, scrut: int64, off: int64, len: int64, fc: FoldCtx) -> void {
    fold_expr(a, scrut, fc)
    mut i: int64 = 0
    while i < len {
        arm: ArmNode = vec_get((*a).arms, vec_get((*a).kids, off + i))
        fold_push_scope(fc)
        fold_bind_pattern(fc, a, arm.pat)
        fold_block(a, arm.body, fc)
        fold_pop_scope(fc)
        i++
    }
}

func fold_block(a: *Ast, id: int64, fc: FoldCtx) -> void {
    fold_push_scope(fc)
    b: BlockNode = vec_get((*a).blocks, id)
    mut i: int64 = 0
    while i < b.len {
        fold_stmt(a, vec_get((*a).kids, b.off + i), fc)
        i++
    }
    fold_pop_scope(fc)
}

// Binds the names a let introduces, after its value has been folded: the value cannot
// see the binder, so a `json := json.core.load()` still folds the module call on its
// right and shadows the module for everything after it.
func fold_bind_let(a: *Ast, s: StmtNode, fc: FoldCtx) -> void {
    mut i: int64 = 0
    while i < s.b {
        bn: BindNode = vec_get((*a).binds, vec_get((*a).kids, s.a + i))
        fold_bind(fc, a, bn.name)
        i++
    }
}

func fold_stmt(a: *Ast, id: int64, fc: FoldCtx) -> void {
    s: StmtNode = vec_get((*a).stmts, id)
    if s.kind == sk_let() {
        fold_expr(a, s.c, fc)
        fold_bind_let(a, s, fc)
    } else if s.kind == sk_assign() {
        fold_expr(a, s.a, fc)
        fold_expr(a, s.b, fc)
    } else if s.kind == sk_assign_op() {
        fold_expr(a, s.b, fc)
        fold_expr(a, s.c, fc)
    } else if s.kind == sk_return() {
        if s.a >= 0 {
            fold_expr(a, s.a, fc)
        }
    } else if s.kind == sk_defer() {
        fold_expr(a, s.a, fc)
    } else if s.kind == sk_if() {
        fold_expr(a, s.a, fc)
        fold_block(a, s.b, fc)
        if s.c >= 0 {
            fold_block(a, s.c, fc)
        }
    } else if s.kind == sk_break() || s.kind == sk_continue() {
    } else if s.kind == sk_while() {
        fold_expr(a, s.a, fc)
        fold_block(a, s.b, fc)
    } else if s.kind == sk_for() {
        fold_expr(a, s.b, fc)
        fold_push_scope(fc)
        fold_bind(fc, a, s.a)
        // The optional second binder rides in d as the interned name plus one, so a
        // `for k, v in m` shadows a module named v over the loop body too.
        if s.d != 0 {
            fold_bind(fc, a, s.d - 1)
        }
        fold_block(a, s.c, fc)
        fold_pop_scope(fc)
    } else if s.kind == sk_match() {
        fold_match(a, s.a, s.b, s.c, fc)
    } else {
        fold_expr(a, s.a, fc)
    }
}

// What one prefix folds into: whether the tables know it at all, whether two imports
// disagreed about which module it names, the package suffix its exports carry, and which
// of those exports the suffix actually moved.
struct NsPick {
    found: bool,
    ambiguous: bool,
    suffix: string,
    moving: *Map<string, int64>,
}

func no_pick(found: bool, ambiguous: bool) -> NsPick {
    return NsPick { found: found, ambiguous: ambiguous, suffix: "", moving: fold_new_set() }
}

// The moving export set a prefix carries in one scope table, empty when the table has
// nothing under that prefix.
func ns_moving_of(t: FoldNs, prefix: string) -> *Map<string, int64> {
    if map_has(t.moving, prefix) {
        empty: *Map<string, int64> = fold_new_set()
        return unwrap_or(map_get(t.moving, prefix), empty)
    }
    return fold_new_set()
}

// Which package scope a prefix names here. The importing file's own imports answer first,
// since they are the only place the question has one answer; the program wide table is the
// fallback, and it is where two imports can have named two different modules with one
// prefix, which nothing but an import in this file can tell apart.
func fold_pick_ns(fc: FoldCtx, prefix: string) -> NsPick {
    own: FoldNs = fc.own
    if map_has(own.suffix, prefix) {
        return NsPick { found: true, ambiguous: false, suffix: unwrap_or(map_get(own.suffix, prefix), ""), moving: ns_moving_of(own, prefix) }
    }
    all: FoldNs = fc.all
    if map_has(all.suffix, prefix) {
        s: string = unwrap_or(map_get(all.suffix, prefix), "")
        if str_eq(s, fold_ns_ambiguous()) {
            return no_pick(true, true)
        }
        return NsPick { found: true, ambiguous: false, suffix: s, moving: ns_moving_of(all, prefix) }
    }
    return no_pick(false, false)
}

// Records the name bearing nodes of a module path the fold is about to drop. The path is
// one identifier under a run of field accesses, so the identifier at its root is the only
// node the coverage record cares about.
func fold_drop_path(a: *Ast, id: int64, fc: FoldCtx) -> void {
    if !fc.mark {
        return
    }
    e: ExprNode = vec_get((*a).exprs, id)
    if e.kind == xk_ident() {
        vec_set(fc.seen, id, 1)
        return
    }
    if e.kind == xk_field() {
        fold_drop_path(a, e.a, fc)
    }
}

// The scoped spelling of one export: the bare name, two underscores, and the package
// suffix, exactly the spelling privatize gave the declaration.
func fold_name_with_suffix(name: string, suffix: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, name)
    sb_push(b, "__")
    sb_push(b, suffix)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

// The fault a prefix two different imports gave two different meanings earns, raised at
// the call that spelled it in a file that imported neither.
func two_modules_msg(prefix: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push_char(b, 39)
    sb_push(b, prefix)
    sb_push(b, "' names two modules; import the one this file means")
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

// Folds a qualified module call into a bare call on the merged module's flat namespace,
// and reports a leaf the named module does not export. The rewrite fires only when the
// path's root is a module name that nothing in the function has bound: a parameter, a
// let, a loop binder, an arm binder, a lambda parameter, or a do binder named for a
// module shadows it, and the call stays the method call it reads as. Without that test a
// `func show(json: Doc) { json.parse() }` in a file that imports json.core became a call
// to that module's free `parse`, silently, with a clean check and the wrong value at run
// time.
func fold_call_callee(a: *Ast, e: ExprNode, callee_id: int64, fc: FoldCtx) -> void {
    mut callee: ExprNode = vec_get((*a).exprs, callee_id)
    if callee.kind != xk_field() {
        return
    }
    prefix, ok := flatten_path(a, callee.a)
    if !ok {
        return
    }
    nsmap: *Map<string, int64> = fc.ns
    if !map_has(nsmap, prefix) {
        return
    }
    root, rooted := path_root_name(a, callee.a)
    if rooted && fold_is_bound(fc, root) {
        return
    }
    leaf: string = ast_name(a, callee.b)
    exmap: *Map<string, *Map<string, int64>> = fc.exports
    if map_has(exmap, prefix) {
        empty: *Map<string, int64> = alloc(map_new())
        ex: *Map<string, int64> = unwrap_or(map_get(exmap, prefix), empty)
        if !map_has(ex, leaf) {
            msg: string = private_msg(leaf, prefix)
            vec_push(fc.errors, load_diag_global(fc.files, e.lo, e.hi, msg))
        }
    }
    pick: NsPick = fold_pick_ns(fc, prefix)
    if pick.ambiguous {
        vec_push(fc.errors, load_diag_global(fc.files, e.lo, e.hi, two_modules_msg(prefix)))
        return
    }
    fold_drop_path(a, callee.a, fc)
    callee.kind = xk_ident()
    callee.a = callee.b
    mut scoped: bool = false
    if str_len(pick.suffix) > 0 && map_has(pick.moving, leaf) {
        callee.a = intern_owned((*a).interner, fold_name_with_suffix(leaf, pick.suffix))
        scoped = true
    }
    if !scoped {
        map_put(fc.resolved, leaf, 1)
    }
    if callee_id < vec_len(fc.folded_at) {
        vec_set(fc.folded_at, callee_id, 1)
    }
    vec_set((*a).exprs, callee_id, callee)
}

// Folds each step of a do block with the binders of the steps before it in scope, and no
// others. A binder is in scope only after its own step, the way the desugar's nested
// continuations lay them out, so a `m <- m.load()` folds the qualified call on its right
// and shadows the module for the steps that follow.
func fold_do(a: *Ast, e: ExprNode, fc: FoldCtx) -> void {
    fold_push_scope(fc)
    mut i: int64 = 0
    while i < e.c {
        d: DoBindNode = vec_get((*a).do_binds, vec_get((*a).kids, e.b + i))
        fold_expr(a, d.expr, fc)
        if d.name >= 0 {
            fold_bind(fc, a, d.name)
        }
        i++
    }
    fold_pop_scope(fc)
}

func fold_lambda(a: *Ast, e: ExprNode, fc: FoldCtx) -> void {
    fold_push_scope(fc)
    mut i: int64 = 0
    while i < e.b {
        pn: ParamNode = vec_get((*a).params, vec_get((*a).kids, e.a + i))
        fold_bind(fc, a, pn.name)
        i++
    }
    fold_block(a, e.d, fc)
    fold_pop_scope(fc)
}

func fold_expr(a: *Ast, id: int64, fc: FoldCtx) -> void {
    e: ExprNode = vec_get((*a).exprs, id)
    if e.kind == xk_call() {
        fold_expr(a, e.a, fc)
        fold_expr_slice(a, e.b, e.c, fc)
        fold_call_callee(a, e, e.a, fc)
    } else if e.kind == xk_unary() {
        fold_expr(a, e.b, fc)
    } else if e.kind == xk_binary() {
        fold_expr(a, e.b, fc)
        fold_expr(a, e.c, fc)
    } else if e.kind == xk_field() {
        fold_expr(a, e.a, fc)
    } else if e.kind == xk_index() {
        fold_expr(a, e.a, fc)
        fold_expr(a, e.b, fc)
    } else if e.kind == xk_range() {
        fold_expr(a, e.a, fc)
        fold_expr(a, e.b, fc)
    } else if e.kind == xk_tuple() {
        fold_expr_slice(a, e.a, e.b, fc)
    } else if e.kind == xk_array() {
        fold_expr_slice(a, e.a, e.b, fc)
    } else if e.kind == xk_fstr() {
        fold_expr_slice(a, e.a, e.b, fc)
    } else if e.kind == xk_struct_lit() {
        mut i: int64 = 0
        while i < e.c {
            fold_expr(a, vec_get((*a).kids, e.b + i + 1), fc)
            i += 2
        }
    } else if e.kind == xk_lambda() {
        fold_lambda(a, e, fc)
    } else if e.kind == xk_match() {
        fold_match(a, e.a, e.b, e.c, fc)
    } else if e.kind == xk_incdec() {
        fold_expr(a, e.a, fc)
    } else if e.kind == xk_ifexpr() {
        fold_expr(a, e.a, fc)
        fold_block(a, e.b, fc)
        fold_block(a, e.c, fc)
    } else if e.kind == xk_do() {
        fold_do(a, e, fc)
    } else if e.kind == xk_await() {
        fold_expr(a, e.a, fc)
    } else if e.kind == xk_collect() {
        fold_expr(a, e.b, fc)
    }
}

// Folds one function body with its parameters bound, so a parameter named for a module
// shadows that module inside it. self is bound for a method for the same reason: the
// receiver is a value, whatever a directory beside the file is called.
func fold_func(a: *Ast, id: int64, is_method: bool, fc: FoldCtx) -> void {
    f: FuncNode = vec_get((*a).funcs, id)
    fold_push_scope(fc)
    if is_method {
        fold_bind_text(fc, "self")
    }
    mut i: int64 = 0
    while i < f.params_len {
        pn: ParamNode = vec_get((*a).params, vec_get((*a).kids, f.params_off + i))
        fold_bind(fc, a, pn.name)
        i++
    }
    fold_block(a, f.body, fc)
    fold_pop_scope(fc)
}

/** Folds every qualified module call in one file's item range. own is that file's own
 *  import scope and all is the program wide one, so a call reaches the module the file
 *  itself imported before it reaches whatever else in the program spelled that prefix.
 *  The range is [lo, hi) over the merged module's items, which the loader appends one
 *  file at a time and so are contiguous per file. seen and mark are the rename pass's
 *  coverage record, written here for the path nodes a fold drops, and resolved collects
 *  the leaves this file's folds answered with a bare spelling. */
export func load_fold_range(a: *Ast, ns: *Map<string, int64>, exports: *Map<string, *Map<string, int64>>, own: FoldNs, all: FoldNs, files: *Vector<FileSrc>, errors: *Vector<LoadDiag>, seen: *Vector<int64>, mark: bool, resolved: *Map<string, int64>, folded_at: *Vector<int64>, lo: int64, hi: int64) -> void {
    bound: *Vector<*Map<string, int64>> = alloc(vec_new())
    fc: FoldCtx = FoldCtx { ns: ns, exports: exports, own: own, all: all, files: files, errors: errors, bound: bound, seen: seen, mark: mark, resolved: resolved, folded_at: folded_at }
    items: *Vector<ItemNode> = (*a).items
    mut i: int64 = lo
    while i < hi {
        it: ItemNode = vec_get(items, i)
        if it.kind == ik_func() {
            fold_func(a, it.id, false, fc)
        } else if it.kind == ik_impl() {
            im: ImplNode = vec_get((*a).impls, it.id)
            mut j: int64 = 0
            while j < im.methods_len {
                fold_func(a, vec_get((*a).kids, im.methods_off + j), true, fc)
                j++
            }
        }
        i++
    }
}
