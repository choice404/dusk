// dawn: the package tool for the dusk language, written in dusk. It is a second
// entry point over the same compiler tree the main binary drives, so a package
// build walks the identical pipeline.
//
// A package is a directory holding package.dawn. That file declares the package and
// names what it requires, each dependency bound to a local alias and pinned to a git
// ref; dawn get resolves every ref to a commit, checks the packages out into
// dawn_modules beside the manifest, and records what it took in dawn.lock, so a
// second machine with the same lock builds the same source. The compiler reads the
// manifest and the checkouts and never touches the network; dawn owns the network
// and the lock and nothing else.
//
// Every message that is not a built program's own output is a dawn line: progress
// goes to stdout and every fault to stderr, the split dawnout keeps.

@paradigm procedural

@import std.io
@import std.string
@import version
@import dawnout
@import dawninit
@import dawncmd
@import dawntree
@import dawnbuild

// The version line both the version command and the top of help print. dawn takes
// the toolchain's own version, since the two ship together and a package pinning a
// language version is pinning both.
func version_line() -> string {
    return "dawn " + toolchain_version()
}

// The command list. It answers no command at all on stdout, and an unknown or
// misused command on stderr under the fault naming it.
func help(to_err: bool) -> void {
    v: string = version_line()
    head: string = f"{v} - package tool for the dusk language"
    free(v)
    tail: string = "a package is a directory holding package.dawn; what it requires lands in dawn_modules/"
    if to_err {
        printerr(head)
        printerr("")
    } else {
        println(head)
        println("")
    }
    dawn_usage_lines(to_err)
    if to_err {
        printerr("")
        printerr(tail)
    } else {
        println("")
        println(tail)
    }
    free(head)
}

func print_version() -> int32 {
    v: string = version_line()
    println(v)
    free(v)
    return 0
}

func main(argc: int32, argv: string[]) -> int32 {
    if argv.len < 2 {
        help(false)
        return 0
    }
    cmd: string = argv[1]
    if str_eq(cmd, "init") {
        return dawn_cmd_init(argv)
    }
    if str_eq(cmd, "get") {
        return dawn_cmd_get(argv)
    }
    if str_eq(cmd, "add") {
        return dawn_cmd_add(argv)
    }
    if str_eq(cmd, "update") {
        return dawn_cmd_update(argv)
    }
    if str_eq(cmd, "tree") {
        return dawn_cmd_tree(argv)
    }
    if str_eq(cmd, "build") {
        return dawn_cmd_build(argv, false)
    }
    if str_eq(cmd, "run") {
        return dawn_cmd_build(argv, true)
    }
    if str_eq(cmd, "version") {
        return print_version()
    }
    if str_eq(cmd, "--version") {
        return print_version()
    }
    if str_eq(cmd, "-V") {
        return print_version()
    }
    if str_eq(cmd, "help") {
        help(false)
        return 0
    }
    if str_eq(cmd, "--help") {
        help(false)
        return 0
    }
    if str_eq(cmd, "-h") {
        help(false)
        return 0
    }
    code: int32 = dawn_fail_owned(f"unknown command '{cmd}'")
    help(true)
    return code
}
