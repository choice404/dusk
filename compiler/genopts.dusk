/** genopts: the build options codegen reads. A build may ask for sanitizer
 *  instrumentation and for allocation site tracking; both reach the emitter through
 *  this one record, so the driver, the command line, and codegen name the same
 *  fields. The sanitizer word is a bit set over the three sanitizer constants below,
 *  so a list such as address,undefined is one value. */

@paradigm procedural

@import std.string

/** What a build asked codegen for beyond plain IR.
 *  sanitize is a bit set of san_address, san_undefined, and san_thread, zero for none.
 *  heap_sites asks for every generational allocation to record its call site. */
export struct GenOpts {
    sanitize: int64,
    heap_sites: bool,
}

/** The options of a plain build: no sanitizer and no site tracking.
 *  @return the default options */
export func genopts_none() -> GenOpts {
    return GenOpts { sanitize: 0, heap_sites: false }
}

/** The AddressSanitizer bit of GenOpts.sanitize.
 *  @return 1 */
export func san_address() -> int64 {
    return 1
}

/** The UndefinedBehaviorSanitizer bit of GenOpts.sanitize.
 *  @return 2 */
export func san_undefined() -> int64 {
    return 2
}

/** The ThreadSanitizer bit of GenOpts.sanitize.
 *  @return 4 */
export func san_thread() -> int64 {
    return 4
}
