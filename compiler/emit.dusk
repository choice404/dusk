// emit: textual LLVM IR module builder for dusk code generation.
//
// The builder is intentionally small: it owns ordered text sections, interns C
// strings as globals, and renders the same module frame as the stage0 compiler.
// Later lowering passes add semantics; this file only assembles bytes.

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
@import genopts

struct EncodedCString {
    text: string,
    len: int64,
}

export struct EmitModule {
    name: string,
    triple: string,
    types: *Vector<string>,
    externs: *Vector<string>,
    globals: *Vector<string>,
    funcs: *Vector<string>,
    str_count: int64,
    strings: *Map<string, string>,
    lambda_count: int64,
    funcval_thunks: *Map<string, int64>,
    faults: *Vector<string>,
    opts: GenOpts,
    defined: *Map<string, int64>,
    cnames: *Map<string, int64>,
    declared: *Map<string, string>,
    locs: *Map<string, string>,
    loc_lines: *Vector<string>,
}

func copy_string(s: string) -> string {
    return substring(s, 0, str_len(s))
}

func built_string(b: *StringBuilder) -> string {
    return substring(sb_cstr(b), 0, sb_size(b))
}

export func emit_module_new(name: string, triple: string) -> *EmitModule {
    types: *Vector<string> = alloc(vec_new())
    externs: *Vector<string> = alloc(vec_new())
    globals: *Vector<string> = alloc(vec_new())
    funcs: *Vector<string> = alloc(vec_new())
    strings: *Map<string, string> = alloc(map_new())
    thunks: *Map<string, int64> = alloc(map_new())
    faults: *Vector<string> = alloc(vec_new())
    defined: *Map<string, int64> = alloc(map_new())
    cnames: *Map<string, int64> = alloc(map_new())
    declared: *Map<string, string> = alloc(map_new())
    locs: *Map<string, string> = alloc(map_new())
    loc_lines: *Vector<string> = alloc(vec_new())
    return alloc(EmitModule {
        name: copy_string(name),
        triple: copy_string(triple),
        types: types,
        externs: externs,
        globals: globals,
        funcs: funcs,
        str_count: 0,
        strings: strings,
        lambda_count: 0,
        funcval_thunks: thunks,
        faults: faults,
        opts: genopts_none(),
        defined: defined,
        cnames: cnames,
        declared: declared,
        locs: locs,
        loc_lines: loc_lines,
    })
}

/** Sets the build options the module's function heads read.
 *  @param m the module under construction
 *  @param opts the options the build asked for */
export func emit_set_opts(m: *EmitModule, opts: GenOpts) -> void {
    (*m).opts = opts
}

// The symbol of a function with internal linkage: its dusk name and the suffix
// .d. A C identifier cannot spell a dot, so no C library function, no runtime
// function, and no function a backend lowering calls by name, the memcpy an
// aggregate copy becomes or the fmod a float remainder becomes, can ever meet a
// dusk function's symbol, whatever the function is called. This is the one place
// the suffix is written.
func internal_sym(name: string) -> string {
    return name + ".d"
}

/** Records a name dusk code calls under its own C spelling: a foreign function, an
 *  `export "C"` function, or main when main is the C entry itself. A reference to any
 *  other function carries the internal suffix. Codegen registers every such name
 *  before it lowers a body, so a call lowered ahead of the callee's own define
 *  reads the same symbol the define writes.
 *  @param m the module under construction
 *  @param name the C name */
export func emit_c_name(m: *EmitModule, name: string) -> void {
    map_put((*m).cnames, copy_string(name), 1)
}

/** The symbol a call or an address of the named function writes after its @: the
 *  name itself for a C name, see emit_c_name, and the internal symbol for every
 *  other function, a top level one, a method, a lambda, a thunk, or a poll function.
 *  @param m the module under construction
 *  @param name the function's dusk name, a method as Type.name
 *  @return the symbol as a fresh string the caller frees */
export func emit_fn_ref(m: *EmitModule, name: string) -> string {
    if map_has((*m).cnames, name) {
        return copy_string(name)
    }
    return internal_sym(name)
}

/** Pushes the symbol of a function reference onto a line under construction, the
 *  text that follows its @, see emit_fn_ref.
 *  @param b the line under construction
 *  @param m the module under construction
 *  @param name the function's dusk name */
export func emit_push_fn_ref(b: *StringBuilder, m: *EmitModule, name: string) -> void {
    sym: string = emit_fn_ref(m, name)
    sb_push(b, sym)
    free(sym)
}

// Records the symbol of a define or a global, and reports a symbol defined twice,
// which clang would refuse as a redefinition against the IR. Functions and globals
// share one table, since an interface table, @vtable.I.T, and a method of a struct
// named vtable can spell one symbol. It turns what the checker leaves into a named
// build error.
func record_define(m: *EmitModule, sym: string) -> void {
    if map_has((*m).defined, sym) {
        msg: string = "symbol '" + sym + "' is defined twice in the emitted module; rename one of the two names that make it"
        emit_error(m, msg)
        free(msg)
        return
    }
    map_put((*m).defined, copy_string(sym), 1)
}

// The symbol a global line defines: the text between its @ and the " = " after it
func global_symbol(g: string) -> string {
    eq: int64 = str_find(g, " = ")
    if !starts_with(g, "@") || eq < 1 {
        return substring(g, 0, 0)
    }
    return substring(g, 1, eq)
}

/** The head line of one function definition, the only place a define is spelled.
 *  Every function is internal unless it is a C entry point: main, the wasm entry,
 *  an `export "C"` function, or the demo's main. An internal function's symbol
 *  carries the suffix of internal_sym, so a dusk name never meets a C symbol, at
 *  link time or inside the module, and nobuiltin tells the optimizer that a call to
 *  the function is a call to this body, never a library function it may fold. A C
 *  entry point keeps its name exactly.
 *  @param m the module the function belongs to
 *  @param external true for a C entry point, false for every other function
 *  @param ret the LLVM return type
 *  @param sym the function's dusk name, without the leading @
 *  @param params the LLVM parameter list, without the parentheses
 *  @return the head line, ending in the opening brace */
export func emit_fn_head(m: *EmitModule, external: bool, ret: string, sym: string, params: string) -> string {
    mut full: string = ""
    if external {
        full = copy_string(sym)
    } else {
        if map_has((*m).cnames, sym) {
            msg: string = "function '" + sym + "' shares its name with a C function the module calls by that name; rename the function"
            emit_error(m, msg)
            free(msg)
        }
        full = internal_sym(sym)
    }
    record_define(m, full)
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "define ")
    if !external {
        sb_push(b, "internal ")
    }
    sb_push(b, ret)
    sb_push(b, " @")
    sb_push(b, full)
    sb_push_char(b, 40)
    sb_push(b, params)
    sb_push(b, ") nobuiltin")
    push_fn_attrs(b, (*m).opts)
    sb_push(b, " {")
    head: string = built_string(b)
    sb_free(b)
    free(b)
    free(full)
    return head
}

// The attributes a sanitized build puts on every define after nobuiltin: the
// sanitizer's own attribute, so every load and store of a dusk function is checked
// under AddressSanitizer or reported under ThreadSanitizer, and with either a frame
// pointer and an unwind table, which is what lets a report's stacks walk through
// dusk frames. UndefinedBehaviorSanitizer is inserted by clang's C front end and a
// .ll has none, so its bit adds nothing here.
func push_fn_attrs(b: *StringBuilder, opts: GenOpts) -> void {
    mut any: bool = false
    if (opts.sanitize & san_address()) != 0 {
        sb_push(b, " sanitize_address")
        any = true
    }
    if (opts.sanitize & san_thread()) != 0 {
        sb_push(b, " sanitize_thread")
        any = true
    }
    if any {
        sb_push(b, " \"frame-pointer\"=\"all\" uwtable")
    }
}

// The symbol a declare line names: the text between its @ and the opening
// parenthesis of the parameter list, or an empty string for a line with no @.
// Always a fresh heap string, so the caller frees it either way.
func declared_symbol(line: string) -> string {
    n: int64 = str_len(line)
    mut at: int64 = 0
    while at < n && line[at] != 64 {
        at++
    }
    if at >= n {
        return substring(line, 0, 0)
    }
    mut end: int64 = at + 1
    while end < n && line[end] != 40 {
        end++
    }
    return substring(line, at + 1, end)
}

/** Reports every symbol the module both defines and declares, in declaration order.
 *  The checker refuses a function named for a runtime or foreign symbol, so this is
 *  the backstop that turns a name the rule missed into a named build error rather
 *  than a redefinition clang reports against the IR.
 *  @param m the finished module */
export func emit_check_names(m: *EmitModule) -> void {
    defined: *Map<string, int64> = (*m).defined
    externs: *Vector<string> = (*m).externs
    for ext in externs {
        sym: string = declared_symbol(ext)
        if str_len(sym) > 0 && map_has(defined, sym) {
            b: *StringBuilder = alloc(sb_new())
            sb_push(b, "function '")
            sb_push(b, sym)
            sb_push(b, "' takes a name the emitted module also declares; rename the function")
            msg: string = built_string(b)
            sb_free(b)
            free(b)
            emit_error(m, msg)
            free(msg)
        }
        free(sym)
    }
}

export func emit_error(m: *EmitModule, msg: string) -> void {
    vec_push((*m).faults, copy_string(msg))
}

export func emit_errors(m: *EmitModule) -> *Vector<string> {
    return (*m).faults
}

export func emit_fresh_lambda(m: *EmitModule) -> int64 {
    n: int64 = (*m).lambda_count
    (*m).lambda_count++
    return n
}

export func emit_need_funcval_thunk(m: *EmitModule, name: string) -> bool {
    thunks: *Map<string, int64> = (*m).funcval_thunks
    if map_has(thunks, name) {
        return false
    }
    map_put(thunks, copy_string(name), 1)
    return true
}

export func emit_define_type(m: *EmitModule, name: string, body: string) -> void {
    b: *StringBuilder = alloc(sb_new())
    sb_push_char(b, 37)
    sb_push(b, name)
    sb_push(b, " = type ")
    sb_push(b, body)
    line: string = built_string(b)
    sb_free(b)
    free(b)
    vec_push((*m).types, line)
}

/** Declares one external function by its full signature line, `ret @name(params)`.
 *  A line already declared is kept once. A second line naming the same symbol with
 *  another signature, a foreign declaration restating a runtime function the
 *  compiler declares itself with other types, would reach clang as a redefinition,
 *  so it is reported as a named build error instead; the checker refuses every such
 *  foreign declaration first.
 *  @param m the module under construction
 *  @param sig the signature, without the leading declare */
export func emit_declare(m: *EmitModule, sig: string) -> void {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "declare ")
    sb_push(b, sig)
    line: string = built_string(b)
    sb_free(b)
    free(b)

    sym: string = declared_symbol(line)
    declared: *Map<string, string> = (*m).declared
    if map_has(declared, sym) {
        prior: string = unwrap_or(map_get(declared, sym), "")
        if !str_eq(prior, line) {
            msg: string = "function '" + sym + "' is declared twice with different signatures; a foreign declaration must match the one the compiler makes"
            emit_error(m, msg)
            free(msg)
        }
        free(sym)
        free(line)
        return
    }
    map_put(declared, sym, copy_string(line))
    vec_push((*m).externs, line)
}

func hex_digit(nib: int64) -> int64 {
    if nib >= 10 {
        return 55 + nib
    }
    return 48 + nib
}

func push_hex_byte(b: *StringBuilder, byte: int64) -> void {
    sb_push_char(b, 92)
    sb_push_char(b, hex_digit((byte >> 4) & 15))
    sb_push_char(b, hex_digit(byte & 15))
}

// Encodes n raw bytes from text as an LLVM c"..." body and appends the string's
// own NUL terminator. This form is useful for tests that construct embedded NULs.
func encode_cstring_n(text: string, n: int64) -> EncodedCString {
    b: *StringBuilder = alloc(sb_new())
    for i in 0..n {
        mut byte: int64 = text[i]
        if byte < 0 {
            byte += 256
        }
        if byte == 92 {
            sb_push(b, "\\5C")
        } else if byte == 34 {
            sb_push(b, "\\22")
        } else if byte >= 32 {
            if byte <= 126 {
                sb_push_char(b, byte)
            } else {
                push_hex_byte(b, byte)
            }
        } else {
            push_hex_byte(b, byte)
        }
    }
    sb_push(b, "\\00")
    out: string = built_string(b)
    sb_free(b)
    free(b)
    return EncodedCString { text: out, len: n + 1 }
}

func encode_cstring(text: string) -> EncodedCString {
    return encode_cstring_n(text, str_len(text))
}

// Interns an already encoded constant body under its encoded text. Every
// cstring path lands here, so a literal and an equal runtime built text share
// one global; the encoded form is a bijection of the constant's bytes, so an
// embedded NUL cannot truncate the key the way a decoded dusk string would.
func emit_intern_cstr(m: *EmitModule, enc_text: string, enc_len: int64) -> string {
    strings: *Map<string, string> = (*m).strings
    if map_has(strings, enc_text) {
        return unwrap_or(map_get(strings, enc_text), "")
    }

    lb: *StringBuilder = alloc(sb_new())
    sb_push(lb, "@.str.")
    sb_push_int(lb, (*m).str_count)
    label: string = built_string(lb)
    sb_free(lb)
    free(lb)
    (*m).str_count++

    gb: *StringBuilder = alloc(sb_new())
    sb_push(gb, label)
    sb_push(gb, " = private unnamed_addr constant [")
    sb_push_int(gb, enc_len)
    sb_push(gb, " x i8] c\"")
    sb_push(gb, enc_text)
    sb_push_char(gb, 34)
    global_line: string = built_string(gb)
    sb_free(gb)
    free(gb)

    vec_push((*m).globals, global_line)
    map_put(strings, copy_string(enc_text), label)
    return label
}

export func emit_cstring(m: *EmitModule, text: string) -> string {
    enc: EncodedCString = encode_cstring(text)
    label: string = emit_intern_cstr(m, enc.text, enc.len)
    free(enc.text)
    return label
}

/** Interns a source location constant, the "path:line" a free passes the runtime,
 *  under its own label family, @.loc.N, rendered after every other global. The
 *  family is apart from @.str.N so a location never renumbers a string constant,
 *  which keeps the IR of everything else in a module where it was.
 *  @param m the module under construction
 *  @param text the location text
 *  @return the label, owned by the module, which the caller must not free */
export func emit_loc(m: *EmitModule, text: string) -> string {
    locs: *Map<string, string> = (*m).locs
    if map_has(locs, text) {
        return unwrap_or(map_get(locs, text), "")
    }
    lines: *Vector<string> = (*m).loc_lines
    lb: *StringBuilder = alloc(sb_new())
    sb_push(lb, "@.loc.")
    sb_push_int(lb, vec_len(lines))
    label: string = built_string(lb)
    sb_free(lb)
    free(lb)
    enc: EncodedCString = encode_cstring(text)
    gb: *StringBuilder = alloc(sb_new())
    sb_push(gb, label)
    sb_push(gb, " = private unnamed_addr constant [")
    sb_push_int(gb, enc.len)
    sb_push(gb, " x i8] c\"")
    sb_push(gb, enc.text)
    sb_push_char(gb, 34)
    vec_push(lines, built_string(gb))
    sb_free(gb)
    free(gb)
    free(enc.text)
    map_put(locs, copy_string(text), label)
    return label
}

// The UTF-8 bytes of one scalar pushed straight into the encoded constant
// form, so a NUL or any other byte survives without a dusk string carrying it.
func emit_encode_scalar(b: *StringBuilder, cp: int64) -> int64 {
    if cp < 128 {
        emit_encode_byte(b, cp)
        return 1
    }
    if cp < 2048 {
        emit_encode_byte(b, 192 + (cp >> 6))
        emit_encode_byte(b, 128 + (cp & 63))
        return 2
    }
    if cp < 65536 {
        emit_encode_byte(b, 224 + (cp >> 12))
        emit_encode_byte(b, 128 + ((cp >> 6) & 63))
        emit_encode_byte(b, 128 + (cp & 63))
        return 3
    }
    emit_encode_byte(b, 240 + (cp >> 18))
    emit_encode_byte(b, 128 + ((cp >> 12) & 63))
    emit_encode_byte(b, 128 + ((cp >> 6) & 63))
    emit_encode_byte(b, 128 + (cp & 63))
    return 4
}

func emit_encode_byte(b: *StringBuilder, byte: int64) -> void {
    if byte == 92 {
        sb_push(b, "\\5C")
    } else if byte == 34 {
        sb_push(b, "\\22")
    } else if byte >= 32 && byte <= 126 {
        sb_push_char(b, byte)
    } else {
        push_hex_byte(b, byte)
    }
}

func emit_hex_val(c: int64) -> int64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return 0
}

// Interns a C string constant from a string literal body in its internal
// escaped form: a backslash stored as \u{5c}, every other non printable
// scalar as \u{hex}, printable bytes raw. Each escape decodes to UTF-8 bytes
// straight into the encoded constant, so an embedded NUL neither truncates
// the constant nor its length.
export func emit_cstring_body(m: *EmitModule, body: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    mut count: int64 = 0
    mut i: int64 = 0
    while i < str_len(body) {
        mut consumed: bool = false
        if body[i] == 92 && i + 3 < str_len(body) && body[i + 1] == 117 && body[i + 2] == 123 {
            mut p: int64 = i + 3
            mut cp: int64 = 0
            mut scanning: bool = true
            while scanning {
                if p >= str_len(body) { scanning = false }
                else if body[p] == 125 { scanning = false }
                else {
                    cp = cp * 16 + emit_hex_val(body[p])
                    p++
                }
            }
            if p < str_len(body) {
                count += emit_encode_scalar(b, cp)
                i = p + 1
                consumed = true
            }
        }
        if !consumed {
            emit_encode_byte(b, body[i])
            count++
            i++
        }
    }
    sb_push(b, "\\00")
    enc_text: string = built_string(b)
    sb_free(b)
    free(b)
    label: string = emit_intern_cstr(m, enc_text, count + 1)
    free(enc_text)
    return label
}

export func emit_push_function(m: *EmitModule, f: string) -> void {
    vec_push((*m).funcs, copy_string(f))
}

/** Adds one global definition line, `@name = ...`, recording its symbol beside the
 *  function symbols so a clash between the two is a named build error.
 *  @param m the module under construction
 *  @param g the whole global line */
export func emit_global(m: *EmitModule, g: string) -> void {
    sym: string = global_symbol(g)
    if str_len(sym) > 0 {
        record_define(m, sym)
    }
    free(sym)
    vec_push((*m).globals, copy_string(g))
}

func emit_section(out: *StringBuilder, lines: *Vector<string>) -> void {
    if vec_len(lines) == 0 {
        return
    }
    for section_line in lines {
        sb_push(out, section_line)
        sb_push_char(out, 10)
    }
    sb_push_char(out, 10)
}

// The globals section, with the location constants at its end. A module with no
// location renders exactly as it did before locations had a family of their own.
func emit_globals(out: *StringBuilder, globals: *Vector<string>, locs: *Vector<string>) -> void {
    if vec_len(locs) == 0 {
        emit_section(out, globals)
        return
    }
    for g in globals {
        sb_push(out, g)
        sb_push_char(out, 10)
    }
    for l in locs {
        sb_push(out, l)
        sb_push_char(out, 10)
    }
    sb_push_char(out, 10)
}

export func emit_render(m: *EmitModule) -> string {
    out: *StringBuilder = alloc(sb_new())
    sb_push(out, "; ModuleID = '")
    sb_push(out, (*m).name)
    sb_push(out, "'\n")
    sb_push(out, "target triple = \"")
    sb_push(out, (*m).triple)
    sb_push(out, "\"\n")
    sb_push_char(out, 10)

    emit_section(out, (*m).types)
    emit_globals(out, (*m).globals, (*m).loc_lines)
    emit_section(out, (*m).externs)

    funcs: *Vector<string> = (*m).funcs
    for func_text in funcs {
        sb_push(out, func_text)
        sb_push(out, "\n\n")
    }

    rendered: string = built_string(out)
    sb_free(out)
    free(out)
    return rendered
}
