@import tcbin
@import tciface
@import tcown
@import tcesc
@import tcesc2

export func call_msg_count(want: int64, got: int64) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "expected ")
    sb_push_int(b, want)
    sb_push(b, " argument(s), found ")
    sb_push_int(b, got)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

export func arg_wrong_msg(i: int64) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "argument ")
    sb_push_int(b, i + 1)
    sb_push(b, " has the wrong type")
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

export func free_ground_msg(rendered: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "free takes a heap pointer, not ")
    sb_push(b, rendered)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

// The argument type an argument check should compare, correcting the one shape that
// reaches the check untyped: a field access. infer_expr leaves a struct field's type
// unknown, and compat wildcards unknown against every parameter, so a field of the
// wrong type slipped past the check and died in clang (str_eq(n.name, "x") with an
// int64 field). When the base is a concrete struct the field type is known; resolve it
// through the ownership chain resolver and check against it, exactly as a named local
// is checked. A generic or otherwise unresolved field stays unknown and permissive.
export func field_arg_ty(tc: *TypeChecker, arg_id: int64, av: int64) -> int64 {
    an: TyNode = ty_get((*tc).ty, av)
    if an.kind != tyk_unknown() { return av }
    a: *Ast = (*tc).ast
    arg: ExprNode = vec_get((*a).exprs, arg_id)
    if arg.kind != xk_field() { return av }
    ft: int64 = own_chain_ty(tc, arg_id)
    fn: TyNode = ty_get((*tc).ty, ft)
    if fn.kind == tyk_unknown() { return av }
    return ft
}

export func func_builtin_ret(tc: *TypeChecker, name: string) -> int64 {
    t: *TyArena = (*tc).ty
    if str_eq(name, "read_file") || str_eq(name, "read_line") || str_eq(name, "read_all") {
        xs: *Vector<int64> = alloc(vec_new())
        vec_push(xs, ty_str(t))
        vec_push(xs, ty_error(t))
        return ty_tuple(t, xs)
    }
    if str_eq(name, "parse_float") {
        ys: *Vector<int64> = alloc(vec_new())
        vec_push(ys, ty_float(t, 64))
        vec_push(ys, ty_error(t))
        return ty_tuple(t, ys)
    }
    if str_eq(name, "write_file") { return ty_error(t) }
    if str_eq(name, "cstr") { return ty_str(t) }
    if str_eq(name, "sizeof") { return ty_int(t, 64) }
    return -1
}

// The target type of a width cast builtin, or -1 for any other name.
export func cast_target_ty(tc: *TypeChecker, name: string) -> int64 {
    t: *TyArena = (*tc).ty
    if str_eq(name, "int8") { return ty_int(t, 8) }
    if str_eq(name, "int16") { return ty_int(t, 16) }
    if str_eq(name, "int32") { return ty_int(t, 32) }
    if str_eq(name, "int64") { return ty_int(t, 64) }
    if str_eq(name, "uint8") { return ty_uint(t, 8) }
    if str_eq(name, "uint16") { return ty_uint(t, 16) }
    if str_eq(name, "uint32") { return ty_uint(t, 32) }
    if str_eq(name, "uint64") { return ty_uint(t, 64) }
    if str_eq(name, "char") { return ty_char(t) }
    if str_eq(name, "rune") { return ty_rune(t) }
    if str_eq(name, "float32") { return ty_float(t, 32) }
    if str_eq(name, "float64") { return ty_float(t, 64) }
    return -1
}

// Whether a type may be a hash key: an integer of any width, a char, a rune, or a
// string, the same set map keys are drawn from. This mirrors comparable() minus
// float and bool: a float breaks hash and equality coherence, since NaN is never
// equal to itself, and bool is left out of the key set for now. The named-type arm
// is permissive the way comparable() is, so a generic parameter passes the surface
// pass and the ground pass rejects a concrete non-hashable instantiation.
export func hashable(tc: *TypeChecker, tyid: int64) -> bool {
    n: TyNode = ty_get((*tc).ty, tyid)
    if n.kind == tyk_int() || n.kind == tyk_char() || n.kind == tyk_rune() || n.kind == tyk_str() || n.kind == tyk_unknown() {
        return true
    }
    if n.kind == tyk_named() {
        name: string = ty_name((*tc).ty, tyid)
        structs: *Map<string, StructSig> = (*tc).structs
        if map_has(structs, name) { return false }
        enums: *Map<string, EnumSig> = (*tc).enums
        if map_has(enums, name) { return false }
        ifaces: *Map<string, int64> = (*tc).ifaces
        if map_has(ifaces, name) { return false }
        return true
    }
    return false
}

export func hash_operand_msg(rendered: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "cannot hash ")
    sb_push(b, rendered)
