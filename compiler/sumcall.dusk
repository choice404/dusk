// Call summaries and constructor payloads for the abstract walk

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
@import ast
@import tcstate
@import summary
@import sumwalk
@import sumplace
@import sumhof
@import summethod
@import sumtype
@import sumscope
@import sumquiet

func kid(a: *Ast, off: int64, i: int64) -> int64 { return vec_get((*a).kids, off + i) }

// The call dispatch: a channel send records its sink by name first, then the
// callee resolves to a known module summary, a constructor, a builtin (with the
// higher-order element models), a resolvable local bind, or the conservative TOP.
export func sum_eval_call(c: *SumCtx, callee_id: int64, arg_off: int64, arg_len: int64) -> SumVal {
    t: *SumTables = (*c).t
    a: *Ast = (*t).ast
    vidx: *Map<string, int64> = (*t).variant_idx
    eidx: *Map<string, int64> = (*t).enum_idx
    argvals: *Vector<SumVal> = alloc(vec_new())
    for i in 0..arg_len {
        vec_push(argvals, sum_eval(c, kid(a, arg_off, i)))
    }
    callee: ExprNode = vec_get((*a).exprs, callee_id)
    if callee.kind == xk_ident() {
        name: string = ast_name(a, callee.a)
        if (str_eq(name, "chan_send") || str_eq(name, "chan_try_send")) && arg_len == 2 {
            record_chan_sink(c, vec_get(argvals, 1))
        }
        sums: *Map<string, SummaryHandle> = (*c).summaries
        // A local, a parameter, or a capture of the name is the callee, never the module
        // function or builtin it shadows; it resolves only through a straight bind
        if sum_name_bound(c, name) {
            g: string = sum_bound_target(c, name)
            if !map_has(sums, g) { return function_value_call(c, name, callee_id, arg_off, arg_len, argvals) }
            return apply_summary(c, call_summary(c, g, arg_off, arg_len, argvals), arg_off, arg_len, argvals, -1)
        }
        if map_has(sums, name) {
            return apply_summary(c, call_summary(c, name, arg_off, arg_len, argvals), arg_off, arg_len, argvals, -1)
        }
        // A bare constructor call is refused by the call check, which says to write it
        // as 'A.Some', so the bare name is only ever seen on a program that is rejected
        // either way; it keeps the name keyed slot. A bound name never reaches here, since
        // answering it with a variant's payload model dropped the view an argument carries.
        if map_has(vidx, name) {
            return ctor_val(c, unwrap_or(map_get(vidx, name), -1), argvals)
        }
        bs: SummaryHandle = builtin_summary(name)
        if !bs.empty {
            if is_higher_order(name, arg_len) {
                return higher_order_val(c, name, arg_off, arg_len, argvals)
            }
            return apply_summary(c, bs, arg_off, arg_len, argvals, -1)
        }
        return apply_top(c, arg_off, arg_len, argvals, -1)
    }
    if callee.kind == xk_field() {
        base: ExprNode = vec_get((*a).exprs, callee.a)
        mut is_enum_ctor: bool = false
        if base.kind == xk_ident() {
            if map_has(eidx, ast_name(a, base.a)) { is_enum_ctor = true }
        }
        if is_enum_ctor {
            // Asked with the enum, not the bare variant name: two enums may declare
            // the same variant, the name keyed slot answers with whichever was
            // declared last, and reading one enum's scalar payload for another's
            // slice drops the view this constructor really carries.
            vkey: string = sum_variant_key(ast_name(a, base.a), ast_name(a, callee.b))
            vbe: *Map<string, int64> = (*t).variant_by_enum
            if map_has(vbe, vkey) { return ctor_val(c, unwrap_or(map_get(vbe, vkey), -1), argvals) }
            return join_all(argvals)
        }
        return sum_method_call(c, callee, arg_off, arg_len, argvals)
    }
    callee_value: SumVal = sum_eval(c, callee_id)
    passed: SumVal = apply_top(c, arg_off, arg_len, argvals, -1)
    if callee_result_carries_nothing(c, callee_id) { return val_none() }
    return val_join(passed, callee_value)
}

// A call through a bound function value: it may return whatever its arguments and
// its captures reach, unless its declared result holds no reference, or the walk is
// the quiet one and the value is a parameter whose results the summary takes to
// carry nothing but its arguments
func function_value_call(c: *SumCtx, name: string, callee_id: int64, arg_off: int64, arg_len: int64, argvals: *Vector<SumVal>) -> SumVal {
    passed: SumVal = apply_top(c, arg_off, arg_len, argvals, -1)
    if callee_result_carries_nothing(c, callee_id) { return val_none() }
    if is_quiet_callback(c, name) { return passed }
    return val_join(passed, sum_eval(c, callee_id))
}

// Applies a known callee summary: route each store edge from arg i into arg j's
// place, join every returned or read-back argument into the result, and thread
// each sunk argument's provenance into this function's sink set.
func apply_summary(c: *SumCtx, sum: SummaryHandle, arg_off: int64, arg_len: int64, argvals: *Vector<SumVal>, receiver_id: int64) -> SumVal {
    a: *Ast = (*(*c).t).ast
    mut i: int64 = 0
    while i < arg_len && i < 64 {
        row: int64 = flow_row(sum.flows, i)
        if row != 0 {
            vi: SumVal = vec_get(argvals, i)
            mut j: int64 = 0
            while j < arg_len && j < 64 {
                place_id: int64 = summary_arg_id(a, arg_off, j, receiver_id)
                if (row & (1 << j)) != 0 && !operand_holds_no_place(a, place_id) {
                    flow_into_value(c, place_id, vi, vec_get(argvals, j))
                }
                j++
            }
        }
        i++
    }
    mut r: SumVal = val_none()
    mut k: int64 = 0
    while k < arg_len && k < 64 {
        if ps_has(sum.returns_alias, k) { r = val_join(r, vec_get(argvals, k)) }
        if ps_has(sum.reads_through, k) { r = val_join(r, vec_get(argvals, k)) }
        if ps_has(sum.sinks, k) {
            av: SumVal = vec_get(argvals, k)
            ps: int64 = av.origins | av.reads
            (*c).sinks = (*c).sinks | ps
            if ps_has(sum.collect_sinks, k) { (*c).collect_sinks = (*c).collect_sinks | ps }
        }
        k++
    }
    return r
}

// The TOP summary of an unknown callee: it may return any argument, store any
// argument's view into any other, write through any argument, and hand any argument
// to a channel.
func apply_top(c: *SumCtx, arg_off: int64, arg_len: int64, argvals: *Vector<SumVal>, receiver_id: int64) -> SumVal {
    a: *Ast = (*(*c).t).ast
    for i in 0..arg_len {
        vi: SumVal = vec_get(argvals, i)
        for j in 0..arg_len {
            if i != j { flow_into_place(c, summary_arg_id(a, arg_off, j, receiver_id), vi) }
        }
    }
    for k in 0..arg_len {
        av: SumVal = vec_get(argvals, k)
        (*c).sinks = (*c).sinks | av.origins | av.reads
    }
    return join_all(argvals)
}

// The abstract value of a constructor call, taken as the join of each payload
// argument's contribution under that payload's declared field type. The variant is
// named by node index rather than by name, so the caller decides which enum's slot
// is read; an index outside the arena joins every argument, the conservative answer
// an unresolvable callee already gets.
func ctor_val(c: *SumCtx, vid: int64, argvals: *Vector<SumVal>) -> SumVal {
    t: *SumTables = (*c).t
    a: *Ast = (*t).ast
    variants: *Vector<VariantNode> = (*a).variants
    if vid < 0 || vid >= vec_len(variants) { return join_all(argvals) }
    vr: VariantNode = vec_get(variants, vid)
    gens: *Map<string, int64> = sum_variant_gens(c, vid)
    mut v: SumVal = val_none()
    for i in 0..vec_len(argvals) {
        mut ft: int64 = -1
        if i < vr.fields_len {
            fld: FieldNode = vec_get((*a).fields, kid(a, vr.fields_off, i))
            ft = fld.ty
        }
        v = val_join(v, member_contrib(t, vec_get(argvals, i), ft, gens))
    }
    return v
}

func join_all(argvals: *Vector<SumVal>) -> SumVal {
    mut r: SumVal = val_none()
    for i in 0..vec_len(argvals) {
        r = val_join(r, vec_get(argvals, i))
    }
    return r
}


func summary_arg_id(a: *Ast, off: int64, index: int64, receiver_id: int64) -> int64 {
    if receiver_id < 0 { return kid(a, off, index) }
    if index == 0 { return receiver_id }
    return kid(a, off, index - 1)
}

func sum_method_call(c: *SumCtx, callee: ExprNode, arg_off: int64, arg_len: int64, argvals: *Vector<SumVal>) -> SumVal {
    key: string = sum_method_key(c, callee)
    mut receiver: SumVal = sum_eval(c, callee.a)
    a: *Ast = (*(*c).t).ast
    base: ExprNode = vec_get((*a).exprs, callee.a)
    if base.kind == xk_unary() && base.a == uop_deref() { receiver = sum_eval(c, base.b) }
    if is_error_method(c, callee) { return error_method_val(c, callee, arg_off, arg_len, argvals) }
    // A scalar tuple member cannot carry the joined aliases of its siblings; a type
    // parameter spelled like a scalar may stand for any type
    receiver_ty: int64 = sum_chain_ty(c, callee.a)
    if sum_scalar_type((*c).t, receiver_ty) && !sum_is_type_parameter(c, receiver_ty) { receiver = val_none() }
    values: *Vector<SumVal> = alloc(vec_new())
    vec_push(values, receiver)
    for value in argvals { vec_push(values, value) }
    sum: SummaryHandle = method_summary(c, key, callee)
    // An unresolved method may return, store, or send its receiver like any argument
    if sum.empty { return apply_top(c, arg_off, arg_len + 1, values, callee.a) }
    return apply_summary(c, sum, arg_off, arg_len + 1, values, callee.a)
}

// Whether a method call is one of the error value's own four: the receiver is typed by
// the builtin error and no impl gives error a method of the name, or no impl declares a
// method of the name anywhere and no struct a field of it, so only an error answers it
func is_error_method(c: *SumCtx, callee: ExprNode) -> bool {
    t: *SumTables = (*c).t
    a: *Ast = (*t).ast
    name: string = ast_name(a, callee.b)
    if !str_eq(name, "exists") && !str_eq(name, "toString") && !str_eq(name, "ignore") && !str_eq(name, "check") { return false }
    if is_builtin_error_type(c, sum_chain_ty(c, callee.a)) { return !map_has((*t).method_funcs, sum_variant_key("error", name)) }
    if map_has((*t).method_names, name) { return false }
    return !map_has((*t).field_names, name)
}

// Whether a receiver's type is the builtin error rather than a type parameter or a
// declared type spelled the same
func is_builtin_error_type(c: *SumCtx, type_id: int64) -> bool {
    t: *SumTables = (*c).t
    a: *Ast = (*t).ast
    node: TypeNode = vec_get((*a).types, type_id)
    if node.kind != tk_named() || node.c != 0 || !str_eq(ast_name(a, node.a), "error") { return false }
    if map_has((*c).gens, "error") || map_has((*t).struct_idx, "error") { return false }
    return !map_has((*t).enum_idx, "error") && !map_has((*t).ifaces, "error")
}

// The error's exists, toString, and ignore read it and nothing else, and an error
// carries no view of a frame, so they tie and return nothing. check calls its handler
// with the error, so the handler is taken as an argument of a call the walk cannot see
// into, and the receiver, which may hold a tuple sibling's aliases, is left out
func error_method_val(c: *SumCtx, callee: ExprNode, arg_off: int64, arg_len: int64, argvals: *Vector<SumVal>) -> SumVal {
    a: *Ast = (*(*c).t).ast
    if str_eq(ast_name(a, callee.b), "check") { apply_top(c, arg_off, arg_len, argvals, -1) }
    return val_none()
}

// The method the receiver's type names, else the join of every implementation behind
// an interface receiver, else the empty sentinel for an opaque callee
func method_summary(c: *SumCtx, key: string, callee: ExprNode) -> SummaryHandle {
    if map_has((*c).summaries, key) { return unwrap_or(map_get((*c).summaries, key), empty_summary()) }
    return sum_interface_method(c, callee)
}

func sum_variant_gens(c: *SumCtx, variant: int64) -> *Map<string, int64> {
    return unwrap_or(map_get((*(*c).t).variant_gens, variant), (*c).gens)
}
