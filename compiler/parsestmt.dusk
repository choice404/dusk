// parsestmt: statement, block, control-flow, and do grammar.

@paradigm procedural
@import std.string
@import std.vector
@import bytes
@import token
@import intern
@import ast
@import parse
@import parsety
@import parseops
@import parseexpr

struct DoElemNode { kind: int64, a: int64, b: int64 }

// The statement loops here, the block body, the do block, and the match arm table, all
// stop once the parser is muted. The nesting guard refuses a subtree without consuming
// its tokens, so a loop that kept reading would parse the rest of that construct again
// as fresh statements, one restart per budget's worth of tokens, and a 4000 deep nest
// reported eight thousand follow-on faults that way. Stopping ends the parse at the one
// diagnostic that named the real problem; the guard already recorded it, so the file
// still fails.
export func parse_block(p: *Parser) -> int64 {
    if !p_enter_nesting(p, "block", "function") {
        p_leave_nesting(p)
        empty: *Vector<int64> = alloc(vec_new())
        return ast_block(p_ast(p), empty)
    }
    stmts: *Vector<int64> = alloc(vec_new())
    p_expect(p, k_lbrace())
    mut reading: bool = true
    while reading {
        if p_at(p, k_rbrace()) {
            reading = false
        } else if p_at_eof(p) {
            reading = false
        } else if p_muted(p) {
            reading = false
        } else if p_at(p, k_semi()) {
            p_stray_semi(p, stray_semi_stmt())
        } else {
            before: int64 = (*p).pos
            sid: int64 = parse_stmt(p)
            if sid >= 0 {
                vec_push(stmts, sid)
            }
            // One semicolon closes the statement just read, the same break a newline
            // makes; a second one has no statement before it and is left for the loop
            // head above to name, which is what makes `;;` a fault rather than an
            // empty statement. The terminator has to sit on the statement's own line:
            // a semicolon opening the next line ends nothing, and reaching across the
            // break to eat it would swallow the stray instead of naming it.
            if !p_nl_here(p) { p_eat(p, k_semi()) }
            p_guard_progress(p, before, "unexpected token in block")
        }
    }
    p_expect(p, k_rbrace())
    p_leave_nesting(p)
    return ast_block(p_ast(p), stmts)
}

export func parse_stmt(p: *Parser) -> int64 {
    t0: Token = p_tok(p)
    if p_eat_kw(p, "break") {
        return ast_stmt(p_ast(p), sk_break(), t0.lo, t0.hi, 0, 0)
    }
    if p_eat_kw(p, "continue") {
        return ast_stmt(p_ast(p), sk_continue(), t0.lo, t0.hi, 0, 0)
    }
    if p_eat_kw(p, "return") {
        if p_at(p, k_rbrace()) { return ast_stmt(p_ast(p), sk_return(), -1, 0, 0, 0) }
        if p_nl_here(p) { return ast_stmt(p_ast(p), sk_return(), -1, 0, 0, 0) }
        // A semicolon ends the statement exactly as the line break above does, so a bare
        // `return;` returns no value; the block loop eats the terminator afterwards. Left
        // out, the value grammar ran on the terminator and named it as a missing
        // expression, which `break;` and `continue;` never did.
        if p_at(p, k_semi()) { return ast_stmt(p_ast(p), sk_return(), -1, 0, 0, 0) }
        return ast_stmt(p_ast(p), sk_return(), parse_await_or_expr(p), 0, 0, 0)
    }
    if p_eat_kw(p, "defer") {
        if (*p).in_async_fn && p_ident_text_is(p, "await") {
            p_error(p, "'await' cannot appear under defer; a defer runs at completion and cannot suspend")
            p_bump(p)
        }
        // Carry the `defer` keyword span in the b/c fields (the sk_break precedent, which
        // uses a/b), so the defer-inside-a-conditional reject points its caret at the
        // keyword the fix targets rather than the whole deferred expression. t0 is the
        // keyword token captured before the keyword was eaten, so it is stable regardless
        // of argument evaluation order.
        return ast_stmt(p_ast(p), sk_defer(), parse_expr(p), t0.lo, t0.hi, 0)
    }
    if p_kw(p, "if") { return parse_if_stmt(p) }
    if p_kw(p, "while") { return parse_while_stmt(p) }
    if p_kw(p, "for") { return parse_for_stmt(p) }
    if p_kw(p, "match") {
        scrut, off, len, hi := parse_match_parts(p)
        hi.ignore()
        return ast_stmt(p_ast(p), sk_match(), scrut, off, len, 0)
    }
    if p_kw(p, "do") { return parse_do_stmt(p) }
    if p_eat_kw(p, "mut") { return parse_let_rest(p, true, false) }
    if p_ident_text_is(p, "ref") {
        if p_kind2(p) == k_ident() {
            p_bump(p)
            return parse_let_rest(p, false, true)
        }
    }
    if is_binding_start(p) { return parse_let_rest(p, false, false) }
    if p_skip_stmt_decl(p) { return -1 }
    e: int64 = parse_await_or_expr(p)
    if p_eat(p, k_assign()) {
        rhs: int64 = parse_expr(p)
        return ast_stmt(p_ast(p), sk_assign(), e, rhs, 0, 0)
    }
    op: int64 = compound_op(p_kind(p))
    if op >= 0 {
        p_bump(p)
        rhs2: int64 = parse_expr(p)
        return ast_stmt(p_ast(p), sk_assign_op(), op, e, rhs2, aos_written())
    }
    return incdec_or_expr_stmt(p, e)
}

// A statement that is one increment or decrement and nothing else keeps the shape it
// has always had: the value is discarded, so it folds back into the compound
// assignment `x += 1` the parser has desugared it to since it was statement only, and
// every pass past the parser sees exactly what it saw before. The prefix and postfix
// forms collapse to the same statement, since a discarded value cannot tell them
// apart. An increment anywhere else in the statement, including one inside parentheses
// or under an operator, stays the expression it parsed as. The synthesized literal
// takes the operator token's own span, recovered from the node's d field, so a
// diagnostic against it points at the `++` that produced it, and the statement's own d
// records which form was written so the checker judges it by the operator's rule rather
// than by the addition.
func incdec_or_expr_stmt(p: *Parser, e: int64) -> int64 {
    a: *Ast = p_ast(p)
    n: ExprNode = vec_get((*a).exprs, e)
    if n.kind != xk_incdec() {
        return ast_stmt(a, sk_expr(), e, 0, 0, 0)
    }
    one: int64 = ast_expr(a, xk_int(), n.d, n.d + 2, 1, -1, 0, 0)
    mut src: int64 = aos_postfix()
    if n.c == incdec_pre() { src = aos_prefix() }
    return ast_stmt(a, sk_assign_op(), n.b, n.a, one, src)
}

func is_binding_start(p: *Parser) -> bool {
    if p_kind(p) != k_ident() { return false }
    k: int64 = p_kind2(p)
    if k == k_colon() { return true }
    if k == k_colon_eq() { return true }
    if k == k_comma() { return true }
    return false
}

func parse_let_rest(p: *Parser, mutable: bool, is_ref: bool) -> int64 {
    binds: *Vector<int64> = alloc(vec_new())
    mut missing: bool = false
    mut reading: bool = true
    while reading {
        name: int64 = p_ident(p)
        mut ty: int64 = -1
        if p_eat(p, k_colon()) {
            ty = parse_type(p)
        } else {
            missing = true
        }
        vec_push(binds, ast_bind(p_ast(p), name, ty))
        if !p_eat(p, k_comma()) { reading = false }
    }
    mut infer: bool = false
    if p_eat(p, k_colon_eq()) {
        infer = true
    } else {
        p_expect(p, k_assign())
    }
    if !infer {
        if missing { p_error(p, "destructuring binding needs ':=' or a type on each name") }
    }
    value: int64 = parse_await_or_expr(p)
    off, len := ast_kids(p_ast(p), binds)
    mut flags: int64 = 0
    if mutable { flags = flags | 1 }
    if is_ref { flags = flags | 2 }
    if infer { flags = flags | 4 }
    return ast_stmt(p_ast(p), sk_let(), off, len, value, flags)
}

export func parse_await_or_expr(p: *Parser) -> int64 {
    if p_ident_text_is(p, "await") {
        if (*p).in_async_fn {
            if (*p).lambda_depth == 0 {
                lo: int64 = p_lo(p)
                p_bump(p)
                op: int64 = parse_expr(p)
                n: ExprNode = vec_get((*p_ast(p)).exprs, op)
                return ast_expr(p_ast(p), xk_await(), lo, n.hi, op, -1, 0, 0)
            }
        }
        if !(*p).in_async_fn {
            if p_kind2(p) != k_lparen() {
                p_error(p, "'await' is only legal inside an async func")
            }
        }
    }
    return parse_expr(p)
}

func parse_if_stmt(p: *Parser) -> int64 {
    p_expect_kw(p, "if")
    cond: int64 = parse_expr_no_struct(p)
    then_block: int64 = parse_block(p)
    mut els: int64 = -1
    if p_eat_kw(p, "else") {
        if p_kw(p, "if") {
            if !p_enter_nesting(p, "block", "function") {
                p_leave_nesting(p)
                empty: *Vector<int64> = alloc(vec_new())
                els = ast_block(p_ast(p), empty)
            } else {
                one: *Vector<int64> = alloc(vec_new())
                vec_push(one, parse_if_stmt(p))
                els = ast_block(p_ast(p), one)
                p_leave_nesting(p)
            }
        } else {
            els = parse_block(p)
        }
    }
    return ast_stmt(p_ast(p), sk_if(), cond, then_block, els, 0)
}

func parse_while_stmt(p: *Parser) -> int64 {
    p_expect_kw(p, "while")
    cond: int64 = parse_expr_no_struct(p)
    body: int64 = parse_block(p)
    return ast_stmt(p_ast(p), sk_while(), cond, body, 0, 0)
}

func parse_for_stmt(p: *Parser) -> int64 {
    p_expect_kw(p, "for")
    var: int64 = p_ident(p)
    // An optional second binder, `for k, v in m`, binds a map's value alongside
    // its key. Encoded in d as the interned name plus one so a plain single-name
    // loop keeps d at 0. The checker judges which iterands the pair form is legal
    // for; the grammar takes it unconditionally.
    mut second: int64 = 0
    if p_eat(p, k_comma()) {
        second = p_ident(p) + 1
    }
    p_expect_kw(p, "in")
    iter: int64 = parse_expr_no_struct(p)
    body: int64 = parse_block(p)
    return ast_stmt(p_ast(p), sk_for(), var, iter, body, second)
}

// Whether the arm just parsed ended in a closing brace: its body was a block, or its
// body was an expression whose last token was one, which is every value form that
// carries a block of its own.
func arm_ends_in_brace(p: *Parser, block_body: bool) -> bool {
    if block_body {
        return true
    }
    return p_prev_kind(p) == k_rbrace()
}

export func parse_match_parts(p: *Parser) -> (int64, int64, int64, int64) {
    p_expect_kw(p, "match")
    scrut: int64 = parse_expr_no_struct(p)
    arms: *Vector<int64> = alloc(vec_new())
    p_expect(p, k_lbrace())
    mut reading: bool = true
    while reading {
        if p_at(p, k_rbrace()) {
            reading = false
        } else if p_at_eof(p) {
            reading = false
        } else if p_muted(p) {
            reading = false
        } else {
            before: int64 = (*p).pos
            pat: int64 = parse_pattern(p)
            p_expect(p, k_fat_arrow())
            block_body: bool = p_at(p, k_lbrace())
            mut body: int64 = -1
            if block_body {
                body = parse_block(p)
            } else if p_kw(p, "return") {
                one: *Vector<int64> = alloc(vec_new())
                vec_push(one, parse_stmt(p))
                body = ast_block(p_ast(p), one)
            } else {
                one2: *Vector<int64> = alloc(vec_new())
                ex: int64 = parse_expr(p)
                vec_push(one2, ast_stmt(p_ast(p), sk_expr(), ex, 0, 0, 0))
                body = ast_block(p_ast(p), one2)
            }
            vec_push(arms, ast_arm(p_ast(p), pat, body))
            // An arm that ends in a closing brace may drop its comma, whether the brace
            // is the arm's own block or the tail of a match, an if, a lambda, or a do the
            // arm evaluates. The separator is there to find the end of a one line arm,
            // and a brace already ends one; demanding it after a block read as a mistake
            // in a shape that looks complete, and the message named a token rather than
            // the rule. Anything else still needs the comma, and now says so.
            if arm_ends_in_brace(p, block_body) {
                p_eat(p, k_comma())
            } else if !p_at(p, k_rbrace()) {
                if !p_eat(p, k_comma()) {
                    p_error(p, "expected ',' after a match arm; an arm that ends in a block may omit it")
                }
            }
            p_guard_progress(p, before, "unexpected token in match arm")
        }
    }
    p_expect(p, k_rbrace())
    off, len := ast_kids(p_ast(p), arms)
    return (scrut, off, len, p_prev_hi(p))
}

func parse_pattern(p: *Parser) -> int64 {
    name: int64 = p_ident(p)
    if str_eq(ast_name(p_ast(p), name), "_") {
        return ast_pattern(p_ast(p), pk_wildcard(), 0, 0, 0)
    }
    if p_eat(p, k_lparen()) {
        binds: *Vector<int64> = alloc(vec_new())
        mut reading: bool = true
        while reading {
            if p_at(p, k_rparen()) {
                reading = false
            } else if p_at_eof(p) {
                reading = false
            } else {
                vec_push(binds, p_ident(p))
                if !p_eat(p, k_comma()) {
                    reading = false
                }
            }
        }
        p_expect(p, k_rparen())
        off, len := ast_kids(p_ast(p), binds)
        return ast_pattern(p_ast(p), pk_variant(), name, off, len)
    }
    return ast_pattern(p_ast(p), pk_ident(), name, 0, 0)
}

func parse_do_stmt(p: *Parser) -> int64 {
    lo: int64 = p_lo(p)
    monad_id, elems := parse_do_block_elems(p)
    if p_kw(p, "while") {
        if !p_nl_here(p) {
            p_bump(p)
            cond: int64 = parse_expr_no_struct(p)
            if monad_id >= 0 { p_error(p, "a 'do while' loop takes no monad name") }
            stmts: *Vector<int64> = alloc(vec_new())
            mut i: int64 = 0
            while i < vec_len(elems) {
                el: DoElemNode = vec_get(elems, i)
                if el.kind == 1 {
                    vec_push(stmts, el.a)
                } else {
                    p_error(p, "monadic bind '<-' is not allowed in a do while loop")
                }
                i = i + 1
            }
            body: int64 = ast_block(p_ast(p), stmts)
            return ast_stmt(p_ast(p), sk_while(), cond, body, 1, 0)
        }
    }
    expr: int64 = do_to_expr(p, monad_id, elems, lo)
    return ast_stmt(p_ast(p), sk_expr(), expr, 0, 0, 0)
}

export func parse_do_expr(p: *Parser) -> int64 {
    lo: int64 = p_lo(p)
    monad_id, elems := parse_do_block_elems(p)
    return do_to_expr(p, monad_id, elems, lo)
}

// The steps of a do block read as a flat list here, but desugar folds them into one
// nested bind per step, so a block of n steps becomes a tree n deep. That is the same
// flat-source deep-tree shape a chain has, so a step costs the same unit of the
// nesting budget; without the charge a two thousand step block overflowed the stack in
// sema. The steps are released together once the block closes.
func parse_do_block_elems(p: *Parser) -> (int64, *Vector<DoElemNode>) {
    elems: *Vector<DoElemNode> = alloc(vec_new())
    if !p_enter_nesting(p, "block", "function") {
        p_leave_nesting(p)
        return (-1, elems)
    }
    p_expect_kw(p, "do")
    mut monad_id: int64 = -1
    if p_kind(p) == k_ident() {
        if p_kind2(p) == k_lbrace() {
            monad_id = p_ident(p)
        }
    }
    p_expect(p, k_lbrace())
    mut steps: int64 = 0
    mut reading: bool = true
    while reading {
        if p_at(p, k_rbrace()) {
            reading = false
        } else if p_at_eof(p) {
            reading = false
        } else if p_muted(p) {
            reading = false
        } else if p_at(p, k_semi()) {
            p_stray_semi(p, stray_semi_stmt())
        } else if !p_enter_chain(p, p_chain_what(steps, "do")) {
            p_leave_nesting(p)
            reading = false
        } else {
            steps = steps + 1
            before: int64 = (*p).pos
            if p_kind(p) == k_ident() {
                if p_kind2(p) == k_larrow() {
                    name: int64 = p_ident(p)
                    p_bump(p)
                    e: int64 = parse_expr(p)
                    vec_push(elems, DoElemNode { kind: 0, a: name, b: e })
                } else {
                    sid: int64 = parse_stmt(p)
                    vec_push(elems, DoElemNode { kind: 1, a: sid, b: 0 })
                }
            } else {
                sid2: int64 = parse_stmt(p)
                if sid2 >= 0 {
                    vec_push(elems, DoElemNode { kind: 1, a: sid2, b: 0 })
                }
            }
            // A step ends at a semicolon exactly as a block statement does, one
            // consumed here, on the step's own line, and a second left for the loop
            // head to name.
            if !p_nl_here(p) { p_eat(p, k_semi()) }
            p_guard_progress(p, before, "unexpected token in do block")
        }
    }
    p_expect(p, k_rbrace())
    p_leave_chain(p, steps)
    p_leave_nesting(p)
    return (monad_id, elems)
}

func do_to_expr(p: *Parser, monad_id: int64, elems: *Vector<DoElemNode>, lo: int64) -> int64 {
    binds: *Vector<int64> = alloc(vec_new())
    mut i: int64 = 0
    while i < vec_len(elems) {
        el: DoElemNode = vec_get(elems, i)
        if el.kind == 0 {
            vec_push(binds, ast_do_bind(p_ast(p), el.a, el.b))
        } else {
            s: StmtNode = vec_get((*p_ast(p)).stmts, el.a)
            if s.kind == sk_expr() {
                vec_push(binds, ast_do_bind(p_ast(p), -1, s.a))
            } else {
                p_error(p, "do notation allows only 'x <- e' binds and a final expression")
            }
        }
        i = i + 1
    }
    if vec_len(binds) > 0 {
        last_id: int64 = vec_get(binds, vec_len(binds) - 1)
        last: DoBindNode = vec_get((*p_ast(p)).do_binds, last_id)
        if last.name >= 0 {
            p_error(p, "a do block must end in an expression, not a 'x <- e' bind")
        }
    }
    off, len := ast_kids(p_ast(p), binds)
    return ast_expr(p_ast(p), xk_do(), lo, p_prev_hi(p), monad_id, off, len, 0)
}

