// lex: the lexer's driver. It runs the scan loop, dispatching each lead byte to a
// token producing pass, and holds the identifier, keyword, number, and suffix
// passes. The literal and operator passes live in lexlit and lexsym. Paradigm
// agnostic like stage0: it never suppresses a token, and gating is a later pass.

@paradigm procedural

@import std.string
@import bytes
@import token
@import lexcore
@import lexlit
@import lexsym

func is_digit(c: int64) -> bool {
    if c >= 48 {
        if c <= 57 {
            return true
        }
    }
    return false
}

func is_alpha(c: int64) -> bool {
    if c >= 97 {
        if c <= 122 {
            return true
        }
    }
    if c >= 65 {
        if c <= 90 {
            return true
        }
    }
    return false
}

func is_ident_start(c: int64) -> bool {
    if is_alpha(c) {
        return true
    }
    if c == 95 {
        return true
    }
    return false
}

func is_ident_continue(c: int64) -> bool {
    if is_ident_start(c) {
        return true
    }
    return is_digit(c)
}

func is_alnum(c: int64) -> bool {
    if is_alpha(c) {
        return true
    }
    return is_digit(c)
}

// True for the integer and float type suffixes the spec allows.
func valid_suffix(s: string) -> bool {
    if str_eq(s, "i8") { return true }
    if str_eq(s, "i16") { return true }
    if str_eq(s, "i32") { return true }
    if str_eq(s, "i64") { return true }
    if str_eq(s, "u8") { return true }
    if str_eq(s, "u16") { return true }
    if str_eq(s, "u32") { return true }
    if str_eq(s, "u64") { return true }
    if str_eq(s, "f32") { return true }
    if str_eq(s, "f64") { return true }
    return false
}

// An identifier, keyword, or boolean literal. The word is scanned, then classified:
// true and false are booleans, a reserved word is a keyword, and the rest is an
// identifier. The kind alone is stored; the renderer reads the span for the text.
func lx_ident(lx: *Lexer, start: int64) -> void {
    mut going: bool = true
    while going {
        if is_ident_continue(lx_peek(lx)) {
            lx_advance(lx, 1)
        } else {
            going = false
        }
    }
    hi: int64 = lx_pos(lx)
    if is_bool_range((*lx).src, start, hi) {
        lx_push(lx, k_bool(), start)
    } else if is_keyword_range((*lx).src, start, hi) {
        lx_push(lx, k_kw(), start)
    } else {
        lx_push(lx, k_ident(), start)
    }
}

// The optional type suffix of a numeric literal: a letter, then letters and
// digits. Returns a fresh string, or the shared empty literal when there is none,
// which the caller frees only when non empty.
func lx_suffix(lx: *Lexer) -> string {
    if !is_alpha(lx_peek(lx)) {
        return ""
    }
    sstart: int64 = lx_pos(lx)
    mut going: bool = true
    while going {
        if is_alnum(lx_peek(lx)) {
            lx_advance(lx, 1)
        } else {
            going = false
        }
    }
    return substring_n((*lx).src, (*lx).n, sstart, lx_pos(lx))
}

// Whether the base 10 digits s[lo, hi) overflow a signed 64 bit integer, using the
// same guarded accumulation as std.string parse_int_radix so the lexer flags the
// exact literals stage0's i64 parse rejects.
func int_overflows(s: string, n: int64, lo: int64, hi: int64) -> bool {
    mut acc: int64 = 0
    mut i: int64 = lo
    while i < hi {
        dv: int64 = bytes.byte_at(s, n, i) - 48
        if acc > (9223372036854775807 - dv) / 10 {
            return true
        }
        acc = acc * 10 + dv
        i = i + 1
    }
    return false
}

// Whether the base 10 digits s[lo, hi) name a value past the unsigned 64 bit top.
// The test compares the digit text rather than accumulating, since no 64 bit
// accumulator can hold the boundary it is testing: leading zeros drop out, a run of
// digits longer than the top's is larger, a shorter one is smaller, and an equal
// length run compares position by position.
func uint_overflows(s: string, n: int64, lo: int64, hi: int64) -> bool {
    top: string = "18446744073709551615"
    width: int64 = str_len(top)
    mut i: int64 = lo
    mut leading: bool = true
    while leading {
        if i < hi && bytes.byte_at(s, n, i) == 48 {
            i = i + 1
        } else {
            leading = false
        }
    }
    digits: int64 = hi - i
    if digits > width { return true }
    if digits < width { return false }
    mut j: int64 = 0
    mut over: bool = false
    mut decided: bool = false
    while j < width && !decided {
        d: int64 = bytes.byte_at(s, n, i + j)
        t: int64 = int64(top[j])
        if d > t {
            over = true
            decided = true
        } else if d < t {
            decided = true
        }
        j = j + 1
    }
    return over
}

// Whether the suffix span s[lo, hi) is one of the unsigned widths. Only the lead
// byte has to be read: valid_suffix has already confirmed the whole spelling, and
// u8, u16, u32, and u64 are the only ones that start with a u.
func unsigned_suffix_span(s: string, n: int64, lo: int64, hi: int64) -> bool {
    if lo >= hi { return false }
    return bytes.byte_at(s, n, lo) == 117
}

// A numeric literal: digits, then an optional fractional part that makes it a
// float, then an optional suffix. An unknown suffix is a recorded fault.
// The kind alone is stored; the renderer reads the span for the value and suffix.
func lx_number(lx: *Lexer, start: int64) -> void {
    mut going: bool = true
    while going {
        if is_digit(lx_peek(lx)) {
            lx_advance(lx, 1)
        } else {
            going = false
        }
    }
    int_end: int64 = lx_pos(lx)
    mut is_float: bool = false
    if lx_peek(lx) == 46 {
        if is_digit(lx_peek2(lx)) {
            is_float = true
            lx_advance(lx, 1)
            mut fgoing: bool = true
            while fgoing {
                if is_digit(lx_peek(lx)) {
                    lx_advance(lx, 1)
                } else {
                    fgoing = false
                }
            }
        }
    }
    suffix: string = lx_suffix(lx)
    if str_len(suffix) > 0 {
        if !valid_suffix(suffix) {
            b: *StringBuilder = alloc(sb_new())
            sb_push(b, "unknown literal suffix '")
            sb_push(b, suffix)
            sb_push_char(b, 39)
            msg: string = substring(sb_cstr(b), 0, sb_size(b))
            lx_err(lx, start, msg)
            sb_free(b)
            free(b)
        }
        free(suffix)
    }
    // A base 10 integer literal that overflows i64 is a fault, the same as stage0's
    // i64 parse failure. A u suffixed literal is not a signed magnitude though: it
    // names a bit pattern, so it ranges against the unsigned top instead, which is
    // what lets 18446744073709551615u64 be written at all. A float never faults
    // here; an out of range float parses to an infinity, which is a value, not an
    // error.
    if !is_float {
        mut too_wide: bool = false
        if unsigned_suffix_span((*lx).src, (*lx).n, int_end, lx_pos(lx)) {
            too_wide = uint_overflows((*lx).src, (*lx).n, start, int_end)
        } else {
            too_wide = int_overflows((*lx).src, (*lx).n, start, int_end)
        }
        if too_wide {
            lx_err(lx, start, "invalid integer literal")
        }
    }
    mut kind: int64 = k_int()
    if is_float {
        kind = k_float()
    }
    lx_push(lx, kind, start)
}

// Runs the scan loop to end of input, dispatching each lead byte. The rune guard,
// r immediately before a quote, is tested before the identifier pass so `r'a'`
// lexes as a rune and a bare `r` stays an identifier. The f-string guard is the
// twin: f immediately before a quote opens an interpolated string, a bare f stays
// an identifier. End of input reached inside an interpolation hole is an
// unterminated literal, and clears the mode so it never leaks past the scan.
export func lex_run(lx: *Lexer) -> void {
    mut going: bool = true
    while going {
        lx_skip_trivia(lx)
        start: int64 = lx_pos(lx)
        c: int64 = lx_peek(lx)
        if c < 0 {
            if lx_fstr_active(lx) {
                lx_err(lx, start, "unterminated string literal")
                lx_fstr_reset(lx)
            }
            lx_push(lx, k_eof(), start)
            going = false
        } else if c == 114 {
            if lx_peek2(lx) == 39 {
                lx_rune(lx, start)
            } else {
                lx_dispatch(lx, start, c)
            }
        } else if c == 102 {
            if lx_peek2(lx) == 34 {
                lx_fstring(lx, start)
            } else {
                lx_dispatch(lx, start, c)
            }
        } else {
            lx_dispatch(lx, start, c)
        }
    }
}

func lx_dispatch(lx: *Lexer, start: int64, c: int64) -> void {
    if is_ident_start(c) {
        lx_ident(lx, start)
    } else if is_digit(c) {
        lx_number(lx, start)
    } else if c == 34 {
        lx_string(lx, start)
    } else if c == 39 {
        lx_char(lx, start)
    } else {
        lx_symbol(lx, start, c)
    }
}

// Lexes a source buffer of byte length n, returning the finished lexer with its
// tokens and faults.
export func lex(src: string, n: int64) -> *Lexer {
    lx: *Lexer = lx_new(src, n)
    lex_run(lx)
    return lx
}
