/** drivercs: the check that no @csource reaches a dusk function by its bare name.
 *  A dusk function's symbol is internal and carries a suffix no C identifier can
 *  spell, so a C file that calls one by the name it has in dusk calls something
 *  else: nothing at all, a link error, or a C library function of the same name,
 *  which links and runs the wrong code without a word. A library archive is worse,
 *  since `ld -r` never complains about an undefined symbol and the failure moves to
 *  the host's link. So after a @csource is compiled to an object, the names it
 *  leaves undefined are read with llvm-nm and any that a dusk function of the
 *  module also takes is refused by name, in an executable build and a library
 *  build alike. An `export "C"` function keeps its C name and is the way a C file
 *  calls dusk by name. */

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.os
@import std.process
@import home
@import diag
@import source
@import driverlink

// The names an object leaves undefined, one per line of llvm-nm's output, and
// whether llvm-nm could read the object at all.
func undefined_names(obj: string) -> (*Vector<string>, bool) {
    q: string = quote(obj)
    cmd: string = "llvm-nm --undefined-only --just-symbol-name " + q + " 2>/dev/null"
    free(q)
    text, code, e := run_capture(cmd)
    free(cmd)
    if e.exists() || code != 0 {
        if code >= 0 {
            free(text)
        }
        empty: *Vector<string> = alloc(vec_new())
        return (empty, false)
    }
    names: *Vector<string> = str_split(text, "\n")
    free(text)
    return (names, true)
}

// Whether the byte is one a C identifier may hold.
func is_ident_byte(c: int64) -> bool {
    if c >= 97 && c <= 122 { return true }
    if c >= 65 && c <= 90 { return true }
    if c >= 48 && c <= 57 { return true }
    return c == 95
}

// The line and column of the first place the C source spells the name as a whole
// identifier outside a comment, a string, and a character constant, or 0 and 0
// when it cannot be read or found. A best effort pointer at the call or the
// declaration, for the refusal's location.
func first_mention(path: string, name: string) -> (int64, int64) {
    src, e := source_load(path)
    if e.exists() {
        return (0, 0)
    }
    n: int64 = str_len(name)
    mut line: int64 = 1
    mut col: int64 = 1
    mut i: int64 = 0
    while i < src.len {
        c: int64 = src.text[i]
        skip: int64 = c_skip_len(src.text, src.len, i)
        if skip > 0 {
            // A comment or a literal is stepped over whole, its newlines counted
            for k in i..i + skip {
                if src.text[k] == 10 {
                    line++
                    col = 1
                } else {
                    col++
                }
            }
            i = i + skip
        } else if c == 10 {
            line++
            col = 1
            i++
        } else {
            if word_at(src.text, src.len, i, name, n) {
                source_free(src)
                return (line, col)
            }
            col++
            i++
        }
    }
    source_free(src)
    return (0, 0)
}

// How many bytes the comment, string, or character constant starting at i spans,
// or 0 when none starts there. An unterminated one runs to the end of the text.
func c_skip_len(text: string, len: int64, i: int64) -> int64 {
    c: int64 = text[i]
    if c == 47 && i + 1 < len && text[i + 1] == 47 {
        mut k: int64 = i + 2
        while k < len && text[k] != 10 {
            k++
        }
        return k - i
    }
    if c == 47 && i + 1 < len && text[i + 1] == 42 {
        mut k: int64 = i + 2
        while k + 1 < len && !(text[k] == 42 && text[k + 1] == 47) {
            k++
        }
        if k + 1 < len {
            return k + 2 - i
        }
        return len - i
    }
    if c == 34 || c == 39 {
        mut k: int64 = i + 1
        while k < len && text[k] != c && text[k] != 10 {
            if text[k] == 92 {
                k++
            }
            k++
        }
        if k < len {
            return k + 1 - i
        }
        return len - i
    }
    return 0
}

// Whether the identifier name starts at offset i and stands alone there.
func word_at(text: string, len: int64, i: int64, name: string, n: int64) -> bool {
    if i + n > len {
        return false
    }
    if i > 0 && is_ident_byte(text[i - 1]) {
        return false
    }
    for k in 0..n {
        if text[i + k] != name[k] {
            return false
        }
    }
    return i + n == len || !is_ident_byte(text[i + n])
}

/** Reports every dusk function a compiled @csource object calls by its bare name,
 *  pointing at the first place the C source spells it.
 *  @param src the C source the object was compiled from
 *  @param obj the object
 *  @param fn_names the module's internal top level functions, by their dusk names
 *  @return true when the source calls none of them */
export func csource_bare_calls_ok(src: string, obj: string, fn_names: *Vector<string>) -> bool {
    dusk_fns: *Map<string, int64> = alloc(map_new())
    for fname in fn_names {
        map_put(dusk_fns, fname, 1)
    }
    undefined, read := undefined_names(obj)
    if !read {
        diag_emit(diag_new(src, 0, 0, "llvm-nm could not read the object of this C source, which the build reads for a dusk function the source calls by its bare name"))
        return false
    }
    mut ok: bool = true
    for sym in undefined {
        if map_has(dusk_fns, sym) {
            line, col := first_mention(src, sym)
            msg: string = "C source calls dusk function '" + sym + "' by name; declare it export \"C\""
            diag_emit(diag_new(src, line, col, msg))
            free(msg)
            ok = false
        }
    }
    return ok
}

/** The executable build's form of the check: each @csource is compiled to an object
 *  beside the build's other output with the module's flags, read, and removed again,
 *  since the link line compiles the sources itself. A source that does not compile
 *  is left to the link, which reports it the way it always has.
 *  @param out the build's output directory
 *  @param stem the output stem, which names the objects
 *  @param csources the @csource paths
 *  @param fn_names the module's internal top level functions
 *  @param flags the module's flags
 *  @return true when no source calls a dusk function by its bare name */
export func csources_bare_calls_ok(out: string, stem: string, csources: *Vector<string>, fn_names: *Vector<string>, flags: string) -> bool {
    mut ok: bool = true
    for ci in 0..vec_len(csources) {
        src: string = vec_get(csources, ci)
        obj: string = path_join(out, f"{stem}.cs{ci}.o")
        cmd: *StringBuilder = alloc(sb_new())
        sb_push(cmd, "clang -c -pthread")
        if str_len(flags) > 0 {
            sb_push_char(cmd, 32)
            sb_push(cmd, flags)
        }
        push_arg(cmd, src)
        sb_push(cmd, " -o")
        push_arg(cmd, obj)
        sb_push(cmd, " 2>/dev/null")
        line: string = substring(sb_cstr(cmd), 0, sb_size(cmd))
        sb_free(cmd)
        free(cmd)
        if run(line) == 0 && !csource_bare_calls_ok(src, obj, fn_names) {
            ok = false
        }
        free(line)
        qobj: string = quote(obj)
        rm: string = "rm -f " + qobj
        run(rm)
        free(rm)
        free(qobj)
        free(obj)
    }
    return ok
}
