/** drivercs: what a failed link says about a C source that called a dusk function
 *  by its bare name. A dusk function's symbol is internal and carries a suffix no C
 *  identifier can spell, so a C call by the name it has in dusk reaches C: the C
 *  library, the runtime, or another C source, whichever defines it. Only when nothing
 *  does is the call unresolved, and then the linker's undefined reference to a name a
 *  dusk function takes is turned into a named build error at the first place a C
 *  source spells it. An executable reads its own link's report; a library build,
 *  whose `ld -r` never complains, reads the report of a trial link of its object
 *  against the runtime and the C library. An `export "C"` function keeps its C name
 *  and is the way a C file calls dusk by name. */

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.os
@import diag
@import source

// The name a linker line reports undefined, from ld's "undefined reference to `X'"
// or lld's and mold's "undefined symbol: X", or an empty string for any other line.
func undefined_name(line: string) -> string {
    bfd: int64 = str_find(line, "undefined reference to `")
    if bfd >= 0 {
        lo: int64 = bfd + 24
        mut hi: int64 = lo
        while hi < str_len(line) && line[hi] != 39 {
            hi++
        }
        return substring(line, lo, hi)
    }
    lld: int64 = str_find(line, "undefined symbol: ")
    if lld >= 0 {
        lo2: int64 = lld + 18
        mut hi2: int64 = lo2
        while hi2 < str_len(line) && line[hi2] != 32 {
            hi2++
        }
        return substring(line, lo2, hi2)
    }
    return substring(line, 0, 0)
}

/** The names a linker's report leaves undefined, each once, in first report order.
 *  @param report the linker's stderr
 *  @return the names, a fresh vector the caller frees */
export func undefined_refs(report: string) -> *Vector<string> {
    names: *Vector<string> = alloc(vec_new())
    seen: *Map<string, int64> = alloc(map_new())
    lines: *Vector<string> = str_split(report, "\n")
    for one in lines {
        name: string = undefined_name(one)
        if str_len(name) > 0 && !map_has(seen, name) {
            map_put(seen, substring(name, 0, str_len(name)), 1)
            vec_push(names, name)
        } else {
            free(name)
        }
    }
    return names
}

// Whether the byte is one a C identifier may hold.
func is_ident_byte(c: int64) -> bool {
    if c >= 97 && c <= 122 { return true }
    if c >= 65 && c <= 90 { return true }
    if c >= 48 && c <= 57 { return true }
    return c == 95
}

// The line and column of the first place the C source spells the name as a whole
// identifier outside a comment, a string, and a character constant, or 0 and 0
// when it cannot be read or found. A best effort pointer at the call or the
// declaration, for the refusal's location.
func first_mention(path: string, name: string) -> (int64, int64) {
    src, e := source_load(path)
    if e.exists() {
        return (0, 0)
    }
    n: int64 = str_len(name)
    mut line: int64 = 1
    mut col: int64 = 1
    mut i: int64 = 0
    while i < src.len {
        c: int64 = src.text[i]
        skip: int64 = c_skip_len(src.text, src.len, i)
        if skip > 0 {
            // A comment or a literal is stepped over whole, its newlines counted
            for k in i..i + skip {
                if src.text[k] == 10 {
                    line++
                    col = 1
                } else {
                    col++
                }
            }
            i = i + skip
        } else if c == 10 {
            line++
            col = 1
            i++
        } else {
            if word_at(src.text, src.len, i, name, n) {
                source_free(src)
                return (line, col)
            }
            col++
            i++
        }
    }
    source_free(src)
    return (0, 0)
}

// How many bytes the comment, string, or character constant starting at i spans,
// or 0 when none starts there. An unterminated one runs to the end of the text.
func c_skip_len(text: string, len: int64, i: int64) -> int64 {
    c: int64 = text[i]
    if c == 47 && i + 1 < len && text[i + 1] == 47 {
        mut k: int64 = i + 2
        while k < len && text[k] != 10 {
            k++
        }
        return k - i
    }
    if c == 47 && i + 1 < len && text[i + 1] == 42 {
        mut k: int64 = i + 2
        while k + 1 < len && !(text[k] == 42 && text[k + 1] == 47) {
            k++
        }
        if k + 1 < len {
            return k + 2 - i
        }
        return len - i
    }
    if c == 34 || c == 39 {
        mut k: int64 = i + 1
        while k < len && text[k] != c && text[k] != 10 {
            if text[k] == 92 {
                k++
            }
            k++
        }
        if k < len {
            return k + 1 - i
        }
        return len - i
    }
    return 0
}

// Whether the identifier name starts at offset i and stands alone there.
func word_at(text: string, len: int64, i: int64, name: string, n: int64) -> bool {
    if i + n > len {
        return false
    }
    if i > 0 && is_ident_byte(text[i - 1]) {
        return false
    }
    for k in 0..n {
        if text[i + k] != name[k] {
            return false
        }
    }
    return i + n == len || !is_ident_byte(text[i + n])
}

/** Reports every name a linker left undefined that a dusk function of the module
 *  takes, each at the first place a C source spells it, or, when none does, as a
 *  library call the compiler made for a C source.
 *  @param report the linker's stderr
 *  @param csources the @csource paths
 *  @param fn_names the module's internal top level functions, by their dusk names
 *  @return how many names were reported */
export func report_dusk_undefined(report: string, csources: *Vector<string>, fn_names: *Vector<string>) -> int64 {
    dusk_fns: *Map<string, int64> = alloc(map_new())
    for fname in fn_names {
        map_put(dusk_fns, fname, 1)
    }
    names: *Vector<string> = undefined_refs(report)
    mut reported: int64 = 0
    for sym in names {
        if map_has(dusk_fns, sym) {
            report_one(sym, csources)
            reported++
        }
    }
    return reported
}

// One unresolved call of a dusk function's name, at the first C source that spells it
func report_one(sym: string, csources: *Vector<string>) -> void {
    for src in csources {
        line, col := first_mention(src, sym)
        if line > 0 {
            msg: string = "C source calls dusk function '" + sym + "' by name; declare it export \"C\""
            diag_emit(diag_new(src, line, col, msg))
            free(msg)
            return
        }
    }
    msg2: string = "dusk: nothing the link reads defines '" + sym + "', a library call clang made for a C source; the dusk function of that name is internal and cannot answer it"
    printerr(msg2)
    free(msg2)
}
