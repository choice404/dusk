/** dawnget: fetching what a package requires, and the two commands that are a fetch
 *  with a step in front of it. The work is one pass over a queue. The root manifest's
 *  requires go in first, in the order the file declares them, and every require of a
 *  package that arrives is appended behind them, so the queue drains breadth first
 *  and dawn.lock ends up in declaration order with the root's own dependencies at the
 *  top. That order is the file's, not a sort, so a lock only changes when what it
 *  records changes.
 *
 *  Each claim in turn is judged against what is already settled, resolved to a
 *  commit, and checked out. The lock is consulted before the remote is: a require the
 *  lock already pins at the same source and ref keeps that pin, which is what makes a
 *  second get quiet and offline. dawn update is this same pass with the lock ignored
 *  for one alias or for all of them, which is the only way a pin ever moves.
 *
 *  What reaches a source goes through this machine's mirror of it, which dawncache
 *  keeps: a repository is cloned from the network once per machine and out of that
 *  mirror every time after, so a package this machine has already seen is fetched again
 *  with no network at all. The mirror is an optimization, so a fetch it cannot serve
 *  falls back to asking the remote directly and the pass reads the same either way.
 *
 *  Two kinds of file are written, at different moments. Each checkout is stamped as it
 *  lands, since the stamp is what says which commit that tree holds and a tree with no
 *  stamp is a tree dawn cannot vouch for. dawn.lock is written once, at the end, only
 *  after the whole graph has landed.
 *
 *  So a clash, an unresolvable ref, or a clone that failed leaves the lock exactly as
 *  it was: the project keeps claiming the state it last resolved to, rather than half
 *  of a state nobody asked for. What the failed pass already fetched stays on disk with
 *  its stamp, which costs nothing and is what the next get reads to skip that
 *  dependency as cached. A checkout the failure interrupted is not left half written
 *  either: a checkout replaces its directory rather than updating it, so a clone that
 *  died leaves no tree at all and the next get fetches it afresh. */

@paradigm procedural

@import std.string
@import std.vector
@import home
@import source
@import manifest
@import manifestlock
@import manifestline
@import dawnout
@import dawnpkg
@import dawngit
@import dawncache
@import dawnres

/** A ref resolved to the commit a checkout will be put at. from_lock records where
 *  the commit came from, since a checkout that fails at a commit the lock supplied
 *  has a different fix from one that fails at a commit the remote just named.
 *  cache_ok is false once the cache has faulted over this source, so the checkout that
 *  follows goes straight to the remote rather than asking a mirror that has just said
 *  it cannot be kept and reporting the same fault twice. */
struct Settled {
    ok: bool,
    commit: string,
    from_lock: bool,
    cache_ok: bool,
}

func copy_string(s: string) -> string {
    return substring(s, 0, str_len(s))
}

/** Whether this alias must be asked of the remote rather than read off the lock. */
func forced(force_all: bool, force_alias: string, alias: string) -> bool {
    if force_all {
        return true
    }
    if str_len(force_alias) == 0 {
        return false
    }
    return str_eq(force_alias, alias)
}

/** The commit the lock pins for exactly this alias, source, and ref, or the empty
 *  string when the lock says nothing that still applies. A lock entry whose source or
 *  ref no longer matches the manifest is not a pin for this require at all, so the
 *  ref is resolved afresh and the pin moves. */
func locked_commit(l: *Lock, w: *DawnWant) -> string {
    idx: int64 = lock_entry_index(l, (*w).alias)
    if idx < 0 {
        return ""
    }
    e: *LockEntry = vec_get((*l).entries, idx)
    if !str_eq((*e).source, (*w).source) {
        return ""
    }
    if !str_eq((*e).ref, (*w).ref) {
        return ""
    }
    return copy_string((*e).commit)
}

/** Appends every require of a manifest to the queue, in the order the file declares
 *  them. origin is the manifest doing the asking, which a clash message names. */
func push_requires(queue: *Vector<*DawnWant>, m: *Manifest, origin: string, from_root: bool) -> void {
    for r in (*m).requires {
        vec_push(queue, dawn_want_new((*r).alias, (*r).source, (*r).ref, origin, from_root))
    }
}

/** The commit this claim resolves to: the lock when its pin still applies, then this
 *  machine's mirror of the source, then the remote itself. The mirror answering is what
 *  lets a second project, or a machine with no connection at all, resolve a ref the
 *  machine has already seen; an update asks the remote first, since moving a pin is the
 *  one thing a stale mirror must not decide. A failure has already been reported when
 *  ok is false. */
func settle(w: *DawnWant, l: *Lock, url: string, scratch: string, force_all: bool, force_alias: string) -> Settled {
    must_fetch: bool = forced(force_all, force_alias, (*w).alias)
    if !must_fetch {
        pinned: string = locked_commit(l, w)
        if str_len(pinned) > 0 {
            return Settled { ok: true, commit: pinned, from_lock: true, cache_ok: true }
        }
    }
    c: DawnCached = dawn_cache_commit(scratch, url, (*w).alias, (*w).ref, must_fetch)
    if str_len(c.commit) > 0 {
        return Settled { ok: true, commit: c.commit, from_lock: false, cache_ok: c.usable }
    }
    rr: DawnRef = dawn_git_resolve(scratch, url, (*w).ref)
    if !rr.ok {
        msg: string = f"cannot resolve '{(*w).ref}' for '{(*w).alias}' at {url}"
        dawn_fail(msg)
        free(msg)
        dawn_detail(rr.detail)
        dawn_ref_free(rr)
        return Settled { ok: false, commit: "", from_lock: false, cache_ok: c.usable }
    }
    out: string = copy_string(rr.commit)
    dawn_ref_free(rr)
    return Settled { ok: true, commit: out, from_lock: false, cache_ok: c.usable }
}

/** Puts the dependency on disk at commit, out of this machine's mirror when it holds
 *  the commit and off the remote when it does not. Either way the checkout replaces its
 *  directory rather than updating it, so a clone that died leaves no tree at all. */
func fetch_into(w: *DawnWant, commit: string, from_lock: bool, url: string, scratch: string, dir: string, cache_ok: bool) -> int32 {
    if cache_ok {
        if dawn_cache_checkout(scratch, url, (*w).alias, commit, dir) {
            return 0
        }
    }
    c: DawnClone = dawn_git_checkout(scratch, url, (*w).ref, commit, dir)
    if !c.ok {
        mut msg: string = "cannot check out '" + (*w).ref + "' of '" + (*w).source + "' for '" + (*w).alias + "'"
        if from_lock {
            msg += "; dawn.lock pins commit " + commit + ", so run dawn update " + (*w).alias + " to resolve the ref again"
        }
        dawn_fail(msg)
        free(msg)
        dawn_detail(c.detail)
        dawn_clone_free(c)
        return 1
    }
    dawn_clone_free(c)
    return 0
}

/** Puts the dependency on disk at commit and stamps what landed. A checkout that is
 *  already the commit is left alone, so a second get touches no remote and rewrites no
 *  working tree; its stamp is written again all the same, which costs nothing and
 *  repairs a stamp whose ref text drifted from the manifest.
 *
 *  What "already the commit" means is read off the tree and not off the stamp alone. A
 *  stamp is a claim dawn wrote, and a directory it names can be moved to another commit,
 *  edited, gutted, or replaced by something that is no repository at all, none of which
 *  changes the file that vouches for it. So the checkout itself is asked, locally,
 *  which commit it is at and whether anything under it has changed, and a tree that
 *  does not answer with the commit it is stamped for is taken as no checkout and
 *  replaced. A build reads the same three files a fetch left behind, so a tree the
 *  fetch would not vouch for is not one a build should compile. */
func place(m: *Manifest, w: *DawnWant, commit: string, from_lock: bool, url: string, scratch: string, cache_ok: bool) -> int32 {
    dir: string = dep_dir(m, (*w).alias)
    st: Stamp = stamp_read(dir)
    mut stamped: bool = false
    if st.ok {
        if str_eq(st.commit, commit) {
            stamped = true
        }
    }
    stamp_free(st)
    mut have: bool = false
    if stamped {
        have = dawn_git_intact(scratch, dir, commit)
    }
    if have {
        dawn_note("dawn: cached ", (*w).alias)
    } else {
        // A tree that is stamped for this commit and did not answer for it is one the
        // fetch replaces rather than one it never had, and the line says which.
        if stamped {
            dawn_note("dawn: refreshing ", (*w).alias)
        } else {
            note: string = f"{(*w).alias} from {url}"
            dawn_note("dawn: fetching ", note)
            free(note)
        }
        fcode: int32 = fetch_into(w, commit, from_lock, url, scratch, dir, cache_ok)
        if fcode != 0 {
            free(dir)
            return fcode
        }
    }
    sp: string = stamp_path(dir)
    text: string = stamp_text((*w).source, (*w).ref, commit)
    code: int32 = dawn_write(sp, text)
    free(text)
    free(sp)
    free(dir)
    return code
}

/** Reads a fetched package's own manifest and appends its requires to the queue. A
 *  package with no manifest requires nothing, which is how a plain repository of
 *  dusk files is used. A manifest that does not read stops the fetch: its requires
 *  are part of this build, and guessing at a file that half parsed would fetch a
 *  graph nobody wrote. */
func enqueue_deep(m: *Manifest, w: *DawnWant, queue: *Vector<*DawnWant>) -> int32 {
    dir: string = dep_dir(m, (*w).alias)
    mpath: string = path_join(dir, "package.dawn")
    free(dir)
    if !source_is_file(mpath) {
        free(mpath)
        return 0
    }
    dm: *Manifest = manifest_read(mpath)
    mut code: int32 = 0
    if dawn_manifest_faulted(dm) {
        code = 1
    } else {
        push_requires(queue, dm, mpath, false)
    }
    manifest_free(dm)
    free(dm)
    free(mpath)
    return code
}

/** Settles one claim: resolve it, put it on disk, record it, and queue whatever it
 *  requires in turn. */
func admit(m: *Manifest, l: *Lock, w: *DawnWant, queue: *Vector<*DawnWant>, deps: *Vector<*DawnDep>, scratch: string, force_all: bool, force_alias: string) -> int32 {
    url: string = source_url((*w).source)
    if str_len(url) == 0 {
        msg: string = f"bad source '{(*w).source}' for '{(*w).alias}'"
        code: int32 = dawn_fail(msg)
        free(msg)
        return code
    }
    s: Settled = settle(w, l, url, scratch, force_all, force_alias)
    if !s.ok {
        free(url)
        return 1
    }
    pcode: int32 = place(m, w, s.commit, s.from_lock, url, scratch, s.cache_ok)
    free(url)
    if pcode != 0 {
        free(s.commit)
        return pcode
    }
    vec_push(deps, dawn_dep_new(w, s.commit))
    free(s.commit)
    return enqueue_deep(m, w, queue)
}

/** Writes dawn.lock from the settled set, one line per dependency in the order they
 *  were settled. */
func write_lock(m: *Manifest, deps: *Vector<*DawnDep>) -> int32 {
    lockp: string = lock_path_for(m)
    ev: *Vector<*LockEntry> = alloc(vec_new())
    errv: *Vector<string> = alloc(vec_new())
    out: *Lock = alloc(Lock { path: copy_string(lockp), entries: ev, errors: errv })
    for d in deps {
        vec_push(ev, alloc(LockEntry {
            alias: copy_string((*d).alias),
            source: copy_string((*d).source),
            ref: copy_string((*d).ref),
            commit: copy_string((*d).commit),
        }))
    }
    werr: string = lock_write(lockp, out)
    lock_free(out)
    free(out)
    free(lockp)
    if str_len(werr) > 0 {
        return dawn_fail_owned(werr)
    }
    return 0
}

/** Drains the queue, judging each claim and settling the ones that are new. */
func walk(m: *Manifest, l: *Lock, scratch: string, deps: *Vector<*DawnDep>, force_all: bool, force_alias: string) -> int32 {
    queue: *Vector<*DawnWant> = alloc(vec_new())
    push_requires(queue, m, (*m).path, true)
    mut code: int32 = 0
    mut qi: int64 = 0
    while qi < vec_len(queue) && code == 0 {
        w: *DawnWant = vec_get(queue, qi)
        qi++
        v: DawnVerdict = dawn_judge(deps, w, (*m).path)
        if v.kind == dawn_admit_clash() {
            code = dawn_fail(v.msg)
            if str_len(v.msg) > 0 { free(v.msg) }
        } else if v.kind == dawn_admit_new() {
            code = admit(m, l, w, queue, deps, scratch, force_all, force_alias)
        }
    }
    dawn_wants_free(queue)
    free(queue)
    return code
}

/** Fetches the whole graph a manifest names and writes the lock. force_all ignores
 *  every pin, force_alias ignores one; with neither, a pin the lock still agrees
 *  with is kept. */
export func dawn_fetch_all(m: *Manifest, force_all: bool, force_alias: string) -> int32 {
    mods: string = dawn_modules_path(m)
    mut ready: bool = dawn_mkdir_p(mods)
    scratch: string = dawn_scratch_path(m)
    if ready {
        ready = dawn_mkdir_p(scratch)
    }
    if !ready {
        code: int32 = dawn_fail_owned(f"cannot create {mods}")
        free(mods)
        free(scratch)
        return code
    }
    free(mods)
    lockp: string = lock_path_for(m)
    l: *Lock = lock_read(lockp)
    free(lockp)
    if dawn_lock_faulted(l) {
        dawn_fail("dawn.lock does not read; fix it or delete it, then run dawn get")
        lock_free(l)
        free(l)
        dawn_rm_rf(scratch)
        free(scratch)
        return 1
    }
    if str_len(force_alias) > 0 {
        mut known: bool = require_index((*m).requires, force_alias) >= 0
        if lock_entry_index(l, force_alias) >= 0 {
            known = true
        }
        if !known {
            code: int32 = dawn_fail_owned(quote_msg("no package named ", force_alias, " is required here"))
            lock_free(l)
            free(l)
            dawn_rm_rf(scratch)
            free(scratch)
            return code
        }
    }
    deps: *Vector<*DawnDep> = alloc(vec_new())
    mut code: int32 = walk(m, l, scratch, deps, force_all, force_alias)
    lock_free(l)
    free(l)
    dawn_rm_rf(scratch)
    free(scratch)
    if code == 0 && str_len(force_alias) > 0 {
        if dawn_dep_index(deps, force_alias) < 0 {
            code = dawn_fail_owned(quote_msg("no package named ", force_alias, " is required here"))
        }
    }
    if code == 0 {
        code = write_lock(m, deps)
    }
    if code == 0 {
        dawn_ready(vec_len(deps))
    }
    dawn_deps_free(deps)
    free(deps)
    return code
}
