// parse: shared parser state and low-level operations. Grammar entry points live
// in parseitem/parsety/parseexpr; this file owns token navigation, diagnostics,
// contextual keyword checks, literal reconstruction, and split-token mutations.

@paradigm procedural

@import std.string
@import std.vector
@import bytes
@import escape
@import token
@import diag
@import dumpval
@import intern
@import ast

export struct Parser {
    toks: *Vector<Token>,
    pos: int64,
    errors: *Vector<Located>,
    no_struct: bool,
    in_async_fn: bool,
    lambda_depth: int64,
    depth: int64,
    hit_depth_limit: bool,
    ast: *Ast,
    src: string,
    n: int64,
    docs: *Vector<DocBlock>,
    doc_pos: int64,
}

export func parser_new(toks: *Vector<Token>, src: string, n: int64) -> *Parser {
    errs: *Vector<Located> = alloc(vec_new())
    empty_docs: *Vector<DocBlock> = alloc(vec_new())
    return alloc(Parser {
        toks: toks,
        pos: 0,
        errors: errs,
        no_struct: false,
        in_async_fn: false,
        lambda_depth: 0,
        depth: 0,
        hit_depth_limit: false,
        ast: ast_new(),
        src: src,
        n: n,
        docs: empty_docs,
        doc_pos: 0,
    })
}

export func p_ast(p: *Parser) -> *Ast { return (*p).ast }
export func p_errors(p: *Parser) -> *Vector<Located> { return (*p).errors }

// Supplies the lexer's captured doc blocks so the item grammar can bind each block
// to the declaration it precedes. Kept separate from parser_new so the existing call
// sites that build a parser without docs stay source compatible; a parser left
// without docs simply binds none.
export func p_set_docs(p: *Parser, docs: *Vector<DocBlock>) -> void {
    (*p).docs = docs
    (*p).doc_pos = 0
}

// Claims the doc block, if any, that binds to the item whose first token is current.
// This is the token-gap rule, a pure byte comparison: cur is the current token's lo,
// prev is the previous token's hi, and the doc position sweeps forward past every
// block ending at or before cur. Among the blocks swept in this call, the last one
// that begins at or after prev, so it sits strictly in the gap between the two
// tokens, is the binding block; its span is returned, else (-1, -1). Blank lines and
// plain comments in the gap never break the binding, since they change no byte
// offset. Blocks whose end lies before prev, a body doc or a doc already claimed by
// an earlier item, are swept but never bind, so a call from the next item skips them.
export func p_take_doc(p: *Parser) -> (int64, int64) {
    docs: *Vector<DocBlock> = (*p).docs
    cur: int64 = p_lo(p)
    prev: int64 = p_prev_hi(p)
    mut best_lo: int64 = -1
    mut best_hi: int64 = -1
    mut going: bool = true
    while going {
        if (*p).doc_pos >= vec_len(docs) {
            going = false
        } else {
            d: DocBlock = vec_get(docs, (*p).doc_pos)
            if d.hi <= cur {
                if d.lo >= prev {
                    best_lo = d.lo
                    best_hi = d.hi
                }
                (*p).doc_pos = (*p).doc_pos + 1
            } else {
                going = false
            }
        }
    }
    return (best_lo, best_hi)
}

export func p_tok(p: *Parser) -> Token {
    toks: *Vector<Token> = (*p).toks
    return vec_get(toks, (*p).pos)
}

export func p_tok2(p: *Parser) -> Token {
    toks: *Vector<Token> = (*p).toks
    if (*p).pos + 1 >= vec_len(toks) {
        return Token { kind: k_eof(), lo: p_prev_hi(p), hi: p_prev_hi(p), nl_before: false }
    }
    return vec_get(toks, (*p).pos + 1)
}

export func p_kind(p: *Parser) -> int64 { return p_tok(p).kind }
export func p_kind2(p: *Parser) -> int64 { return p_tok2(p).kind }
export func p_lo(p: *Parser) -> int64 { return p_tok(p).lo }
export func p_hi(p: *Parser) -> int64 { return p_tok(p).hi }
export func p_nl_here(p: *Parser) -> bool { return p_tok(p).nl_before }
export func p_at(p: *Parser, k: int64) -> bool { return p_kind(p) == k }
export func p_at_eof(p: *Parser) -> bool { return p_kind(p) == k_eof() }

export func p_prev_hi(p: *Parser) -> int64 {
    if (*p).pos > 0 {
        toks: *Vector<Token> = (*p).toks
        return vec_get(toks, (*p).pos - 1).hi
    }
    return 0
}

// Whether the parser has stopped reporting. The nesting guard fires once, and past
// that point the token stream is desynchronized: the guard refuses a subtree without
// consuming its tokens, so the grammar restarts mid-construct and every later fault
// is an artifact of that one rejection rather than a separate mistake. A 3000 deep
// parenthesis nest used to bury the guard's message under eighteen thousand lines of
// "expected ')'", so the guard's diagnostic is the last one the file produces.
// Nothing is lost: the guard's message is already recorded, so the parse still fails.
export func p_muted(p: *Parser) -> bool { return (*p).hit_depth_limit }

export func p_error(p: *Parser, msg: string) -> void {
    if p_muted(p) { return }
    vec_push((*p).errors, located(p_lo(p), p_hi(p), msg))
}

// Reports a message the caller allocated. A muted parser frees it rather than
// recording it, so suppression drops no allocation on the floor.
export func p_error_owned(p: *Parser, msg: string) -> void {
    if p_muted(p) {
        free(msg)
        return
    }
    vec_push((*p).errors, located(p_lo(p), p_hi(p), msg))
}

export func p_error_at(p: *Parser, lo: int64, msg: string) -> void {
    if p_muted(p) { return }
    vec_push((*p).errors, located(lo, p_hi(p), msg))
}

export func p_error_span(p: *Parser, lo: int64, hi: int64, msg: string) -> void {
    if p_muted(p) { return }
    vec_push((*p).errors, located(lo, hi, msg))
}

export func p_bump(p: *Parser) -> void {
    if !p_at_eof(p) {
        (*p).pos = (*p).pos + 1
    }
}

export func p_eat(p: *Parser, k: int64) -> bool {
    if p_at(p, k) {
        (*p).pos = (*p).pos + 1
        return true
    }
    return false
}

export func p_expect(p: *Parser, k: int64) -> bool {
    if p_eat(p, k) {
        return true
    }
    if !p_muted(p) {
        p_error_owned(p, expected_found(kind_name(k), p))
    }
    return false
}

// "expected <what>, found <token>", the current token rendered in stage0's Debug
// form, so a parser diagnostic reads exactly as stage0's.
export func expected_found(what: string, p: *Parser) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "expected ")
    sb_push(b, what)
    sb_push(b, ", found ")
    found: string = token_found((*p).src, (*p).n, p_tok(p))
    sb_push(b, found)
    free(found)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

export func p_kw(p: *Parser, lit: string) -> bool {
    mut t: Token = p_tok(p)
    if t.kind != k_kw() {
        return false
    }
    return str_eq_range((*p).src, t.lo, t.hi, lit)
}

export func p_ident_text_is(p: *Parser, lit: string) -> bool {
    mut t: Token = p_tok(p)
    if t.kind != k_ident() {
        return false
    }
    return str_eq_range((*p).src, t.lo, t.hi, lit)
}

export func p_ident2_text_is(p: *Parser, lit: string) -> bool {
    t: Token = p_tok2(p)
    if t.kind != k_ident() {
        return false
    }
    return str_eq_range((*p).src, t.lo, t.hi, lit)
}

export func p_eat_kw(p: *Parser, lit: string) -> bool {
    if p_kw(p, lit) {
        p_bump(p)
        return true
    }
    return false
}

export func p_expect_kw(p: *Parser, lit: string) -> bool {
    if p_eat_kw(p, lit) {
        return true
    }
    p_error(p, "expected keyword")
    return false
}

export func p_ident(p: *Parser) -> int64 {
    t: Token = p_tok(p)
    if t.kind == k_ident() {
        id: int64 = intern_range((*(*p).ast).interner, (*p).src, (*p).n, t.lo, t.hi)
        p_bump(p)
        return id
    }
    if !p_muted(p) {
        p_error_owned(p, expected_found("identifier", p))
    }
    return intern_id((*(*p).ast).interner, "")
}

export func p_guard_progress(p: *Parser, before: int64, ctx: string) -> bool {
    if (*p).pos == before {
        if !p_muted(p) {
            // "<ctx>: <token>", the stuck token rendered in stage0's Debug form.
            b: *StringBuilder = alloc(sb_new())
            sb_push(b, ctx)
            sb_push(b, ": ")
            found: string = token_found((*p).src, (*p).n, p_tok(p))
            sb_push(b, found)
            free(found)
            msg: string = substring(sb_cstr(b), 0, sb_size(b))
            p_error_owned(p, msg)
            sb_free(b)
            free(b)
        }
        p_bump(p)
        return true
    }
    return false
}

// A top-level declaration keyword (enum, struct, interface, impl) at statement
// position is a common mistake, and left to the expression grammar it derails into
// a long cascade of follow-on errors. This names the mistake once against the
// keyword's own span, then skips the whole misplaced declaration so the rest of the
// body parses cleanly. Returns true when the current token began such a declaration,
// in which case it has already been reported and consumed and the caller yields the
// no-statement sentinel; the keyword is always consumed, so block progress holds.
// Recovery consumes forward through the matching close brace of the first {...}
// group, counting nested braces; a close brace seen before any open brace is the
// enclosing body's, so it is left in place, and EOF stops the scan either way.
export func p_skip_stmt_decl(p: *Parser) -> bool {
    mut what: string = ""
    if p_kw(p, "enum") {
        what = "an enum"
    } else if p_kw(p, "struct") {
        what = "a struct"
    } else if p_kw(p, "interface") {
        what = "an interface"
    } else if p_kw(p, "impl") {
        what = "an impl block"
    } else {
        return false
    }
    if !p_muted(p) {
        b: *StringBuilder = alloc(sb_new())
        sb_push(b, what)
        sb_push(b, " is declared at the top level, not inside a function body")
        msg: string = substring(sb_cstr(b), 0, sb_size(b))
        p_error_owned(p, msg)
        sb_free(b)
        free(b)
    }
    p_bump(p)
    mut depth: int64 = 0
    mut seen: bool = false
    mut going: bool = true
    while going {
        if p_at_eof(p) {
            going = false
        } else if p_at(p, k_lbrace()) {
            depth = depth + 1
            seen = true
            p_bump(p)
        } else if p_at(p, k_rbrace()) {
            if seen {
                depth = depth - 1
                p_bump(p)
                if depth == 0 {
                    going = false
                }
            } else {
                going = false
            }
        } else {
            p_bump(p)
        }
    }
    return true
}

// Names the construct that ran out of budget, once per file. The message is recorded
// before the mute latches, so the guard's own diagnostic is the one that survives.
func p_depth_report(p: *Parser, what: string) -> void {
    if (*p).hit_depth_limit {
        return
    }
    if str_eq(what, "block") {
        p_error(p, "block nesting is too deep; simplify the function")
    } else if str_eq(what, "type") {
        p_error(p, "type nesting is too deep; simplify the type")
    } else if str_eq(what, "chain") {
        p_error(p, "expression chain is too long; split it across bindings")
    } else if str_eq(what, "postfix") {
        p_error(p, "field and call chain is too long; bind an intermediate value")
    } else if str_eq(what, "do") {
        p_error(p, "do block has too many steps; move some of them into a helper function")
    } else {
        p_error(p, "expression nesting is too deep; simplify the expression")
    }
    (*p).hit_depth_limit = true
}

// One budget covers every way a program can deepen the tree the later passes walk: a
// nested block, a nested type, a nested expression, and, through p_enter_chain, each
// link of a chain the grammar folds in a loop.
export func p_enter_nesting(p: *Parser, what: string, fix: string) -> bool {
    (*p).depth = (*p).depth + 1
    if (*p).depth > 500 {
        p_depth_report(p, what)
        return false
    }
    return true
}

// One link of a chain the grammar folds in a loop, charged to the same budget. The
// charge matters because a chain nests in the AST without nesting in the parser: a + a
// + ... parses iteratively but builds a left deep tree one node per operator, and
// resolve, typeck, mono, and codegen all descend it recursively. Uncharged, a 3370 term
// sum and a 924 link call chain each killed the compiler with a stack overflow before
// any diagnostic. Charging to the one budget is also what makes the shapes compose: a
// chain buried under nested calls spends the same 500 units, so the tree depth a
// program can reach is bounded however the shapes are mixed. The two units the link's
// own operand parse will spend are reserved here, so a chain that runs out is named as
// a long chain rather than as ordinary nesting one operand deeper.
// Names the fault a chain loop reports. A loop that has already folded a link ran out
// of budget because the chain itself is long, so it names the chain. A loop that has
// folded none was at the limit before it started, and what is too deep is the nesting
// around it, not a chain of one, so it names that instead.
export func p_chain_what(links: int64, long: string) -> string {
    if links > 0 {
        return long
    }
    return "expression"
}

export func p_enter_chain(p: *Parser, what: string) -> bool {
    (*p).depth = (*p).depth + 1
    if (*p).depth + 2 > 500 {
        p_depth_report(p, what)
        return false
    }
    return true
}

export func p_leave_nesting(p: *Parser) -> void {
    (*p).depth = (*p).depth - 1
}

// Releases the budget a chain loop charged, one unit per link it folded. A loop that
// stopped on the guard has already released the unit that failed, so links counts only
// the links it built.
export func p_leave_chain(p: *Parser, links: int64) -> void {
    mut n: int64 = links
    while n > 0 {
        p_leave_nesting(p)
        n = n - 1
    }
}

export func p_at_type_close(p: *Parser) -> bool {
    k: int64 = p_kind(p)
    if k == k_gt() { return true }
    if k == k_shr() { return true }
    if k == k_shr_eq() { return true }
    if k == k_ge() { return true }
    return false
}

export func p_expect_gt(p: *Parser) -> void {
    mut t: Token = p_tok(p)
    rest_lo: int64 = t.lo + 1
    if t.kind == k_gt() {
        p_bump(p)
    } else if t.kind == k_shr() {
        t.kind = k_gt()
        t.lo = rest_lo
        vec_set((*p).toks, (*p).pos, t)
    } else if t.kind == k_shr_eq() {
        t.kind = k_ge()
        t.lo = rest_lo
        vec_set((*p).toks, (*p).pos, t)
    } else if t.kind == k_ge() {
        t.kind = k_assign()
        t.lo = rest_lo
        vec_set((*p).toks, (*p).pos, t)
    } else {
        if !p_muted(p) {
            p_error_owned(p, expected_found("'>'", p))
        }
    }
}

export func p_split_starstar(p: *Parser) -> void {
    mut t: Token = p_tok(p)
    t.kind = k_star()
    t.lo = t.lo + 1
    vec_set((*p).toks, (*p).pos, t)
}

func is_digit(c: int64) -> bool {
    if c >= 48 {
        if c <= 57 {
            return true
        }
    }
    return false
}

func is_alpha(c: int64) -> bool {
    if c >= 97 {
        if c <= 122 {
            return true
        }
    }
    if c >= 65 {
        if c <= 90 {
            return true
        }
    }
    return false
}

export func p_num_body_end(p: *Parser, t: Token) -> int64 {
    mut i: int64 = t.lo
    while is_digit(byte_at((*p).src, (*p).n, i)) {
        i = i + 1
    }
    if byte_at((*p).src, (*p).n, i) == 46 {
        if is_digit(byte_at((*p).src, (*p).n, i + 1)) {
            i = i + 1
            while is_digit(byte_at((*p).src, (*p).n, i)) {
                i = i + 1
            }
        }
    }
    return i
}

export func p_suffix_id(p: *Parser, t: Token, body_end: int64) -> int64 {
    if body_end >= t.hi {
        return -1
    }
    if !is_alpha(byte_at((*p).src, (*p).n, body_end)) {
        return -1
    }
    return intern_range((*(*p).ast).interner, (*p).src, (*p).n, body_end, t.hi)
}

// The bit pattern of the base 10 digits t.lo to body_end, accumulated with the wrap
// two's complement multiplication already gives. A u suffixed literal names a
// pattern rather than a signed magnitude, so the values between int64's top and
// uint64's top land exactly here where parse_int refuses them. The lexer has
// already refused anything past the unsigned top, so no wider value arrives.
func p_uint_pattern(p: *Parser, t: Token, body_end: int64) -> int64 {
    mut acc: int64 = 0
    mut i: int64 = t.lo
    while i < body_end {
        acc = acc * 10 + (byte_at((*p).src, (*p).n, i) - 48)
        i = i + 1
    }
    return acc
}

// Whether a numeric literal's suffix names an unsigned width. Only the lead byte is
// read; the lexer has already refused every suffix spelling but i8 through f64, and
// u8, u16, u32, and u64 are the ones that start with a u.
func p_has_unsigned_suffix(p: *Parser, t: Token, body_end: int64) -> bool {
    if body_end >= t.hi {
        return false
    }
    return byte_at((*p).src, (*p).n, body_end) == 117
}

export func p_int_value(p: *Parser, t: Token) -> int64 {
    body_end: int64 = p_num_body_end(p, t)
    if p_has_unsigned_suffix(p, t, body_end) {
        return p_uint_pattern(p, t, body_end)
    }
    s: string = substring_n((*p).src, (*p).n, t.lo, body_end)
    v, e := parse_int(s)
    e.ignore()
    free(s)
    return v
}

export func p_float_bits(p: *Parser, t: Token) -> int64 {
    body_end: int64 = p_num_body_end(p, t)
    s: string = substring_n((*p).src, (*p).n, t.lo, body_end)
    v, e := parse_float(s)
    e.ignore()
    free(s)
    return cool_f64_bits(v)
}

export func p_string_body_id(p: *Parser, t: Token) -> int64 {
    body: string = string_body_internal((*p).src, (*p).n, t.lo, t.hi)
    return intern_owned((*(*p).ast).interner, body)
}

// The interned format-cooked body of a string literal used as a print format, read from
// its raw source span so an escaped brace survives as a literal brace rather than a
// placeholder delimiter. lo/hi are the string token span, quotes included, the same span
// p_string_body_id reads.
export func p_fmt_body_id(p: *Parser, lo: int64, hi: int64) -> int64 {
    body: string = fmt_cook_internal((*p).src, (*p).n, lo, hi)
    return intern_owned((*(*p).ast).interner, body)
}

// The interned internal-form body of an f-string chunk token. A full or head chunk
// opens with the two-byte f" prefix, a mid or tail chunk with the one-byte } that
// closed the prior hole; every chunk ends with a single { or " delimiter one byte
// before hi. fstr_chunk_internal reads the exact body span [lo, hi), decodes its
// escapes, and collapses each doubled brace to a single one, so the interned chunk
// is fully cooked and codegen appends it verbatim.
export func p_fstr_chunk_id(p: *Parser, t: Token) -> int64 {
    mut lo: int64 = t.lo + 1
    if t.kind == k_fstr_full() || t.kind == k_fstr_head() {
        lo = t.lo + 2
    }
    body: string = fstr_chunk_internal((*p).src, (*p).n, lo, t.hi - 1)
    return intern_owned((*(*p).ast).interner, body)
}

export func p_char_scalar(p: *Parser, bstart: int64) -> int64 {
    b: int64 = byte_at((*p).src, (*p).n, bstart)
    if b < 0 { return 0 }
    if b == 39 { return 0 }
    if b == 92 {
        res: Escape = scan_escape((*p).src, (*p).n, bstart + 1)
        if res.scalar < 0 {
            return 0
        }
        return res.scalar
    }
    if b < 128 {
        return b
    }
    d: Decoded = decode_utf8((*p).src, (*p).n, bstart)
    return d.scalar
}
