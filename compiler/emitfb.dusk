// emitfb: textual LLVM IR function builder for dusk code generation.
//
// The builder owns one function body and simple counters for SSA temporaries and
// labels. It performs no type checking; helpers are only formatting funnels for
// textual LLVM instructions.

@paradigm procedural

@import std.string

export struct FuncBuilder {
    header: string,
    body: *StringBuilder,
    entry_allocas: *StringBuilder,
    tmp: int64,
    label: int64,
    // The location label, @.loc.N, of the statement being lowered in a --heap-sites
    // build, which line brackets each call with; empty when brackets are off: in a
    // build without the flag, in a standard library function, and before the first
    // statement of a body
    site: string,
}

func fb_built_string(b: *StringBuilder) -> string {
    return substring(sb_cstr(b), 0, sb_size(b))
}

func fb_copy_string(s: string) -> string {
    return substring(s, 0, str_len(s))
}

/** A builder for one function whose head line is already written. The head comes
 *  from emit_fn_head, the one writer of a define, so no builder spells its own.
 *  @param head the finished head line, ending in the opening brace
 *  @return a builder positioned at the entry block */
export func func_new_head(head: string) -> *FuncBuilder {
    body: *StringBuilder = alloc(sb_new())
    sb_push(body, "entry:\n")
    allocas: *StringBuilder = alloc(sb_new())
    return alloc(FuncBuilder {
        header: head,
        body: body,
        entry_allocas: allocas,
        tmp: 0,
        label: 0,
        site: "",
    })
}

export func func_async_new() -> *FuncBuilder {
    body: *StringBuilder = alloc(sb_new())
    allocas: *StringBuilder = alloc(sb_new())
    return alloc(FuncBuilder { header: fb_copy_string(""), body: body, entry_allocas: allocas, tmp: 0, label: 0, site: "" })
}

export func next_tmp(f: *FuncBuilder) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "%t")
    sb_push_int(b, (*f).tmp)
    out: string = fb_built_string(b)
    sb_free(b)
    free(b)
    (*f).tmp++
    return out
}

/** The location label the builder brackets calls with, empty when it brackets none.
 *  @param f the builder
 *  @return the label, borrowed from the module */
export func fb_site(f: *FuncBuilder) -> string {
    return (*f).site
}

/** Sets the location label every later call is bracketed with, or the empty string
 *  to stop bracketing. The label is an interned @.loc.N the module owns.
 *  @param f the builder
 *  @param site the label, or empty */
export func fb_set_site(f: *FuncBuilder, site: string) -> void {
    (*f).site = site
}

// Writes one instruction line into the body, indented
func fb_write(f: *FuncBuilder, text: string) -> void {
    sb_push((*f).body, "  ")
    sb_push((*f).body, text)
    sb_push_char((*f).body, 10)
}

/** Writes one instruction into the body. Every instruction a lowering emits passes
 *  through here, so this is the one place a --heap-sites build brackets a call: when
 *  the builder carries a site and the instruction is a call to anything but an exempt
 *  callee, a push of the site goes before it and a pop after it, three consecutive
 *  instructions. The bracket holds no branch, return, suspension, or defer, so the
 *  site stack is balanced on every path out of the call, and a call a lowering adds
 *  later is bracketed without anyone remembering to.
 *  @param f the builder
 *  @param text one instruction, without indent or newline */
export func line(f: *FuncBuilder, text: string) -> void {
    if str_len((*f).site) == 0 || !fb_is_site_call(text) {
        fb_write(f, text)
        return
    }
    body: *StringBuilder = (*f).body
    sb_push(body, "  call void @cool_site_push(ptr ")
    sb_push(body, (*f).site)
    sb_push(body, ")\n")
    fb_write(f, text)
    sb_push(body, "  call void @cool_site_pop()\n")
}

// Whether an instruction is a call the site stack brackets: a call, with or without
// a result name, whose callee is not exempt
func fb_is_site_call(text: string) -> bool {
    start: int64 = fb_call_start(text)
    if start < 0 {
        return false
    }
    callee: string = fb_callee(text, start)
    exempt: bool = fb_site_exempt(callee)
    free(callee)
    return !exempt
}

// The index just past the call keyword when an instruction is a call, else -1. A
// call starts the line, or follows a result name and " = "
func fb_call_start(text: string) -> int64 {
    if starts_with(text, "call ") {
        return 5
    }
    if !starts_with(text, "%") {
        return -1
    }
    eq: int64 = str_find(text, " = call ")
    if eq < 0 {
        return -1
    }
    for i in 1..eq {
        if text[i] == 32 {
            return -1
        }
    }
    return eq + 8
}

// The callee of a call, its name with the @ or % sigil, or the empty string: the
// first global or local name past the call keyword that an argument list follows
// directly. A return type such as %Pair or { ptr, i64 } is followed by a space, and a
// global passed as an argument comes after the callee's own parenthesis
func fb_callee(text: string, start: int64) -> string {
    n: int64 = str_len(text)
    mut i: int64 = start
    while i < n {
        c: int64 = text[i]
        if c != 64 && c != 37 {
            i++
            continue
        }
        end: int64 = fb_name_end(text, i + 1, n)
        if end < n && text[end] == 40 {
            return substring(text, i, end)
        }
        i = end
    }
    return substring(text, 0, 0)
}

// The index just past an LLVM name starting at i, a quoted one included
func fb_name_end(text: string, i: int64, n: int64) -> int64 {
    mut j: int64 = i
    if j < n && text[j] == 34 {
        j++
        while j < n && text[j] != 34 {
            j++
        }
        if j < n {
            return j + 1
        }
        return j
    }
    while j < n && fb_name_byte(text[j]) {
        j++
    }
    return j
}

// Whether a byte can continue an unquoted LLVM name: a letter, a digit, or one of
// . _ $ -
func fb_name_byte(c: int64) -> bool {
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) {
        return true
    }
    return c == 46 || c == 95 || c == 36 || c == 45
}

// The callees a site bracket never wraps: an LLVM intrinsic, the site functions
// themselves, the string index check, and the runtime's fault functions, which end
// the process. A runtime symbol never holds a dot, so a dusk function, whose symbol
// carries the .d suffix, is never exempt whatever it is called. A call with no
// callee the scan can name is left alone
func fb_site_exempt(callee: string) -> bool {
    if str_len(callee) == 0 || starts_with(callee, "@llvm.") {
        return true
    }
    if str_eq(callee, "@cool_site_push") || str_eq(callee, "@cool_site_pop") || str_eq(callee, "@cool_str_index_at") {
        return true
    }
    return starts_with(callee, "@cool_") && str_contains(callee, "_fault") && !str_contains(callee, ".")
}

export func call_void(f: *FuncBuilder, callee_and_args: string) -> void {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "call void ")
    sb_push(b, callee_and_args)
    text: string = fb_built_string(b)
    sb_free(b)
    free(b)
    line(f, text)
    free(text)
}

export func ret(f: *FuncBuilder, ty: string, val: string) -> void {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "ret ")
    sb_push(b, ty)
    sb_push_char(b, 32)
    sb_push(b, val)
    text: string = fb_built_string(b)
    sb_free(b)
    free(b)
    line(f, text)
    free(text)
}

export func fresh_label(f: *FuncBuilder) -> int64 {
    n: int64 = (*f).label
    (*f).label++
    return n
}

export func place_label(f: *FuncBuilder, n: int64) -> void {
    sb_push_char((*f).body, 76)
    sb_push_int((*f).body, n)
    sb_push((*f).body, ":\n")
}

export func place_named_label(f: *FuncBuilder, name: string) -> void {
    sb_push((*f).body, name)
    sb_push((*f).body, ":\n")
}

export func branch_label(n: int64) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "%L")
    sb_push_int(b, n)
    out: string = fb_built_string(b)
    sb_free(b)
    free(b)
    return out
}

export func push_entry_alloca(f: *FuncBuilder, text: string) -> void {
    sb_push((*f).entry_allocas, "  ")
    sb_push((*f).entry_allocas, text)
    sb_push_char((*f).entry_allocas, 10)
}

export func body_out(f: *FuncBuilder) -> string {
    return fb_built_string((*f).body)
}

export func op2(f: *FuncBuilder, dest: string, op: string, ty: string, lhs: string, rhs: string) -> void {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, dest)
    sb_push(b, " = ")
    sb_push(b, op)
    sb_push_char(b, 32)
    sb_push(b, ty)
    sb_push_char(b, 32)
    sb_push(b, lhs)
    sb_push(b, ", ")
    sb_push(b, rhs)
    text: string = fb_built_string(b)
    sb_free(b)
    free(b)
    line(f, text)
    free(text)
}

export func fb_load(f: *FuncBuilder, dest: string, ty: string, ptr: string) -> void {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, dest)
    sb_push(b, " = load ")
    sb_push(b, ty)
    sb_push(b, ", ptr ")
    sb_push(b, ptr)
    text: string = fb_built_string(b)
    sb_free(b)
    free(b)
    line(f, text)
    free(text)
}

export func store(f: *FuncBuilder, ty: string, val: string, ptr: string) -> void {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "store ")
    sb_push(b, ty)
    sb_push_char(b, 32)
    sb_push(b, val)
    sb_push(b, ", ptr ")
    sb_push(b, ptr)
    text: string = fb_built_string(b)
    sb_free(b)
    free(b)
    line(f, text)
    free(text)
}

export func br(f: *FuncBuilder, label_operand: string) -> void {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "br label ")
    sb_push(b, label_operand)
    text: string = fb_built_string(b)
    sb_free(b)
    free(b)
    line(f, text)
    free(text)
}

export func br_cond(f: *FuncBuilder, cond: string, then_label: string, else_label: string) -> void {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "br i1 ")
    sb_push(b, cond)
    sb_push(b, ", label ")
    sb_push(b, then_label)
    sb_push(b, ", label ")
    sb_push(b, else_label)
    text: string = fb_built_string(b)
    sb_free(b)
    free(b)
    line(f, text)
    free(text)
}

func push_body_without_entry(out: *StringBuilder, body: string) -> void {
    mut i: int64 = 7
    while body[i] != 0 {
        sb_push_char(out, body[i])
        i++
    }
}

export func finish(f: *FuncBuilder) -> string {
    out: *StringBuilder = alloc(sb_new())
    sb_push(out, (*f).header)
    sb_push_char(out, 10)
    sb_push(out, "entry:\n")
    sb_push(out, sb_cstr((*f).entry_allocas))
    push_body_without_entry(out, sb_cstr((*f).body))
    sb_push_char(out, 125)
    rendered: string = fb_built_string(out)
    sb_free(out)
    free(out)
    return rendered
}
