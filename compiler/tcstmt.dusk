// tcstmt: statement and block checking for S3a.

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
@import ast
@import ty
@import tcstate
@import tcscope
@import tcbin
@import tcexpr
@import tclet
@import tciface
@import tcmatch
@import tcown
@import tcesc
@import tcesccap

// Whether an expression names storage an assignment can write: a binding, a
// field chain, a scalar index (a range mints an rvalue slice), or a
// dereference. Everything else has no address, and codegen would silently
// drop the store.
func is_place_expr(a: *Ast, id: int64) -> bool {
    e: ExprNode = vec_get((*a).exprs, id)
    if e.kind == xk_ident() { return true }
    if e.kind == xk_field() { return is_place_expr(a, e.a) }
    if e.kind == xk_index() {
        idx: ExprNode = vec_get((*a).exprs, e.b)
        return idx.kind != xk_range()
    }
    if e.kind == xk_unary() {
        if e.a == uop_deref() { return true }
    }
    return false
}

func cannot_iterate_msg(rendered: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "cannot iterate ")
    sb_push(b, rendered)
    sb_push(b, "; a for loop takes an array, a slice, a string, a *Vector, or a *Map")
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

// The for-iterand classes recorded in for_iters. 0 (none) and -1 (a teach reject
// was emitted) are control values the caller reads; 1/2/3 are the recorded class.
func fc_none() -> int64 { return 0 }
func fc_vec() -> int64 { return 1 }
func fc_mapkeys() -> int64 { return 2 }
func fc_mappairs() -> int64 { return 3 }
func fc_teach() -> int64 { return -1 }

// Classifies a for iterand as one of the two stdlib containers, or judges the two
// container-shape rejects. Returns fc_vec/fc_mapkeys/fc_mappairs for a pointer to
// a std Vector or Map whose positional-access generics are loaded, which the
// caller records for the pre-mono rewrite. Returns fc_teach after emitting a teach
// reject: a by-value container (the loop needs the fat pointer to re-read length
// and element each iteration), or two binders on an iterand that is not a map (the
// pair form binds a map's key and value). Returns fc_none for everything else,
// which takes the existing element path. The container type names are the protocol
// and the accessor-presence guard keeps a user Vector without std.vector on today's
// clean cannot-iterate reject; a name collision is already the loader's duplicate
// definition error. A types-only run suppresses the emits, matching the surface
// origin of the classification.
func classify_container_for(tc: *TypeChecker, it: int64, has_second: bool, lo: int64, hi: int64) -> int64 {
    // The surface pass owns container classification and the pre-mono rewrite consumes
    // it; the ground pass runs types-only over the already-rewritten module, so no
    // container for reaches it. Declining to classify on the ground pass keeps a
    // leftover container for (a for the surface pass could not classify) a loud
    // cannot-iterate reject rather than a silent pass-through to codegen, and closes
    // the class where a generic accessor name surviving to the ground module would
    // coincidentally classify a for the rewrite never touched.
    if (*tc).types_only { return fc_none() }
    itn: TyNode = ty_get((*tc).ty, it)
    sigs: *Map<string, FnSig> = (*tc).sigs
    if itn.kind == tyk_named() {
        nm: string = ty_name((*tc).ty, it)
        if (str_eq(nm, "Vector") && map_has(sigs, "vec_len")) || (str_eq(nm, "Map") && map_has(sigs, "map_len")) {
            tc_emit(tc, "iterate the container through a pointer, as in v: *Vector<T>", lo, hi)
            return fc_teach()
        }
    }
    if itn.kind == tyk_ptr() {
        inner: TyNode = ty_get((*tc).ty, itn.a)
        if inner.kind == tyk_named() {
            nm2: string = ty_name((*tc).ty, itn.a)
            if str_eq(nm2, "Vector") && map_has(sigs, "vec_len") && map_has(sigs, "vec_get") {
                if has_second {
                    tc_emit(tc, "two loop names bind a map's key and value; this iterand has only elements", lo, hi)
                    return fc_teach()
                }
                return fc_vec()
            }
            if str_eq(nm2, "Map") && map_has(sigs, "map_len") && map_has(sigs, "map_key_at") {
                if has_second {
                    // The pair form needs the value accessor; without it the loop would
                    // silently fall to key-only iteration leaving the value binder
                    // unbound, so refuse rather than under-bind.
                    if map_has(sigs, "map_val_at") { return fc_mappairs() }
                    tc_emit(tc, "the map pair form needs map_val_at in scope; import std.map to iterate key and value", lo, hi)
                    return fc_teach()
                }
                return fc_mapkeys()
            }
        }
    }
    // A second binder on a known non-container iterand is the pair-form misuse. On an
    // unknown iterand (a generic, or a shape the surface could not ground) stay
    // permissive: the iterand may ground to a map, and a leftover for is judged then.
    if has_second {
        if itn.kind == tyk_unknown() { return fc_none() }
        tc_emit(tc, "two loop names bind a map's key and value; this iterand has only elements", lo, hi)
        return fc_teach()
    }
    return fc_none()
}

// The AST type of a classified container iterand's idx-th type argument, read from
// the un-erased AST where a named type keeps its generic args: *Vector<T> arg 0 is
// T, *Map<K, V> arg 0 is K and arg 1 is V. Returns -1 when the AST type is not a
// pointer to a named type with that arg, so the binder falls back to the wildcard.
func container_elem_ast(a: *Ast, ptr_ast: int64, idx: int64) -> int64 {
    if ptr_ast < 0 { return -1 }
    pn: TypeNode = vec_get((*a).types, ptr_ast)
    if pn.kind != tk_ptr() { return -1 }
    inner: TypeNode = vec_get((*a).types, pn.a)
    if inner.kind != tk_named() { return -1 }
    if idx >= inner.c { return -1 }
    return vec_get((*a).kids, inner.b + idx)
}

// The AST type id of a struct field, found by scanning the struct definitions for the
// base AST type's name (dereferencing a pointer to the struct first). Returns -1 when
// the base is not a known struct or the field is absent. A generic struct still yields
// its field's AST type, so a container field classifies by name; the caller guards the
// element it derives from a field, since that names the struct's own type parameter.
func struct_field_ast(tc: *TypeChecker, struct_ast: int64, field: string) -> int64 {
    a: *Ast = (*tc).ast
    if struct_ast < 0 { return -1 }
    sn: TypeNode = vec_get((*a).types, struct_ast)
    mut named: TypeNode = sn
    if sn.kind == tk_ptr() { named = vec_get((*a).types, sn.a) }
    if named.kind != tk_named() { return -1 }
    sname: string = ast_name(a, named.a)
    structs: *Vector<StructNode> = (*a).structs
    mut i: int64 = 0
    while i < vec_len(structs) {
        st: StructNode = vec_get(structs, i)
        if str_eq(ast_name(a, st.name), sname) {
            mut j: int64 = 0
            while j < st.fields_len {
                fld: FieldNode = vec_get((*a).fields, vec_get((*a).kids, st.fields_off + j))
                if str_eq(ast_name(a, fld.name), field) { return fld.ty }
                j = j + 1
            }
            return -1
        }
        i = i + 1
    }
    return -1
}

// The AST return type id of a non-generic top-level function, for classifying and
// typing a for over a call's result. A generic function returns -1 (its return names
// a type parameter the surface pass cannot ground here); the ground pass recovers it.
func func_ret_ast(tc: *TypeChecker, fname: string) -> int64 {
    a: *Ast = (*tc).ast
    funcs: *Vector<FuncNode> = (*a).funcs
    mut i: int64 = 0
    while i < vec_len(funcs) {
        f: FuncNode = vec_get(funcs, i)
        if str_eq(ast_name(a, f.name), fname) {
            if f.generics_len > 0 { return -1 }
            return f.ret
        }
        i = i + 1
    }
    return -1
}

// The AST type id of a for iterand, recovered from the un-erased AST so a container
// held in a binding, a struct field, or a call result classifies even though the
// surface arena erased its generic args. Handles a plain name, a field chain, and a
// direct call; anything else returns -1 and the iterand falls back to inference.
func iterand_ast_ty(tc: *TypeChecker, expr_id: int64) -> int64 {
    a: *Ast = (*tc).ast
    e: ExprNode = vec_get((*a).exprs, expr_id)
    if e.kind == xk_ident() { return binding_ast_of(tc, ast_name(a, e.a)) }
    if e.kind == xk_field() {
        base_ast: int64 = iterand_ast_ty(tc, e.a)
        return struct_field_ast(tc, base_ast, ast_name(a, e.b))
    }
    if e.kind == xk_call() {
        callee: ExprNode = vec_get((*a).exprs, e.a)
        if callee.kind == xk_ident() { return func_ret_ast(tc, ast_name(a, callee.a)) }
    }
    return -1
}

// Whether a recovered element arena type is safe to declare as the binder type: any
// non-named type, or a named type that resolves to a known struct, enum, interface,
// or container. An unresolved named type is a generic parameter the surface pass
// cannot ground, so the binder stays a wildcard and the ground pass recovers it.
func elem_ty_safe(tc: *TypeChecker, tyid: int64) -> bool {
    n: TyNode = ty_get((*tc).ty, tyid)
    if n.kind != tyk_named() { return true }
    nm: string = ty_name((*tc).ty, tyid)
    if str_eq(nm, "Vector") || str_eq(nm, "Map") { return true }
    structs: *Map<string, StructSig> = (*tc).structs
    if map_has(structs, nm) { return true }
    enums: *Map<string, EnumSig> = (*tc).enums
    if map_has(enums, nm) { return true }
    ifaces: *Map<string, int64> = (*tc).ifaces
    if map_has(ifaces, nm) { return true }
    return false
}

func infer_await_operand(tc: *TypeChecker, await_expr: ExprNode) -> int64 {
    ft: int64 = infer_expr(tc, await_expr.a)
    fn: TyNode = ty_get((*tc).ty, ft)
    if fn.kind == tyk_future() { return fn.a }
    if fn.kind == tyk_unknown() { return ft }
    // On the ground AST mono may leave a future as its mangled Future$T named type
    // where the operand's type was read from a table the unmangle walk does not
    // reach, a struct field among them. The future table names its element, so an
    // await still yields the right type instead of the permissive backstop.
    if fn.kind == tyk_named() {
        nm: string = ty_name((*tc).ty, ft)
        fe: *Map<string, int64> = (*tc).future_elems
        if map_has(fe, nm) {
            return unwrap_or(map_get(fe, nm), ty_unknown((*tc).ty))
        }
    }
    if !(*tc).types_only {
        tc_emit(tc, "the operand of await is not a future", await_expr.lo, await_expr.hi)
    }
    return ty_unknown((*tc).ty)
}

func check_return_value(tc: *TypeChecker, expr_id: int64) -> void {
    a: *Ast = (*tc).ast
    e: ExprNode = vec_get((*a).exprs, expr_id)
    mut t: int64 = ty_unknown((*tc).ty)
    if e.kind == xk_await() {
        t = infer_await_operand(tc, e)
    } else {
        // A managed return type hints the match verdict the same way a managed binding does,
        // so a returned match extraction over a locally allocated subject still classifies.
        // A bare type-parameter return (a generic func returning T) hints the same way: the
        // returned match may launder a borrow the subject owns, and the surface pass is the
        // only place the borrow is visible before mono grounds T. T lowers to a hole, so the
        // written return node is consulted through cur_ret_ast.
        if !(*tc).types_only && e.kind == xk_match() && (is_managed_ty(tc, (*tc).cur_ret) || is_typaram_ast(tc, (*tc).cur_ret_ast)) { (*tc).match_ctx = 1 }
        t = infer_expr(tc, expr_id)
        (*tc).match_ctx = 0
    }
    // Returning a match expression whose arms agreed on a borrow hands the caller a
    // pointer the subject still owns: the return position would launder the borrow into
    // the caller's owner exactly as the copy spelling does in binding position. The
    // verdict walk_match_expr stored gates on a managed return type, so a scalar match
    // return is untouched.
    if !(*tc).types_only && e.kind == xk_match() && (is_managed_ty(tc, (*tc).cur_ret) || is_typaram_ast(tc, (*tc).cur_ret_ast)) {
        if match_own_of(tc, expr_id) == own_borrow() {
            tc_emit(tc, "cannot return a borrowed match result; move the payload or return an owning call", e.lo, e.hi)
        }
    }
    if !compat((*tc).ty, (*tc).cur_ret, t) {
        rn: TyNode = ty_get((*tc).ty, (*tc).cur_raw_ret)
        tn: TyNode = ty_get((*tc).ty, t)
        mut handled: bool = false
        ifaces: *Map<string, int64> = (*tc).ifaces
        if rn.kind == tyk_named() && map_has(ifaces, ty_name((*tc).ty, (*tc).cur_raw_ret)) && tn.kind == tyk_named() {
            check_conformance(tc, (*tc).cur_raw_ret, t, e.lo, e.hi)
            handled = true
        } else if tuple_iface_mismatch(tc, (*tc).cur_raw_ret, t, e.lo, e.hi) {
            handled = true
        }
        // A `return self` against a `*T` return earns the precise receiver-value
        // message, not the generic mismatch: `self` is the receiver value, and
        // codegen would hand the struct where the fat pointer belongs. Mirrors
        // stage0's self_value_in_ptr_position at the return position, which the
        // call-arg positions already run. dusk's `&&` does not short-circuit, so
        // the ident kind is guarded with nested ifs before the name is read; a
        // flat chain would call ast_name on a non-ident return expr and fault.
        if !handled && (*tc).in_method {
            if e.kind == xk_ident() {
                if str_eq(ast_name(a, e.a), "self") {
                    rt: TyNode = ty_get((*tc).ty, (*tc).cur_ret)
                    selfn: TyNode = ty_get((*tc).ty, lookup(tc, "self"))
                    if rt.kind == tyk_ptr() && selfn.kind == tyk_named() {
                        tc_emit(tc, "cannot use 'self' where a pointer is required; 'self' is the receiver value, not a pointer to it", e.lo, e.hi)
                        handled = true
                    }
                }
            }
        }
        if !handled {
            tc_emit(tc, "return type does not match the function's return type", e.lo, e.hi)
        }
    }
    check_int_fits(tc, expr_id, (*tc).cur_ret)
    check_escape(tc, expr_id, t)
    mark_errs_in(tc, expr_id)
}

func branch_block(tc: *TypeChecker, block_id: int64) -> void {
    saved: *Vector<*Map<string, int64>> = clone_owns(tc)
    (*tc).branch_depth = (*tc).branch_depth + 1
    check_block(tc, block_id)
    (*tc).branch_depth = (*tc).branch_depth - 1
    restore_owns(tc, saved)
}

func loop_body_fixpoint(tc: *TypeChecker, block_id: int64) -> void {
    (*tc).loop_depth = (*tc).loop_depth + 1
    (*tc).suppress = (*tc).suppress + 1
    mut prev: string = esc_snapshot(tc)
    mut i: int64 = 0
    mut done: bool = false
    while i < 64 && !done {
        branch_block(tc, block_id)
        now: string = esc_snapshot(tc)
        if str_eq(now, prev) {
            done = true
        } else {
            prev = now
        }
        i = i + 1
    }
    (*tc).suppress = (*tc).suppress - 1
    branch_block(tc, block_id)
    (*tc).loop_depth = (*tc).loop_depth - 1
}

func check_match_stmt(tc: *TypeChecker, scrut: int64, off: int64, len: int64) -> void {
    st: int64 = infer_expr(tc, scrut)
    scrut_esc: EscPair = value_escape(tc, scrut)
    a: *Ast = (*tc).ast
    (*tc).branch_depth = (*tc).branch_depth + 1
    mut i: int64 = 0
    while i < len {
        arm: ArmNode = vec_get((*a).arms, vec_get((*a).kids, off + i))
        push_scope(tc)
        bind_match_arm(tc, arm.pat, st, scrut)
        bind_match_arm_escape(tc, arm.pat, scrut, scrut_esc)
        check_block_no_scope(tc, arm.body)
        pop_scope(tc)
        i = i + 1
    }
    (*tc).branch_depth = (*tc).branch_depth - 1
    check_match_scrutinee(tc, st, scrut, off, len)
}

export func check_stmt(tc: *TypeChecker, id: int64) -> void {
    a: *Ast = (*tc).ast
    s: StmtNode = vec_get((*a).stmts, id)
    if s.kind == sk_let() {
        value: ExprNode = vec_get((*a).exprs, s.c)
        if value.kind == xk_await() {
            check_let_await(tc, s, value)
        } else {
            check_let(tc, s)
        }
    } else if s.kind == sk_assign() {
        lt: int64 = infer_expr(tc, s.a)
        rt: int64 = infer_expr(tc, s.b)
        lhs: ExprNode = vec_get((*a).exprs, s.a)
        if !is_place_expr(a, s.a) {
            tc_emit(tc, "the left side of an assignment must be a place: a name, a field, an index, or a dereference", lhs.lo, lhs.hi)
        }
        if !compat((*tc).ty, lt, rt) {
            if !check_char_array_lit(tc, lt, s.b) {
                tc_emit(tc, "assignment type mismatch", lhs.lo, lhs.hi)
            }
        }
        check_int_fits(tc, s.b, lt)
        if lhs.kind == xk_ident() {
            raw: int64 = slice_iface_of(tc, ast_name(a, lhs.a))
            if raw >= 0 {
                rhs_expr: ExprNode = vec_get((*a).exprs, s.b)
                check_slice_covariance(tc, raw, rt, s.b, rhs_expr.lo, rhs_expr.hi)
            }
        }
        check_assign_target(tc, s.a)
        check_assign_ownership(tc, s.a, s.b, lt)
        if lhs.kind == xk_ident() {
            dst: string = ast_name(a, lhs.a)
            esc: EscPair = value_escape(tc, s.b)
            assign_esc(tc, dst, esc.slice, esc.closure)
            record_lambda_assign(tc, dst, s.b)
            if links_as_alias(tc, lt) || links_as_alias(tc, chain_ty(tc, s.b)) {
                link_binding_aliases(tc, dst, s.b, true)
            }
        } else {
            root: string = store_root(tc, s.a)
            if str_len(root) > 0 && param_alias_of(tc, root) < 0 {
                esc2: EscPair = value_escape(tc, s.b)
                if esc2.slice || esc2.closure { raise_esc(tc, root, esc2.slice, esc2.closure) }
            }
        }
    } else if s.kind == sk_assign_op() {
        lt2: int64 = infer_expr(tc, s.b)
        rt2: int64 = infer_expr(tc, s.c)
        lhs2: ExprNode = vec_get((*a).exprs, s.b)
        if !is_place_expr(a, s.b) {
            tc_emit(tc, "the left side of an assignment must be a place: a name, a field, an index, or a dereference", lhs2.lo, lhs2.hi)
        }
        result: int64 = check_binary(tc, s.a, lt2, rt2, lhs2.lo, lhs2.hi)
        if s.a == bop_shl() || s.a == bop_shr() { check_shift_amount(tc, s.c, lt2, lhs2.lo, lhs2.hi) }
        if s.a == bop_pow() { check_pow_exponent(tc, lt2, rt2, s.c, lhs2.lo, lhs2.hi) }
        if !compat((*tc).ty, result, lt2) {
            tc_emit(tc, "assignment type mismatch", lhs2.lo, lhs2.hi)
        }
        check_int_fits(tc, s.c, lt2)
        check_assign_target(tc, s.b)
    } else if s.kind == sk_return() {
        if s.a >= 0 {
            re: ExprNode = vec_get((*a).exprs, s.a)
            if re.kind == xk_await() {
                el: int64 = infer_await_operand(tc, re)
                if !compat((*tc).ty, (*tc).cur_ret, el) {
                    tc_emit(tc, "return type does not match the function's return type", re.lo, re.hi)
                }
                mark_errs_in(tc, re.a)
            } else {
                check_return_value(tc, s.a)
            }
        } else if !compat((*tc).ty, (*tc).cur_ret, ty_unit((*tc).ty)) {
            tc_emit(tc, "missing return value", 0, 0)
        }
    } else if s.kind == sk_defer() {
        if (*tc).branch_depth > 0 {
            // The caret points at the `defer` keyword (its span rides in s.b/s.c from the
            // parser), not the deferred expression: the keyword is what is misplaced.
            tc_emit(tc, "a defer inside a conditional or loop is not supported; register it at the top level of the function", s.b, s.c)
        }
        if s.a >= 0 { infer_expr(tc, s.a) }
    } else if s.kind == sk_if() {
        ct: int64 = infer_expr(tc, s.a)
        cn: TyNode = ty_get((*tc).ty, ct)
        cond: ExprNode = vec_get((*a).exprs, s.a)
        if cn.kind != tyk_bool() && cn.kind != tyk_unknown() {
            tc_emit(tc, "if condition must be a bool", cond.lo, cond.hi)
        }
        branch_block(tc, s.b)
        if s.c >= 0 { branch_block(tc, s.c) }
    } else if s.kind == sk_break() {
        if (*tc).loop_depth == 0 {
            tc_emit(tc, "break is only legal inside a loop", s.a, s.b)
        }
    } else if s.kind == sk_continue() {
        if (*tc).loop_depth == 0 {
            tc_emit(tc, "continue is only legal inside a loop", s.a, s.b)
        }
    } else if s.kind == sk_while() {
        ct2: int64 = infer_expr(tc, s.a)
        cn2: TyNode = ty_get((*tc).ty, ct2)
        cond2: ExprNode = vec_get((*a).exprs, s.a)
        if cn2.kind != tyk_bool() && cn2.kind != tyk_unknown() {
            tc_emit(tc, "while condition must be a bool", cond2.lo, cond2.hi)
        }
        loop_body_fixpoint(tc, s.b)
    } else if s.kind == sk_for() {
        it: int64 = infer_expr(tc, s.b)
        for_iter: ExprNode = vec_get((*a).exprs, s.b)
        // The AST type of the iterand, un-erased, recovered from a binding, a struct
        // field, or a call result. A struct field read of a container infers unknown
        // on the surface, so the container type is recovered here to classify it;
        // without this a field-held container reaches codegen unrewritten and crashes.
        iter_ast: int64 = iterand_ast_ty(tc, s.b)
        mut it_for_class: int64 = it
        if ty_get((*tc).ty, it).kind == tyk_unknown() && iter_ast >= 0 {
            it_for_class = tc_type(tc, iter_ast)
        }
        // Classify the two stdlib containers and record the class for the pre-mono
        // rewrite, and judge the two container-shape rejects (a by-value container,
        // two binders on a non-map). fc_teach means a teach reject already fired, so
        // the generic reject is suppressed to leave the one precise message.
        forclass: int64 = classify_container_for(tc, it_for_class, s.d != 0, for_iter.lo, for_iter.hi)
        if forclass == fc_vec() || forclass == fc_mapkeys() || forclass == fc_mappairs() {
            map_put((*tc).for_iters, id, forclass)
            // Record the iterand's AST type so the rewrite can annotate the container
            // binding: mono re-infers a plain name and a call result, but not a struct
            // field, so without the annotation vec_len/map_len cannot pin their args.
            if iter_ast >= 0 { map_put((*tc).for_iter_asts, id, iter_ast) }
        }
        // A for iterand must have an element: an array, a slice, a string (bytes as
        // chars), or one of the two classified std containers. A ground iterand with
        // no element and no container class is rejected here; a generic or unresolved
        // one stays permissive on the surface pass and the ground pass re-checks it
        // once mono makes it concrete. fc_teach already emitted its own precise
        // message, and a container class is lowered by the pre-mono rewrite, so both
        // suppress this generic reject. A types only rule, so both passes run it.
        itn: TyNode = ty_get((*tc).ty, it)
        mut ground: bool = itn.kind != tyk_unknown()
        if itn.kind == tyk_named() {
            gmap: *Map<string, int64> = (*tc).cur_generics
            if map_has(gmap, ty_name((*tc).ty, it)) { ground = false }
        }
        if ground && forclass == fc_none() {
            eln: TyNode = ty_get((*tc).ty, elem_of((*tc).ty, it))
            if eln.kind == tyk_unknown() {
                tc_emit(tc, cannot_iterate_msg(ty_render((*tc).ty, it)), for_iter.lo, for_iter.hi)
            }
        }
        push_scope(tc)
        reject_alloc_shadow(tc, ast_name(a, s.a), for_iter.lo, for_iter.hi)
        // The binder carries its element type, not the permissive wildcard the for
        // loop used to declare. For an array, slice, or string that is elem_of; for a
        // container it is the classifier's type argument, T for a vector and K for a
        // map's key. A width or type mismatch that used to slip through now raises
        // here, and a managed element makes the binder a borrow so freeing or moving
        // it rejects: the binder is a view into the iterand, which keeps its owner.
        // A container's element type is erased in the surface arena (Vector and Map
        // keep their args only in the AST), so the binder type is recovered from the
        // iterand's recorded AST type when the iterand is a binding: the *Vector<T>
        // element, or the *Map<K, V> key and value, lowered for the binder. That is
        // what lets a nested container loop over the binder classify. When the iterand
        // is not a recorded binding the binder falls back to the wildcard and the
        // ground pass recovers its width from the rewritten vec_get/map_key_at let.
        // Ownership is surface-only, so the container binder is a borrow by its class:
        // vec_get, map_key_at, and map_val_at are all non-owning views the container
        // still owns, so freeing or moving the binder rejects.
        mut elem: int64 = elem_of((*tc).ty, it)
        mut second: int64 = ty_unknown((*tc).ty)
        is_container: bool = forclass == fc_vec() || forclass == fc_mapkeys() || forclass == fc_mappairs()
        // Recover the binder element types from the iterand's AST type (a binding,
        // field, or call result), so a nested container loop over the binder classifies
        // and the binder width-checks on the surface. A recovered element that names a
        // struct's own type parameter is not ground here, so elem_ty_safe keeps the
        // binder a wildcard for it and the ground pass recovers the width.
        mut key_ast: int64 = -1
        mut val_ast: int64 = -1
        if is_container && iter_ast >= 0 {
            key_ast = container_elem_ast(a, iter_ast, 0)
            if forclass == fc_mappairs() { val_ast = container_elem_ast(a, iter_ast, 1) }
        }
        if key_ast >= 0 {
            kt: int64 = tc_type(tc, key_ast)
            if !elem_ty_safe(tc, kt) { key_ast = -1 } else { elem = kt }
        }
        if val_ast >= 0 {
            vt2: int64 = tc_type(tc, val_ast)
            if !elem_ty_safe(tc, vt2) { val_ast = -1 } else { second = vt2 }
        }
        declare(tc, ast_name(a, s.a), elem)
        if key_ast >= 0 { declare_binding_ast(tc, ast_name(a, s.a), key_ast) }
        set_esc(tc, ast_name(a, s.a), false, false)
        if is_container || is_managed_ty(tc, elem) { declare_own(tc, ast_name(a, s.a), own_borrow()) }
        // The optional second binder is the map-pair form's value, typed V when the
        // iterand's AST type is known and a borrow for the same reason the key is:
        // map_val_at hands back a view the map still owns. It is only reachable
        // through the map-pair rewrite; every other two-binder iterand is rejected
        // above, where it stays a plain wildcard so its uses still resolve.
        if s.d != 0 {
            declare(tc, ast_name(a, s.d - 1), second)
            if val_ast >= 0 { declare_binding_ast(tc, ast_name(a, s.d - 1), val_ast) }
            set_esc(tc, ast_name(a, s.d - 1), false, false)
            if forclass == fc_mappairs() || is_managed_ty(tc, second) { declare_own(tc, ast_name(a, s.d - 1), own_borrow()) }
        }
        if member_carries_view(tc, elem) {
            esc3: EscPair = value_escape(tc, s.b)
            set_esc(tc, ast_name(a, s.a), esc3.slice, esc3.closure)
        }
        if links_as_alias(tc, elem) {
            link_binding_aliases(tc, ast_name(a, s.a), s.b, false)
        }
        loop_body_fixpoint(tc, s.c)
        pop_scope(tc)
    } else if s.kind == sk_match() {
        check_match_stmt(tc, s.a, s.b, s.c)
    } else {
        e: ExprNode = vec_get((*a).exprs, s.a)
        if e.kind == xk_await() {
            el2: int64 = infer_await_operand(tc, e)
            if !compat((*tc).ty, ty_unit((*tc).ty), el2) {
                tc_emit(tc, "'await f' discards a value; bind it, as in v, e := await f", e.lo, e.hi)
            }
        } else {
            if e.kind == xk_call() {
                callee: ExprNode = vec_get((*a).exprs, e.a)
                if callee.kind == xk_ident() {
                    aname: string = ast_name(a, callee.a)
                    asyncs: *Map<string, int64> = (*tc).async_fns
                    if map_has(asyncs, aname) && !is_local(tc, aname) {
                        tc_emit(tc, future_never_awaited_msg(aname), e.lo, e.hi)
                    }
                }
            }
            et: int64 = infer_expr(tc, s.a)
            if ty_has_error(tc, et) {
                tc_emit(tc, "this expression's error result is ignored; bind it and handle the error with exists, check, or ignore", e.lo, e.hi)
            }
        }
    }
}

func future_never_awaited_msg(name: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "the future from '")
    sb_push(b, name)
    sb_push(b, "' is never awaited; bind it so it can be awaited or released")
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

func await_shape_msg(values: int64, n: int64) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "await destructures this future into ")
    sb_push_int(b, values)
    sb_push(b, " values, but ")
    sb_push_int(b, n)
    sb_push(b, " names are bound")
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

func check_let_await(tc: *TypeChecker, s: StmtNode, value: ExprNode) -> void {
    a: *Ast = (*tc).ast
    el: int64 = infer_await_operand(tc, value)
    nbinds: int64 = s.b
    en: TyNode = ty_get((*tc).ty, el)
    if en.kind == tyk_tuple() && nbinds > 1 {
        if en.len != nbinds {
            tc_emit(tc, await_shape_msg(en.len, nbinds), value.lo, value.hi)
        }
        mut i: int64 = 0
        while i < en.len && i < nbinds {
            b: BindNode = vec_get((*a).binds, vec_get((*a).kids, s.a + i))
            declare_await_bind(tc, b, (s.d & 1) != 0, vec_get((*(*tc).ty).kids, en.off + i), value.lo, value.hi)
            i = i + 1
        }
        while i < nbinds {
            b2: BindNode = vec_get((*a).binds, vec_get((*a).kids, s.a + i))
            declare(tc, ast_name(a, b2.name), ty_unknown((*tc).ty))
            i = i + 1
        }
    } else if nbinds == 2 {
        b0: BindNode = vec_get((*a).binds, vec_get((*a).kids, s.a))
        b1: BindNode = vec_get((*a).binds, vec_get((*a).kids, s.a + 1))
        declare_await_bind(tc, b0, (s.d & 1) != 0, el, value.lo, value.hi)
        declare_await_bind(tc, b1, (s.d & 1) != 0, ty_error((*tc).ty), value.lo, value.hi)
    } else if nbinds == 1 {
        b3: BindNode = vec_get((*a).binds, vec_get((*a).kids, s.a))
        declare_await_bind(tc, b3, (s.d & 1) != 0, el, value.lo, value.hi)
    } else {
        mut values: int64 = 2
        if en.kind == tyk_tuple() { values = en.len }
        tc_emit(tc, await_shape_msg(values, nbinds), value.lo, value.hi)
        mut j: int64 = 0
        while j < nbinds {
            bx: BindNode = vec_get((*a).binds, vec_get((*a).kids, s.a + j))
            declare(tc, ast_name(a, bx.name), ty_unknown((*tc).ty))
            j = j + 1
        }
    }
}

export func check_block_no_scope(tc: *TypeChecker, block_id: int64) -> void {
    a: *Ast = (*tc).ast
    b: BlockNode = vec_get((*a).blocks, block_id)
    mut i: int64 = 0
    while i < b.len {
        check_stmt(tc, vec_get((*a).kids, b.off + i))
        i = i + 1
    }
}

export func check_block(tc: *TypeChecker, block_id: int64) -> void {
    push_scope(tc)
    check_block_no_scope(tc, block_id)
    pop_scope(tc)
}
