/** loader: P4 import resolver, parser merger, privatizer, and namespace fold. It also
 *  keeps the per file record the import scoped rename in loadrename reads afterwards:
 *  which package each file belongs to, where its declarations and its arena nodes landed
 *  in the merged module, and which imports it wrote, since an import puts names in the
 *  scope of the file that wrote it and no other. */

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
@import source
@import lex
@import parse
@import parseitem
@import ast
@import diag
@import home
@import privatize
@import loadfold
@import loadns
@import manifest
@import loaderpkg
@import paradigm
@import loadcopy
@import loadrename
@import loadscope
@import loaddirs

/** The loader's whole output: module is the merged AST across the root and its
 *  imports, has_module gates the passes that read it, errors holds the load-stage
 *  diagnostics, files backs span rendering, and links and csources carry the C
 *  boundary directives the driver forwards to clang. */
export struct Program {
    module: *Ast,
    has_module: bool,
    errors: *Vector<LoadDiag>,
    files: *Vector<FileSrc>,
    links: *Vector<string>,
    csources: *Vector<string>,
}

struct ParsedFile {
    ok: bool,
    // Whether the file lexed and parsed into a valid AST, before the paradigm gate ran. A
    // gate error leaves the AST intact, so the loader can still walk the imports to collect
    // their own diagnostics (a reserved-name reject in an imported module, say) rather than
    // stopping at the root's gate error and masking them.
    struct_ok: bool,
    ast: *Ast,
    src: Source,
}

// One file's import list waiting to be walked. dir is the physical directory the
// importing file sits in, the base a dotted import resolves against; importer is that
// file's display path, the one a diagnostic names; and pkg is the package it belongs
// to, which decides which aliases its imports may spell.
struct WorkItem {
    imports: *Vector<string>,
    dir: string,
    importer: string,
    pkg: int64,
    // Which registered file wrote this import list. An import puts names in the scope of
    // the file that wrote it and no other, so the resolution has to find its way back to
    // that file's record rather than to the program as a whole.
    file_idx: int64,
}

// One resolved import: the physical file it names, the leaf symbol when the import
// named one, and the package the file belongs to, which decides the spelling it
// registers under. reported is set when the resolution failed with a fault of its own
// already recorded, so the caller does not add a second, vaguer one over it.
struct Resolved {
    ok: bool,
    file: string,
    has_leaf: bool,
    leaf: string,
    pkg: int64,
    reported: bool,
    // Whether the file was found in the standard library rather than in the tree of the
    // package that asked for it. The standard library carries package 0 like the project
    // does, and it has to be told apart from it: a std module a dependency imported for
    // itself is in the program, but it is not something the project reached for, so its
    // exports do not get to answer a bare name the project scoped to a dependency.
    from_std: bool,
}

func new_set() -> *Map<string, int64> {
    return alloc(map_new())
}

func copy_string(s: string) -> string {
    return substring(s, 0, str_len(s))
}

func has_slash(s: string) -> bool {
    mut i: int64 = 0
    while s[i] != 0 {
        if s[i] == 47 {
            return true
        }
        i++
    }
    return false
}

func dotted_to_rel(s: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    mut i: int64 = 0
    while s[i] != 0 {
        if s[i] == 46 {
            sb_push_char(b, 47)
        } else {
            sb_push_char(b, s[i])
        }
        i++
    }
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

func with_dusk_ext(rel: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, rel)
    sb_push(b, ".dusk")
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

func last_slash(s: string) -> int64 {
    mut last: int64 = -1
    mut i: int64 = 0
    while s[i] != 0 {
        if s[i] == 47 {
            last = i
        }
        i++
    }
    return last
}

func canon(path: string) -> string {
    real: string = source_realpath(path)
    if str_len(real) > 0 {
        return real
    }
    return copy_string(path)
}

func resolved_none() -> Resolved {
    return Resolved { ok: false, file: "", has_leaf: false, leaf: "", pkg: 0, reported: false, from_std: false }
}

// A failure whose own fault is already on the error list.
func resolved_reported() -> Resolved {
    return Resolved { ok: false, file: "", has_leaf: false, leaf: "", pkg: 0, reported: true, from_std: false }
}

// The same resolution, tagged with the package the file belongs to. A file found in
// the standard library belongs to no package and carries 0, the root, which is what
// keeps a stdlib name colliding with a project name the duplicate definition it has
// always been rather than a cross package collision.
func in_pkg(r: Resolved, pkg: int64) -> Resolved {
    if !r.ok {
        return r
    }
    return Resolved { ok: true, file: r.file, has_leaf: r.has_leaf, leaf: r.leaf, pkg: pkg, reported: false, from_std: r.from_std }
}

// The same resolution, marked as having come out of the standard library.
func in_std(r: Resolved) -> Resolved {
    if !r.ok {
        return r
    }
    return Resolved { ok: true, file: r.file, has_leaf: r.has_leaf, leaf: r.leaf, pkg: r.pkg, reported: false, from_std: true }
}

func resolve_in_one(rel: string, root: string) -> Resolved {
    file_rel: string = with_dusk_ext(rel)
    full: string = path_join(root, file_rel)
    if source_is_file(full) {
        return Resolved { ok: true, file: full, has_leaf: false, leaf: "", pkg: 0, reported: false, from_std: false }
    }
    idx: int64 = last_slash(rel)
    if idx >= 0 {
        parent_rel: string = substring(rel, 0, idx)
        leaf: string = substring(rel, idx + 1, str_len(rel))
        parent_file_rel: string = with_dusk_ext(parent_rel)
        parent: string = path_join(root, parent_file_rel)
        if source_is_file(parent) {
            return Resolved { ok: true, file: parent, has_leaf: true, leaf: leaf, pkg: 0, reported: false, from_std: false }
        }
    }
    return resolved_none()
}

// Resolves an import whose first segment is a dependency alias: a bare alias names that
// package's root file, and the rest of a dotted path walks under the root file's own
// directory by exactly the rules a local import follows, so the module form and the
// file plus leaf symbol form both work through an alias.
func resolve_dep(imp: string, alias: string, ps: *PkgSet, pkg: int64, importer: string, errors: *Vector<LoadDiag>) -> Resolved {
    di: int64 = pkg_dep_index(ps, pkg, alias, importer, errors)
    if di < 0 {
        return resolved_reported()
    }
    rootf: string = pkg_root_file(ps, di)
    rest: string = pkg_rest_segments(imp)
    if str_len(rest) == 0 {
        return Resolved { ok: true, file: copy_string(rootf), has_leaf: false, leaf: "", pkg: di, reported: false, from_std: false }
    }
    rel: string = dotted_to_rel(rest)
    r: Resolved = in_pkg(resolve_in_one(rel, dir_of(rootf)), di)
    if r.ok {
        return r
    }
    // One segment after the alias and no file of that name under the package: the
    // segment names a symbol the package's own root file exports, the same shape a
    // local import reads as a file plus a leaf. The export check that follows judges
    // it, so an alias naming nothing at all still fails, by name.
    if !has_slash(rel) {
        return Resolved { ok: true, file: copy_string(rootf), has_leaf: true, leaf: rest, pkg: di, reported: false, from_std: false }
    }
    return r
}

// Resolves one import against the directory of the file that wrote it. The order is
// deliberate: the quoted git form is refused first, then the two reserved first segments,
// then a dependency alias the importing package declared, and only then the local tree
// and the standard library. A reserved segment and an alias are answered before the tree
// is read, so what an import means follows from the manifest rather than from the shape
// of the directory the importing file happens to sit in.
func resolve(imp: string, base: string, stdlib: string, ps: *PkgSet, pkg: int64, importer: string, errors: *Vector<LoadDiag>) -> Resolved {
    if has_slash(imp) {
        // An import carrying a path named a git repository before 1.14.0 and resolved
        // against a machine wide clone cache with no reference and no lock behind it.
        // The manifest is where a dependency is written down now, so the form is refused
        // wherever it is written, inside a project and outside one alike, rather than
        // answering out of a cache nothing fills.
        vec_push(errors, pkg_url_import_fault(importer, imp))
        return resolved_reported()
    }
    seg: string = pkg_first_segment(imp)
    rel: string = dotted_to_rel(imp)
    if str_eq(seg, "std") {
        // Reserved: the standard library answers an import under std whatever the tree
        // holds, and a local directory that would have shadowed it is named instead of
        // quietly winning.
        shadow: Resolved = resolve_in_one(rel, base)
        if shadow.ok {
            vec_push(errors, pkg_std_shadow_fault(importer))
            return resolved_reported()
        }
        return in_std(in_pkg(resolve_in_one(rel, stdlib), 0))
    }
    if str_eq(seg, dawn_modules_dir()) {
        vec_push(errors, pkg_dawn_modules_fault(importer, imp))
        return resolved_reported()
    }
    if pkg_is_alias(ps, pkg, seg) {
        return resolve_dep(imp, seg, ps, pkg, importer, errors)
    }
    r: Resolved = in_pkg(resolve_in_one(rel, base), pkg)
    if r.ok {
        return r
    }
    return in_std(in_pkg(resolve_in_one(rel, stdlib), 0))
}

func located_diag(path: string, src: string, n: int64, t: *LineTable, e: Located) -> LoadDiag {
    return load_diag_span(path, src, n, t, e.lo, e.hi, e.msg)
}

func read_error(path: string, e: error) -> LoadDiag {
    if !e.exists() {
        return load_diag_plain(path, "")
    }
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "read error: ")
    sb_push(b, e.toString())
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return load_diag_plain(path, out)
}

// Reads and parses one file. path is where the file physically is, the only thing
// opened here; disp is the spelling every diagnostic raised against it carries, which
// for a dependency's file is its manifest relative name rather than wherever the
// checkout landed on this machine.
func parse_file(path: string, disp: string, errors: *Vector<LoadDiag>) -> ParsedFile {
    s, e := source_load(path)
    if e.exists() {
        vec_push(errors, read_error(disp, e))
        return ParsedFile { ok: false, struct_ok: false, ast: ast_new(), src: s }
    }
    lx: *Lexer = lex(s.text, s.len)
    p: *Parser = parser_new(lx_tokens(lx), s.text, s.len)
    p_set_docs(p, lx_docs(lx))
    a: *Ast = parse_module(p)
    mut ok: bool = true
    // One line table for this file, shared by every diagnostic raised against it,
    // so a file that raises thousands of them locates them all against one pass
    // over the source. It stays unbuilt unless something renders.
    t: *LineTable = line_table_new()
    lex_errs: *Vector<Located> = lx_errors(lx)
    mut i: int64 = 0
    while i < vec_len(lex_errs) {
        vec_push(errors, located_diag(disp, s.text, s.len, t, vec_get(lex_errs, i)))
        ok = false
        i++
    }
    parse_errs: *Vector<Located> = p_errors(p)
    mut j: int64 = 0
    while j < vec_len(parse_errs) {
        vec_push(errors, located_diag(disp, s.text, s.len, t, vec_get(parse_errs, j)))
        ok = false
        j++
    }
    struct_ok: bool = ok
    if ok {
        paradigm_errs: *Vector<SpanDiagnostic> = paradigm_check(a)
        for sd in paradigm_errs {
            vec_push(errors, load_diag_span(disp, s.text, s.len, t, sd.lo, sd.hi, sd.msg))
            ok = false
        }
    }
    return ParsedFile { ok: ok, struct_ok: struct_ok, ast: a, src: s }
}

func ast_import_strings(a: *Ast) -> *Vector<string> {
    out: *Vector<string> = alloc(vec_new())
    imps: *Vector<int64> = (*a).imports
    mut i: int64 = 0
    while i < vec_len(imps) {
        vec_push(out, ast_name(a, vec_get(imps, i)))
        i++
    }
    return out
}

// Adds one file to the program's span table under the spelling it is to be named by.
// path here is the display path: it backs every rendered diagnostic and every fault
// location the emitted IR carries, so it is the manifest relative name for a
// dependency's file and the resolved path as written for everything else.
// Every item level span in one file's arenas, moved onto the program wide line the merged
// module counts from. load_shift_module moves what a block holds, which is every span a
// statement or an expression carries; a declaration's own span sits outside every block and
// so needs its own pass. Without it a diagnostic keyed on a declaration in an imported
// file, a reserved builtin name taken by a function among them, carried a file local offset
// into a program wide table and caretted whatever the root file happened to have there.
// Every node in these arenas belongs to this one file, so each is walked once by index
// rather than through the items, which is both simpler and complete.
func shift_item_spans(a: *Ast, base: int64) -> void {
    if base == 0 {
        return
    }
    funcs: *Vector<FuncNode> = (*a).funcs
    mut i: int64 = 0
    while i < vec_len(funcs) {
        mut f: FuncNode = vec_get(funcs, i)
        f.lo += base
        f.hi += base
        vec_set(funcs, i, f)
        i++
    }
    structs: *Vector<StructNode> = (*a).structs
    mut j: int64 = 0
    while j < vec_len(structs) {
        mut st: StructNode = vec_get(structs, j)
        st.lo += base
        st.hi += base
        vec_set(structs, j, st)
        j++
    }
    enums: *Vector<EnumNode> = (*a).enums
    mut k: int64 = 0
    while k < vec_len(enums) {
        mut en: EnumNode = vec_get(enums, k)
        en.lo += base
        en.hi += base
        vec_set(enums, k, en)
        k++
    }
    ifaces: *Vector<InterfaceNode> = (*a).interfaces
    mut m: int64 = 0
    while m < vec_len(ifaces) {
        mut ifc: InterfaceNode = vec_get(ifaces, m)
        ifc.lo += base
        ifc.hi += base
        vec_set(ifaces, m, ifc)
        m++
    }
    impls: *Vector<ImplNode> = (*a).impls
    mut n: int64 = 0
    while n < vec_len(impls) {
        mut im: ImplNode = vec_get(impls, n)
        im.lo += base
        im.hi += base
        vec_set(impls, n, im)
        n++
    }
    foreigns: *Vector<ForeignNode> = (*a).foreigns
    mut q: int64 = 0
    while q < vec_len(foreigns) {
        mut fb: ForeignNode = vec_get(foreigns, q)
        fb.lo += base
        fb.hi += base
        vec_set(foreigns, q, fb)
        q++
    }
    sigs: *Vector<MethodSigNode> = (*a).method_sigs
    mut t: int64 = 0
    while t < vec_len(sigs) {
        mut ms: MethodSigNode = vec_get(sigs, t)
        ms.lo += base
        ms.hi += base
        vec_set(sigs, t, ms)
        t++
    }
    ffs: *Vector<ForeignFuncNode> = (*a).foreign_funcs
    mut u: int64 = 0
    while u < vec_len(ffs) {
        mut ff: ForeignFuncNode = vec_get(ffs, u)
        ff.lo += base
        ff.hi += base
        vec_set(ffs, u, ff)
        u++
    }
}

func register_file(files: *Vector<FileSrc>, base: int64, path: string, src: Source, a: *Ast) -> int64 {
    load_shift_module(a, base)
    shift_item_spans(a, base)
    vec_push(files, FileSrc { path: path, base: base, src: src.text, len: src.len, lines: line_table_new() })
    return base + src.len + 1
}

func cannot_resolve(importer: string, imp: string) -> LoadDiag {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "cannot resolve import '")
    sb_push(b, imp)
    sb_push_char(b, 39)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return load_diag_plain(importer, out)
}

func leaf_error(importer: string, imp: string, leaf: string) -> LoadDiag {
    mut modpath: string = imp
    dot: int64 = load_last_dot(imp)
    slash: int64 = last_slash(imp)
    mut cut: int64 = dot
    if slash > cut {
        cut = slash
    }
    if cut >= 0 {
        modpath = substring(imp, 0, cut)
    }
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "import '")
    sb_push(b, imp)
    sb_push(b, "' names '")
    sb_push(b, leaf)
    sb_push(b, "', but '")
    sb_push(b, modpath)
    sb_push(b, "' exports no such symbol")
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return load_diag_plain(importer, out)
}

func pop_work(work: *Vector<WorkItem>) -> WorkItem {
    idx: int64 = vec_len(work) - 1
    w: WorkItem = vec_get(work, idx)
    (*work).len = idx
    return w
}

func push_work(work: *Vector<WorkItem>, imports: *Vector<string>, dir: string, importer: string, pkg: int64, file_idx: int64) -> void {
    vec_push(work, WorkItem { imports: imports, dir: dir, importer: importer, pkg: pkg, file_idx: file_idx })
}

// The dependency aliases a package's own manifest declares. A name some package exports
// tells the file that spelled it which package to import, and this is what tells that
// apart from a package the file's own manifest never asked for, where there is a @require
// to write before there is an import to add.
func require_aliases(ps: *PkgSet, idx: int64, alias_file: *Map<string, string>, alias_line: *Map<string, int64>) -> *Map<string, int64> {
    out: *Map<string, int64> = new_set()
    m: *Manifest = pkg_manifest(ps, idx)
    rv: *Vector<*Require> = (*m).requires
    for rq in rv {
        key: string = copy_string((*rq).alias)
        map_put(out, key, 1)
        // Where the alias was chosen, so a fault about the alias itself is raised at the
        // line that wrote it rather than at some file it happens to collide with. The
        // manifest is released at the end of the load and the diagnostic outlives it, so
        // the display path travels as its own copy.
        if !map_has(alias_file, key) {
            map_put(alias_file, key, pkg_manifest_display(ps, idx))
            map_put(alias_line, key, (*rq).line)
        }
    }
    return out
}

func empty_program(errors: *Vector<LoadDiag>, files: *Vector<FileSrc>, links: *Vector<string>, csources: *Vector<string>) -> Program {
    return Program { module: ast_new(), has_module: false, errors: errors, files: files, links: links, csources: csources }
}

/** The P4 loader entry point: lexes and parses the root, recursively loads every
 *  import, privatizes and paradigm-gates each file, and merges them into one flat
 *  module, the single seam the driver and every dump command reach the surface
 *  module through.
 *  @param root_path the root source file to load from
 *  @param prog the program name used in diagnostics
 *  @return the merged Program, with has_module false and errors populated on failure */
export func load(root_path: string, prog: string) -> Program {
    return load_project(root_path, prog, false)
}

/** The same load, told whether the root file was taken from a package.dawn rather than
 *  named on the command line. That is the one shape where the project's own files
 *  register under a manifest relative spelling: a command with no file argument left no
 *  spelling to preserve, so the manifest's is used and two checkouts of one project at
 *  different paths emit identical bytes. A command that names a file keeps that file's
 *  spelling exactly, which is what the stage ladder compares on. */
export func load_project(root_path: string, prog: string, from_manifest: bool) -> Program {
    errors: *Vector<LoadDiag> = alloc(vec_new())
    files: *Vector<FileSrc> = alloc(vec_new())
    links: *Vector<string> = alloc(vec_new())
    csources: *Vector<string> = alloc(vec_new())
    seen_links: *Map<string, int64> = new_set()
    seen_csources: *Map<string, int64> = new_set()
    stdlib: string = path_join(dusk_home_for(prog, "lib"), "lib")
    visited: *Map<string, int64> = new_set()
    exports: *Map<string, *Map<string, int64>> = alloc(map_new())
    namespaces: *Map<string, int64> = new_set()
    ns_exports: *Map<string, *Map<string, int64>> = alloc(map_new())
    // Which package first exported each name, and the file it came from, so a name
    // reaching the merged module from two packages is named against both files rather
    // than surfacing later as a duplicate definition with no position at all.
    export_pkg: *Map<string, int64> = new_set()
    export_file: *Map<string, string> = alloc(map_new())
    // One record per registered file, in registration order, and the renamed exports each
    // physical file contributed. Together they are what the import scoped rename reads
    // after the worklist empties: which names a file may spell bare, and where in the
    // merged arenas its own nodes live.
    metas: *Vector<*FileMeta> = alloc(vec_new())
    alias_file: *Map<string, string> = alloc(map_new())
    alias_line: *Map<string, int64> = new_set()
    movings: *Map<string, *Map<string, int64>> = alloc(map_new())
    fixeds: *Map<string, *Map<string, int64>> = alloc(map_new())
    mut base: int64 = 0

    // The project governing this compile: the package.dawn found by walking up from
    // the root source file, with its lock read and checked against it. A root file with
    // no manifest above it resolves exactly as it did before 1.14.0.
    ps: *PkgSet = pkgset_discover(root_path, from_manifest, errors)
    root_disp: string = pkg_display_path(ps, 0, root_path)

    root: ParsedFile = parse_file(root_path, root_disp, errors)
    // A structurally broken root (a lex or parse error) cannot be walked further. A root
    // that only failed the paradigm gate keeps a valid AST, so the walk continues to gate
    // its imports too: an imported module that reserves a builtin name surfaces its own
    // reject rather than being masked by the root's gate error. The check pipeline reports
    // every collected load diagnostic and stops before resolve, so no pass runs on the
    // gate-violating module.
    if !root.struct_ok {
        pkgset_free(ps)
        free(ps)
        return empty_program(errors, files, links, csources)
    }
    map_put(visited, canon(root_path), 1)
    base = register_file(files, base, root_disp, root.src, root.ast)
    collect_pkg_directives(ps, 0, links, csources, seen_links, seen_csources, errors)
    collect_directives(root.src.text, root.src.len, root_path, root_disp, errors, links, csources, seen_links, seen_csources)
    // The root belongs to the project, which is one package with the standard library as
    // far as scoping goes, so it renames nothing and every name it exports stays bare.
    pkg_check_exports(export_file, export_pkg, load_exported_names(root.ast), root_disp, 0, errors)
    vec_push(metas, file_meta(root_disp, "", "", false, require_aliases(ps, 0, alias_file, alias_line), new_set(), new_set(), 0, vec_len((*root.ast).items), 0, vec_len((*root.ast).exprs), 0, vec_len((*root.ast).types)))

    work: *Vector<WorkItem> = alloc(vec_new())
    push_work(work, ast_import_strings(root.ast), dir_of(root_path), root_disp, 0, 0)

    while vec_len(work) > 0 {
        w: WorkItem = pop_work(work)
        imps: *Vector<string> = w.imports
        for imp in imps {
            r: Resolved = resolve(imp, w.dir, stdlib, ps, w.pkg, w.importer, errors)
            if !r.ok {
                // A resolution that failed with a fault of its own, a checkout that is
                // not there or an import through a reserved name, has already said what
                // is wrong; the general fault would only bury it.
                if !r.reported {
                    vec_push(errors, cannot_resolve(w.importer, imp))
                }
            } else {
                // An import carrying a path never resolves, so every import that
                // reaches here names a module and contributes that namespace.
                mod_ns: string = load_module_namespace(imp, r.has_leaf)
                load_add_namespace(namespaces, mod_ns)

                // The physical path is what the load dedups on, so one file reached
                // two ways is read once however it was spelled; the display path is
                // what everything a person or the IR sees is written with.
                cfile: string = canon(r.file)
                if !map_has(visited, cfile) {
                    map_put(visited, cfile, 1)
                    disp: string = pkg_display_path(ps, r.pkg, r.file)
                    parsed: ParsedFile = parse_file(r.file, disp, errors)
                    if parsed.ok {
                        ex: *Map<string, int64> = load_exported_names(parsed.ast)
                        map_put(exports, cfile, ex)
                        // The package suffix a dependency's exports take, empty for the
                        // project and the standard library. What it moves is one half of
                        // the export split; the other half keeps its bare spelling and so
                        // is still what two packages cannot both export.
                        esuf: string = pkg_alias(ps, r.pkg)
                        moving, fixed := load_export_split(parsed.ast)
                        map_put(fixeds, cfile, fixed)
                        if str_len(esuf) > 0 {
                            map_put(movings, cfile, moving)
                            pkg_check_exports(export_file, export_pkg, fixed, disp, r.pkg, errors)
                        } else {
                            map_put(movings, cfile, new_set())
                            pkg_check_exports(export_file, export_pkg, ex, disp, r.pkg, errors)
                        }
                        idx: int64 = vec_len(files)
                        suffix: string = suffix_for(r.file, idx)
                        privatize(parsed.ast, suffix, esuf)
                        push_work(work, ast_import_strings(parsed.ast), dir_of(r.file), disp, r.pkg, idx)
                        base = register_file(files, base, disp, parsed.src, parsed.ast)
                        collect_pkg_directives(ps, r.pkg, links, csources, seen_links, seen_csources, errors)
                        collect_directives(parsed.src.text, parsed.src.len, r.file, disp, errors, links, csources, seen_links, seen_csources)
                        items_lo: int64 = vec_len((*root.ast).items)
                        exprs_lo: int64 = vec_len((*root.ast).exprs)
                        types_lo: int64 = vec_len((*root.ast).types)
                        load_append_items(root.ast, parsed.ast)
                        none_mv: *Map<string, int64> = new_set()
                        none_fx: *Map<string, int64> = new_set()
                        vec_push(metas, file_meta(disp, esuf, suffix, r.from_std, require_aliases(ps, r.pkg, alias_file, alias_line), unwrap_or(map_get(movings, cfile), none_mv), unwrap_or(map_get(fixeds, cfile), none_fx), items_lo, vec_len((*root.ast).items), exprs_lo, vec_len((*root.ast).exprs), types_lo, vec_len((*root.ast).types)))
                    }
                }

                // The import is recorded against the file that wrote it however the
                // resolution went, since a file reached a second time is still in the
                // scope of every file that named it.
                empty_mv: *Map<string, int64> = new_set()
                empty_fx: *Map<string, int64> = new_set()
                file_meta_import(vec_get(metas, w.file_idx), import_res(mod_ns, pkg_alias(ps, r.pkg), r.has_leaf, r.leaf, unwrap_or(map_get(movings, cfile), empty_mv), unwrap_or(map_get(fixeds, cfile), empty_fx)))

                if map_has(exports, cfile) {
                    empty: *Map<string, int64> = new_set()
                    ex2: *Map<string, int64> = unwrap_or(map_get(exports, cfile), empty)
                    load_extend_ns_exports(ns_exports, mod_ns, ex2)
                }
                if r.has_leaf {
                    if map_has(exports, cfile) {
                        empty2: *Map<string, int64> = new_set()
                        ex3: *Map<string, int64> = unwrap_or(map_get(exports, cfile), empty2)
                        if !map_has(ex3, r.leaf) {
                            vec_push(errors, leaf_error(w.importer, imp, r.leaf))
                        }
                    }
                }
            }
        }
    }

    load_check_alias_clash(metas, alias_file, alias_line, errors)
    load_rename_module(root.ast, metas, namespaces, ns_exports, files, errors)
    // Every manifest and lock the load read is released here, after the last question
    // asked of them. What outlives them was copied on the way out: a display path, a
    // resolved file, a link value, a rendered fault.
    pkgset_free(ps)
    free(ps)
    return Program { module: root.ast, has_module: true, errors: errors, files: files, links: links, csources: csources }
}
