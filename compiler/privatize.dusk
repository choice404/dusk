/** privatize: top level name isolation for loaded imports. Two renames run through the
 *  one walker here. The first is per file and as old as imports: a name a file does not
 *  export takes a suffix derived from that file, so a bare call in one file cannot reach
 *  another file's private helper. The second is per package and new in 1.14.1: a
 *  dependency's exported names take the alias its importer pinned, so two packages may
 *  each export one name and a file reaches an export only through its own imports. The
 *  loader drives both, the second in two halves, the declarations and the declaring
 *  file's own references here and every other file's references in loadrename. */

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
@import ast
@import diag
@import loadns
@import renscope

func name_with_suffix(name: string, suffix: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, name)
    sb_push(b, "__")
    sb_push(b, suffix)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}

func add_private(rnames: *Map<string, int64>, a: *Ast, name: int64, suffix: string) -> void {
    n: string = ast_name(a, name)
    nn: string = name_with_suffix(n, suffix)
    nid: int64 = intern_owned((*a).interner, nn)
    map_put(rnames, n, nid)
}

func add_name_kids(a: *Ast, s: *Map<string, int64>, off: int64, len: int64) -> void {
    mut i: int64 = 0
    while i < len {
        ren_set_add(s, ast_name(a, vec_get((*a).kids, off + i)))
        i = i + 1
    }
}

func ren_type_list(r: *Renamer, off: int64, len: int64, skip: *Map<string, int64>) -> void {
    mut i: int64 = 0
    while i < len {
        ren_ty(r, vec_get((*(*r).ast).kids, off + i), skip)
        i = i + 1
    }
}

func ren_ty(r: *Renamer, id: int64, skip: *Map<string, int64>) -> void {
    if id < 0 {
        return
    }
    a: *Ast = (*r).ast
    tys: *Vector<TypeNode> = (*a).types
    mut t: TypeNode = vec_get(tys, id)
    if t.kind == tk_named() {
        ren_mark_type(r, id)
        n: string = ast_name(a, t.a)
        if !ren_set_has(skip, n) {
            t.a = ren_maybe_rename_id(r, t.a)
        }
        ren_type_list(r, t.b, t.c, skip)
    } else if t.kind == tk_ptr() {
        ren_ty(r, t.a, skip)
    } else if t.kind == tk_rawptr() {
        ren_ty(r, t.a, skip)
    } else if t.kind == tk_slice() {
        ren_ty(r, t.a, skip)
    } else if t.kind == tk_array() {
        ren_ty(r, t.a, skip)
    } else if t.kind == tk_tuple() {
        ren_type_list(r, t.a, t.b, skip)
    } else if t.kind == tk_func() {
        ren_type_list(r, t.a, t.b, skip)
        ren_ty(r, t.c, skip)
    } else if t.kind == tk_collector() {
        ren_ty(r, t.a, skip)
    }
    vec_set(tys, id, t)
}

func ren_param(r: *Renamer, id: int64, skip: *Map<string, int64>) -> ParamNode {
    a: *Ast = (*r).ast
    params: *Vector<ParamNode> = (*a).params
    p: ParamNode = vec_get(params, id)
    ren_ty(r, p.ty, skip)
    return p
}

func ren_func(r: *Renamer, f: FuncNode) -> FuncNode {
    return ren_func_in(r, f, false)
}

// One function's body walked with its own names bound. is_method binds the implicit
// receiver, which the fold has always bound and this walk had not: `self` is an ordinary
// identifier by the time it reaches here, so left free it read as a top level name and a
// rename map holding one would have moved it.
func ren_func_in(r: *Renamer, f: FuncNode, is_method: bool) -> FuncNode {
    a: *Ast = (*r).ast
    skip: *Map<string, int64> = ren_new_set()
    add_name_kids(a, skip, f.generics_off, f.generics_len)
    bound: *Vector<*Map<string, int64>> = alloc(vec_new())
    ren_push_scope(bound)
    if is_method {
        ren_set_add(ren_last_scope(bound), "self")
    }
    mut i: int64 = 0
    while i < f.params_len {
        pid: int64 = vec_get((*a).kids, f.params_off + i)
        p: ParamNode = ren_param(r, pid, skip)
        ren_add_bound(r, bound, p.name)
        i = i + 1
    }
    ren_ty(r, f.ret, skip)
    ren_block(r, f.body, skip, bound)
    return f
}

func ren_field_list(r: *Renamer, off: int64, len: int64, skip: *Map<string, int64>) -> void {
    a: *Ast = (*r).ast
    mut i: int64 = 0
    while i < len {
        fid: int64 = vec_get((*a).kids, off + i)
        fl: FieldNode = vec_get((*a).fields, fid)
        ren_ty(r, fl.ty, skip)
        i = i + 1
    }
}

func ren_method_sig_list(r: *Renamer, off: int64, len: int64, skip: *Map<string, int64>) -> void {
    a: *Ast = (*r).ast
    mut i: int64 = 0
    while i < len {
        mid: int64 = vec_get((*a).kids, off + i)
        m: MethodSigNode = vec_get((*a).method_sigs, mid)
        mut j: int64 = 0
        while j < m.params_len {
            pid: int64 = vec_get((*a).kids, m.params_off + j)
            p: ParamNode = vec_get((*a).params, pid)
            ren_ty(r, p.ty, skip)
            j = j + 1
        }
        ren_ty(r, m.ret, skip)
        i = i + 1
    }
}

/** Renames one top level item and everything under it: the declaration's own name where
 *  the map moves it, every type it mentions, and every free name its bodies spell. */
export func ren_item(r: *Renamer, it: ItemNode) -> void {
    a: *Ast = (*r).ast
    if it.kind == ik_func() {
        funcs: *Vector<FuncNode> = (*a).funcs
        mut f: FuncNode = vec_get(funcs, it.id)
        f.name = ren_maybe_rename_id(r, f.name)
        f = ren_func(r, f)
        vec_set(funcs, it.id, f)
    } else if it.kind == ik_struct() {
        structs: *Vector<StructNode> = (*a).structs
        mut s: StructNode = vec_get(structs, it.id)
        s.name = ren_maybe_rename_id(r, s.name)
        skip: *Map<string, int64> = ren_new_set()
        add_name_kids(a, skip, s.generics_off, s.generics_len)
        ren_field_list(r, s.fields_off, s.fields_len, skip)
        vec_set(structs, it.id, s)
    } else if it.kind == ik_enum() {
        enums: *Vector<EnumNode> = (*a).enums
        mut e: EnumNode = vec_get(enums, it.id)
        e.name = ren_maybe_rename_id(r, e.name)
        skip2: *Map<string, int64> = ren_new_set()
        add_name_kids(a, skip2, e.generics_off, e.generics_len)
        mut i: int64 = 0
        while i < e.variants_len {
            vid: int64 = vec_get((*a).kids, e.variants_off + i)
            v: VariantNode = vec_get((*a).variants, vid)
            ren_field_list(r, v.fields_off, v.fields_len, skip2)
            i = i + 1
        }
        vec_set(enums, it.id, e)
    } else if it.kind == ik_interface() {
        interfaces: *Vector<InterfaceNode> = (*a).interfaces
        mut iface: InterfaceNode = vec_get(interfaces, it.id)
        iface.name = ren_maybe_rename_id(r, iface.name)
        skip3: *Map<string, int64> = ren_new_set()
        add_name_kids(a, skip3, iface.generics_off, iface.generics_len)
        ren_method_sig_list(r, iface.methods_off, iface.methods_len, skip3)
        vec_set(interfaces, it.id, iface)
    } else if it.kind == ik_impl() {
        impls: *Vector<ImplNode> = (*a).impls
        mut im: ImplNode = vec_get(impls, it.id)
        if im.iface >= 0 {
            im.iface = ren_maybe_rename_id(r, im.iface)
        }
        im.ty = ren_maybe_rename_id(r, im.ty)
        mut j: int64 = 0
        while j < im.methods_len {
            mid: int64 = vec_get((*a).kids, im.methods_off + j)
            funcs2: *Vector<FuncNode> = (*a).funcs
            mf: FuncNode = ren_func_in(r, vec_get(funcs2, mid), true)
            vec_set(funcs2, mid, mf)
            j = j + 1
        }
        vec_set(impls, it.id, im)
    } else if it.kind == ik_foreign() {
        // A foreign function's own name never moves: it is the C symbol the linker
        // resolves, and a suffix on it would name nothing. Its parameter and return
        // types are ordinary dusk types though, so a signature naming a struct this
        // file kept private, or one an imported package exported, has to follow that
        // type wherever it went. Left unwalked the declaration kept the old spelling
        // and the type it named was gone, so the block failed with an unknown type.
        foreigns: *Vector<ForeignNode> = (*a).foreigns
        fb: ForeignNode = vec_get(foreigns, it.id)
        skip4: *Map<string, int64> = ren_new_set()
        mut k: int64 = 0
        while k < fb.funcs_len {
            ff: ForeignFuncNode = vec_get((*a).foreign_funcs, vec_get((*a).kids, fb.funcs_off + k))
            mut q: int64 = 0
            while q < ff.params_len {
                pp: ParamNode = vec_get((*a).params, vec_get((*a).kids, ff.params_off + q))
                ren_ty(r, pp.ty, skip4)
                q = q + 1
            }
            ren_ty(r, ff.ret, skip4)
            k = k + 1
        }
    }
}

func ren_block(r: *Renamer, id: int64, skip: *Map<string, int64>, bound: *Vector<*Map<string, int64>>) -> void {
    ren_push_scope(bound)
    a: *Ast = (*r).ast
    b: BlockNode = vec_get((*a).blocks, id)
    mut i: int64 = 0
    while i < b.len {
        ren_stmt(r, vec_get((*a).kids, b.off + i), skip, bound)
        i = i + 1
    }
    ren_pop_scope(bound)
}

func ren_bind_list_after_value(r: *Renamer, off: int64, len: int64, skip: *Map<string, int64>, bound: *Vector<*Map<string, int64>>) -> void {
    a: *Ast = (*r).ast
    mut i: int64 = 0
    while i < len {
        bid: int64 = vec_get((*a).kids, off + i)
        b: BindNode = vec_get((*a).binds, bid)
        if b.ty >= 0 {
            ren_ty(r, b.ty, skip)
        }
        ren_add_bound(r, bound, b.name)
        i = i + 1
    }
}

func ren_stmt(r: *Renamer, id: int64, skip: *Map<string, int64>, bound: *Vector<*Map<string, int64>>) -> void {
    a: *Ast = (*r).ast
    s: StmtNode = vec_get((*a).stmts, id)
    if s.kind == sk_let() {
        ren_expr(r, s.c, skip, bound)
        ren_bind_list_after_value(r, s.a, s.b, skip, bound)
    } else if s.kind == sk_assign() {
        ren_expr(r, s.a, skip, bound)
        ren_expr(r, s.b, skip, bound)
    } else if s.kind == sk_assign_op() {
        ren_expr(r, s.b, skip, bound)
        ren_expr(r, s.c, skip, bound)
    } else if s.kind == sk_return() {
        if s.a >= 0 {
            ren_expr(r, s.a, skip, bound)
        }
    } else if s.kind == sk_defer() {
        ren_expr(r, s.a, skip, bound)
    } else if s.kind == sk_if() {
        ren_expr(r, s.a, skip, bound)
        ren_block(r, s.b, skip, bound)
        if s.c >= 0 {
            ren_block(r, s.c, skip, bound)
        }
    } else if s.kind == sk_break() || s.kind == sk_continue() {
    } else if s.kind == sk_while() {
        ren_expr(r, s.a, skip, bound)
        ren_block(r, s.b, skip, bound)
    } else if s.kind == sk_for() {
        ren_expr(r, s.b, skip, bound)
        ren_push_scope(bound)
        ren_add_bound(r, bound, s.a)
        // `for k, v in m` binds a second name, the interned name plus one in d, and
        // the privatizer sees that form because it runs before the for rewrite. Left
        // out of the loop's scope the binder read as a free name, so a body that calls
        // it, `v()` over a map of closures, was renamed to an imported file's private
        // top level of the same name and called that instead: the wrong function,
        // silently, with no diagnostic anywhere.
        if s.d != 0 { ren_add_bound(r, bound, s.d - 1) }
        ren_block(r, s.c, skip, bound)
        ren_pop_scope(bound)
    } else if s.kind == sk_match() {
        ren_match_value(r, s.a, s.b, s.c, skip, bound)
    } else {
        ren_expr(r, s.a, skip, bound)
    }
}

func bind_pattern(r: *Renamer, id: int64, bound: *Vector<*Map<string, int64>>) -> void {
    a: *Ast = (*r).ast
    p: PatternNode = vec_get((*a).patterns, id)
    if p.kind == pk_ident() {
        ren_add_bound(r, bound, p.a)
    } else if p.kind == pk_variant() {
        mut i: int64 = 0
        while i < p.c {
            ren_add_bound(r, bound, vec_get((*a).kids, p.b + i))
            i = i + 1
        }
    }
}

func ren_match_value(r: *Renamer, scrut: int64, off: int64, len: int64, skip: *Map<string, int64>, bound: *Vector<*Map<string, int64>>) -> void {
    a: *Ast = (*r).ast
    ren_expr(r, scrut, skip, bound)
    mut i: int64 = 0
    while i < len {
        aid: int64 = vec_get((*a).kids, off + i)
        arm: ArmNode = vec_get((*a).arms, aid)
        ren_push_scope(bound)
        bind_pattern(r, arm.pat, bound)
        ren_block(r, arm.body, skip, bound)
        ren_pop_scope(bound)
        i = i + 1
    }
}

func ren_expr_list(r: *Renamer, off: int64, len: int64, skip: *Map<string, int64>, bound: *Vector<*Map<string, int64>>) -> void {
    a: *Ast = (*r).ast
    mut i: int64 = 0
    while i < len {
        ren_expr(r, vec_get((*a).kids, off + i), skip, bound)
        i = i + 1
    }
}

func ren_field_expr_pairs(r: *Renamer, off: int64, len: int64, skip: *Map<string, int64>, bound: *Vector<*Map<string, int64>>) -> void {
    a: *Ast = (*r).ast
    mut i: int64 = 0
    while i < len {
        ren_expr(r, vec_get((*a).kids, off + i + 1), skip, bound)
        i = i + 2
    }
}

func ren_lambda(r: *Renamer, e: ExprNode, skip: *Map<string, int64>, bound: *Vector<*Map<string, int64>>) -> void {
    a: *Ast = (*r).ast
    ren_push_scope(bound)
    mut i: int64 = 0
    while i < e.b {
        pid: int64 = vec_get((*a).kids, e.a + i)
        p: ParamNode = vec_get((*a).params, pid)
        ren_ty(r, p.ty, skip)
        ren_add_bound(r, bound, p.name)
        i = i + 1
    }
    ren_ty(r, e.c, skip)
    ren_block(r, e.d, skip, bound)
    ren_pop_scope(bound)
}

// A do block's steps run top to bottom and each binder is in scope only for the steps
// after it, exactly as the desugar's nested continuations lay them out. Binding the whole
// block first was an over-approximation that read `value <- value()` as a step calling its
// own binder: the initializer went unrenamed and reached whatever else in the merged
// module answered to that name, silently.
func ren_do(r: *Renamer, e: ExprNode, skip: *Map<string, int64>, bound: *Vector<*Map<string, int64>>) -> void {
    a: *Ast = (*r).ast
    ren_push_scope(bound)
    mut i: int64 = 0
    while i < e.c {
        did: int64 = vec_get((*a).kids, e.b + i)
        d: DoBindNode = vec_get((*a).do_binds, did)
        ren_expr(r, d.expr, skip, bound)
        if d.name >= 0 {
            ren_add_bound(r, bound, d.name)
        }
        i = i + 1
    }
    ren_pop_scope(bound)
}

func ren_expr(r: *Renamer, id: int64, skip: *Map<string, int64>, bound: *Vector<*Map<string, int64>>) -> void {
    a: *Ast = (*r).ast
    exprs: *Vector<ExprNode> = (*a).exprs
    mut e: ExprNode = vec_get(exprs, id)
    if e.kind == xk_ident() {
        ren_mark_expr(r, id)
        if !ren_is_bound(r, bound, e.a) {
            nn: int64 = ren_renamed_id(r, e.a)
            if nn >= 0 {
                e.a = nn
            } else {
                ren_note(r, id, e.a, e.lo, e.hi)
            }
        }
    } else if e.kind == xk_unary() {
        ren_expr(r, e.b, skip, bound)
    } else if e.kind == xk_binary() {
        ren_expr(r, e.b, skip, bound)
        ren_expr(r, e.c, skip, bound)
    } else if e.kind == xk_call() {
        ren_expr(r, e.a, skip, bound)
        ren_expr_list(r, e.b, e.c, skip, bound)
    } else if e.kind == xk_field() {
        if ren_is_module_path(r, e.a, bound) {
            ren_mark_path(r, e.a)
        } else {
            ren_expr(r, e.a, skip, bound)
        }
    } else if e.kind == xk_index() {
        ren_expr(r, e.a, skip, bound)
        ren_expr(r, e.b, skip, bound)
    } else if e.kind == xk_range() {
        ren_expr(r, e.a, skip, bound)
        ren_expr(r, e.b, skip, bound)
    } else if e.kind == xk_tuple() {
        ren_expr_list(r, e.a, e.b, skip, bound)
    } else if e.kind == xk_array() {
        ren_expr_list(r, e.a, e.b, skip, bound)
    } else if e.kind == xk_fstr() {
        ren_expr_list(r, e.a, e.b, skip, bound)
    } else if e.kind == xk_struct_lit() {
        ren_mark_expr(r, id)
        nl: int64 = ren_renamed_id(r, e.a)
        if nl >= 0 {
            e.a = nl
        } else {
            ren_note(r, id, e.a, e.lo, e.hi)
        }
        ren_field_expr_pairs(r, e.b, e.c, skip, bound)
    } else if e.kind == xk_lambda() {
        ren_lambda(r, e, skip, bound)
    } else if e.kind == xk_match() {
        ren_match_value(r, e.a, e.b, e.c, skip, bound)
    } else if e.kind == xk_incdec() {
        ren_expr(r, e.a, skip, bound)
    } else if e.kind == xk_ifexpr() {
        // Each branch is a block, and ren_block opens its own scope, so a binding made
        // inside one branch cannot leak into the other or into the enclosing body.
        ren_expr(r, e.a, skip, bound)
        ren_block(r, e.b, skip, bound)
        ren_block(r, e.c, skip, bound)
    } else if e.kind == xk_do() {
        ren_do(r, e, skip, bound)
    } else if e.kind == xk_await() {
        ren_expr(r, e.a, skip, bound)
        if e.b >= 0 {
            ren_ty(r, e.b, skip)
        }
    } else if e.kind == xk_sizeof_type() {
        ren_ty(r, e.a, skip)
    } else if e.kind == xk_collect() {
        ren_ty(r, e.a, skip)
        ren_expr(r, e.b, skip, bound)
    }
    vec_set(exprs, id, e)
}

// The spelling one top level declaration takes: the file suffix when the file keeps it to
// itself, the package suffix when the file exports it and the package is a dependency,
// and nothing at all when neither applies. An empty export_suffix is the root project and
// the standard library, which are one package and keep every export bare.
func add_scoped(rnames: *Map<string, int64>, a: *Ast, name: int64, exported: bool, suffix: string, export_suffix: string) -> void {
    // A name the file keeps to itself is scoped to the file, always. The generic do
    // protocol is the tempting exception, since the desugar reaches a bare `bind` after
    // the loader has run and a suffixed pair leaves the declaring file's own `do { }`
    // calling nothing, but leaving an unexported pair bare is worse: it reaches every
    // other file in the program, and two files each writing their own private pair become
    // one duplicate definition out of two programs that used to build.
    if !exported {
        add_private(rnames, a, name, suffix)
        return
    }
    // An exported name is what a package scope moves, and two shapes cannot move. A
    // builtin's name has to stay as written for resolve to refuse it, and the bare `bind`
    // and `unit` pair is the do protocol the desugar reaches for. An exported monad member
    // is `Type.member`, the spelling that same desugar rebuilds from the keyword.
    n: string = ast_name(a, name)
    if load_name_is_fixed(n) {
        return
    }
    if load_name_has_dot(n) {
        return
    }
    if str_len(export_suffix) > 0 {
        add_private(rnames, a, name, export_suffix)
    }
}

/** Renames one loaded file's top level declarations and every reference to them the file
 *  makes itself. suffix scopes what the file does not export to the file; export_suffix
 *  scopes what it does export to its package, and is empty for the root project and the
 *  standard library, which keep their exports bare. What an export_suffix does not move
 *  is the class load_export_is_fixed names, the C symbols and the do protocol, since
 *  those names are read by something outside this module.
 *  @param a the parsed module to rewrite in place
 *  @param suffix the per file suffix for unexported declarations
 *  @param export_suffix the package suffix for exported declarations, or the empty string */
export func privatize(a: *Ast, suffix: string, export_suffix: string) -> void {
    rnames: *Map<string, int64> = ren_new_set()
    items: *Vector<ItemNode> = (*a).items
    mut i: int64 = 0
    while i < vec_len(items) {
        it: ItemNode = vec_get(items, i)
        if it.kind == ik_func() {
            f: FuncNode = vec_get((*a).funcs, it.id)
            if !f.abi_export {
                add_scoped(rnames, a, f.name, f.exported, suffix, export_suffix)
            }
        } else if it.kind == ik_struct() {
            s: StructNode = vec_get((*a).structs, it.id)
            add_scoped(rnames, a, s.name, s.exported, suffix, export_suffix)
        } else if it.kind == ik_enum() {
            e: EnumNode = vec_get((*a).enums, it.id)
            add_scoped(rnames, a, e.name, e.exported, suffix, export_suffix)
        } else if it.kind == ik_interface() {
            iface: InterfaceNode = vec_get((*a).interfaces, it.id)
            add_scoped(rnames, a, iface.name, iface.exported, suffix, export_suffix)
        }
        i = i + 1
    }
    if map_len(rnames) == 0 {
        return
    }
    r: *Renamer = renamer_new(a, rnames, load_import_prefixes(a), ren_sink_quiet())
    mut j: int64 = 0
    while j < vec_len(items) {
        ren_item(r, vec_get(items, j))
        j = j + 1
    }
}

func path_file_name(path: string) -> string {
    n: int64 = str_len(path)
    mut last: int64 = -1
    mut i: int64 = 0
    while i < n {
        if path[i] == 47 {
            last = i
        }
        i = i + 1
    }
    return substring(path, last + 1, n)
}

func path_stem(path: string) -> string {
    name: string = path_file_name(path)
    n: int64 = str_len(name)
    mut dot: int64 = -1
    mut i: int64 = 0
    while i < n {
        if name[i] == 46 {
            dot = i
        }
        i = i + 1
    }
    if dot >= 0 {
        return substring(name, 0, dot)
    }
    return name
}

func is_alnum(c: int64) -> bool {
    if c >= 48 {
        if c <= 57 {
            return true
        }
    }
    if c >= 65 {
        if c <= 90 {
            return true
        }
    }
    if c >= 97 {
        if c <= 122 {
            return true
        }
    }
    return false
}

export func suffix_for(path: string, index: int64) -> string {
    mut stem: string = path_stem(path)
    if str_len(stem) == 0 {
        stem = "mod"
    }
    b: *StringBuilder = alloc(sb_new())
    mut i: int64 = 0
    while stem[i] != 0 {
        c: int64 = stem[i]
        if is_alnum(c) {
            sb_push_char(b, c)
        } else {
            sb_push_char(b, 95)
        }
        i = i + 1
    }
    sb_push_char(b, 95)
    sb_push_int(b, index)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}
