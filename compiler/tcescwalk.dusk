// tcescwalk: the walk that builds a frame relation. The first pass over a function,
// every lambda body inside it included, records each declaration, each lambda frame,
// and the frame each expression is written in; the second unifies the names a
// pointer can travel between: an initializer, an assignment through any place, a for
// or match binder, a destructure, a lambda's captures, parameters, and returns, and
// every edge a call may make, read from the callee's own relation

@paradigm procedural

@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
@import ast
@import summary
@import tcescunify
@import tcescrepoint

func kid(a: *Ast, off: int64, i: int64) -> int64 { return vec_get((*a).kids, off + i) }

/** Walks a function twice, the first time collecting its declarations and frames, the
 *  second uniting, then seals the classes for reading
 *  @params rel - A fresh relation of a function
 *  @returns {void} */
export func relation_walk_twice(rel: *FrameRelation) -> void {
    t: *SumTables = (*rel).t
    function: FuncNode = vec_get((*(*t).ast).funcs, (*rel).function_id)
    (*rel).returns_carry = type_carries(t, (*rel).cache, function.ret)
    walk_function(rel, function)
    (*rel).collecting = false
    (*rel).frame_cursor = 0
    (*rel).depth = 0
    walk_function(rel, function)
    relation_seal(rel)
}

// A method's receiver is operand 0 of every call, ahead of the written parameters
func walk_function(rel: *FrameRelation, function: FuncNode) -> void {
    a: *Ast = (*(*rel).t).ast
    mut shift: int64 = 0
    if str_len(method_receiver((*rel).t, (*rel).cache, (*rel).function_id)) > 0 {
        relation_note_decl(rel, NameDecl { name: "self", frame: -1, is_param: true, index: -1, operand: 0, ty: -1, carries: true })
        shift = 1
    }
    for i in 0..function.params_len {
        param: ParamNode = vec_get((*a).params, kid(a, function.params_off, i))
        relation_note_decl(rel, NameDecl { name: ast_name(a, param.name), frame: -1, is_param: true, index: i, operand: i + shift, ty: param.ty, carries: true })
    }
    tail: int64 = walk_block(rel, function.body)
    if (*rel).returns_carry { relation_note_return(rel, tail) }
}

// A binding whose written type holds no reference, or whose unwritten type took a
// value holding none, can never point anywhere, so it never makes a name ambiguous
func bind_name(rel: *FrameRelation, name: string, ty: int64, value: int64) -> void {
    mut carries: bool = value >= 0
    if ty >= 0 { carries = type_carries((*rel).t, (*rel).cache, ty) }
    relation_note_decl(rel, NameDecl { name: name, frame: (*rel).frame, is_param: false, index: -1, operand: -1, ty: ty, carries: carries })
    relation_unite(rel, relation_name_value(rel, name), value)
}

func walk_block(rel: *FrameRelation, block_id: int64) -> int64 {
    if block_id < 0 { return -1 }
    a: *Ast = (*(*rel).t).ast
    block: BlockNode = vec_get((*a).blocks, block_id)
    mut tail: int64 = -1
    (*rel).depth = (*rel).depth + 1
    for i in 0..block.len {
        statement: StmtNode = vec_get((*a).stmts, kid(a, block.off, i))
        if i == block.len - 1 && statement.kind == sk_expr() {
            tail = relation_eval(rel, statement.a)
        } else {
            walk_stmt(rel, statement)
        }
    }
    (*rel).depth = (*rel).depth - 1
    return tail
}

func walk_stmt(rel: *FrameRelation, statement: StmtNode) -> void {
    kind: int64 = statement.kind
    if kind == sk_let() {
        walk_let(rel, statement)
    } else if kind == sk_assign() {
        walk_assign(rel, statement.a, relation_eval(rel, statement.b))
    } else if kind == sk_assign_op() {
        walk_assign(rel, statement.b, relation_eval(rel, statement.c))
    } else if kind == sk_return() {
        walk_return(rel, statement.a)
    } else if kind == sk_defer() {
        note_shared(rel, statement.a)
        relation_eval(rel, statement.a)
    } else if kind == sk_expr() {
        relation_eval(rel, statement.a)
    } else if kind == sk_if() {
        relation_eval(rel, statement.a)
        walk_block(rel, statement.b)
        walk_block(rel, statement.c)
    } else if kind == sk_while() {
        relation_eval(rel, statement.a)
        walk_block(rel, statement.b)
    } else if kind == sk_for() {
        walk_for(rel, statement)
    } else if kind == sk_match() {
        walk_arms(rel, relation_eval(rel, statement.a), statement.b, statement.c)
    }
}

func walk_let(rel: *FrameRelation, statement: StmtNode) -> void {
    a: *Ast = (*(*rel).t).ast
    value: int64 = relation_eval(rel, statement.c)
    for i in 0..statement.b {
        binding: BindNode = vec_get((*a).binds, kid(a, statement.a, i))
        if (*rel).collecting && holds_function(a, binding.ty, statement.c) { map_put((*rel).function_names, ast_name(a, binding.name), 1) }
        bind_name(rel, ast_name(a, binding.name), binding.ty, value)
    }
}

func holds_function(a: *Ast, ty: int64, value_id: int64) -> bool {
    if ty >= 0 {
        written: TypeNode = vec_get((*a).types, ty)
        return written.kind == tk_func()
    }
    if value_id < 0 { return false }
    value: ExprNode = vec_get((*a).exprs, value_id)
    return value.kind == xk_lambda()
}

// A name a deferred statement reads, which it reads only when the function ends
func note_shared(rel: *FrameRelation, expression_id: int64) -> void {
    if !(*rel).collecting { return }
    names: *Vector<string> = alloc(vec_new())
    collect_read_names((*(*rel).t).ast, expression_id, names)
    for name in names { map_put((*rel).shared_names, name, 1) }
}

// A function value bound once and reassigned at the top of the function body, where
// statements run exactly once and in order, takes a fresh node at each assignment,
// so a call reaches only the closure the binding holds at that point. A binding read
// as a value anywhere, captured by a lambda, or read by a deferred statement may be
// called through another name or at a later time, and keeps the single node every
// other binding has
func is_versioned(rel: *FrameRelation, name: string) -> bool {
    if (*rel).depth != 1 || (*rel).frame >= 0 || relation_decl_count(rel, name) != 1 { return false }
    return map_has((*rel).function_names, name) && !map_has((*rel).shared_names, name)
}

// A store through any place ties the stored value to the place's root value. A place
// with no root binding of its own ties the value to every name the place mentions
func walk_assign(rel: *FrameRelation, place_id: int64, value: int64) -> void {
    a: *Ast = (*(*rel).t).ast
    place: ExprNode = vec_get((*a).exprs, place_id)
    if place.kind == xk_ident() {
        note_frame(rel, place_id)
        name: string = ast_name(a, place.a)
        if !(*rel).collecting && is_versioned(rel, name) {
            version: int64 = relation_new_node(rel, relation_kind_name(), -1, name)
            map_put((*rel).versions, name, version)
            relation_unite(rel, version, value)
            return
        }
        relation_unite(rel, relation_name_value(rel, name), value)
        return
    }
    relation_unite(rel, relation_eval(rel, place_id), value)
    if str_len(written_place_root(a, place_id)) > 0 { return }
    mentioned: *Vector<string> = alloc(vec_new())
    collect_read_names(a, place_id, mentioned)
    for name in mentioned { relation_unite(rel, relation_name_value(rel, name), value) }
}

// A function's returned value outlives its frame; a lambda's joins the lambda itself
// and is noted with the lambda's frame. A return of a bare name is noted apart, since
// the checker follows that name's flag to the return
func walk_return(rel: *FrameRelation, value_id: int64) -> void {
    if value_id < 0 { return }
    value: int64 = relation_eval(rel, value_id)
    if (*rel).lambda_node >= 0 {
        note_lambda_return(rel, value, is_name_expr(rel, value_id))
        return
    }
    if !(*rel).returns_carry { return }
    relation_note_return(rel, value)
    returned: ExprNode = vec_get((*(*(*rel).t).ast).exprs, value_id)
    if !(*rel).collecting && returned.kind == xk_ident() { vec_push((*rel).plain_returns, value) }
}

func walk_for(rel: *FrameRelation, statement: StmtNode) -> void {
    a: *Ast = (*(*rel).t).ast
    iterated: int64 = relation_eval(rel, statement.b)
    bind_name(rel, ast_name(a, statement.a), -1, iterated)
    // `for k, v in m` binds a second name, the interned name plus one in d
    if statement.d != 0 { bind_name(rel, ast_name(a, statement.d - 1), -1, iterated) }
    walk_block(rel, statement.c)
}

// Each arm's binders take the scrutinee; the arms' tails join into the match's value
func walk_arms(rel: *FrameRelation, scrutinee: int64, offset: int64, count: int64) -> int64 {
    a: *Ast = (*(*rel).t).ast
    mut joined: int64 = -1
    for i in 0..count {
        arm: ArmNode = vec_get((*a).arms, kid(a, offset, i))
        pattern: PatternNode = vec_get((*a).patterns, arm.pat)
        if pattern.kind == pk_ident() {
            bind_arm_name(rel, ast_name(a, pattern.a), scrutinee)
        } else if pattern.kind == pk_variant() {
            for j in 0..pattern.c { bind_name(rel, ast_name(a, kid(a, pattern.b, j)), -1, scrutinee) }
        }
        joined = relation_join(rel, joined, walk_block(rel, arm.body))
    }
    return joined
}

// A payload free arm names a variant of the scrutinee's enum, binding nothing, or is
// the catch all binder, as the scrutinee's enum decides, which the walk cannot read.
// A name some enum declares as a variant is noted as a binding either way, and it takes
// the scrutinee only when the function reads the name as a value somewhere, so the arms
// of unrelated matches that name one variant never tie their scrutinees together
func bind_arm_name(rel: *FrameRelation, name: string, scrutinee: int64) -> void {
    if !(*rel).collecting && relation_is_variant(rel, name) && !map_has((*rel).shared_names, name) { return }
    bind_name(rel, name, -1, scrutinee)
}

// The first walk records the frame each expression is written in, which a query
// asked from that expression reads
func note_frame(rel: *FrameRelation, id: int64) -> void {
    if (*rel).collecting && id >= 0 { map_put((*rel).expr_frames, id, (*rel).frame) }
}

/** The class an expression's value may point into. Every subexpression is walked, so
 *  a call nested anywhere adds its edges
 *  @params rel - The relation being built
 *  @params id - The expression
 *  @returns {int64} - The value's node, or -1 for a value that holds no reference */
export func relation_eval(rel: *FrameRelation, id: int64) -> int64 {
    if id < 0 { return -1 }
    note_frame(rel, id)
    value: int64 = eval_kind(rel, id)
    if (*rel).collecting || value < 0 { return value }
    if relation_holds_no_reference(rel, id) { return -1 }
    return value
}

func eval_kind(rel: *FrameRelation, id: int64) -> int64 {
    a: *Ast = (*(*rel).t).ast
    e: ExprNode = vec_get((*a).exprs, id)
    kind: int64 = e.kind
    if kind == xk_ident() { return eval_ident(rel, ast_name(a, e.a)) }
    if kind == xk_unary() { return relation_eval(rel, e.b) }
    if kind == xk_binary() { return eval_operands(rel, e.b, e.c) }
    // A range's bounds are a and b; c is the inclusive flag and d the step's literal value
    if kind == xk_range() { return eval_operands(rel, e.a, e.b) }
    if kind == xk_incdec() {
        relation_eval(rel, e.a)
        return -1
    }
    if kind == xk_tuple() || kind == xk_array() { return eval_list(rel, e.a, e.b, 0, 1) }
    if kind == xk_fstr() {
        eval_list(rel, e.a, e.b, 0, 1)
        return -1
    }
    if kind == xk_struct_lit() { return eval_list(rel, e.b, e.c / 2, 1, 2) }
    if kind == xk_index() {
        relation_eval(rel, e.b)
        return relation_eval(rel, e.a)
    }
    if kind == xk_field() { return relation_eval(rel, e.a) }
    if kind == xk_collect() { return relation_eval(rel, e.b) }
    if kind == xk_lambda() { return eval_lambda(rel, id, e) }
    if kind == xk_match() { return walk_arms(rel, relation_eval(rel, e.a), e.b, e.c) }
    if kind == xk_ifexpr() {
        relation_eval(rel, e.a)
        return relation_join(rel, walk_block(rel, e.b), walk_block(rel, e.c))
    }
    if kind == xk_call() { return relation_call(rel, e) }
    if kind == xk_await() { return relation_join(rel, relation_eval(rel, e.a), relation_outside()) }
    if kind == xk_do() { return eval_do(rel, e) }
    return -1
}

func eval_operands(rel: *FrameRelation, first: int64, second: int64) -> int64 {
    relation_eval(rel, first)
    relation_eval(rel, second)
    return -1
}

func eval_list(rel: *FrameRelation, offset: int64, count: int64, first: int64, stride: int64) -> int64 {
    a: *Ast = (*(*rel).t).ast
    mut joined: int64 = -1
    for i in 0..count { joined = relation_join(rel, joined, relation_eval(rel, kid(a, offset, first + i * stride))) }
    return joined
}

// A type or variant name holds no memory. A module function read as a value holds
// none of its own, and a call through it ties every operand together, so it reaches
// outside the frame only when the function itself hands an operand or its result
// there. A name the function also declares somewhere may be either one, so it is both
func eval_ident(rel: *FrameRelation, name: string) -> int64 {
    if (*rel).collecting { map_put((*rel).shared_names, name, 1) }
    declared: bool = relation_decl_count(rel, name) > 0
    is_function: bool = is_function_item(rel, name)
    if !declared && !is_function && relation_is_type_item(rel, name) { return -1 }
    if !is_function { return relation_ident(rel, name) }
    mut item: int64 = -1
    if function_value_leaks(rel, unwrap_or(map_get((*(*rel).t).module_fns, name), -1)) { item = relation_outside() }
    if !declared { return item }
    return relation_join(rel, relation_ident(rel, name), item)
}

/** The value of a name read inside the walk, noted as a use for capture analysis
 *  @params rel - The relation being built
 *  @params name - The name read
 *  @returns {int64} - The name's node, or -1 */
export func relation_ident(rel: *FrameRelation, name: string) -> int64 {
    if (*rel).collecting && (*rel).frame >= 0 { map_put((*rel).shared_names, name, 1) }
    value: int64 = relation_name_value(rel, name)
    note_use(rel, value)
    return value
}

/** Records the frame a call's callee is written in, which a query about the call
 *  is asked from
 *  @params rel - The relation being built
 *  @params callee_id - The callee expression
 *  @returns {void} */
export func relation_note_callee(rel: *FrameRelation, callee_id: int64) -> void {
    note_frame(rel, callee_id)
}

func note_use(rel: *FrameRelation, value: int64) -> void {
    refs: *Vector<*Vector<int64>> = (*rel).refs
    if value >= 0 && vec_len(refs) > 0 { vec_push(vec_get(refs, vec_len(refs) - 1), value) }
}

// A bare variant name never constructs, so a module function of the name is the item
func is_function_item(rel: *FrameRelation, name: string) -> bool {
    return map_has((*(*rel).t).module_fns, name)
}

// A do block left in place binds each step to whatever the monad hands it. Its a slot
// holds the monad's interned name, not an expression
func eval_do(rel: *FrameRelation, e: ExprNode) -> int64 {
    a: *Ast = (*(*rel).t).ast
    mut joined: int64 = relation_outside()
    for i in 0..e.c {
        step: DoBindNode = vec_get((*a).do_binds, kid(a, e.b, i))
        joined = relation_join(rel, joined, relation_eval(rel, step.expr))
        if step.name >= 0 { bind_name(rel, ast_name(a, step.name), -1, joined) }
    }
    return joined
}

// A lambda's environment holds its captures, receives its parameters, and yields its
// returns, so a call through it or a store of it ties all of them together
func eval_lambda(rel: *FrameRelation, id: int64, e: ExprNode) -> int64 {
    a: *Ast = (*(*rel).t).ast
    frame: int64 = (*rel).frame_cursor
    (*rel).frame_cursor = frame + 1
    if (*rel).collecting {
        vec_push((*rel).frame_parent, (*rel).frame)
        map_put((*rel).lambda_frames, id, frame)
    }
    environment: int64 = relation_new_node(rel, relation_kind_lambda(), frame, "")
    saved_frame: int64 = (*rel).frame
    saved_lambda: int64 = (*rel).lambda_node
    (*rel).frame = frame
    (*rel).lambda_node = environment
    uses: *Vector<int64> = alloc(vec_new())
    vec_push((*rel).refs, uses)
    for i in 0..e.b {
        param: ParamNode = vec_get((*a).params, kid(a, e.a, i))
        name: string = ast_name(a, param.name)
        relation_note_decl(rel, NameDecl { name: name, frame: frame, is_param: true, index: -1, operand: i, ty: param.ty, carries: true })
        relation_unite(rel, environment, relation_name_value(rel, name))
    }
    note_lambda_return(rel, walk_block(rel, e.d), block_tail_is_name(rel, e.d))
    used: *Vector<int64> = vec_get((*rel).refs, vec_len((*rel).refs) - 1)
    vec_pop((*rel).refs)
    (*rel).frame = saved_frame
    (*rel).lambda_node = saved_lambda
    for value in used {
        if is_captured(rel, value, frame) {
            relation_unite(rel, environment, value)
            note_use(rel, value)
        }
    }
    return environment
}

// What a lambda returns joins its environment, and the frame it was returned from is
// kept beside it, with whether the return names a binding bare, so a query from
// inside the lambda can tell its own results apart
func note_lambda_return(rel: *FrameRelation, value: int64, is_name: bool) -> void {
    relation_unite(rel, (*rel).lambda_node, value)
    if (*rel).collecting || value < 0 { return }
    vec_push((*rel).frame_returns, value)
    vec_push((*rel).frame_return_frames, (*rel).frame)
    vec_push((*rel).frame_return_names, is_name)
}

func is_name_expr(rel: *FrameRelation, value_id: int64) -> bool {
    if value_id < 0 { return false }
    return vec_get((*(*(*rel).t).ast).exprs, value_id).kind == xk_ident()
}

// Whether a block ends in an expression statement naming a binding bare
func block_tail_is_name(rel: *FrameRelation, block_id: int64) -> bool {
    if block_id < 0 { return false }
    a: *Ast = (*(*rel).t).ast
    block: BlockNode = vec_get((*a).blocks, block_id)
    if block.len == 0 { return false }
    statement: StmtNode = vec_get((*a).stmts, kid(a, block.off, block.len - 1))
    return statement.kind == sk_expr() && is_name_expr(rel, statement.a)
}

// A name a lambda reads that no frame inside it declares
func is_captured(rel: *FrameRelation, value: int64, frame: int64) -> bool {
    if !relation_is_name(rel, value) { return false }
    name: string = vec_get((*rel).names, value)
    declared: int64 = vec_get((*rel).node_frames, value)
    if !relation_frame_declares(rel, name, declared) { return !relation_is_module_item(rel, name) }
    return !relation_frame_within(rel, declared, frame)
}
