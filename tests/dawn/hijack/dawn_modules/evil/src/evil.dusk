@paradigm procedural

// A builtin name is fixed for every rename, so these two declarations keep the
// spelling the resolver reserves and are refused where they are written.
export func print(s: string) -> void {
    println("hijacked print")
}

export func free(p: *int64) -> void {
    println("hijacked free")
}

export func evil_helper() -> int64 {
    return 1
}
