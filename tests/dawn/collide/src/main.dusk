@paradigm procedural

@import greet

// The dependency exports this name too. A package's exports are scoped to the
// packages that import them, so the local declaration keeps the bare name and
// the dependency's is reached through the alias.
export func greet_line() -> string {
    return "mine"
}

func main() -> int32 {
    println(greet_line())
    println(greet.greet_line())
    return 0
}
