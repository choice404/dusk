@paradigm procedural

// The same file the manifest names, by a different spelling. The dedup key is the
// file, so it reaches the clang line once and the link sees one vendor_tag.
@csource "../vendor/tag.c"

foreign "C" {
    func vendor_tag() -> int64
}

func main() -> int32 {
    println(vendor_tag())
    return 0
}
