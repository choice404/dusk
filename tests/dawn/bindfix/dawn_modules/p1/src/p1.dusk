@paradigm functional

// One of two packages that each wrote an unexported pair. Neither is a name any scope
// moves, and neither is a name the desugar can reach after the loader has scoped it.
func bind(x: int64, f: (int64) -> int64) -> int64 {
    return f(x)
}

func unit(x: int64) -> int64 {
    return x
}

export func p1_go() -> int64 {
    return do {
        a <- 7
        a * 3
    }
}
