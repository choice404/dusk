@paradigm procedural

@import std.vector
@import d.d_count

// The leaf import binds d_count and nothing else, so the package's own vec_len never
// enters this file's scope and the bare call is the standard library's over the vector
// this file built. The package's own reading of the name still answers inside it.
func main() -> int32 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 1)
    println(vec_len(v))
    println(d_count())
    vec_free(v)
    free(v)
    return 0
}
