@paradigm procedural

@import ca
@import mb

// The relief the fixmov1 refusal asks for. The same two packages, one exporting foo to C
// and one exporting a foo a suffix moves, with both calls qualified by the alias each was
// required under. Neither kind of export is out of reach, so the refusal costs the file a
// spelling and no program.
func main() -> int32 {
    println(ca.foo())
    println(mb.foo())
    return 0
}
