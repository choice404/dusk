@paradigm procedural

@import std.vector
@import d

// Both answers to vec_len are in this file's scope, the standard library's and the
// package's, so the bare name would be refused here. Qualified, each one is named and the
// program says which is which: the vector holds one element and the package returns 999.
func main() -> int32 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 1)
    println(std.vector.vec_len(v))
    println(d.vec_len(v))
    vec_free(v)
    free(v)
    return 0
}
