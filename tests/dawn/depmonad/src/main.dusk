@paradigm functional

@import mon

// The do block names the dependency's monad type, and the dependency's own
// generic do block runs inside it.
func main() -> int32 {
    r := do M {
        a <- M { v: 3 }
        b <- M { v: 4 }
        a + b
    }
    println(r.v)
    println(mon.mon_gen())
    return 0
}
