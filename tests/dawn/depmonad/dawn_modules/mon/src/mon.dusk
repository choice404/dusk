@paradigm functional

@import gen

export struct M<T> {
    v: T,
}

monad M {
    export func bind<A, B>(m: M<A>, f: (A) -> M<B>) -> M<B> {
        return f(m.v)
    }
    export func unit<A>(x: A) -> M<A> {
        return M { v: x }
    }
}

export func mon_gen() -> int64 {
    return gen_line()
}
