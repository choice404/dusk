@paradigm functional

// The generic do block reaches for a bare bind and unit, the protocol pair, and
// finds this package's own.
export func bind(x: int64, f: (int64) -> int64) -> int64 {
    return f(x)
}

export func unit(x: int64) -> int64 {
    return x
}

export func gen_line() -> int64 {
    r := do {
        a <- 7
        a * 3
    }
    return r
}
