@paradigm functional

@import q

export func bind(x: int64, f: (int64) -> int64) -> int64 {
    return f(x)
}

export func unit(x: int64) -> int64 {
    return x
}

// mid imported q and declares no value of its own, so the call on the right of the
// arrow is q's, not the project's function of the same name.
export func run() -> int64 {
    return do {
        value <- value()
        value
    }
}
