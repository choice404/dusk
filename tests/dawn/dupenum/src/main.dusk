@paradigm procedural

@import left
@import right

// Both imports bring an enum named Color into scope, and both spell a variant
// Red, so the bare name names neither enum.
func main() -> int32 {
    c: Color = Color.Red
    match c {
        Red => {
            println("red")
        }
        Blue => {
            println("blue")
        }
    }
    return 0
}
