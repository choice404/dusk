@paradigm oop
@paradigm procedural

export struct Point {
    x: int64,
}

export enum Color {
    Red,
    Blue,
}

export interface Shape {
    area() -> int64
}

impl Shape for Point {
    func area() -> int64 {
        return self.x * 2
    }
}

export func point_area(p: Point) -> int64 {
    return p.x
}
