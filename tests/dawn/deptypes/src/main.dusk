@paradigm oop
@paradigm procedural

@import shapes
@import std.vector

// Every kind of name a package exports reaches this file through the import: a
// struct in an annotation and a literal, the same struct as a generic argument,
// an interface a local struct implements, a function, and an enum with its
// variants.
struct Local {
    k: int64,
}

impl Shape for Local {
    func area() -> int64 {
        return self.k
    }
}

func main() -> int32 {
    p: Point = Point { x: 3 }
    println(point_area(p))
    println(p.area())
    v: *Vector<Point> = alloc(vec_new())
    vec_push(v, Point { x: 4 })
    println(vec_get(v, 0).x)
    vec_free(v)
    free(v)
    l: Local = Local { k: 5 }
    s: Shape = l
    println(s.area())
    c: Color = Color.Red
    match c {
        Red => {
            println("red")
        }
        Blue => {
            println("blue")
        }
    }
    return 0
}
