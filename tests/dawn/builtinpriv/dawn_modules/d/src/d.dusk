@paradigm procedural

// hash is a builtin, and an exported declaration under that name is refused for it. This
// one is kept to the file, so the loader scopes it away from the reserved spelling and
// the call beside it follows the rename.
func hash(v: int64) -> int64 {
    return v * 7
}

export func d_hash(v: int64) -> int64 {
    return hash(v)
}
