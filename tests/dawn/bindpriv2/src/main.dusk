@paradigm functional

@import helper

// The root file is never renamed, so the pair it writes keeps the spelling the desugar
// reaches for and answers the other file's do block too, whose own private pair was
// scoped away. The 1000 the private bind adds is what tells the two apart.
func bind(x: int64, f: (int64) -> int64) -> int64 {
    return f(x)
}

func unit(x: int64) -> int64 {
    return x
}

func main() -> int32 {
    r := do {
        a <- 5
        a * 2
    }
    println(r)
    println(helper_do())
    return 0
}
