@paradigm functional

// The pair is unexported, so the loader scopes it to this file and the bare bind the
// desugar reaches for is answered by the project root's pair instead. The 1000 this one
// adds is never in the output, which is how the program says which pair ran.
func bind(x: int64, f: (int64) -> int64) -> int64 {
    return f(x) + 1000
}

func unit(x: int64) -> int64 {
    return x
}

export func helper_do() -> int64 {
    return do {
        a <- 7
        a * 3
    }
}
