@paradigm procedural

@import tags

// The dependency exports tag and this file imports it, so the bare name is in
// scope. Every local binding of that name still wins over it: a parameter, a
// let binding, a for binder, and a match arm binder each print their own value,
// and the dependency's function is still reachable through the alias.
enum Note {
    Line(t: string),
}

func from_param(tag: string) -> string {
    return tag
}

func main() -> int32 {
    println(from_param("param"))
    tag := "let"
    println(tag)
    words: string[] = ["for"]
    for tag in words {
        println(tag)
    }
    n: Note = Note.Line("arm")
    match n {
        Line(tag) => {
            println(tag)
        }
    }
    println(tags.tag())
    return 0
}
