@paradigm functional

// The protocol pair is unexported, and the do desugar reaches a bind and a unit by
// that bare spelling after the loader has run, so the pair keeps the names it wrote
// and this package's own do block finds them.
func bind(x: int64, f: (int64) -> int64) -> int64 {
    return f(x)
}

func unit(x: int64) -> int64 {
    return x
}

export func pm_run() -> int64 {
    return do {
        a <- 7
        a * 3
    }
}
