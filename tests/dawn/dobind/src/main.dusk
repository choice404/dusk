@paradigm functional

@import q

func bind(x: int64, f: (int64) -> int64) -> int64 {
    return f(x)
}

func unit(x: int64) -> int64 {
    return x
}

// The binder is spelled like the dependency's export it is bound from, so the do
// block reads the call on the right of the arrow before the name it binds.
func main() -> int32 {
    r := do {
        value <- value()
        value
    }
    println(r)
    println(q.value())
    return 0
}
