# The 2.0.0 records that need what the runner learned in 2.0.0: the flags field,
# placed between the subcommand and the file, and the release_out and
# symbols_internal specials. They live apart from goldens.manifest so the previous
# release's runner, which refuses a field it does not know, still reads that one.
#
# DUSK_HOME=$PWD DUSK_BIN=target/dusk-out/dusk target/dusk-out/testrun tests/gauge.manifest
---
# At -O2 a dusk sqrt, abs, and floor still keep their own bodies; through 1.17.3 the
# optimizer folded each call as the library function and this printed 2, 3, and 2.
test link_libm_names_release
mode special
special release_out
file examples/link_libm_names_ok.dusk
out 5\n97\n2.75\n
---
# Only main is an external symbol of a built program; the dusk functions, named for
# C library functions or not, are local.
test link_symbols_internal
mode special
special symbols_internal
file examples/link_libc_names_ok.dusk
args getpid sync write reboot mount
---
test link_symbols_internal_wrapped_main
mode special
special symbols_internal
file examples/voidmain_argv_exit0.dusk
args main
---
# A dusk function named for a runtime function, for strlen, or for a function the
# backend calls by name is a local symbol with the suffix, and at -O2 each still
# answers with its own value while the compiler's own calls reach C.
test link_symbols_runtime_names
mode special
special symbols_internal
file examples/name_runtime_names_ok.dusk
args cool_gen_alloc cool_helper strlen cool_thread_spawn apply
---
test link_symbols_libcall_names
mode special
special symbols_internal
file examples/link_libcall_names_ok.dusk
args memcpy memset memmove fmod pow rem main
---
test name_runtime_names_release
mode special
special release_out
file examples/name_runtime_names_ok.dusk
out 5\n1\n99\n4\nabcd\n99\nthe dusk cool_thread_spawn\n6\n
---
test link_libcall_names_release
mode special
special release_out
file examples/link_libcall_names_ok.dusk
out 65\n65\n1.5\n27\n2\n3\n4\n42\n7\n
---
# A library archive's C source that calls a dusk function by its bare name is
# refused by name too: ld -r would carry the undefined name into the archive for
# the host's link to bind to whatever it finds.
test link_csource_bare_lib_fail
mode build_fail
flags --lib
file examples/link_csource_bare_fail.dusk
err_has link_csource_call.c: 6:9: error: C source calls dusk function 'dusk_twice' by name; declare it export "C"
---
test link_csource_libc_name_lib_ok
mode tool
argv build --lib examples/link_csource_libc_name_ok.dusk
code 0
---
# The build flags are refused by name when they cannot build.
test flag_unknown_sanitizer_fail
mode build_fail
flags --sanitize=adress
file examples/hello.dusk
err_has dusk: unknown sanitizer 'adress'; --sanitize takes address, undefined, and thread
---
test flag_address_thread_fail
mode build_fail
flags --sanitize=address,thread
file examples/hello.dusk
err_has dusk: --sanitize=address and --sanitize=thread cannot be combined; build one binary for each
---
test flag_lib_sites_fail
mode build_fail
flags --lib --heap-sites
file examples/embed_lib.dusk
err_has dusk: build --lib takes no --sanitize and no --heap-sites yet
---
test flag_unknown_build_flag_fail
mode build_fail
flags --heap-site
file examples/hello.dusk
err_has dusk: unknown build flag '--heap-site'; build takes --release, --lib, --heap-sites, and --sanitize=<list>
---
# build and ir take one file, and a second one is refused rather than dropped unread.
test flag_second_file_fail
mode build_fail
flags examples/sites_basic.dusk
file examples/hello.dusk
err_has dusk: build takes one file; build 'examples/sites_basic.dusk' and 'examples/hello.dusk' one at a time
---
test flag_ir_second_file_fail
mode tool
argv ir examples/hello.dusk examples/sites_basic.dusk
code 1
---
test flag_run_unknown_fail
mode run_raw
flags --bogus
file examples/hello.dusk
ok false
err_has dusk: unknown run flag '--bogus'; run takes --heap-sites and --sanitize=<list> before the file
---
# run reads its flags before the file and hands every word after the file to the
# program untouched.
test flag_run_stops_at_the_file
mode run
flags --heap-sites
file examples/voidmain_argv_exit0.dusk
args --heap-sites b
out 3\n--heap-sites\nb\n
---
# ir reads the same flags, wherever they sit among its words, and refuses what it
# cannot emit.
test flag_ir_wasm_sites_fail
mode tool
argv ir --target=wasm32 --heap-sites examples/hello.dusk
code 1
---
test flag_ir_unknown_fail
mode tool
argv ir --bogus examples/hello.dusk
code 1
---
test flag_ir_sites_ok
mode tool
argv ir examples/hello.dusk --heap-sites
code 0
---
# A --heap-sites build prints exactly what the plain build prints when nothing is
# live at exit, reports what is live at exit when something is, and reports on
# demand at each heap_report call; every report checks the registry walk against
# the counters.
test sites_clean
mode run_raw
flags --heap-sites
file examples/hello.dusk
ok true
out hello, world\n
err_eq 
---
test sites_exit_report
mode run_raw
flags --heap-sites
file examples/heap_counters_ok.dusk
ok true
out 1\n8\n0\n1\n7\n0\ntrue\n0\n0\ntrue\n2\ntrue\n
err_has dusk heap: 4 blocks, 60 bytes live
err_absent build with --heap-sites
---
test sites_on_demand
mode run_raw
flags --heap-sites
file examples/sites_on_demand.dusk
ok true
out abcd\nijkl\n
err_has dusk heap: 3 blocks, 15 bytes live
err_has dusk heap: 1 block, 5 bytes live
err_absent build with --heap-sites
---
test sites_on_demand_plain
mode run_raw
file examples/sites_on_demand.dusk
ok true
out abcd\nijkl\n
err_eq dusk heap: 3 blocks, 15 bytes live\ndusk heap: build with --heap-sites to see allocation sites\ndusk heap: 1 block, 5 bytes live\ndusk heap: build with --heap-sites to see allocation sites\n
---
test sites_counter_agree
mode run_raw
flags --heap-sites
file examples/sites_counter_agree.dusk
ok true
out kept!\n
err_has dusk heap: 0 blocks, 0 bytes live
err_absent counter drift
---
---
# Codegen brackets every call in the program's own files with a push and a pop of
# its line, so a block left live at exit is reported under the line that allocated
# it and the chain of calls that led there.
test sites_basic
mode run_raw
flags --heap-sites
file examples/sites_basic.dusk
ok true
out leftright\nleftright\nleftright\n1\n
err_eq dusk heap: 5 blocks, 86 bytes live, 3 sites\n      1 block        32 bytes  examples/sites_basic.dusk:14\n      3 blocks       30 bytes  examples/sites_basic.dusk:10\n      1 block        24 bytes  examples/sites_basic.dusk:13\n
---
# Standard library code is never bracketed, so a concatenation, an f-string, a
# split, and a map are each attributed to the program's line that asked for them.
test sites_std_attribution
mode run_raw
flags --heap-sites
file examples/sites_attribution.dusk
ok true
out abcd\nn is 42\n3\n1\n
err_eq dusk heap: 13 blocks, 323 bytes live, 5 sites\n      5 blocks      216 bytes  examples/sites_attribution.dusk:15\n      5 blocks       62 bytes  examples/sites_attribution.dusk:14\n      1 block        32 bytes  examples/sites_attribution.dusk:16\n      1 block         8 bytes  examples/sites_attribution.dusk:13\n      1 block         5 bytes  examples/sites_attribution.dusk:11\n
err_absent lib/std
---
test sites_chain_helper
mode run_raw
flags --heap-sites
file examples/sites_chain_helper.dusk
ok true
out first!\nsecond!\n
err_eq dusk heap: 2 blocks, 15 bytes live, 2 sites\n      1 block         8 bytes  examples/sites_chain_helper.dusk:6\n        from examples/sites_chain_helper.dusk:14\n        from examples/sites_chain_helper.dusk:19\n      1 block         7 bytes  examples/sites_chain_helper.dusk:6\n        from examples/sites_chain_helper.dusk:10\n        from examples/sites_chain_helper.dusk:18\n
---
# A bracket is one instruction wide, so an early return, a deferred call, a lambda
# run by the standard library, a method, an interface call, a thread, a pool task,
# an async task across an await, and a recursion deeper than the site stack all
# leave the stack where they found it.
test sites_early_return
mode run_raw
flags --heap-sites
file examples/sites_early_return.dusk
ok true
out early!\nlate!\nafter!\n
err_eq dusk heap: 3 blocks, 20 bytes live, 3 sites\n      1 block         7 bytes  examples/sites_early_return.dusk:7\n        from examples/sites_early_return.dusk:13\n      1 block         7 bytes  examples/sites_early_return.dusk:15\n      1 block         6 bytes  examples/sites_early_return.dusk:9\n        from examples/sites_early_return.dusk:14\n
---
test sites_defer
mode run_raw
flags --heap-sites
file examples/sites_defer.dusk
ok true
out body!\ndeferred!\n1\nafter!\n
err_eq dusk heap: 2 blocks, 17 bytes live, 2 sites\n      1 block        10 bytes  examples/sites_defer.dusk:6\n        from examples/sites_defer.dusk:11\n        from examples/sites_defer.dusk:19\n      1 block         7 bytes  examples/sites_defer.dusk:20\n
---
test sites_lambda
mode run_raw
flags --heap-sites
file examples/sites_lambda.dusk
ok true
out 2\n
err_eq dusk heap: 6 blocks, 66 bytes live, 2 sites\n      2 blocks       56 bytes  examples/sites_lambda.dusk:12\n      4 blocks       10 bytes  examples/sites_lambda.dusk:13\n        from examples/sites_lambda.dusk:12\n
---
test sites_method_iface
mode run_raw
flags --heap-sites
file examples/sites_method.dusk
ok true
out tag!\ndog!\n
err_eq dusk heap: 2 blocks, 10 bytes live, 2 sites\n      1 block         5 bytes  examples/sites_method.dusk:16\n        from examples/sites_method.dusk:27\n        from examples/sites_method.dusk:33\n      1 block         5 bytes  examples/sites_method.dusk:22\n        from examples/sites_method.dusk:32\n
---
test sites_spawn
mode run_raw
flags --heap-sites
file examples/sites_spawn.dusk
ok true
out thread!\n
err_eq dusk heap: 1 block, 8 bytes live, 1 site\n      1 block         8 bytes  examples/sites_spawn.dusk:7\n
---
test sites_pool
mode run_raw
flags --heap-sites
file examples/sites_pool.dusk
ok true
out pool!\n
err_eq dusk heap: 1 block, 6 bytes live, 1 site\n      1 block         6 bytes  examples/sites_pool.dusk:14\n
---
test sites_async
mode run_raw
flags --heap-sites
file examples/sites_async.dusk
ok true
out before!\nafter!\n0\n
err_eq dusk heap: 2 blocks, 15 bytes live, 2 sites\n      1 block         8 bytes  examples/sites_async.dusk:11\n        from examples/sites_async.dusk:22\n      1 block         7 bytes  examples/sites_async.dusk:13\n        from examples/sites_async.dusk:22\n
---
test sites_deep_recursion
mode run_raw
flags --heap-sites
file examples/sites_deep_recursion.dusk
ok true
out bottom!\nafter!\n
err_has       1 block         8 bytes  examples/sites_deep_recursion.dusk:10\n        from examples/sites_deep_recursion.dusk:10\n
err_has       1 block         7 bytes  examples/sites_deep_recursion.dusk:15\n
---
# run_capture freed none of the lines it read and joined, so every call left one
# block per line of output live; a heap sites build of a program that frees what
# run_capture hands back now prints no report.
test sites_run_capture_clean
mode run_raw
flags --heap-sites
file examples/sites_run_capture_clean.dusk
ok true
out one\ntwo\nthree\n0\n
err_eq 
