# The 2.0.0 records that build with --sanitize and so need clang's sanitizer
# runtimes, the compiler-rt package, on the machine. A sanitized binary reserves far
# more address space than the suite's ulimit -v allows, so this manifest runs under
# a CPU limit and a timeout only:
#
# DUSK_HOME=$PWD DUSK_BIN=target/dusk-out/dusk target/dusk-out/testrun tests/sanitize.manifest
---
# Every load and store of a dusk function is checked under address, so a write one
# byte past a C library block is reported in the dusk function that makes it.
test asan_c_overflow
mode run_raw
flags --sanitize=address
file examples/asan_c_overflow.dusk
ok false
err_has AddressSanitizer: heap-buffer-overflow
out 
err_has in poke.d
---
test asan_hello_ok
mode run_raw
flags --sanitize=address
file examples/hello.dusk
ok true
out hello, world\n
err_absent Sanitizer
---
test asan_ubsan_names_ok
mode run_raw
flags --sanitize=address,undefined
file examples/name_runtime_names_ok.dusk
ok true
out 5\n1\n99\n4\nabcd\n99\nthe dusk cool_thread_spawn\n6\n
err_absent Sanitizer
err_absent runtime error
---
# Two threads adding to one word with no lock are a data race in the dusk function
# that writes it; the locked twin and a channel relay are clean.
test tsan_race_reported
mode run_raw
flags --sanitize=thread
file examples/tsan_race_reported.dusk
ok false
out true\n
err_has ThreadSanitizer: data race
err_has bump.d
---
test tsan_mutex_ok
mode run_raw
flags --sanitize=thread
file examples/countermutex.dusk
ok true
out 10000\n
err_absent ThreadSanitizer
---
test tsan_channel_ok
mode run_raw
flags --sanitize=thread
file examples/chanrelay_ok.dusk
ok true
out 42\n
err_absent ThreadSanitizer
---
# undefined instruments the runtime and every @csource; a signed overflow in the C
# file is reported by its line.
test ubsan_csource_reported
mode run_raw
flags --sanitize=undefined
file examples/ubsan_csource.dusk
ok true
out -2147483648\n
err_has ubsan_csource.c:3:14: runtime error: signed integer overflow
---
# Under address the program's generational heap really frees at the exact size it
# was asked for, so AddressSanitizer sees a read after a free, a byte past a raw
# block, and a second free, each with the dusk functions on its stacks.
test asan_string_uaf
mode run_raw
flags --sanitize=address
file examples/asan_string_uaf.dusk
ok false
err_has AddressSanitizer: heap-use-after-free
err_has in reader.d
err_has freed by thread T0 here
---
test asan_raw_overflow
mode run_raw
flags --sanitize=address
file examples/asan_raw_overflow.dusk
ok false
out 
err_has AddressSanitizer: heap-buffer-overflow
err_has in poke.d
err_has 0 bytes after
---
test asan_double_free
mode run_raw
flags --sanitize=address
file examples/asan_double_free.dusk
ok false
out 
err_has AddressSanitizer: heap-use-after-free
err_has in cool_gen_free_at
err_has in twice.d
err_absent unreachable
---
test asan_managed_uaf
mode run_raw
flags --sanitize=address
file examples/asan_managed_uaf.dusk
ok false
out 
err_has AddressSanitizer: heap-use-after-free
err_absent use of a freed or stale pointer
---
# The runtime's own records stay on the parking heap, so the reads of a retired
# future and a retired join record that are defined behavior stay quiet, and a
# second join is still the named fault.
test asan_late_complete_ok
mode run_raw
flags --sanitize=address
file examples/asan_late_complete_ok.dusk
ok true
out 4\nfuture already completed\n
err_absent AddressSanitizer
---
test asan_double_join_fault
mode run_raw
flags --sanitize=address
file examples/doublejoin.dusk
ok false
out once\n
err_has use of a freed or stale pointer
err_absent AddressSanitizer
---
# The collector's scan reads stack redzones and other threads' blocks by design and
# is left uninstrumented, the sanitizer's fake stacks are off by default so a root
# on the stack is seen, and a real free waits for a scan in progress.
test asan_collector_stress_ok
mode run_raw
flags --sanitize=address
file examples/gcstress.dusk
ok true
out 19900\n
err_absent AddressSanitizer
---
test asan_collector_async_ok
mode run_raw
flags --sanitize=address
file examples/gcasync.dusk
ok true
out 100\n20\n3\n123\n
err_absent AddressSanitizer
---
test asan_collector_root_ok
mode run_raw
flags --sanitize=address
file examples/stdcollector.dusk
ok true
out 9\n72\n1\n28\n99\nok\n
err_absent AddressSanitizer
---
# The two flags compose: the leak report of a --heap-sites build is unchanged under
# address.
test asan_sites_report
mode run_raw
flags --sanitize=address --heap-sites
file examples/sites_basic.dusk
ok true
out leftright\nleftright\nleftright\n1\n
err_eq dusk heap: 5 blocks, 86 bytes live, 3 sites\n      1 block        32 bytes  examples/sites_basic.dusk:14\n      3 blocks       30 bytes  examples/sites_basic.dusk:10\n      1 block        24 bytes  examples/sites_basic.dusk:13\n
---
# Under thread the heap still parks its blocks, and a race on a generational heap
# block is reported in the dusk function that writes it.
test tsan_heap_race
mode run_raw
flags --sanitize=thread
file examples/tsan_heap_race.dusk
ok false
out true\n
err_has ThreadSanitizer: data race
err_has bump.d
---
---
# A closure's capture set follows the checker's scoping, so a stored closure whose
# only use of a frame slice's name is its own binder carries no environment in the
# frame it outlives, and AddressSanitizer sees no read after that frame returned.
test asan_capture_scoped_ok
mode run_raw
flags --sanitize=address
file examples/capshadow_for_ok.dusk
ok true
out 1\n3\n
err_absent AddressSanitizer
---
test asan_capshadow_ok
mode run_raw
flags --sanitize=address
file examples/capshadow_ok.dusk
ok true
out 1\n42\n
err_absent AddressSanitizer
---
# A datagram read as a string is terminated inside its buffer.
test asan_udp_round6_ok
mode run_raw
flags --sanitize=address
file examples/udp_round6.dusk
ok true
out 4\ntrue\nping\n
err_absent AddressSanitizer
---
test asan_anet_udp_ok
mode run_raw
flags --sanitize=address
file examples/anet_udp.dusk
ok true
out 4\ntrue\npong\n
err_absent AddressSanitizer
