# The parse dump proves the step reaches the tree: a range head carries its step in
# the node the expression grammar built, printed as one more line under the range, and
# a head written without a step prints exactly the range every earlier release did.
test forrange_parse_shows_by
mode tool
argv parse examples/forrange_step2.dusk
out Module {\n    paradigms: [\n        "procedural",\n    ],\n    imports: [],\n    monads: [],\n    items: [\n        Func(\n            Func {\n                exported: false,\n                is_async: false,\n                owning: false,\n                name: "main",\n                span: Span {\n                    lo: 263,\n                    hi: 267,\n                },\n                generics: [],\n                params: [],\n                ret: Named(\n                    "int32",\n                    [],\n                ),\n                body: Block {\n                    stmts: [\n                        For(\n                            For {\n                                var: "i",\n                                iter: Expr {\n                                    kind: Range(\n                                        Expr {\n                                            kind: Int(\n                                                0,\n                                                None,\n                                            ),\n                                            span: Span {\n                                                lo: 294,\n                                                hi: 295,\n                                            },\n                                        },\n                                        Expr {\n                                            kind: Int(\n                                                10,\n                                                None,\n                                            ),\n                                            span: Span {\n                                                lo: 297,\n                                                hi: 299,\n                                            },\n                                        },\n                                        false,\n                                        by: 2,\n                                    ),\n                                    span: Span {\n                                        lo: 294,\n                                        hi: 299,\n                                    },\n                                },\n                                body: Block {\n                                    stmts: [\n                                        Expr(\n                                            Expr {\n                                                kind: Call(\n                                                    Expr {\n                                                        kind: Ident(\n                                                            "println",\n                                                        ),\n                                                        span: Span {\n                                                            lo: 315,\n                                                            hi: 322,\n                                                        },\n                                                    },\n                                                    [\n                                                        Expr {\n                                                            kind: Ident(\n                                                                "i",\n                                                            ),\n                                                            span: Span {\n                                                                lo: 323,\n                                                                hi: 324,\n                                                            },\n                                                        },\n                                                    ],\n                                                ),\n                                                span: Span {\n                                                    lo: 315,\n                                                    hi: 325,\n                                                },\n                                            },\n                                        ),\n                                    ],\n                                },\n                            },\n                        ),\n                        Return(\n                            Some(\n                                Expr {\n                                    kind: Int(\n                                        0,\n                                        None,\n                                    ),\n                                    span: Span {\n                                        lo: 343,\n                                        hi: 344,\n                                    },\n                                },\n                            ),\n                        ),\n                    ],\n                },\n            },\n        ),\n    ],\n}\n
