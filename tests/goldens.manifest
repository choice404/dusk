---
# doc --json span keys (1.7.1 W8): every item object and every doc object carries a
# span {lo, hi, line, col} of file-local byte offsets and a 1 based line and scalar
# column. This example locks the shape across every declaration form: function,
# struct, enum, interface method, impl head and method, and monad method.
test docjson_spans
mode tool
argv doc --json examples/docjson_spans.dusk
out {\n  "module": "docjson_spans",\n  "file": "examples/docjson_spans.dusk",\n  "paradigms": [\n    "procedural"\n  ],\n  "doc": {\n    "span": {"lo": 0, "hi": 218, "line": 1, "col": 1},\n    "summary": "The docjson_spans module pins a span object on every declaration form the JSON doc face emits: a function, a struct, an enum, an interface and its method, an impl head and its method, and a monad method.",\n    "body": "",\n    "params": [],\n    "return": null,\n    "examples": []\n  },\n  "funcs": [\n    {\n      "name": "twice",\n      "span": {"lo": 324, "hi": 329, "line": 9, "col": 6},\n      "exported": false,\n      "async": false,\n      "owning": false,\n      "generics": [],\n      "params": [\n        {"name": "x", "type": "int64", "using": false}\n      ],\n      "return": "int64",\n      "signature": "func twice(x: int64) -> int64",\n      "doc": {\n        "span": {"lo": 241, "hi": 318, "line": 6, "col": 1},\n        "summary": "Doubles a number.",\n        "body": "",\n        "params": [\n          {"name": "x", "desc": "the value to double"}\n        ],\n        "return": "twice x",\n        "examples": []\n      }\n    },\n    {\n      "name": "Box.unit",\n      "span": {"lo": 1009, "hi": 1013, "line": 46, "col": 17},\n      "exported": true,\n      "async": false,\n      "owning": false,\n      "generics": [\n        "A"\n      ],\n      "params": [\n        {"name": "x", "type": "A", "using": false}\n      ],\n      "return": "Box<A>",\n      "signature": "export func Box.unit<A>(x: A) -> Box<A>",\n      "doc": {\n        "span": {"lo": 888, "hi": 992, "line": 43, "col": 5},\n        "summary": "unit lifts a value into a Box.",\n        "body": "",\n        "params": [\n          {"name": "x", "desc": "the value to lift"}\n        ],\n        "return": "a Box holding x",\n        "examples": []\n      }\n    },\n    {\n      "name": "Box.bind",\n      "span": {"lo": 1085, "hi": 1089, "line": 49, "col": 17},\n      "exported": true,\n      "async": false,\n      "owning": false,\n      "generics": [\n        "A",\n        "B"\n      ],\n      "params": [\n        {"name": "m", "type": "Box<A>", "using": false},\n        {"name": "f", "type": "(A) -> Box<B>", "using": false}\n      ],\n      "return": "Box<B>",\n      "signature": "export func Box.bind<A, B>(m: Box<A>, f: (A) -> Box<B>) -> Box<B>",\n      "doc": null\n    },\n    {\n      "name": "main",\n      "span": {"lo": 1173, "hi": 1177, "line": 54, "col": 6},\n      "exported": false,\n      "async": false,\n      "owning": false,\n      "generics": [],\n      "params": [],\n      "return": "int32",\n      "signature": "func main() -> int32",\n      "doc": null\n    }\n  ],\n  "structs": [\n    {\n      "name": "Pair",\n      "span": {"lo": 404, "hi": 408, "line": 14, "col": 8},\n      "exported": false,\n      "generics": [],\n      "fields": [\n        {"name": "a", "type": "int64"},\n        {"name": "b", "type": "int64"}\n      ],\n      "doc": {\n        "span": {"lo": 371, "hi": 396, "line": 13, "col": 1},\n        "summary": "A pair of numbers.",\n        "body": "",\n        "params": [],\n        "return": null,\n        "examples": []\n      }\n    },\n    {\n      "name": "Host",\n      "span": {"lo": 645, "hi": 649, "line": 31, "col": 8},\n      "exported": false,\n      "generics": [],\n      "fields": [\n        {"name": "id", "type": "int64"}\n      ],\n      "doc": null\n    }\n  ],\n  "enums": [\n    {\n      "name": "Shape",\n      "span": {"lo": 485, "hi": 490, "line": 20, "col": 6},\n      "exported": false,\n      "generics": [],\n      "variants": [\n        {"name": "Circle", "fields": []},\n        {"name": "Square", "fields": []}\n      ],\n      "doc": {\n        "span": {"lo": 442, "hi": 479, "line": 19, "col": 1},\n        "summary": "The shapes the renderer knows.",\n        "body": "",\n        "params": [],\n        "return": null,\n        "examples": []\n      }\n    }\n  ],\n  "interfaces": [\n    {\n      "name": "Greeter",\n      "span": {"lo": 562, "hi": 569, "line": 26, "col": 11},\n      "exported": false,\n      "generics": [],\n      "methods": [\n        {\n          "name": "greet",\n          "span": {"lo": 618, "hi": 623, "line": 28, "col": 5},\n          "params": [],\n          "return": "int64",\n          "signature": "greet() -> int64",\n          "doc": {\n            "span": {"lo": 576, "hi": 613, "line": 27, "col": 5},\n            "summary": "greet returns a greeting code.",\n            "body": "",\n            "params": [],\n            "return": null,\n            "examples": []\n          }\n        }\n      ],\n      "doc": {\n        "span": {"lo": 520, "hi": 551, "line": 25, "col": 1},\n        "summary": "Anything that can greet.",\n        "body": "",\n        "params": [],\n        "return": null,\n        "examples": []\n      }\n    }\n  ],\n  "impls": [\n    {\n      "interface": "Greeter",\n      "type": "Host",\n      "span": {"lo": 712, "hi": 716, "line": 34, "col": 1},\n      "methods": [\n        {\n          "name": "greet",\n          "span": {"lo": 821, "hi": 826, "line": 37, "col": 10},\n          "generics": [],\n          "params": [],\n          "return": "int64",\n          "signature": "func greet() -> int64",\n          "doc": {\n            "span": {"lo": 740, "hi": 811, "line": 35, "col": 5},\n            "summary": "greet on Host returns the host id.",\n            "body": "",\n            "params": [],\n            "return": "the stored id",\n            "examples": []\n          }\n        }\n      ],\n      "doc": {\n        "span": {"lo": 665, "hi": 711, "line": 33, "col": 1},\n        "summary": "Host greets by returning its stored id.",\n        "body": "",\n        "params": [],\n        "return": null,\n        "examples": []\n      }\n    }\n  ]\n}\n
