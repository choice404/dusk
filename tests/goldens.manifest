2",\n          "variadic": false,\n          "signature": "func puts(s: *raw char) -> int32",\n          "doc": {\n            "span": {"lo": 505, "hi": 563, "line": 17, "col": 5},\n            "summary": "Writes s and a trailing newline to standard output.",\n            "body": "",\n            "params": [],\n            "return": null,\n            "examples": []\n          }\n        },\n        {\n          "name": "snprintf",\n          "span": {"lo": 829, "hi": 837, "line": 27, "col": 10},\n          "params": [\n            {"name": "buf", "type": "*raw char", "using": false},\n            {"name": "size", "type": "int64", "using": false},\n            {"name": "fmt", "type": "*raw char", "using": false}\n          ],\n          "return": "int32",\n          "variadic": true,\n          "signature": "func snprintf(buf: *raw char, size: int64, fmt: *raw char, ...) -> int32",\n          "doc": {\n            "span": {"lo": 606, "hi": 819, "line": 20, "col": 5},\n            "summary": "Formats into a bounded buffer, the variadic case.",\n            "body": "",\n            "params": [\n              {"name": "buf", "desc": "the destination buffer"},\n              {"name": "size", "desc": "the buffer capacity in bytes"},\n              {"name": "fmt", "desc": "the printf style format string"}\n            ],\n            "return": null,\n            "examples": []\n          }\n        },\n        {\n          "name": "labs",\n          "span": {"lo": 907, "hi": 911, "line": 29, "col": 10},\n          "params": [\n            {"name": "n", "type": "int64", "using": false}\n          ],\n          "return": "int64",\n          "variadic": false,\n          "signature": "func labs(n: int64) -> int64",\n          "doc": null\n        }\n      ]\n    }\n  ]\n}\n
