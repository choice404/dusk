# One alias bound twice in one manifest is refused rather than resolved to whichever line
# came last, so an alias names one package for the whole project.
test a_manifest_that_requires_one_alias_twice_is_refused
mode check_fail
file tests/dawn/dupalias/src/main.dusk
err_has tests/dawn/dupalias/package.dawn:5: duplicate alias 'greet'
---
# std is reserved on the manifest side too: a require may not claim the alias the standard
# library answers to, which would have made an import under std ambiguous.
test a_require_claiming_the_std_alias_is_refused
mode check_fail
file tests/dawn/stdalias/src/main.dusk
err_has tests/dawn/stdalias/package.dawn:4: 'std' is reserved
---
# A @require takes an alias, a source, and a ref. A line short one word is refused naming
# the three it wanted and the count it got, rather than reading a ref off the wrong word.
test a_require_with_the_wrong_argument_count_is_refused
mode check_fail
file tests/dawn/arity/src/main.dusk
err_has tests/dawn/arity/package.dawn:4: @require takes 3 arguments (alias source ref), got 2
---
# A directive no dawn file knows is a mistake in the file, not something to skip: a
# misspelled @requires would otherwise drop a dependency silently.
test a_directive_no_dawn_file_knows_is_refused
mode check_fail
file tests/dawn/unknowndirective/src/main.dusk
err_has tests/dawn/unknowndirective/package.dawn:3: unknown directive '@requires'
---
# The checkout is there and matches its pin, and its own manifest names a root file that
# is not in it, so the alias has nothing to resolve to. Named against the importing file.
test a_dependency_with_no_entry_file_is_refused
mode check_fail
file tests/dawn/depnoroot/src/main.dusk
err_has tests/dawn/depnoroot/src/main.dusk: dependency 'greet' has no root file; add @root to its package.dawn
---
# The second review batch of project fixtures. Six of these are containment and
# agreement rules a dependency's own package.dawn must answer to, since a checkout is
# only as trustworthy as the lock that pinned it; the other three are the alias leaf
# form and the C source dedup key.

# An alias import may run one segment past the alias and name a symbol the package's
# root file exports, with no file of that name in the package. Same leaf form a local
# import already had, reached through an alias.
test an_alias_import_may_end_in_a_symbol_the_root_file_exports
mode run
file tests/dawn/leafalias/src/main.dusk
out hello from greet\n
---
# The twin: the same shape naming a symbol the package does not export is refused, and
# the refusal names the symbol and the package rather than reporting an unresolvable
# import, which is what the file plus leaf form looks like from the outside.
test an_alias_import_naming_a_symbol_the_package_does_not_export_is_refused
mode check_fail
file tests/dawn/leafmiss/src/main.dusk
err_has tests/dawn/leafmiss/src/main.dusk: import 'greet.no_such' names 'no_such', but 'greet' exports no such symbol
---
# A dependency's @root climbs out of its own checkout, and the file it names really is
# there, so nothing but the containment rule refuses it. A checkout may only compile
# files the lock stands behind.
test a_dependency_whose_root_climbs_out_of_its_checkout_is_refused
mode check_fail
file tests/dawn/rootescape/src/main.dusk
err_has tests/dawn/rootescape/src/main.dusk: dependency 'greet' names a root outside its checkout; fix @root in its package.dawn
---
# The same containment rule over @csource: a dependency may not hand clang a C file
# from outside its checkout, which would compile code no commit pinned.
test a_dependency_csource_outside_its_checkout_is_refused
mode check_fail
file tests/dawn/csrcescape/src/main.dusk
err_has dawn_modules/greet/package.dawn: dependency 'greet' names a C source outside its checkout; fix @csource in its package.dawn
---
# A dependency may name a library to link, never a path to one: a path would reach an
# object outside the checkout the same way an escaping csource does.
test a_dependency_link_naming_a_path_instead_of_a_library_is_refused
mode check_fail
file tests/dawn/linkpath/src/main.dusk
err_has dependency 'greet' names a link path; a dependency may only link a library by name
err_absent clang
---
# @package is what build --lib writes libNAME.a and NAME.h from, so the value is held to
# letters, digits, underscore and hyphen rather than passed through to a file name.
test a_package_value_that_is_not_a_package_name_is_refused
mode check_fail
file tests/dawn/pkgname/src/main.dusk
err_has tests/dawn/pkgname/package.dawn:1: @package value '../evil' is not a package name; use letters, digits, _ and -
---
# The project's lock pins util to a source the package that requires it never asked for,
# with a stamp that matches the lock, so every check that reads the lock alone passes it.
# The requirement it answers has to agree too, or a lock line can swap a dependency out.
test a_transitive_pin_the_requiring_package_never_asked_for_is_refused
mode check_fail
file tests/dawn/translockmismatch/src/main.dusk
err_has dawn_modules/mid/src/mid.dusk: dependency 'util' of 'mid' does not match dawn.lock; run dawn get
---
# A dependency whose own package.dawn does not read is refused with that file's own
# fault, spelled manifest relative so it reads the same on every machine, and the import
# that asked for it adds nothing vaguer over the top.
test a_dependency_whose_own_manifest_does_not_read_is_refused
mode check_fail
file tests/dawn/depbadmanifest/src/main.dusk
err_has dawn_modules/greet/package.dawn:3: expected a directive
err_absent tests/dawn/depbadmanifest/dawn_modules
---
# A dependency pinning a language surface this toolchain does not have is refused before
# a line of it is resolved through, under its own package.dawn and spelled manifest
# relative. The project's own @dusk floor is read before an import resolves, and this is
# that same reading one level down, so a checkout written for a newer dusk cannot be
# compiled as if it were written for this one.
test a_dependency_asking_for_a_newer_dusk_is_refused
mode check_fail
file tests/dawn/depdusktoonew/src/main.dusk
err_has dawn_modules/greet/package.dawn: package.dawn asks for dusk 9.9, this is 
err_absent tests/dawn/depdusktoonew/dawn_modules
---
# One C file named by package.dawn and by a source file under two different spellings.
# The dedup key is the file rather than the spelling, so clang compiles it once and the
# link sees one vendor_tag instead of failing on a duplicate symbol.
test one_c_file_named_by_a_manifest_and_a_source_compiles_once
mode run
file tests/dawn/csrcdouble/src/main.dusk
out 7\n
---
# A string literal has no allocation header in front of it, so the generational retire's
# read of the size word and its bump of the generation word land in read only memory and
# used to take the process down by signal with nothing named. The runtime tests the
# pointer against the loaded program image before it touches the block and aborts by
# name at the free itself. The heap string freed one line earlier is the precision half
# of the record: the guard names the constant and leaves a real allocation alone.
test freeliteral_fault
mode run_raw
file examples/freeliteral_fault.dusk
out abcd\nheap ok\nlit\n
ok false
err_has fatal: free of a string literal or other constant; it was never allocated
---
# Builtin fetches a fixture package, takes the fixture repository out of reach, and then
# fetches the same source into a second project, which only the bare mirror the first
# fetch left under DAWN_CACHE can answer.
test dawn_a_mirrored_source_fetches_again_with_nothing_to_reach
mode special
special dawn_cache_offline_get
---
# Builtin fetches a package that requires a package of its own and asserts dawn tree
# prints the root, both requirements at their depth with the commits the lock pinned, a
# deleted checkout marked as not fetched, and a requirement nothing locked marked as not
# locked.
test dawn_tree_prints_the_graph_the_manifest_and_the_lock_describe
mode special
special dawn_tree_prints_graph
---
# Builtin edits a file inside a fetched checkout, moves its head off the locked commit,
# and deletes it outright, asserting each time that the next get replaces the tree and
# says so rather than taking the stamp beside it at its word.
test dawn_a_checkout_that_no_longer_holds_its_commit_is_refetched
mode special
special dawn_tampered_checkout_refreshed
---
# An export is scoped to the package that wrote it and reaches another file only through
# that file's own import. These records are the reading of that rule from the compiler's
# side: what a bare name means in a file, what an alias reaches, and the two shapes that
# no scope can tell apart because the name leaves dusk.

# Two packages each export parse. The name a package exports is scoped to it, so the two
# qualified calls name two different functions and the program prints both.
test two_packages_exporting_one_name_are_told_apart_by_their_aliases
mode run
file tests/dawn/twodeps/src/main.dusk
out a parse\nb parse\n
---
# The twin: one file imports both packages, so both parses are in scope under one bare
# name. Naming it bare is refused against the two packages that exported it rather than
# resolved to whichever import came first.
test a_name_two_imported_packages_both_export_is_refused_bare
mode check_fail
file tests/dawn/twodepsbare/src/main.dusk
err_has 'parse' is exported by both 'a' and 'b'; qualify it
err_absent two packages cannot export one name
---
# An import is what puts a package's exports in scope, and once it has, the export answers
# to its bare name with no alias in front of it.
test an_imported_packages_export_answers_to_its_bare_name
mode run
file tests/dawn/bareimport/src/main.dusk
out maybe\n
---
# The twin, and the one shape 1.14.0 accepted that 1.14.1 refuses: the project's helper
# imports maybe and main does not, so the export is in scope in helper alone. Reaching it
# from main used to work because exports were global, and now the refusal names the
# package to import.
test a_dependency_export_reached_without_importing_it_is_refused
mode check_fail
file tests/dawn/barenoimport/src/main.dusk
err_has 'maybe_tag' is exported by package 'maybe'; import it
---
# A name in scope from an import is still only a name, so every local binding of it wins:
# a parameter, a let binding, a for binder, and a match arm binder each print their own
# value, and the dependency's function is still there through the alias.
test a_local_binding_wins_over_an_imported_packages_export
mode run
file tests/dawn/shadowlocal/src/main.dusk
out param\nlet\nfor\narm\ndep\n
---
# A package is one scope. Its src/b.dusk never imports its src/a.dusk and still calls that
# sibling's export by its bare name, which is what makes a multi file package one unit
# rather than a set of files that have to import each other.
test a_packages_own_file_reaches_a_siblings_export_without_importing_it
mode run
file tests/dawn/sibling/src/main.dusk
out b over a\n
---
# Every kind of name a package exports crosses the import: a struct in an annotation, in a
# literal, and as a generic argument, a function taking it, an interface a local struct
# implements, a method an impl in the package gave that struct, and an enum with its
# variants named bare.
test every_kind_of_exported_name_reaches_the_importing_file
mode run
file tests/dawn/deptypes/src/main.dusk
out 3\n6\n4\n5\nred\n
---
# The type twin: two packages export an enum named Color and both spell a variant Red. The
# bare name names neither, and the refusal names both packages rather than picking the
# enum whose variant matched.
test an_enum_two_imported_packages_both_export_is_refused_bare
mode check_fail
file tests/dawn/dupenum/src/main.dusk
err_has 'Color' is exported by both 'left' and 'right'; qualify it
err_absent two packages cannot export one name
---
# An export "C" function keeps the symbol a C host calls, so it is the one export a
# package cannot scope. It stays reachable by its bare name from the importing file.
test a_c_export_keeps_its_bare_name_across_a_package_boundary
mode run
file tests/dawn/cabi/src/main.dusk
out 7\n
---
# The same C export named through the alias it was required under. A name that leaves dusk
# unscoped is still reached the ordinary way, so neither spelling of the call is a program
# the 1.14.1 scope rule takes away.
test a_c_export_is_still_reachable_through_its_alias
mode run
file tests/dawn/cabiqual/src/main.dusk
out 7\n
---
# Two packages export one C symbol. The linker sees both names as written, so no scope
# tells them apart and the program cannot be built. The collision refusal that covered
# every export in 1.14.0 is kept for exactly this class.
test one_c_symbol_exported_by_two_packages_is_refused
mode check_fail
file tests/dawn/cabitwo/src/main.dusk
err_has dawn_modules/two/src/two.dusk: 'cabi_tag' is also exported by 'dawn_modules/one/src/one.dusk'; two packages cannot export one name
---
# A do block over a dependency's monad: the type, its bind, and its unit all come from the
# package, and the package's own generic do block runs inside the same program against the
# bare bind and unit it exports.
test a_do_block_over_a_dependencys_monad_runs
mode run
file tests/dawn/depmonad/src/main.dusk
out 7\n21\n
---
# bind and unit are the generic do protocol and a do block reaches them by their bare
# names, so they are the other class no scope can tell apart. Two packages exporting a
# bind is refused the way one name exported twice always was.
test the_do_protocol_pair_exported_by_two_packages_is_refused
mode check_fail
file tests/dawn/monadbind/src/main.dusk
err_has dawn_modules/q1/src/q1.dusk: 'bind' is also exported by 'dawn_modules/p1/src/p1.dusk'; two packages cannot export one name
---
# The leaf form binds the one symbol it names and nothing else the package exports, so the
# package's other export is not in scope in the importing file and the refusal names the
# package to import.
test a_leaf_import_does_not_bring_the_packages_other_exports
mode check_fail
file tests/dawn/leafother/src/main.dusk
err_has 'greet_other' is exported by package 'greet'; import it
---
# path_dirname's "." branch and path_extension's empty branch each used to hand back a
# string literal under a contract that says the caller owns and frees the result, so
# freeing one reached into read only memory. Both fallbacks return a heap copy now, and
# this record frees all four results, the two fallback branches and the two ordinary ones,
# and exits clean.
test fs_literal_free_ok
mode run
file examples/fs_literal_free_ok.dusk
out .\n0\na/b\ntxt\nok\n
---
# The 1.14.1 reading of the scope rule at its edges: the names no rename may move, the
# names a rename does move, and the two prefixes that name more than one thing. Each of
# these is a static fixture under tests/dawn/, so nothing here fetches anything.

# A builtin name is fixed for every rename, so a dependency's export keeps the spelling
# resolve reserves and is refused at the declaration. Renamed, the dependency's print and
# free would have answered every bare print and free in the file that imported it, and the
# free would have leaked rather than freed.
test a_dependency_exporting_a_builtins_name_is_refused
mode check_fail
