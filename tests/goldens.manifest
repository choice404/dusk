out {\n  "file": "examples/checkjson_type_error.dusk",\n  "ok": false,\n  "diagnostics": [\n    {\n      "file": "examples/checkjson_type_error.dusk",\n      "severity": "error",\n      "message": "return type does not match the function's return type",\n      "span": {\n        "lo": 55,\n        "hi": 69,\n        "line": 4,\n        "col": 12,\n        "end_line": 4,\n        "end_col": 26\n      }\n    }\n  ]\n}\n
