# doc --json (1.6.1 W7): the same schema every consumer reads, two space indent,
# fixed key order, null for an absent doc block, source order arrays. It shares
# clidoc's error surface exactly with markdown: any fault prints to stderr and
# exits 1 with nothing on stdout.
test doc_json_basic
mode tool
argv doc --json examples/doc_attach_basic.dusk
out {\n  "module": "doc_attach_basic",\n  "file": "examples/doc_attach_basic.dusk",\n  "paradigms": [\n    "procedural"\n  ],\n  "doc": {\n    "span": {"lo": 0, "hi": 294, "line": 1, "col": 1},\n    "summary": "The doc_attach_basic module shows every place a doc block binds: the module itself, a top-level function, a struct, an enum, an interface and its method, an impl method, and a monad method. It also mixes the gutter and non-gutter styles and puts an at-word inside an example.",\n    "body": "",\n    "params": [],\n    "return": null,\n    "examples": []\n  },\n  "funcs": [\n    {\n      "name": "add",\n      "span": {"lo": 461, "hi": 464, "line": 12, "col": 6},\n      "exported": false,\n      "async": false,\n      "owning": false,\n      "generics": [],\n      "params": [\n        {"name": "a", "type": "int64", "using": false},\n        {"name": "b", "type": "int64", "using": false}\n      ],\n      "return": "int64",\n      "signature": "func add(a: int64, b: int64) -> int64",\n      "doc": {\n        "span": {"lo": 317, "hi": 455, "line": 7, "col": 1},\n        "summary": "Adds two numbers, in the gutter style.",\n        "body": "",\n        "params": [\n          {"name": "a", "desc": "the first addend"},\n          {"name": "b", "desc": "the second addend"}\n        ],\n        "return": "the sum of a and b",\n        "examples": []\n      }\n    },\n    {\n      "name": "Box.unit",\n      "span": {"lo": 1233, "hi": 1237, "line": 53, "col": 17},\n      "exported": true,\n      "async": false,\n      "owning": false,\n      "generics": [\n        "A"\n      ],\n      "params": [\n        {"name": "x", "type": "A", "using": false}\n      ],\n      "return": "Box<A>",\n      "signature": "export func Box.unit<A>(x: A) -> Box<A>",\n      "doc": {\n        "span": {"lo": 1112, "hi": 1216, "line": 50, "col": 5},\n        "summary": "unit lifts a value into a Box.",\n        "body": "",\n        "params": [\n          {"name": "x", "desc": "the value to lift"}\n        ],\n        "return": "a Box holding x",\n        "examples": []\n      }\n    },\n    {\n      "name": "Box.bind",\n      "span": {"lo": 1309, "hi": 1313, "line": 56, "col": 17},\n      "exported": true,\n      "async": false,\n      "owning": false,\n      "generics": [\n        "A",\n        "B"\n      ],\n      "params": [\n        {"name": "m", "type": "Box<A>", "using": false},\n        {"name": "f", "type": "(A) -> Box<B>", "using": false}\n      ],\n      "return": "Box<B>",\n      "signature": "export func Box.bind<A, B>(m: Box<A>, f: (A) -> Box<B>) -> Box<B>",\n      "doc": null\n    },\n    {\n      "name": "main",\n      "span": {"lo": 1397, "hi": 1401, "line": 61, "col": 6},\n      "exported": false,\n      "async": false,\n      "owning": false,\n      "generics": [],\n      "params": [],\n      "return": "int32",\n      "signature": "func main() -> int32",\n      "doc": null\n    }\n  ],\n  "structs": [\n    {\n      "name": "Point",\n      "span": {"lo": 578, "hi": 583, "line": 17, "col": 8},\n      "exported": false,\n      "generics": [],\n      "fields": [\n        {"name": "x", "type": "int64"},\n        {"name": "y", "type": "int64"}\n      ],\n      "doc": {\n        "span": {"lo": 516, "hi": 570, "line": 16, "col": 1},\n        "summary": "A point in the plane, compact non-gutter style.",\n        "body": "",\n        "params": [],\n        "return": null,\n        "examples": []\n      }\n    },\n    {\n      "name": "Host",\n      "span": {"lo": 916, "hi": 920, "line": 39, "col": 8},\n      "exported": false,\n      "generics": [],\n      "fields": [\n        {"name": "id", "type": "int64"}\n      ],\n      "doc": null\n    }\n  ],\n  "enums": [\n    {\n      "name": "Shape",\n      "span": {"lo": 756, "hi": 761, "line": 28, "col": 6},\n      "exported": false,\n      "generics": [],\n      "variants": [\n        {"name": "Circle", "fields": []},\n        {"name": "Square", "fields": []}\n      ],\n      "doc": {\n        "span": {"lo": 617, "hi": 749, "line": 22, "col": 1},\n        "summary": "The shapes the renderer knows.",\n        "body": "",\n        "params": [],\n        "return": null,\n        "examples": [\n          "s := Shape.Circle\\n@import std.io is content inside an example, not a tag"\n        ]\n      }\n    }\n  ],\n  "interfaces": [\n    {\n      "name": "Greeter",\n      "span": {"lo": 833, "hi": 840, "line": 34, "col": 11},\n      "exported": false,\n      "generics": [],\n      "methods": [\n        {\n          "name": "greet",\n          "span": {"lo": 889, "hi": 894, "line": 36, "col": 5},\n          "params": [],\n          "return": "int64",\n          "signature": "greet() -> int64",\n          "doc": {\n            "span": {"lo": 847, "hi": 884, "line": 35, "col": 5},\n            "summary": "greet returns a greeting code.",\n            "body": "",\n            "params": [],\n            "return": null,\n            "examples": []\n          }\n        }\n      ],\n      "doc": {\n        "span": {"lo": 791, "hi": 822, "line": 33, "col": 1},\n        "summary": "Anything that can greet.",\n        "body": "",\n        "params": [],\n        "return": null,\n        "examples": []\n      }\n    }\n  ],\n  "impls": [\n    {\n      "interface": "Greeter",\n      "type": "Host",\n      "span": {"lo": 936, "hi": 940, "line": 41, "col": 1},\n      "methods": [\n        {\n          "name": "greet",\n          "span": {"lo": 1045, "hi": 1050, "line": 44, "col": 10},\n          "generics": [],\n          "params": [],\n          "return": "int64",\n          "signature": "func greet() -> int64",\n          "doc": {\n            "span": {"lo": 964, "hi": 1035, "line": 42, "col": 5},\n            "summary": "greet on Host returns the host id.",\n            "body": "",\n            "params": [],\n            "return": "the stored id",\n            "examples": []\n          }\n        }\n      ],\n      "doc": null\n    }\n  ]\n}\n
