err_has duplicate definition of 'foo
---
# The release build. --release reaches clang and stops there, so what a record can pin
# about it is that the compiler takes the flag, links with it, and comes out clean; the
# proof that it changes no emitted byte is the dump differential rather than a golden.
test build_release_links_the_module_and_the_runtime_at_o2
mode tool
argv build --release examples/hello.dusk
out 
code 0
---
# The two build flags compose in either order. The archive takes the same level for the
# module object, the runtime objects, and every @csource object inside it.
test build_release_composes_with_lib
mode tool
argv build --lib --release examples/embed_lib.dusk
out [dusk] archive : target/dusk-out/libembed_lib.a\n[dusk] header  : target/dusk-out/embed_lib.h\n
code 0
---
# run stays at -O0 and forwards everything after the file to the program being run, so a
# --release written in front of the file is refused by name rather than read as a file.
test run_takes_no_release_flag
mode run_raw
file --release
args examples/hello.dusk
out 
ok false
err_eq dusk: run takes no --release; build --release <file>, then run target/dusk-out/<stem>\n
---
# A mistyped flag is named where it is written, rather than taken for a source file the
# loader then reports it cannot read.
test build_refuses_an_unknown_flag
mode tool
argv build --relase examples/hello.dusk
out 
code 1
---
