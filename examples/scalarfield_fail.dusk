// A field read off a scalar is refused at check. An int64 carries no member, so
// `a.f` has nothing to read and no lowering: before this rule the file passed
// `dusk check` clean and died in codegen as an `unsupported field expression`
// naming no file and no line. The chain reports once, at its first link.
@paradigm procedural

func main() -> int32 {
    a: int64 = 5
    x: int64 = a.f.f.f
    println("{}", x)
    return 0
}
