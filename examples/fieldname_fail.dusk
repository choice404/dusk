@paradigm procedural

// A field the struct does not declare. The read answered the checker's wildcard, so check
// passed and the build died as `unsupported field expression` naming no file and no line.
// The declaration is in the sig table, so the name is judged where it is written; dusk has
// no field inheritance, so a struct's own list is the whole list.
struct S { n: int64 }

func main() -> int32 {
    p: *S = alloc(S { n: 1 })
    println((*p).nofield)
    free(p)
    return 0
}
