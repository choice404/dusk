// A generic body cannot be width checked while its parameter is still a hole,
// so the surface pass lets the mix through and the ground pass, which runs the
// type class again after mono makes every type concrete, is what rejects the
// unsigned instantiation.
@paradigm procedural

func scale<T>(v: T, k: int32) -> T {
    return v * k
}

func main() -> int32 {
    ticks: uint32 = 5
    println(scale(ticks, 3))
    return 0
}
