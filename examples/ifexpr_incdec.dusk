@paradigm procedural

// A branch whose whole text is `n++` yields a value like any other branch. The parser
// folds a statement that is one increment back into a compound assignment, since a
// discarded value cannot tell the two forms apart, and a branch tail is not discarded,
// so the operator comes back as the expression it was written as: postfix hands back the
// value the place held, prefix the value it now holds.
func main() -> int32 {
    mut n: int64 = 5
    c: bool = true
    v: int64 = if c { n++ } else { n-- }
    println(v)
    println(n)
    w: int64 = c ? 1 : n--
    println(w)
    println(n)
    x: int64 = if !c { n++ } else { --n }
    println(x)
    println(n)
    return 0
}
