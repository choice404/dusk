@paradigm procedural
@paradigm oop
@import std.string
@import std.vector

struct Name { text: string }
impl Name {
    func read() -> string { return self.text }
    func copied() -> string { return substring(self.text, 0, str_len(self.text)) }
    func me() -> Name { return Name { text: self.text } }
}
func main() -> int32 {
    name: Name = Name { text: substring("hello", 0, 5) }
    entries: *Vector<Name> = alloc(vec_new())
    vec_push(entries, name)
    println(name.me().read())
    println(vec_get(entries, 0).read())
    copied := name.me().copied()
    println(copied)
    free(copied)
    free(name.text)
    vec_free(entries)
    free(entries)
    return 0
}
