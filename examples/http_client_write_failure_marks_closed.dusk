// A write failure marks the Conn closed like every other error. The client's own write
// side is shut down before the send, so the request write fails with Broken pipe, never a
// fault since the runtime ignores SIGPIPE, and conn_send hands back the error beside an
// empty Response with the Conn closed. The raw server thread only waits for the close.
@paradigm procedural
@import std.net.http.client
@import std.fmt

func serve(lfd: int64) -> void {
    cfd, peer, ae := net_accept(lfd)
    if ae.exists() {
        printerr(ae)
        return
    }
    text, re := read_to_end(fd_reader(cfd))
    re.ignore()
    free(text)
    ce := net_close(cfd)
    ce.ignore()
    if addr_port(peer) == 0 {
        printerr("unexpected peer")
    }
}

func main() -> int32 {
    lfd, le := net_listen(addr_loopback(0), 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    bound, be := net_local_addr(lfd)
    be.ignore()
    t, te := spawn(lambda () -> void {
        serve(lfd)
    })
    if te.exists() {
        printerr(te)
        return 1
    }
    text: string = format("http://127.0.0.1:%d/", [arg_int(addr_port(bound))])
    u, pe := url_parse(text)
    pe.ignore()
    c, de := http_dial(u)
    if de.exists() {
        println(de)
    }
    se := net_shutdown_write((*c).fd)
    se.ignore()
    req: *Request = request_new("GET", "/")
    resp, e := conn_send(c, req)
    if e.exists() {
        println(e)
    }
    println((*resp).status)
    println((*c).is_open)
    response_free(resp)
    free(resp)
    request_free(req)
    free(req)
    ce := conn_close(c)
    ce.ignore()
    free(c)
    url_free(u)
    free(u)
    free(text)
    je := join(t)
    je.ignore()
    lc := net_close(lfd)
    lc.ignore()
    return 0
}
