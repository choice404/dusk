// A request line that stops partway is 408 Request Timeout once the read timeout runs
// out, where a connection that sends nothing at all is closed with no response; the
// partial line beside the timeout is what tells the two apart. The client's bytes wait
// in the accept queue before the server thread starts, so the server always finds them
// there and the 50ms timeout can only run out after them.
@paradigm procedural
@import std.net.http.server
@import std.concurrent.thread
@import std.fmt

func handle(req: *Request, ctx: int64) -> *Response {
    resp := response_new(200)
    response_set_body(resp, "ok")
    return resp
}

func main() -> int32 {
    lfd, le := net_listen(addr_loopback(0), 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    bound, be := net_local_addr(lfd)
    be.ignore()
    s := http_server_new(lfd)
    (*s).send_date = false
    (*s).read_timeout_ms = 50
    fd, de := net_dial(bound)
    if de.exists() {
        printerr(de)
        return 1
    }
    we := write_string(fd_writer(fd), "GET / HT")
    we.ignore()
    t, te := spawn(lambda () -> void {
        e := http_serve_one(s, 0, handle)
        if e.exists() {
            println(e)
        }
    })
    if te.exists() {
        printerr(te)
        return 1
    }
    reply, re := read_to_end(fd_reader(fd))
    re.ignore()
    je := join(t)
    je.ignore()
    q: string = format("%q", [arg_str(reply)])
    println(q)
    free(q)
    free(reply)
    ce := net_close(fd)
    ce.ignore()
    lc := net_close(lfd)
    lc.ignore()
    free(s)
    return 0
}
