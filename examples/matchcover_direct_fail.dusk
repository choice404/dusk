@paradigm procedural

// A payload free constructor matched where it is written. It is a field expression,
// not a call, so the coverage check had no call callee to read its enum from and no
// chain type either, and the match was left unjudged: at run time the value takes no
// arm and the program walks past it. The base of the field names the enum.
enum Opt { Some(n: int64), None }

func main() -> int32 {
    match Opt.None {
        Some(p) => { println(p) }
    }
    println(42)
    return 0
}
