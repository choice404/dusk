// send_date is true by default, so every response carries a Date field. The value
// changes every second, so the client parses the reply through the wire readers over a
// string_reader and prints only whether the field is there.
@paradigm procedural
@import std.net.http.server
@import std.concurrent.thread

func handle(req: *Request, ctx: int64) -> *Response {
    resp := response_new(200)
    response_set_body(resp, "ok")
    return resp
}

// Writes the request bytes and reads the whole reply
func exchange(a: Addr, request: string) -> string {
    fd, de := net_dial(a)
    if de.exists() {
        printerr(de)
        return substring("", 0, 0)
    }
    we := write_string(fd_writer(fd), request)
    we.ignore()
    reply, re := read_to_end(fd_reader(fd))
    re.ignore()
    ce := net_close(fd)
    ce.ignore()
    return reply
}

// Parses the status line and the header section of a reply and asks for one field
func has_field(reply: string, name: string) -> bool {
    c: *StringReader = alloc(string_reader_new(reply))
    b: *BufReader = bufreader_new(string_reader(c), 256)
    line, le := read_line_capped(b, 8192)
    le.ignore()
    resp, pe := parse_status_line(line)
    pe.ignore()
    free(line)
    he := read_headers(b, (*resp).headers, 65536, 100)
    he.ignore()
    found: bool = headers_has((*resp).headers, name)
    response_free(resp)
    free(resp)
    bufreader_free(b)
    free(b)
    free(c)
    return found
}

func main() -> int32 {
    lfd, le := net_listen(addr_loopback(0), 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    bound, be := net_local_addr(lfd)
    be.ignore()
    s := http_server_new(lfd)
    t, te := spawn(lambda () -> void {
        e := http_serve_one(s, 0, handle)
        if e.exists() {
            println(e)
        }
    })
    if te.exists() {
        printerr(te)
        return 1
    }
    reply := exchange(bound, "GET / HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
    je := join(t)
    je.ignore()
    println(has_field(reply, "Date"))
    free(reply)
    lc := net_close(lfd)
    lc.ignore()
    free(s)
    return 0
}
