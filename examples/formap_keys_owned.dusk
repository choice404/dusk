@paradigm procedural
@import std.map
@import std.vector

// The pre-container idiom still works: map_keys returns a fresh owned vector, and a
// container for iterates that vector. The classifier fires on the *Vector the call
// yields, and the owned copy is freed after the loop.
func main() -> int64 {
    m: *Map<string, int64> = alloc(map_new())
    map_put(m, "x", 1)
    map_put(m, "y", 2)
    map_put(m, "z", 3)
    ks: *Vector<string> = map_keys(m)
    for k in ks {
        println(k)
    }
    vec_free(ks)
    free(ks)
    map_free(m)
    free(m)
    return 0
}
