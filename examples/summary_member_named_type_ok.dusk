// A member of a generic struct typed by the struct's own type parameter, `struct W<T>`
// beside a declared `struct T`, read through `get(w: W<R>)` over heap rows builds and
// runs, and the method called is `R.rows_of`, the member's own
@paradigm procedural
@paradigm oop
@paradigm functional

struct T { rows: int64[] }
struct R { rows: int64[] }
struct W<T> { item: T }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

impl T {
    func rows_of() -> int64[] { return heap_rows() }
}
impl R {
    func rows_of() -> int64[] { return self.rows }
}

func get(w: W<R>) -> int64[] { return w.item.rows_of() }

func outer() -> int64[] {
    kept: int64[] = map(heap_rows(), lambda (value: int64) -> int64 { return value * 7 })
    return get(W { item: R { rows: kept } })
}

func main() -> int32 {
    println(outer()[0])
    return 0
}
