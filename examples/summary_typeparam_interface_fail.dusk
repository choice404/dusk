// Compile-fail: a generic helper's type parameter spelled like a declared interface,
// `Shape` beside `interface Shape`, is a value of that parameter, so `q.keep(xs)` is a
// call the summary cannot see into rather than the join of the interface's
// implementations. The helper may keep its slice argument, and a caller handing it a
// frame slice is refused
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

struct Plain { n: int64 }
interface Shape { keep(xs: int64[]) -> void }
impl Shape for Plain {
    func keep(xs: int64[]) -> void { }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func put<Shape>(q: Shape, xs: int64[]) -> void { q.keep(xs) }

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: h })
    put(s, local[0..4])
}

func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println(noise(1, 2))
    println((*h).rows[0])
    return 0
}
