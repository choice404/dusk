// 1.10.1 X1: an inferred `x := match` carries only the surface wildcard, so is_managed_ty
// cannot see the result is a managed pointer; without consulting the match ownership verdict
// the borrowed result laundered into x and freeing it double freed the caller's allocation.
// Both arms yield a borrow (the subject rt is a ref alias, b is a ref alias to p), so the
// match is a borrow and the free is refused.
@paradigm procedural

enum Node {
    Leaf(v: *int64),
    Empty,
}

func main() -> int64 {
    p := alloc(42)
    t := alloc(Node.Leaf(p))
    ref rt := t
    ref b := p
    x := match *rt {
        Leaf(w) => w,
        Empty => b,
    }
    println(*x)
    free(x)
    free(t)
    return 0
}
