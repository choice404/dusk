// The ambient allocator survives a suspension. One allocation runs before an await and one
// after; the poll re-enters at the await label and re-reads the allocator from the frame
// slot, so the second allocation still uses the arena rather than falling to the default
// heap. The arena reports 16 bytes (both allocations), plus the awaited value 5, so the
// program prints 21. A dropped allocator across the suspension would report 8 and print 13.
@paradigm procedural

@import std.memory.arena
@import std.async.future
@import std.async.loop

async func val(n: int64) -> int64 {
    return n
}

async func fill(using a: Arena) -> int64 {
    p: *int64 = alloc(1)
    *p = 1
    x := await val(5)
    q: *int64 = alloc(2)
    *q = 2
    return a.used + x
}

func main() -> int32 {
    ar: *Arena = alloc(arena_new(128))
    le := loop_init()
    le.ignore()
    r := async_run(fill(*ar))
    loop_free()
    println(r)
    arena_destroy(ar)
    free(ar)
    return 0
}
