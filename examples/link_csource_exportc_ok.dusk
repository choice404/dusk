@paradigm procedural

// The same C source against an export "C" function links and runs: export "C"
// keeps the function's symbol external under its own name, the one way a C file
// calls dusk by name.
@csource "link_csource_call.c"

foreign "C" {
    func c_calls_dusk(x: int64) -> int64
}

export "C" func dusk_twice(x: int64) -> int64 {
    return x * 2
}

func main() -> int32 {
    println(c_calls_dusk(20))
    return 0
}
