// addr_parse reads a dotted quad and two IPv6 literals and refuses a short quad
// and a host name, since it never looks a name up.
@paradigm procedural
@import std.net.addr

func show(text: string, port: int64) -> void {
    a, e := addr_parse(text, port)
    if e.exists() {
        println("error")
        return
    }
    s := addr_string(a)
    println(s)
    free(s)
}

func main() -> int64 {
    show("127.0.0.1", 80)
    show("::1", 443)
    show("2001:db8::1", 8443)
    show("1.2.3", 80)
    show("localhost", 80)
    return 0
}
