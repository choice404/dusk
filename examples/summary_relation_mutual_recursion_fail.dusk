// Compile-fail: two functions call each other and one of them relinks the sink to
// the caller's holder. The summary of the pair is computed together until it settles,
// so the relink reaches the caller and the later store is refused
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func ping(s: *Sink, h: *Holder, n: int64) -> void {
    if n == 0 {
        (*s).h = h
        return
    }
    pong(s, h, n - 1)
}

func pong(s: *Sink, h: *Holder, n: int64) -> void { ping(s, h, n) }

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    pong(s, h, 3)
    s.keep(local[0..4])
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
