@paradigm procedural
@import std.string
@import std.vector

struct Envelope<T> { value: T }

func read_name(names: *Vector<string>) -> Envelope<string> {
    return Envelope { value: vec_get(names, 0) }
}

func unwrap<U>(envelope: Envelope<U>) -> U { return envelope.value }

func main() -> int32 {
    names: *Vector<string> = alloc(vec_new())
    vec_push(names, substring("hello", 0, 5))
    text: string = unwrap(read_name(names))
    free(text)
    return 0
}
