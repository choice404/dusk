@paradigm procedural

// A negative step counts down, and the comparison flips with it: 10..0 by -3
// tests `i > 0`, so the binder takes 10, 7, 4, 1 and stops before crossing the
// bound. The bounds read low..high the same way whichever direction the step goes.
func main() -> int32 {
    for i in 10..0 by -3 {
        println(i)
    }
    return 0
}
