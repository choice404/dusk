// A branch of an if used as a value cannot yield a lambda. Codegen has no result slot for
// a closure minted inside the branch, the same hole a match arm has, so the checker
// rejects it first and points at the same fix: bind the function to a name outside the if
// and choose between the names.
@paradigm procedural

func run(c: bool, n: int64) -> int64 {
    f := if c { lambda (x: int64) -> int64 { return x + 1 } } else { lambda (x: int64) -> int64 { return x - 1 } }
    return f(n)
}

func main() -> int32 {
    return 0
}
