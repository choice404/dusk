// Same-type block shadow: an inner x shadows an outer x of the same type inside
// an if-block. Before the scope chain, codegen's flat locals map let the inner
// binding permanently clobber the outer slot, so the trailing print read the
// inner value (2) instead of the restored outer one (1). With per-block scopes
// the inner binding lives only inside the branch, so the outer x prints 1.
@paradigm procedural

func main() -> int64 {
    x: int64 = 1
    if true {
        x: int64 = 2
        println(x)
    }
    println(x)
    return 0
}
