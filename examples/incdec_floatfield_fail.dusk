@paradigm procedural

// The increment's operand rule needs the place's type, and a struct field read used to
// answer the wildcard, so this passed check and died in clang adding an integer 1 to a
// double. The field read carries its declared type now, so the float place is named where
// it is written, exactly as a float binding already was.
struct S { f: float64 }

func main() -> int32 {
    mut s: S = S { f: 1.5 }
    y := s.f++
    println(y)
    return 0
}
