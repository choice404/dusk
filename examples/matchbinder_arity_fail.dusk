@paradigm procedural

// A variant pattern that binds two names into a one field payload. The arity check ran
// only when the scrutinee's type named its enum, and a binding a constructor
// initialized infers unknown, so this went unjudged and the second binder reached
// codegen with nothing behind it. The scrutinee's enum is resolved from the expression
// now, and the count mismatch reads as the diagnostic it always was for a typed one.
enum Opt { Some(n: int64), None }

func main() -> int32 {
    o := Opt.Some(1)
    match o {
        Some(a, b) => { println(a) }
        None => { println(0) }
    }
    return 0
}
