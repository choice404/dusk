@paradigm procedural

// The same masking through a parameter that repeats a variant name. The parameter owns
// the name inside this function, so the call is an indirect call through it.
enum Tag { Some(n: int64), None }

func mk(Some: (int64[]) -> int64[]) -> int64[] {
    local: int64[4] = [1, 2, 3, 4]
    r := Some(local[0..4])
    return r
}

func main() -> int32 {
    v := mk(lambda (xs: int64[]) -> int64[] { return xs })
    println(v[0])
    return 0
}
