// A match arm calling an interface method sizes its result from the interface's declared
// method return, shared by every impl.
@paradigm oop
interface Shape {
    area() -> float64
}
struct Circ { r: float64 }
impl Shape for Circ {
    func area() -> float64 { return self.r * self.r * 3.0 }
}
enum E { A, B }
func main() -> int32 {
    e: E = E.A
    c: Circ = Circ { r: 1.5 }
    s: Shape = c
    x := match e { A => s.area(), B => s.area() }
    println("{}", x)
    return 0
}
