// The power operator sits in the same family: two integers, one result type, so
// the base and the exponent must agree on width and on signedness before there
// is a type to give the result.
@paradigm procedural

func main() -> int32 {
    base: uint32 = 2
    exponent: int32 = 3
    println(base ** exponent)
    return 0
}
