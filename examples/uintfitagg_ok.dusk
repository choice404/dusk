// The accept twin of the aggregate literal rejects. Every literal here sits at or
// inside the edge of the type it is written into, an array element, a nested
// element, a destructure binder, a tuple member, a struct field, a match arm tail,
// and an operand, so the raised ranges must still take all of it and print the
// values unchanged.
@paradigm procedural

enum Pick {
    First,
    Second,
}

struct Box {
    cells: uint8[2],
}

func take(xs: uint8[]) -> uint8 {
    return xs[0]
}

func edges() -> (uint8, int8) {
    return (250, -128)
}

func main() -> int32 {
    p := Pick.First
    xs: uint8[2] = [255, 0]
    ys: int8[2] = [-128, 127]
    grid: uint8[2][2] = [[1, 2], [3, 255]]
    n: uint8, m: int8 := (255, -128)
    t: (uint8, int8) = (0, 127)
    b := Box { cells: [7, 8] }
    u: uint32 = 5
    s: int8 = 3
    picked: uint8 = match p {
        First  => 255,
        Second => 0,
    }
    println(take(xs[0..2]))
    println(ys[0])
    println(grid[1][1])
    println(n)
    println(m)
    println(b.cells[1])
    println(picked)
    println(u + 1)
    println(4294967295 - u)
    println(s + 124)
    println(s << 4)
    a2, b2 := t
    println(a2)
    println(b2)
    c2, d2 := edges()
    println(c2)
    println(d2)
    return 0
}
