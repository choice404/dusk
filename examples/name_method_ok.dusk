@paradigm procedural
@paradigm oop

// Only top level functions meet the reserved names. A method is emitted as
// Type.name, which no C symbol can spell, so a method may be called strlen or
// carry the cool_ prefix.
struct Text {
    n: int64,
}

impl Text {
    func strlen() -> int64 {
        return self.n
    }
    func cool_size() -> int64 {
        return self.n * 2
    }
}

func main() -> int32 {
    t := Text { n: 4 }
    println(t.strlen())
    println(t.cool_size())
    return 0
}
