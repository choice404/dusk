// An IPv4 address built from its octets formats through inet_ntop, reads its
// port back, and takes a new port in a copy while the original keeps its own.
@paradigm procedural
@import std.net.addr

func main() -> int64 {
    a := addr_ip4(127, 0, 0, 1, 8080)
    s := addr_string(a)
    println(s)
    free(s)
    println(addr_port(a))
    b := addr_with_port(a, 9090)
    t := addr_string(b)
    println(t)
    free(t)
    return 0
}
