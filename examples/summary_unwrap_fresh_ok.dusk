@paradigm procedural
@import std.string
@import std.functional.maybe

struct Box { value: int64 }
func find_text(isFound: bool) -> Maybe<string> {
    if isFound { return Maybe.Some(substring("abc", 0, 3)) }
    return Maybe.None
}
func find_box(isFound: bool) -> Maybe<*Box> {
    if isFound { return Maybe.Some(alloc(Box { value: 3 })) }
    return Maybe.None
}
func main() -> int32 {
    text := unwrap_or(find_text(true), substring("d", 0, 1))
    println(text)
    free(text)
    box := unwrap_or(find_box(true), alloc(Box { value: 0 }))
    println((*box).value)
    free(box)
    fallback := unwrap_or(find_text(false), substring("d", 0, 1))
    println(fallback)
    free(fallback)
    payload := unwrap_or(Maybe.Some(substring("fresh", 0, 5)), "")
    println(payload)
    free(payload)
    return 0
}
