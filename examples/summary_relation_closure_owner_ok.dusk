// A lambda hands back the frame's own sink, and a frame view is stored through the
// result. The lambda reaches nothing outside the frame, so the store is legal.
// Prints 444
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func main() -> int32 {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    g := lambda () -> *Sink { return s }
    t: *Sink = g()
    t.keep(local[0..4])
    println((*(*s).h).rows[3])
    return 0
}
