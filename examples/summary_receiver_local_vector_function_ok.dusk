@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Rows { items: *Vector<int64[]> }
impl Rows {
    func add(xs: int64[]) -> void { vec_push(self.items, xs) }
    func count() -> int64 { return vec_len(self.items) }
}
func rows_add(r: Rows, xs: int64[]) -> void { vec_push(r.items, xs) }
func rows_addp(r: *Rows, xs: int64[]) -> void { vec_push((*r).items, xs) }
func main() -> int32 {
    local: int64[4] = [1, 2, 3, 4]
    items: *Vector<int64[]> = alloc(vec_new())
    r: Rows = Rows { items: items }
    rows_add(r, local[0..4])
    println(r.count())
    return 0
}
