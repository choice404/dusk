@paradigm procedural
@import std.string
@import std.vector

func mk() -> *Vector<string> {
    v: *Vector<string> = alloc(vec_new())
    vec_push(v, substring("alice-in-wonderland", 0, 19))
    return v
}
func f(v: *Vector<int64>) -> void {
    if vec_len(v) > 0 {
        v := mk()
        s := vec_get(v, 0)
        free(s)
        t: string = substring("s3cr3t-s3cr3t-s3cr3", 0, 19)
        println(vec_get(v, 0))
        free(t)
    }
}
func main() -> int32 {
    names: *Vector<int64> = alloc(vec_new())
    vec_push(names, 1)
    f(names)
    return 0
}
