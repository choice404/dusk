// The accept twin of arrlitlen_fail. Every array literal here writes exactly the
// count its fixed length holds, at each position the literal fit walk reaches: a
// binding, an element inside a nested literal, a struct field, a call argument, a
// return, and an assignment. The shapes the length rule must leave alone are here
// too: a literal coerced to a slice takes its own length, a string literal fills a
// char array by its own byte rule, an array of slices counts its slices and not
// their elements, and a fixed array bound from another fixed array value is not a
// literal at all.
@paradigm procedural

struct Grid {
    cells: int64[4],
}

func take(xs: int64[3]) -> int64 {
    return xs[0] + xs[2]
}

func mk() -> int64[4] {
    return [1, 2, 3, 4]
}

func main() -> int32 {
    exact: int64[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    nested: int64[2][2] = [[10, 20], [30, 40]]
    g := Grid { cells: [5, 6, 7, 8] }
    mut m: int64[3] = [1, 2, 3]
    m = [9, 8, 7]
    copied: int64[4] = mk()
    view: int64[] = [100, 200, 300]
    text: char[5] = "Hello"
    rows: int64[][2] = [view[0..3], view[1..2]]
    println(exact[7])
    println(nested[1][0])
    println(g.cells[3])
    println(m[0])
    println(copied[3])
    println(view[2])
    println(text)
    println(rows[1][0])
    println(take([11, 12, 13]))
    return 0
}
