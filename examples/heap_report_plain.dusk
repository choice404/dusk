@paradigm procedural

@import std.memory.heap

// heap_report prints the live totals to stderr, recomputed from the heap and
// checked against the counters. A build without allocation sites has no table by
// site, so the report says how to get one.
func main() -> int32 {
    s := "re" + "port"
    println(s)
    heap_report()
    free(s)
    return 0
}
