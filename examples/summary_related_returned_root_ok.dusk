// A maker that stores its parameter's view into the sink it returns, and returns it
// through that same sink only, is legal where the caller keeps the result in its
// own frame, and with heap rows anywhere
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fresh() -> *Sink {
    return alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

func mk(xs: int64[]) -> *Sink {
    s: *Sink = fresh()
    s.keep(xs)
    return s
}

func use_it() -> int64 {
    local: int64[4] = [5, 6, 7, 8]
    t: *Sink = mk(local[0..4])
    return (*(*t).h).rows[1]
}

func main() -> int32 {
    println(use_it())
    t: *Sink = mk(heap_rows())
    println((*(*t).h).rows[0])
    return 0
}
