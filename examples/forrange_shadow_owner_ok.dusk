@paradigm procedural

// The binder shadows an outer managed pointer of the same name. The ownership tables
// are keyed by name, so the loop declares the counter's own class: without that a plain
// copy of the counter reads as a copy of the pointer and is refused, and the pointer's
// state answers for the counter's. The pointer is still the outer name's after the
// loop, so it prints and frees there.
func main() -> int32 {
    i: *int64 = alloc(7)
    for i in 0..2 {
        j := i
        println(j)
    }
    println(*i)
    free(i)
    return 0
}
