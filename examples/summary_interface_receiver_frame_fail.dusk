@paradigm procedural
@paradigm oop
@paradigm functional
@import std.vector
@import std.functional.maybe
struct R { rows: int64[] }
impl R {
    func rows_of() -> int64[] { return self.rows }
    func me() -> R { return R { rows: self.rows } }
}
interface Viewer { view() -> int64[] }
impl Viewer for R { func view() -> int64[] { return self.rows } }
func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}

func make() -> int64[] {
    local: int64[4] = [111, 222, 333, 444]
    r: R = R { rows: local[0..4] }
    v: Viewer = r
    return v.view()
}

func main() -> int32 {
    xs: int64[] = make()
    println(noise(1, 2))
    println(xs[0])
    return 0
}
