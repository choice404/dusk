@paradigm procedural

// The counted loop in its plainest form: `for i in 0..5` walks the half open
// range the way a slice bound does, so the binder takes 0 through 4 and never
// reaches the upper bound. The binder is a fresh immutable int64 per iteration.
func main() -> int32 {
    for i in 0..5 {
        println(i)
    }
    return 0
}
