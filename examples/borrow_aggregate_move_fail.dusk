@paradigm procedural
@import std.string
@import std.vector
struct Box { n: int64 }
struct Rec { name: string, p: *Box }

func main() -> int32 {
    v: *Vector<Rec> = alloc(vec_new())
    vec_push(v, Rec { name: substring("alice-in-wonderland", 0, 19), p: alloc(Box { n: 1 }) })
    r := move(vec_get(v, 0))
    println(r.name)
    return 0
}
