@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Item { qty: int64, tags: int64[] }
impl Item {
    func total() -> int64 { return self.qty + self.tags.len }
    func bump(n: int64) -> Item { return Item { qty: self.qty + n, tags: self.tags } }
    func sum_with(xs: int64[]) -> int64 { return self.qty + xs[0] }
    func tagged() -> int64[] { return self.tags }
}
struct Wrap { it: Item }
interface Totals { total() -> int64 }
impl Totals for Wrap { func total() -> int64 { return self.it.total() } }
func pick<T>(a: T, b: T) -> T { return a }
func first_of<T>(v: *Vector<T>) -> T { return vec_get(v, 0) }
func second<A, B>(a: A, b: B) -> B { return b }

func main() -> int32 {
    items: *Vector<Item> = alloc(vec_new())
    vec_push(items, Item { qty: 4, tags: [] })
    vec_push(items, Item { qty: 5, tags: [] })
    local: int64[4] = [1, 2, 3, 4]
    if local[0] == 0 { return 1 }
    x := if local[0] == 1 { vec_get(items, 0) } else { vec_get(items, 1) }
    println(x.total())
    return 0
}
