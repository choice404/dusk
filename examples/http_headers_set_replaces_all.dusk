// headers_set removes every field of the name, both Host fields here, then appends the
// one copy, so the list holds exactly one Host after.
@paradigm procedural
@import std.net.http

func main() -> int32 {
    h := headers_new()
    headers_add(h, "Host", "a")
    headers_add(h, "host", "b")
    headers_set(h, "HOST", "c")
    println(vec_len(h))
    v, ok := headers_get(h, "Host")
    if ok {
        println(v)
    }
    headers_free(h)
    free(h)
    return 0
}
