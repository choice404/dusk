@paradigm procedural

// A C source that calls a dusk function by its bare name would reach the C
// library's function of that name instead, since the dusk function's symbol is
// internal: here the C library's getuid. The build refuses it by name.
@csource "link_csource_libc_name.c"

foreign "C" {
    func c_calls_getuid() -> int64
}

export func getuid() -> int32 {
    return -7
}

func main() -> int32 {
    println(getuid())
    println(c_calls_getuid() == -7)
    return 0
}
