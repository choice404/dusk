@paradigm procedural
@import std.string
@import std.vector

struct Wrap<T> { items: *Vector<T> }
func main() -> int32 {
    w: Wrap<string> = Wrap { items: alloc(vec_new()) }
    vec_push(w.items, substring("alice-in-wonderland", 0, 19))
    s := vec_get(w.items, 0)
    free(s)
    t: string = substring("s3cr3t-s3cr3t-s3cr3", 0, 19)
    println(vec_get(w.items, 0))
    free(t)
    return 0
}
