// The unsigned top has a spelling. A u suffixed literal names a bit pattern rather
// than a signed magnitude, so the values between int64's top and uint64's top are
// writable, and the widest of them round trips through a binding, a bare print, and
// arithmetic.
@paradigm procedural

func main() -> int32 {
    top: uint64 = 18446744073709551615u64
    half: uint64 = 9223372036854775808u64
    println(top)
    println(half)
    println(18446744073709551615u64)
    println(top - 1u64)
    return 0
}
