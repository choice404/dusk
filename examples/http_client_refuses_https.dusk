// The https scheme is refused with a named error before any lookup or socket, since this
// release ships no TLS; the Response beside the error is a real empty one, freed like any
// other.
@paradigm procedural
@import std.net.http.client

func main() -> int32 {
    resp, e := http_get("https://127.0.0.1:1/")
    if e.exists() {
        println(e)
    } else {
        println((*resp).status)
    }
    response_free(resp)
    free(resp)
    return 0
}
