@paradigm procedural
@paradigm oop

interface Raw { bytes() -> *raw char }
struct Record { bytes: () -> string, data: *raw char }
impl Raw for Record {
    func bytes() -> *raw char { return self.data }
}
func text() -> string { return "abc" }

func main() -> int32 {
    data: *raw char = alloc_bytes(4)
    data[0] = 97
    data[1] = 0
    data[2] = 99
    data[3] = 0
    first: Raw = Record { bytes: text, data: data }
    second: Record = Record { bytes: text, data: data }
    isFirst: bool = false
    bytes := (if isFirst { first } else { second }).bytes()
    println(int64(bytes[2]))
    free(data)
    return 0
}
