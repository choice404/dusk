// Compile-fail: a sink is relinked to the caller's holder on one branch only, then a
// method stores a view of a frame array through it. Whichever branch runs, the sink's
// holder may be the caller's, so the store is refused even though the relink sits
// in an if the checker cannot decide
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    if local[0] > 0 { relink(s, h) }
    s.keep(local[0..4])
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
