@paradigm procedural

// An arm that ends in a closing brace may drop its comma: its own block, or the match,
// if, or lambda the arm evaluates. The separator exists to find the end of a one line
// arm, and a brace already ends one. An arm that ends in anything else still needs it.
enum E {
    A(v: int64),
    B,
    C,
}

func pick(e: E, t: bool) -> int64 {
    return match e {
        A(n) => {
            n * 2
        }
        B => if t { 3 } else { 4 }
        C => 9,
    }
}

func main() -> int32 {
    println(pick(E.A(5), true))
    println(pick(E.B, true))
    println(pick(E.B, false))
    println(pick(E.C, true))
    return 0
}
