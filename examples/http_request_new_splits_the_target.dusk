// request_new copies the method and splits the target at its first ? into the path and
// the query, with minor 1 and an empty body.
@paradigm procedural
@import std.net.http

func main() -> int32 {
    r := request_new("GET", "/a?b=1")
    println((*r).method)
    println((*r).path)
    println((*r).query)
    println((*r).minor)
    println((*r).body_len)
    request_free(r)
    free(r)
    return 0
}
