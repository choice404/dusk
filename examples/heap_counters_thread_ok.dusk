@paradigm procedural

@import std.memory.heap

// The counters are kept under the heap lock, so allocations and frees from four
// threads at once leave them exact. Each thread's join record is a runtime block
// too, counted while the thread runs and retired by its join, so after every
// join the live count is back where it started.
func churn(n: int64) -> void {
    for i in 0..n {
        s := "thread " + "block"
        p: *int64 = alloc(i)
        free(p)
        free(s)
    }
}

func main() -> int32 {
    b0 := heap_live_blocks()
    y0 := heap_live_bytes()
    t1, e1 := spawn(lambda () -> void { churn(2000) })
    e1.ignore()
    t2, e2 := spawn(lambda () -> void { churn(2000) })
    e2.ignore()
    t3, e3 := spawn(lambda () -> void { churn(2000) })
    e3.ignore()
    t4, e4 := spawn(lambda () -> void { churn(2000) })
    e4.ignore()
    j1 := join(t1)
    j1.ignore()
    j2 := join(t2)
    j2.ignore()
    j3 := join(t3)
    j3.ignore()
    j4 := join(t4)
    j4.ignore()
    println(heap_live_blocks() - b0)
    println(heap_live_bytes() - y0)
    return 0
}
