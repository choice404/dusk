// Borrow-side family: a parameter of a bare type parameter is a borrow, so freeing it
// rejects at the surface exactly as the concrete twin does. Inside the generic body T may
// be a managed pointer the caller owns, and freeing p here would double free it once mono
// instantiates T with *Box. The concrete func g(p: *Box) already rejects the same free.
@paradigm procedural

struct Box { v: int64 }

func f<T>(p: T) -> void {
    free(p)
}

func main() -> int32 {
    b: *Box = alloc(Box { v: 7 })
    f(b)
    free(b)
    println("done")
    return 0
}
