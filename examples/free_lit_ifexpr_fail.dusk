@paradigm procedural

// An if expression whose every branch is a literal yields a literal on every path,
// and so does the ternary form of the same node.
func main(argc: int32, argv: string[]) -> int32 {
    s := if argc > 1 { "many" } else { "one" }
    println(s)
    free(s)
    t := argc > 2 ? "yes" : "no"
    println(t)
    free(t)
    return 0
}
