@paradigm procedural
@paradigm functional

func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}
func fresh(xs: int64[]) -> int64[] { return map(xs, lambda (x: int64) -> int64 { return x }) }
func same(xs: int64[]) -> int64[] { return xs }
// The inner bind names fresh only inside its block; the return calls the parameter
func apply(step: (int64[]) -> int64[], xs: int64[], isFresh: bool) -> int64[] {
    if isFresh {
        step := fresh
        println(step(xs)[0])
    }
    return step(xs)
}
func make() -> int64[] {
    local: int64[4] = [111, 222, 333, 444]
    return apply(same, local[0..4], false)
}
func main() -> int32 {
    xs: int64[] = make()
    println(noise(1, 2))
    println(xs[0])
    return 0
}
