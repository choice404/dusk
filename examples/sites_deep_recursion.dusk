@paradigm procedural

// A recursion deeper than the site stack holds is counted past the stack's end, so
// a block allocated at the bottom names the deepest recorded call, and the stack
// unwinds to where it was: a block allocated after the recursion names its own line.
func down(n: int64) -> string {
    if n == 0 {
        return "bottom" + "!"
    }
    return down(n - 1)
}

func main() -> int32 {
    b := down(3000)
    c := "after" + "!"
    println(b)
    println(c)
    return 0
}
