// A request with both Content-Length and Transfer-Encoding is the request smuggling
// shape. The server answers 400 and closes without reading past the head, so the
// second request hidden in the body is never parsed and the handler is never called.
@paradigm procedural
@import std.net.http.server
@import std.concurrent.thread
@import std.fmt

// The handler's state, behind the context pointer the server passes on every call
struct Counter {
    n: int64,
}

func handle(req: *Request, calls: *Counter) -> *Response {
    (*calls).n = (*calls).n + 1
    resp := response_new(200)
    response_set_body(resp, "ok")
    return resp
}

// Writes the request bytes and reads the whole reply
func exchange(a: Addr, request: string) -> string {
    fd, de := net_dial(a)
    if de.exists() {
        printerr(de)
        return substring("", 0, 0)
    }
    we := write_string(fd_writer(fd), request)
    we.ignore()
    reply, re := read_to_end(fd_reader(fd))
    re.ignore()
    ce := net_close(fd)
    ce.ignore()
    return reply
}

func main() -> int32 {
    lfd, le := net_listen(addr_loopback(0), 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    bound, be := net_local_addr(lfd)
    be.ignore()
    s := http_server_new(lfd)
    (*s).send_date = false
    calls: *Counter = alloc(Counter { n: 0 })
    t, te := spawn(lambda () -> void {
        e := http_serve_one(s, calls, handle)
        if e.exists() {
            println(e)
        }
    })
    if te.exists() {
        printerr(te)
        return 1
    }
    reply := exchange(bound, "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nGET /smuggled HTTP/1.1\r\nHost: a\r\n\r\n")
    je := join(t)
    je.ignore()
    q: string = format("%q", [arg_str(reply)])
    println(q)
    free(q)
    println((*calls).n)
    free(reply)
    free(calls)
    lc := net_close(lfd)
    lc.ignore()
    free(s)
    return 0
}
