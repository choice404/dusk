// A call through a function typed struct field returns the string the field's type
// names, and an index over the result is a string index.
@paradigm procedural
@paradigm oop

struct H { f: () -> string }

func lit() -> string { return "abc" }

func main() -> int32 {
    h: H = H { f: lit }
    n := h.f()
    println(int64(n[1]))
    return 0
}
