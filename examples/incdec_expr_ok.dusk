@paradigm procedural

// The legal shapes of the increment and decrement expression: a bare name, an index whose
// own operand steps, an argument, a field, a dereference, and an unsigned place that wraps
// at its end. Every one of them writes a `mut` place of an integer width, which is the
// whole of the rule.
struct Counter { n: int64 }

func take(n: int64) -> int64 {
    return n
}

func main() -> int32 {
    arr: int64[3] = [10, 20, 30]
    mut idx: int64 = 0
    a := arr[idx++]
    b := arr[++idx]
    c := take(idx++)
    println(a)
    println(b)
    println(c)
    mut u: uint8 = 0u8
    d := u--
    println(d)
    mut s: Counter = Counter { n: 1 }
    e := s.n++
    println(e)
    mut p: *int64 = alloc(5)
    f := (*p)++
    println(f)
    free(p)
    mut n: int64 = 1
    println(++n + n++)
    return 0
}
