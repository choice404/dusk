@paradigm procedural

// An unsigned bound is refused the same way a narrower signed one is. The cursor
// is a signed int64 that a negative step runs backwards, so accepting a uint32
// bound would mean widening into a type whose compare rule differs.
func main() -> int32 {
    n: uint32 = 3
    for i in 0..n {
        println(i)
    }
    return 0
}
