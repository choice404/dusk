// The error http_get returns must be handled: binding it and never reading it is refused
// at check, even though the Response beside it is freed.
@paradigm procedural
@import std.net.http.client

func main() -> int32 {
    resp, e := http_get("http://127.0.0.1:1/")
    println((*resp).status)
    response_free(resp)
    free(resp)
    return 0
}
