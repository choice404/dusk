// A do block reads flat but desugars into one nested bind per step, so 520 steps is
// 520 levels of tree. Steps are charged to the nesting budget for exactly that reason,
// and this block is past it, so the parser names the block instead of letting sema
// descend a nest that overflows the stack.

@paradigm functional

func bind(x: int64, f: (int64) -> int64) -> int64 {
    return f(x)
}

func unit(x: int64) -> int64 {
    return x
}

