@paradigm procedural
@import std.string
@import std.vector

func names_new() -> *Vector<string> {
    names: *Vector<string> = alloc(vec_new())
    vec_push(names, substring("held", 0, 4))
    return names
}

func show(names: *Vector<int64>) -> void {
    if vec_len(names) == 0 { return }
    names := names_new()
    text := vec_get(names, 0)
    println(text)
    taken := vec_take(names, 0)
    free(taken)
    vec_free(names)
    free(names)
}

func main() -> int32 {
    names: *Vector<int64> = alloc(vec_new())
    vec_push(names, 42)
    show(names)
    if vec_len(names) > 0 {
        names := names_new()
        text := vec_get(names, 0)
        println(text)
        taken := vec_take(names, 0)
        free(taken)
        vec_free(names)
        free(names)
    }
    println(vec_get(names, 0))
    vec_free(names)
    free(names)
    return 0
}
