@paradigm procedural

// The declaration order twin of collectorvshadow_ok: the enum whose Some carries a
// managed pointer is declared first and the scalar one second. A name keyed payload
// read is order sensitive, so both orders are pinned; the slot read answers Opt with
// Opt's own payload either way and the collected scalar array prints 7.
foreign "C" {
    func cool_gc_collect() -> void
}

struct Inner {
    s: int64[],
}

enum Held { Some(c: *Inner), None }
enum Opt { Some(n: int64), None }

struct Wrap {
    items: Opt[1],
    p: *Inner,
}

func mk() -> collector<Opt[]> {
    a: int64[3] = [1, 2, 3]
    p := alloc(Inner { s: a[0..2] })
    w := Wrap { items: [Opt.Some(7)], p: p }
    return collector<Opt[]>(w.items)
}

func main() -> int32 {
    c := mk()
    cool_gc_collect()
    match c[0] {
        Some(n) => { println(n) }
        None => { println(0) }
    }
    return 0
}
