@paradigm procedural
@paradigm oop
@import std.string

struct Rec { name: string }
impl Rec { func nm() -> string { return self.name } }

func main() -> int32 {
    r: Rec = Rec { name: substring("hello", 0, 5) }
    q: Rec = Rec { name: substring("world", 0, 5) }
    isFirst: bool = str_len(r.name) > 1
    n: string = (isFirst ? r : q).nm()
    free(n)
    free(r.name)
    free(q.name)
    return 0
}
