@paradigm procedural

// The accept twin of the conservative rejects. The scrutinee shapes are the same ones
// no type can name, an outer match's payload binder and a tuple destructured binding,
// but exactly one enum in the module declares each variant name, so the name keyed
// payload answer is the right one and nothing is lost by using it. The conservative
// rule must fire only where the name is genuinely ambiguous, or every legal program
// that matches through a binder would start failing.
enum Opt { Some(n: int64), None }
enum Outer { Wrap(o: Opt), Nil }

func main() -> int32 {
    w := Outer.Wrap(Opt.Some(5))
    match w {
        Wrap(o) => {
            match o {
                Some(n) => { println(n) }
                None => { println(0) }
            }
        }
        Nil => { println(0) }
    }
    o, n := (Opt.Some(6), 7)
    match o {
        Some(m) => { println(m) }
        None => { println(0) }
    }
    println(n)
    return 0
}
