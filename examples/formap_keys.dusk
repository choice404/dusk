@paradigm procedural
@import std.map

// `for k in m` binds the map's keys in insertion order. An overwrite keeps a key at
// its first position and a remove purges it, so the walk reflects the map's
// documented order contract, not the hash layout.
func main() -> int64 {
    m: *Map<string, int64> = alloc(map_new())
    map_put(m, "a", 1)
    map_put(m, "b", 2)
    map_put(m, "c", 3)
    map_put(m, "b", 20)
    map_remove(m, "a")
    for k in m {
        println(k)
    }
    map_free(m)
    free(m)
    return 0
}
