@paradigm procedural

// A match arm whose block tail is an increment yields that postfix value.
enum Pick { Yes, No }

func main() -> int32 {
    mut n: int64 = 5
    p: Pick = Pick.Yes
    value: int64 = match p {
        Yes => { n++ }
        No => { n-- }
    }
    println(value)
    println(n)
    return 0
}
