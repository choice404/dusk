@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Item { qty: int64, tags: int64[] }
impl Item {
    func total() -> int64 { return self.qty + self.tags.len }
    func bump(n: int64) -> Item { return Item { qty: self.qty + n, tags: self.tags } }
}
func pick<T>(a: T, b: T) -> T { return a }

func main() -> int32 {
    items: *Vector<Item> = alloc(vec_new())
    vec_push(items, Item { qty: 4, tags: [] })
    first := vec_get(items, 0)
    println(first.total())
    return 0
}
