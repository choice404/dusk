// An element of a map(...) result is the callback's result type, so a string element
// indexes as a string, bound first or indexed in place, and through a filter over it.
@paradigm procedural
@paradigm functional

func same(s: string) -> string { return s }

func main() -> int32 {
    xs: string[2] = ["abc", "def"]
    ys := map(xs[0..2], lambda (s: string) -> int64 { return int64(s[1]) })
    println(ys[0])
    zs := map(xs[0..2], lambda (s: string) -> string { return s })
    q := zs[1]
    println(int64(q[1]))
    println(int64(zs[1][2]))
    ws := filter(map(xs[0..2], same), lambda (s: string) -> bool { return true })
    println(int64(ws[0][0]))
    return 0
}
