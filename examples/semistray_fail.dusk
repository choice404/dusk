@paradigm procedural

// A semicolon ends a statement exactly as a newline does, so one that arrives where a
// statement is supposed to begin ends nothing: at the head of the body, doubled after
// a statement that already ended, and alone on its own line.
func main() -> int32 {
    ; mut n: int64 = 1
    n = n + 1;;
    n = n + 2
    ;
    println(n)
    return 0
}
