// The accept twin of the folded constant rule. A constant an expression of bare
// literals folds to is stored as written when the width holds it, and every
// deliberate wrap keeps its own spelling: a suffixed operand computes in its own
// width, and a cast is the explicit wrap.
@paradigm procedural

func main() -> int64 {
    fits: uint8 = 100 + 100 - 100
    chain: int8 = 100 * 3 / 3
    edge: uint8 = 255 - 0
    wrapped: uint8 = 255u8 + 1u8
    maxu: uint64 = 0u64 - 1u64
    cast: uint8 = uint8(0) - uint8(1)
    mixed: uint32 = 5u32 + 1
    println(uint64(fits))
    println(int64(chain))
    println(uint64(edge))
    println(uint64(wrapped))
    println(maxu)
    println(uint64(cast))
    println(uint64(mixed))
    return 0
}
