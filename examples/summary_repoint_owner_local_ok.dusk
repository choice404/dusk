@paradigm procedural
@paradigm oop
@paradigm functional
@import std.vector
// A local that owns its memory and never has a pointer slot repointed keeps a frame
// slice for as long as the frame lives, so storing one through it by a helper or a
// method is accepted and reads back while the frame is alive.
struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}
func store_rows(s: *Sink, xs: int64[]) -> void { (*(*s).h).rows = xs }
func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}
func fillit(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: [] }) })
    store_rows(s, local[0..4])
    println((*(*s).h).rows[1])
    s.keep(local[2..4])
    println((*(*s).h).rows[0])
    (*h).rows = heap_rows()
    free(s)
}
func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fillit(h)
    println((*h).rows[0])
    return 0
}
