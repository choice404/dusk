// The accept twin of the folded constant overflow rule. An expression of bare
// literals is computed at int64 and stored as the bits that computation leaves, so a
// fold whose value passes int64's top is the value uint64 names there rather than the
// negative the pattern reads as. A narrower target keeps ranging the value the fold
// ends on, which is the value codegen computes.
@paradigm procedural

func main() -> int64 {
    half: uint64 = 9223372036854775807 + 1
    past: uint64 = 9223372036854775807 + 3
    top: uint64 = 9223372036854775807 * 2 + 1
    back: uint8 = 9223372036854775807 + 1 - 9223372036854775807
    println(half)
    println(past)
    println(top)
    println(uint64(back))
    return 0
}
