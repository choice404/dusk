@paradigm procedural

// main's body is an internal function under main's own name with the internal suffix
// when a C entry wrapper calls it, so a function named dusk__main, which the body was
// called through 1.17.3, or the wasm entry __main_argc_argv is a function like any
// other.
func dusk__main() -> int64 {
    return 3
}

func __main_argc_argv(a: int32) -> int32 {
    return a + 1
}

func main(argc: int32, argv: string[]) -> int32 {
    println(dusk__main())
    println(__main_argc_argv(argc))
    return 0
}
