@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Rec { name: string }
impl Rec {
    func nm() -> string { return self.name }
    func me() -> Rec { return Rec { name: self.name } }
}
interface Named { label() -> string }
impl Named for Rec { func label() -> string { return self.name } }
struct Wrap<T> { item: T }
enum Opt<A> { Has(a: A), Nope }

func main() -> int32 {
    v: *Vector<Rec> = alloc(vec_new())
    vec_push(v, Rec { name: substring("hello", 0, 5) })
    n := vec_get(v, 0).nm()
    free(n)
    free(vec_get(v, 0).name)
    return 0
}
