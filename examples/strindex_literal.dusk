// A string literal lives in the program image rather than on the heap, and an
// index past its end is held to the same bound, so it faults the same way.
@paradigm procedural

func main() -> int32 {
    s: string = "dusk"
    mut i: int64 = 0
    while i < 6 {
        println(int64(s[i]))
        i++
    }
    return 0
}
