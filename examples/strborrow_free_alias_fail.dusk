// A copy of a borrowed string is the same borrow under a second name, so freeing the
// copy frees the caller's text.
@paradigm procedural
@import std.string

func show(s: string) -> void {
    t := s
    println(t)
    free(t)
}

func main() -> int32 {
    msg: string = substring("hello", 0, 5)
    show(msg)
    free(msg)
    return 0
}
