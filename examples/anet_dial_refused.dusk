// A net_dial_async to a port nothing listens on is an error value, never a fault. The
// listener is closed before the dial so the port is known to be free.
@paradigm procedural
@import std.async.net
@import std.net
@import std.async.future
@import std.async.loop

async func amain() -> int32 {
    lfd, le := net_listen(addr_loopback(0), 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    bound, be := net_local_addr(lfd)
    be.ignore()
    lc := net_close(lfd)
    lc.ignore()
    fd, de := await net_dial_async(bound)
    if de.exists() {
        println("error")
    } else {
        println(fd)
    }
    return 0
}

func main() -> int32 {
    le := loop_init()
    le.ignore()
    se := reactor_start()
    se.ignore()
    rc := async_run(amain())
    reactor_stop()
    loop_free()
    return rc
}
