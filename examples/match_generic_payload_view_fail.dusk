// Compile-fail: a holder storing a view of a frame array is wrapped in an option,
// and the arm binding the option's payload returns it. The payload's type is the
// option's type parameter, so the binder carries what the option holds and the
// return is refused
@paradigm procedural
@paradigm oop
@paradigm functional
@import std.functional.maybe

struct Holder { rows: int64[] }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func pick(h: *Holder) -> *Holder {
    local: int64[4] = [111, 222, 333, 444]
    s: *Holder = alloc(Holder { rows: local[0..4] })
    m: Maybe<*Holder> = Maybe.Some(s)
    match m {
        Some(y) => { return y }
        None => { }
    }
    return h
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    println((*pick(h)).rows[2])
    return 0
}
