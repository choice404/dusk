// A hole holds an arbitrary expression: a call, a field chain through a pointer,
// an index, arithmetic, a plain string literal that itself carries braces (the
// brace-depth counter must not miscount braces inside a nested string), and a
// struct literal whose own braces the counter balances so the hole closes at the
// right one.
@paradigm procedural
@import std.string

func dbl(n: int64) -> int64 { return n * 2 }

struct Pt {
    x: int64,
    y: int64,
}

func sumpt(p: Pt) -> int64 { return p.x + p.y }

func main() -> int64 {
    n: int64 = 4
    p: *Pt = alloc(Pt { x: 10, y: 20 })
    nums: int64[3] = [10, 20, 30]
    println(f"dbl={dbl(n)}")
    println(f"px={(*p).x}")
    println(f"idx={nums[1]}")
    println(f"sum={n + n + 1}")
    println(f"lit={str_len("a{b}c")}")
    println(f"pt={sumpt(Pt { x: 3, y: 5 })}")
    free(p)
    return 0
}
