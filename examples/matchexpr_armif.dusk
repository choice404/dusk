@paradigm procedural

// An arm body's tail carries the arm's value, and a complete `if` is a tail that yields
// one, so an arm can end in an if the same way it can end in a match. An if with no else
// still yields nothing and is still refused.
enum E {
    A(v: int64),
    B,
}

func pick(e: E, t: bool) -> int64 {
    return match e {
        A(n) => {
            if t { n * 2 } else { n }
        }
        B => 7,
    }
}

func main() -> int32 {
    println(pick(E.A(5), true))
    println(pick(E.A(5), false))
    println(pick(E.B, true))
    return 0
}
