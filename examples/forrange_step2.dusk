@paradigm procedural

// A positive step: `by 2` advances the binder by two each time and keeps the
// `<` comparison, so 0..10 by 2 yields the five even numbers below ten. The
// step is an integer literal, so the loop's direction is known at compile time.
func main() -> int32 {
    for i in 0..10 by 2 {
        println(i)
    }
    return 0
}
