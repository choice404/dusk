// The integer verbs and every flag that lays a number out, one line for a positive value
// and one for its negative. %x, %o, and %b print a minus and the magnitude rather than
// the two's complement word C prints, so a negative value reads the same way in every
// base, and %.3d is a minimum digit count rather than a width.
@paradigm procedural

@import std.fmt

func line(n: int64) -> void {
    s: string = format("%d|%5d|%-5d|%05d|%+d|% d|%x|%X|%#x|%o|%b|%.3d", [
        arg_int(n),
        arg_int(n),
        arg_int(n),
        arg_int(n),
        arg_int(n),
        arg_int(n),
        arg_int(n),
        arg_int(n),
        arg_int(n),
        arg_int(n),
        arg_int(n),
        arg_int(n)
    ])
    println(s)
    free(s)
}

func main() -> int64 {
    line(42)
    line(0 - 42)
    return 0
}
