// A closure-typed parameter cannot take a builtin call name: a call of that name inside the
// body would be cooked and dispatched as the builtin rather than the parameter, so the
// parameter is refused. A scalar parameter named after a builtin is never called and is
// left alone.
@paradigm procedural
func apply(println: (int64) -> int64, x: int64) -> int64 {
    return println(x)
}
func main() -> int32 {
    println(apply(lambda (v: int64) -> int64 { return v + 1 }, 5))
    return 0
}
