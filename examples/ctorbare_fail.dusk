@paradigm procedural

// A payload free constructor written as a qualified name is the enum's value, so it carries
// the enum's type the way the call form does. Before that it answered the checker's
// wildcard and every comparison downstream silently agreed: an annotation of another type,
// a return of another type, and a reassignment with another enum's variant all passed check
// and died in clang. The three are named here, one per position.
enum Opt { Some(n: int64), None }
enum Tag { Lo, Hi }

func pick() -> int64 {
    return Opt.None
}

func main() -> int32 {
    x: int64 = Opt.None
    println(x)
    println(pick())
    mut o := Opt.Some(3)
    o = Tag.Lo
    match o {
        Some(v) => println(v),
        None => println(0),
    }
    return 0
}
