@paradigm procedural

// A ref alias read after its owner is freed reaches the generation load in the dusk
// function, which AddressSanitizer reports as a heap use after free before the
// generation compare runs. A plain build faults at the compare by name.
func main() -> int32 {
    p: *int64 = alloc(41)
    ref q := p
    free(p)
    println(*q)
    return 0
}
