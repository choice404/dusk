@paradigm procedural

@import name_foreign_shape_mod

// A foreign declaration that passes or returns a struct by value is compared with
// another of its name by the types it spells, so a div that returns an int64 here
// and the struct in the imported file is one symbol with two prototypes.
foreign "C" {
    func div(n: int32, d: int32) -> int64
}

func main() -> int32 {
    println(remainder(17, 5))
    return 0
}
