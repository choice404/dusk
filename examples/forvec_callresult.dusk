@paradigm procedural
@import std.vector

// A container for over a call result, nested. The outer binder row is typed from the
// callee's return type, so the inner for over row classifies without binding the
// call to a name first.
func build() -> *Vector<*Vector<int64>> {
    outer: *Vector<*Vector<int64>> = alloc(vec_new())
    inner: *Vector<int64> = alloc(vec_new())
    vec_push(inner, 7)
    vec_push(inner, 8)
    vec_push(outer, inner)
    return outer
}

func main() -> int64 {
    for row in build() {
        for x in row {
            println(x)
        }
    }
    return 0
}
