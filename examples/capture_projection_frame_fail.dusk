@paradigm procedural
@import std.vector

struct Cell { rows: int64[] }
struct Outer { inner: *Cell }

func main() -> int32 {
    cell: *Cell = alloc(Cell { rows: [] })
    outer: *Outer = alloc(Outer { inner: cell })
    fill := lambda () -> void {
        local: int64[4] = [111, 222, 333, 444]
        ref alias := (*outer).inner
        (*alias).rows = local[0..4]
    }
    fill()
    println((*cell).rows[0])
    return 0
}
