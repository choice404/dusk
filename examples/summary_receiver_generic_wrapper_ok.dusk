@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Item { qty: int64, tags: int64[] }
impl Item {
    func total() -> int64 { return self.qty + self.tags.len }
    func bump(n: int64) -> Item { return Item { qty: self.qty + n, tags: self.tags } }
}
struct Wrap { it: Item }
struct GBox<T> { v: T }
func pick<T>(a: T, b: T) -> T { return a }
func gb<T>(x: T) -> GBox<T> { return GBox { v: x } }
func gv<T>(b: GBox<T>) -> T { return b.v }

func main() -> int32 {
    items: *Vector<Item> = alloc(vec_new())
    vec_push(items, Item { qty: 4, tags: [] })
    vec_push(items, Item { qty: 5, tags: [] })
    local: int64[4] = [1, 2, 3, 4]
    if local[0] == 0 { return 1 }
    b := gb(vec_get(items, 0))
    x := gv(b)
    println(x.total())
    return 0
}
