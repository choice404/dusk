@paradigm procedural
@import std.map

// Enough inserts to force several rehashing grows. A grow rebuilds the hash table
// but never the insertion-order record, so the pair walk stays in insertion order
// across every grow.
func main() -> int64 {
    m: *Map<int64, int64> = alloc(map_new())
    mut i: int64 = 1
    while i <= 9 {
        map_put(m, i, i * 10)
        i = i + 1
    }
    for k, v in m {
        print(k)
        print("=")
        println(v)
    }
    map_free(m)
    free(m)
    return 0
}
