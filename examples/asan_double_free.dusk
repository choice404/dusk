@paradigm procedural

// A second free of a raw block is AddressSanitizer's heap use after free report
// under --sanitize=address, raised in the runtime's free on its first read of the
// block, with the stacks of both frees. A plain build names it fatal: double free.
func twice(b: *raw char) -> void {
    free(b)
}

func main() -> int32 {
    c: *raw char = alloc_bytes(5)
    c[0] = 65
    free(c)
    twice(c)
    println("unreachable")
    return 0
}
