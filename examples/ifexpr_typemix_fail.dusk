@paradigm procedural

// An if used as a value yields one result slot, so its branches must agree on the type
// that slot holds. The then branch is an int32 and the else branch an int64, which would
// size the slot from whichever branch resolved first and truncate the other, the same
// silent width bug the match arms already refuse. The ground pass judges it, once mono
// has made both branches concrete.
func small() -> int32 { return 5 }

func main() -> int32 {
    c: bool = true
    big: int64 = 5000000000
    x: int64 = if c { small() } else { big }
    println(x)
    return 0
}
