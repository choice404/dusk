@paradigm procedural

// Two counted loops nested, a multiplication table. Each loop keeps its own
// bound and cursor, so the inner loop restarting does not disturb the outer
// binder, and the two binders never collide.
func main() -> int32 {
    for i in 1..4 {
        for j in 1..4 {
            println(i * j)
        }
    }
    return 0
}
