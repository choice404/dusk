// token_list_has finds an element of a comma separated list field, case folded with the
// whitespace around each element ignored, and never matches part of an element.
@paradigm procedural
@import std.net.http.wire

func main() -> int32 {
    println(token_list_has("keep-alive, Upgrade", "upgrade"))
    println(token_list_has("close", "keep-alive"))
    return 0
}
