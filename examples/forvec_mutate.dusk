@paradigm procedural
@import std.vector

// The length re-reads every iteration, so a push in the body is visited by a later
// iteration. Bounded by a guard so it terminates: 1 grows the vector to 1, 2, 3 and
// then stops.
func main() -> int64 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 1)
    for x in v {
        println(x)
        if x < 3 {
            vec_push(v, x + 1)
        }
    }
    vec_free(v)
    free(v)
    return 0
}
