@paradigm procedural

// Calls and binary operands evaluate left to right around postfix increments.
func show(a: int64, b: int64) -> void {
    println(a)
    println(b)
}

func main() -> int32 {
    mut i: int64 = 1
    show(i++, i++)
    println(i)
    i = 1
    println(i++ + i++)
    println(i)
    return 0
}
