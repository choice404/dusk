// A binding named after a builtin is legal when its type is a concrete non-function: it is
// never called, so the builtin dispatch never hijacks it. A local string named filter and a
// parameter int named map both compile and are used as plain values, the same freedom the
// golden runner's own `filter: string` relies on.
@paradigm procedural
func add(map: int64, n: int64) -> int64 {
    return map + n
}
func main() -> int32 {
    mut filter: string = "keep"
    println(filter)
    println("{}", add(40, 2))
    return 0
}
