@paradigm procedural

@import std.memory.heap

// Four threads allocate and free at once while the main thread reports. Every
// report walks the registry and checks the walk against the counters, and says so
// when they drift; they never do, since both are kept under the heap lock.
func churn(n: int64) -> void {
    for i in 0..n {
        s := "thread " + "block"
        p: *int64 = alloc(i)
        free(p)
        free(s)
    }
}

func main() -> int32 {
    keep := "kept" + "!"
    t1, e1 := spawn(lambda () -> void { churn(3000) })
    e1.ignore()
    t2, e2 := spawn(lambda () -> void { churn(3000) })
    e2.ignore()
    t3, e3 := spawn(lambda () -> void { churn(3000) })
    e3.ignore()
    t4, e4 := spawn(lambda () -> void { churn(3000) })
    e4.ignore()
    for i in 0..20 {
        heap_report()
    }
    j1 := join(t1)
    j1.ignore()
    j2 := join(t2)
    j2.ignore()
    j3 := join(t3)
    j3.ignore()
    j4 := join(t4)
    j4.ignore()
    println(keep)
    free(keep)
    heap_report()
    return 0
}
