@paradigm procedural
@import std.async.future
@import std.async.loop
@import std.vector

// A container for inside an async function, with an await in the body. The spliced
// locals __fit and __fi live across the suspension, so they ride the async task
// frame: the loop resumes with the container pointer and index intact.
async func dbl(n: int64) -> int64 {
    return n * 2
}

async func amain() -> int32 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 1)
    vec_push(v, 2)
    vec_push(v, 3)
    mut total: int64 = 0
    for x in v {
        d := await dbl(x)
        total = total + d
    }
    println(total)
    vec_free(v)
    free(v)
    return 0
}

func main() -> int32 {
    le := loop_init()
    le.ignore()
    rc := async_run(amain())
    loop_free()
    return rc
}
