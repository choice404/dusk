// Compile-fail: an arm pattern spelled like a variant of some other enum is the
// catch all binder for this match, so the name holds the scrutinee. Matching on it
// reaches the sink that holds the caller's holder, and the store through it is refused
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

enum Mode { Quiet, Loud(level: int64) }
enum Slot { Held(s: *Sink), Empty }

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    slot: Slot = Slot.Held(alloc(Sink { h: h }))
    match slot {
        Empty => { println(0) },
        Quiet => {
            match Quiet {
                Held(inner) => { inner.keep(local[0..4]) },
                Empty => { println(1) },
            }
        },
    }
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
