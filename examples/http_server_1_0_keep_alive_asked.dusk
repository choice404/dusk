// An HTTP/1.0 client keeps the connection only by asking with Connection: keep-alive,
// and the server says keep-alive back, since a 1.0 client assumes a close otherwise; the
// next 1.0 request that does not ask gets Connection: close and ends the stream.
@paradigm procedural
@import std.net.http.server
@import std.fmt

func handle(req: *Request, ctx: int64) -> *Response {
    resp := response_new(200)
    response_set_body(resp, "ok")
    return resp
}

func main() -> int32 {
    s := http_server_new(-1)
    (*s).send_date = false
    c: *StringReader = alloc(string_reader_new("GET /a HTTP/1.0\r\nConnection: keep-alive\r\n\r\nGET /b HTTP/1.0\r\n\r\nGET /c HTTP/1.0\r\n\r\n"))
    out: *StringBuilder = alloc(sb_new())
    count, e := http_serve_stream(s, string_reader(c), sb_writer(out), 0, handle)
    println(count)
    println(e.exists())
    q: string = format("%q", [arg_str(sb_cstr(out))])
    println(q)
    free(q)
    sb_free(out)
    free(out)
    free(c)
    free(s)
    return 0
}
