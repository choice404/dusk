@paradigm procedural
@import std.string
@import std.vector
func mk() -> *Vector<int64> {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 41)
    return v
}
func main() -> int32 {
    names: *Vector<string> = alloc(vec_new())
    vec_push(names, "a")
    if vec_len(names) > 0 {
        names := mk()
        mut n := vec_get(names, 0)
        n += 1
        println(n)
        println(move(n))
    }
    return 0
}
