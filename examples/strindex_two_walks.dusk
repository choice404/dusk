// Two long strings walked side by side, the shape str_eq and str_cmp read them in,
// each keep their own remembered measurement, so comparing them stays one pass over
// each. Were the two to share one, every step would measure again from the start
// and each comparison of two MiB strings would scan about a trillion bytes.
@paradigm procedural

@import std.string

func main() -> int32 {
    a: string = repeat("0123456789abcdef", 65536)
    b: string = repeat("0123456789abcdef", 65536)
    c: string = substring(b, 0, 1048575)
    println(str_eq(a, b))
    println(str_eq(b, a))
    println(str_cmp(a, b))
    println(str_cmp(b, a))
    println(str_eq(a, c))
    println(str_cmp(c, a))
    free(a)
    free(b)
    free(c)
    return 0
}
