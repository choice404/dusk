// An index into a scalar is refused at check. An int64 has no elements, so `a[0]`
// has nothing to read and no lowering: before this rule the file passed `dusk
// check` clean and died in codegen as an `unsupported index expression` naming no
// file and no line. The chain reports once, at its first link.
@paradigm procedural

func main() -> int32 {
    a: int64 = 5
    x: int64 = a[0][0]
    println("{}", x)
    return 0
}
