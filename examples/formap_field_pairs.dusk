@paradigm procedural
@import std.map

// The pair form over a map held in a struct field. The classifier recovers the field
// type, so the two-binder loop is not misjudged as pair-over-a-non-map.
struct Holder {
    m: *Map<string, int64>,
}

func main() -> int64 {
    m: *Map<string, int64> = alloc(map_new())
    map_put(m, "a", 1)
    map_put(m, "b", 2)
    h: Holder = Holder { m: m }
    for k, v in h.m {
        print(k)
        print("=")
        println(v)
    }
    map_free(m)
    free(m)
    return 0
}
