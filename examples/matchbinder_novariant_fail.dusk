@paradigm procedural

// An arm naming a variant of an entirely different enum, over a scrutinee whose type is
// the surface unknown a constructor infers. The check that refuses a variant the
// scrutinee's enum does not declare only ran for a named type, so this arm bound
// silently and died later in codegen.
enum Opt { Some(n: int64), None }
enum Other { Foo(x: int64), Bar }

func main() -> int32 {
    o := Opt.Some(1)
    match o {
        Some(n) => { println(n) }
        None => { println(0) }
        Foo(x) => { println(x) }
    }
    return 0
}
