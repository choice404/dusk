// The same option around a holder of heap rows: the binder carries nothing of the
// frame, so returning it is accepted and runs
@paradigm procedural
@paradigm oop
@paradigm functional
@import std.functional.maybe

struct Holder { rows: int64[] }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func pick(h: *Holder) -> *Holder {
    s: *Holder = alloc(Holder { rows: heap_rows() })
    m: Maybe<*Holder> = Maybe.Some(s)
    match m {
        Some(y) => { return y }
        None => { }
    }
    return h
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    println((*pick(h)).rows[2])
    return 0
}
