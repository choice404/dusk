// A doubled brace in an f-string collapses to one, but a brace produced by a \u
// escape is a literal scalar that never collapses: f"\u{7b}\u{7b}" is two braces
// while f"{{}}" is one of each. The plain-string println twin keeps its own
// documented format-string collapse, an asymmetry the spec records.
@paradigm procedural

func main() -> int64 {
    a: string = f"\u{7b}\u{7b} {1}"
    println("{}", a)
    b: string = f"A\u{7b}B {2}"
    println("{}", b)
    c: string = f"{{}} {3}"
    println("{}", c)
    return 0
}
