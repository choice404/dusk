@paradigm procedural
@paradigm functional

// The same conservative answer for a field of a generic struct, whose declared type is
// the type parameter rather than the enum the instance substitutes for it.
struct Cell { rows: int64[] }

enum Opt { Some(c: *Cell), None }
enum Tag { Some(n: int64), None }

struct GBox<T> { o: T }

func heap4() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (x: int64) -> int64 { return x })
}

func mk() -> *Cell {
    c: *Cell = alloc(Cell { rows: heap4() })
    b: GBox<Opt> = GBox { o: Opt.Some(c) }
    local: int64[4] = [111, 222, 333, 444]
    match b.o {
        Some(p) => { (*p).rows = local[0..4] }
        None => {}
    }
    return c
}

func main() -> int32 {
    c := mk()
    println((*c).rows[0])
    free(c)
    return 0
}
