@paradigm functional

// A do-block step begins at a statement position, where a lone semicolon is stray.
func bind(x: int64, f: (int64) -> int64) -> int64 {
    return f(x)
}

func unit(x: int64) -> int64 {
    return x
}

func main() -> int32 {
    value := do {
        ;
        x <- 1
        x
    }
    println(value)
    return 0
}
