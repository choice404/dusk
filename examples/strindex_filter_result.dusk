// An element of a filter(...) result is the collection's element type, so a string
// element indexes as a string, bound first or indexed in place.
@paradigm procedural
@paradigm functional

func main() -> int32 {
    xs: string[2] = ["abc", "def"]
    zs := filter(xs[0..2], lambda (s: string) -> bool { return s[0] == 100 })
    q := zs[0]
    println(int64(q[1]))
    println(int64(zs[0][2]))
    ws := map(filter(xs[0..2], lambda (s: string) -> bool { return true }), lambda (s: string) -> string { return s })
    println(int64(ws[0][2]))
    return 0
}
