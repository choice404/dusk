@paradigm procedural
@import std.vector

// A container for needs the fat pointer so it can re-read the length and each
// element every iteration, so the iterand must be a pointer, not a by-value copy.
func main() -> int64 {
    v: Vector<int64> = vec_new()
    for x in v {
        println(x)
    }
    return 0
}
