// An array or slice literal's elements are ranged against the element type the
// annotation names, at every nesting depth. Without the element pass the outer
// check sees an array target, not an integer one, and each written value reaches
// codegen to wrap or truncate into the element with nothing at the surface saying
// so.
@paradigm procedural

func main() -> int32 {
    over: uint8[1] = [256]
    negative: uint8[2] = [-1, 5]
    signed: int8[1] = [300]
    nested: uint8[2][2] = [[1, 2], [3, 300]]
    println(over[0])
    println(negative[0])
    println(signed[0])
    println(nested[1][1])
    return 0
}
