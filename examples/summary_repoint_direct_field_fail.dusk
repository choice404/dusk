@paradigm procedural
@paradigm oop
@paradigm functional
@import std.vector
// A field assignment that repoints memory a local owns is invisible to the alias
// model, so a call that stores a frame slice through that local is refused once any
// assignment in the function writes a pointer slot it reaches.
struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}
func store_rows(s: *Sink, xs: int64[]) -> void { (*(*s).h).rows = xs }
func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}
struct Outer { s: *Sink }
func store_outer(o: *Outer, xs: int64[]) -> void { (*(*(*o).s).h).rows = xs }
func fillit(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    o: *Outer = alloc(Outer { s: alloc(Sink { h: alloc(Holder { rows: [] }) }) })
    inner: *Sink = (*o).s
    (*inner).h = h
    store_outer(o, local[0..4])
    free(o)
}
func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fillit(h)
    println((*h).rows[0])
    return 0
}
