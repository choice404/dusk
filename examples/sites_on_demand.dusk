@paradigm procedural

@import std.memory.heap

// heap_report prints the live blocks whenever it is called. In a --heap-sites build
// the report groups them by allocation site, here twice, the second report smaller
// than the first, and since everything is freed by the end there is no report at
// exit. Without the flag each call prints the totals line alone.
func main() -> int32 {
    a := "ab" + "cd"
    b := "ef" + "gh"
    c := "ij" + "kl"
    println(a)
    heap_report()
    free(a)
    free(b)
    println(c)
    heap_report()
    free(c)
    return 0
}
