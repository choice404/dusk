// A heap slice minted by `map` over concrete `Sq` values, handed to an interface
// method that takes a slice of `Shape`, which the escape reject leaves alone since
// the slice is heap owned. The type pass after monomorphization gives the `map`
// result its element type, so the covariance guard sees `Sq` and refuses the call
// at check, `cannot pass a slice of 'Sq' as a slice of interface 'Shape'; ...`.
// The codegen backstop that refused it before, a named build error, stays behind
// the check, so the miss is loud either way and never a silent miscompile
@paradigm oop
@paradigm procedural
@paradigm functional

interface Shape { area() -> int64 }
interface Summer { total(shapes: Shape[]) -> int64 }

struct Sq { s: int64 }
impl Shape for Sq { func area() -> int64 { return self.s * self.s } }

struct Calc { base: int64 }
impl Summer for Calc {
    func total(shapes: Shape[]) -> int64 {
        mut sum: int64 = 0
        mut i: int64 = 0
        while i < shapes.len {
            sum = sum + shapes[i].area()
            i = i + 1
        }
        return sum
    }
}

func main() -> int32 {
    sqs: Sq[2] = [Sq { s: 3 }, Sq { s: 4 }]
    hs := map(sqs[0..2], lambda (x: Sq) -> Sq { return x })
    s: Summer = Calc { base: 0 }
    println(s.total(hs))
    return 0
}
