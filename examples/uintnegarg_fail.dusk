// The negative literal reject follows the unsigned type into every position a
// literal can adapt into, not just the annotated bind: an argument, a return,
// and a struct field are all checked by the same rule.
@paradigm procedural

struct Slot { size: uint8 }

func hold(v: uint16) -> uint16 { return v }

func floor() -> uint64 { return -8 }

func main() -> int32 {
    println(hold(-1))
    s: Slot = Slot { size: -3 }
    println(s.size)
    println(floor())
    return 0
}
