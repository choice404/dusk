@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Item { qty: int64, tags: int64[] }
impl Item {
    func total() -> int64 { return self.qty + self.tags.len }
    func bump(n: int64) -> Item { return Item { qty: self.qty + n, tags: self.tags } }
}
func pick<T>(a: T, b: T) -> T { return a }

func main() -> int32 {
    m: *Map<string, Item> = alloc(map_new())
    map_put(m, "a", Item { qty: 4, tags: [1] })
    it := unwrap_or(map_get(m, "a"), Item { qty: 0, tags: [] })
    println(it.total())
    match map_get(m, "a") {
        Some(x) => { println(x.total()) }
        None => { }
    }
    return 0
}
