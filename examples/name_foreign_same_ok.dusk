@paradigm procedural

@import name_foreign_same_mod

// Two declarations of one C name that spell the same dusk types, a variadic tail
// included, agree, and every call reaches the one C function.
foreign "C" {
    func abs(n: int32) -> int32
    func snprintf(buf: *raw char, size: int64, fmt: *raw char, ...) -> int32
}

func main() -> int32 {
    println(abs(-3))
    println(mod_abs(-4))
    println(mod_format())
    return 0
}
