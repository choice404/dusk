// The compile fail twin: an expression of bare literals is computed at int64 and
// truncated into the target, so a constant the width cannot hold is refused
// exactly as the written literal is, instead of wrapping quietly in codegen.
@paradigm procedural

func take(v: uint8) -> int64 { return int64(v) }

func main() -> int64 {
    x: uint8 = 128 + 128
    y: int8 = 100 + 100
    m: uint64 = 0 - 1
    println(take(2 * 200))
    println(int64(x) + int64(y))
    println(int64(m))
    return 0
}
