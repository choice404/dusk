// A match arm that calls a local closure sizes its result slot from the closure's declared
// return type, so a float-returning closure gives a float result.
@paradigm procedural
enum E { A, B }
func main() -> int32 {
    e: E = E.A
    f := lambda () -> float64 { return 2.5 }
    x := match e { A => f(), B => f() }
    println("{}", x)
    return 0
}
