@paradigm procedural

// An if used as a value in return position hands the caller whatever its branches agreed
// on, so a borrow agreed on there would launder into the caller's owner exactly as a
// borrowed match result would. Both branches hand back a pointer the caller already owns,
// so the return is refused and the fix is the one the match form names.
func hand(c: bool, a: *int64, b: *int64) -> *int64 {
    return if c { a } else { b }
}

func main() -> int32 {
    return 0
}
