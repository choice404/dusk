// A string ends at its first NUL, so a byte stored past an embedded NUL is out of
// bounds for an index: the read at offset 2 is the terminator and legal, the read
// at offset 3 faults where it used to read the c.
@paradigm procedural

func main() -> int32 {
    s: string = "ab\u{0}cd"
    println(int64(s[2]))
    println(int64(s[3]))
    return 0
}
