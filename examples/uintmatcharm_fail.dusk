// A match expression yields into its binding, so each arm's tail literal is ranged
// against the annotation the same way a plain value is. The surface pass types a
// match as a wildcard, so without the arm walk the annotation never meets the
// written value and the arm stores a wrapped one.
@paradigm procedural

enum Pick {
    First,
    Second,
}

func main() -> int32 {
    p := Pick.First
    wide: uint8 = match p {
        First  => 300,
        Second => -1,
    }
    narrow: int8 = match p {
        First  => 200,
        Second => 0,
    }
    println(wide)
    println(narrow)
    return 0
}
