// A datagram longer than the receive buffer is cut to the buffer and the tail is dropped
// silently: eight bytes sent, four received, no error.
@paradigm procedural
@import std.net.udp
@import std.string

func main() -> int32 {
    a, ae := udp_bind(addr_loopback(0))
    if ae.exists() {
        printerr(ae)
        return 1
    }
    b, be := udp_bind(addr_loopback(0))
    if be.exists() {
        printerr(be)
        return 1
    }
    a_addr, a_err := net_local_addr(a)
    a_err.ignore()
    b_addr, b_err := net_local_addr(b)
    b_err.ignore()
    msg: *raw char = cbuf("12345678")
    sent, se := udp_send_to(a, msg, 8, b_addr)
    free(msg)
    if se.exists() {
        printerr(se)
        return 1
    }
    if sent != 8 {
        printerr("short send")
    }
    buf: *raw char = alloc_bytes(4)
    got, from, re := udp_recv_from(b, buf, 4)
    free(buf)
    if re.exists() {
        printerr(re)
        return 1
    }
    println(got)
    if !addr_eq(from, a_addr) {
        printerr("unexpected sender")
    }
    c1 := net_close(a)
    c1.ignore()
    c2 := net_close(b)
    c2.ignore()
    return 0
}
