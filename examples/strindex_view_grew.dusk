// A string view over a raw buffer the program keeps writing can grow under the
// view. An index past the end the view last measured is measured again on the
// live bytes before anything faults, so a read of the new byte succeeds.
@paradigm procedural

func main() -> int32 {
    buf: *raw char = alloc_bytes(8)
    buf[0] = 65
    buf[1] = 0
    v: string = cstr(buf)
    println(int64(v[0]))
    println(int64(v[1]))
    buf[1] = 66
    buf[2] = 67
    buf[3] = 0
    println(int64(v[1]))
    println(int64(v[2]))
    println(int64(v[3]))
    free(buf)
    return 0
}
