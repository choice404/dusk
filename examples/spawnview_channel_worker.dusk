// A channel handle may cross a spawn even when its element is a pointer to a
// record holding a heap backed slice, whose element follows the channel rule
@paradigm procedural
@paradigm functional
@import std.concurrent.channel

struct Job { rows: int64[], id: int64 }

func heap4() -> int64[] {
    seed: int64[4] = [10, 20, 30, 40]
    return map(seed[0..4], lambda (x: int64) -> int64 { return x })
}

func main() -> int32 {
    ch: Channel<*Job> = chan_new(4)
    t, e := spawn(lambda () -> void {
        j, re := chan_recv(ch)
        re.ignore()
        println((*j).rows[3] + (*j).id)
        free(j)
    })
    if e.exists() { return 1 }
    j: *Job = alloc(Job { rows: heap4(), id: 2 })
    se := chan_send(ch, move(j))
    se.ignore()
    je := join(t)
    je.ignore()
    chan_close(ch)
    chan_free(ch)
    return 0
}
