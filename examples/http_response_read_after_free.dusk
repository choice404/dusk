// A Response is released in two steps, response_free for its parts and free for the
// block, and after the second one it is gone. Reading its status anyway is a use after
// free the generational check names and aborts on, rather than handing back whatever
// bytes happen to sit there.
@paradigm procedural
@import std.net.http

func main() -> int32 {
    r := response_new(200)
    println((*r).status)
    response_free(r)
    free(r)
    println((*r).status)
    return 0
}
