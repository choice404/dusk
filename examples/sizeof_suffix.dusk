// A width suffix pins a literal's type for sizeof of an aggregate: an int32 tuple, an int32
// array, and an int32 pair of locals each measure 8 bytes, not the default-int64 16.
@paradigm procedural
func main() -> int32 {
    println("{}", sizeof((1i32, 2i32)))
    println("{}", sizeof([1i32, 2i32]))
    a: int32 = 1
    b: int32 = 2
    println("{}", sizeof((a, b)))
    return 0
}
