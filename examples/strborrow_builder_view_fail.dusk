// sb_cstr is a view of the builder's own buffer, so freeing it frees the bytes the
// builder still holds and frees again in sb_free.
@paradigm procedural
@import std.string

func main() -> int32 {
    b: *StringBuilder = alloc(sb_new())
    sb_push(b, "hello")
    x := sb_cstr(b)
    println(x)
    free(x)
    sb_free(b)
    free(b)
    return 0
}
