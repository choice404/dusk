@paradigm procedural
@paradigm functional

struct Rows { rows: int64[] }
struct Count { n: int64 }

func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}
// The loop binder shadows the parameter only inside the loop
func rows_after_loop(value: Rows, counts: Count[]) -> int64[] {
    for value in counts { println(value.n) }
    return value.rows
}
func make() -> int64[] {
    local: int64[4] = [111, 222, 333, 444]
    counts: Count[] = map([1], lambda (n: int64) -> Count { return Count { n: n } })
    return rows_after_loop(Rows { rows: local[0..4] }, counts)
}
func main() -> int32 {
    xs: int64[] = make()
    println(noise(1, 2))
    println(xs[0])
    return 0
}
