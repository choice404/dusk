// A method that pushes scalars read out of a frame view into a vector its object
// holds stores no view anywhere, so calling it on an object that views a frame array
// is legal
@paradigm procedural
@paradigm oop
@paradigm functional
@import std.vector

struct Lexer { src: int64[], toks: *Vector<int64> }
impl Lexer {
    func run() -> void {
        for i in 0..self.src.len { vec_push(self.toks, self.src[i] * 2) }
    }
}

func main() -> int32 {
    local: int64[4] = [1, 2, 3, 4]
    toks: *Vector<int64> = alloc(vec_new())
    p: *Lexer = alloc(Lexer { src: [], toks: toks })
    (*p).src = local[0..4]
    p.run()
    println(vec_get(toks, 3))
    free(p)
    return 0
}
