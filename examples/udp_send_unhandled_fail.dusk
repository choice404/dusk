// The error udp_send_to returns must be handled: binding it and never reading it is
// refused at check.
@paradigm procedural
@import std.net.udp
@import std.string

func main() -> int32 {
    fd, be := udp_bind(addr_loopback(0))
    be.ignore()
    msg: *raw char = cbuf("ping")
    n, e := udp_send_to(fd, msg, 4, addr_loopback(9))
    free(msg)
    println(n)
    return 0
}
