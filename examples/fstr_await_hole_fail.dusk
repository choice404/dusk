// A hole is an ordinary expression, and await cannot appear mid-expression, so an
// await inside a hole is refused at parse; bind the awaited value first.
@paradigm procedural

async func fetch() -> int64 {
    return 7
}

async func run_it() -> int64 {
    s: string = f"v={await fetch()}"
    println("{}", s)
    return 0
}

func main() -> int64 {
    return 0
}
