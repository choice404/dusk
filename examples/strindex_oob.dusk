// A string index is held to the string's length, the offset of its first NUL, so
// an index past the end of a heap string faults by name and line instead of
// reading whatever bytes sit beyond the terminator.
@paradigm procedural

@import std.string

func byte_at(s: string, i: int64) -> int64 {
    return int64(s[i])
}

func main() -> int32 {
    s: string = substring("abcdef", 0, 3)
    println(byte_at(s, 2))
    far: int64 = 200
    println(byte_at(s, far))
    free(s)
    return 0
}
