@paradigm procedural
@import std.map

// A module whose exported function iterates a map with the pair form. The loader must
// carry the second binder across the module merge, or the value name is lost.
export func show_pairs(m: *Map<string, int64>) -> void {
    for k, v in m {
        print(k)
        print("=")
        println(v)
    }
}
