// The async echo over a unix domain stream socket. The listener comes from the
// blocking layer, net_listen, and is set nonblocking before tcp_accept parks on it;
// the client task dials it through net_dial_async, whose unix connect completes at
// once. net_listen never unlinks, so the stale file from a dead run is removed before
// the listen and this run's file after the close.
@paradigm procedural
@import std.async.net
@import std.net
@import std.async.future
@import std.async.loop
@import std.fs

async func serve(lfd: int64) -> (int64, error) {
    cfd, ae := await tcp_accept(lfd)
    if ae.exists() {
        return (1, ae)
    }
    buf: *raw char = alloc_bytes(64)
    n, re := await tcp_read(cfd, buf, 64)
    if re.exists() {
        free(buf)
        cc := tcp_close(cfd)
        cc.ignore()
        return (2, re)
    }
    w, we := await tcp_write(cfd, buf, n)
    we.ignore()
    free(buf)
    cc := tcp_close(cfd)
    cc.ignore()
    if w != n {
        return (3, error { message: "short echo write" })
    }
    return (0, error {})
}

async func client(a: Addr) -> (int64, error) {
    fd, ce := await net_dial_async(a)
    if ce.exists() {
        return (1, ce)
    }
    msg: *raw char = cbuf("ping")
    w, we := await tcp_write(fd, msg, 4)
    we.ignore()
    if w != 4 {
        free(msg)
        cc := tcp_close(fd)
        cc.ignore()
        return (2, error { message: "short request write" })
    }
    n, re := await tcp_read(fd, msg, 4)
    re.ignore()
    msg[n] = 0
    println(cstr(msg))
    free(msg)
    cc := tcp_close(fd)
    cc.ignore()
    return (0, error {})
}

async func amain() -> int32 {
    path: string = "/tmp/dusk_anet_dial_unix.sock"
    stale := remove_file(path)
    stale.ignore()
    a: Addr = addr_unix(path)
    lfd, le := net_listen(a, 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    ne := fd_nonblock(lfd)
    ne.ignore()
    sf := serve(lfd)
    cv, ce := await client(a)
    ce.ignore()
    sv, se := await sf
    se.ignore()
    lc := net_close(lfd)
    lc.ignore()
    gone := remove_file(path)
    gone.ignore()
    if cv != 0 || sv != 0 {
        return 1
    }
    return 0
}

func main() -> int32 {
    le := loop_init()
    le.ignore()
    se := reactor_start()
    se.ignore()
    rc := async_run(amain())
    reactor_stop()
    loop_free()
    return rc
}
