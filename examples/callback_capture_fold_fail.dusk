// Compile-fail: a fold callback stores each element, a view of a frame array, through
// a sink it captures while it counts, and the sink leads to the parameter's holder
@paradigm procedural
@paradigm oop
@paradigm functional

@import std.functional.maybe

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    t: *Sink = alloc(Sink { h: h })
    views: (int64[])[1] = [local[0..4]]
    seen: int64 = fold(views[0..1], 0, lambda (acc: int64, ys: int64[]) -> int64 {
        t.keep(ys)
        return acc + 1
    })
    println(seen)
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
