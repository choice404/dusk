@paradigm procedural

func after_if() -> void {
    value: int64 = 7
    defer println("if done {}", value)
    if true {
        value: int64 = 1
        println("if {}", value)
    }
}

func after_while() -> void {
    value: int64 = 8
    defer println("while done {}", value)
    mut index: int64 = 0
    while index < 1 {
        value: int64 = 2
        if true { println("while {}", value) }
        index++
    }
}

func after_for() -> void {
    value: int64 = 9
    defer println("for done {}", value)
    for value in [3] {
        if true { println("for {}", value) }
    }
}

func main() -> int32 {
    after_if()
    after_while()
    after_for()
    return 0
}
