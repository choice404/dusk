@paradigm procedural
@paradigm oop
@import std.vector

struct Item { rows: int64[] }
struct Count { value: int64 }
impl Item {
    func total() -> int64 { return self.rows.len }
    func copy() -> Item { return Item { rows: self.rows } }
}
impl Count { func total() -> int64 { return self.value } }
func count() -> Count { return Count { value: 9 } }
func main() -> int32 {
    rows: int64[2] = [11, 22]
    items: *Vector<Item> = alloc(vec_new())
    vec_push(items, Item { rows: rows[0..2] })
    value := vec_get(items, 0)
    if true {
        value := value.copy()
        println(value.total())
        if true {
            value := count()
            println(value.total())
        }
        println(value.total())
    }
    println(value.total())
    vec_free(items)
    free(items)
    return 0
}
