@paradigm procedural

// An arm that does not end in a brace still needs its comma, and the message names the
// rule rather than the token it wanted.
enum E {
    A,
    B,
}

func pick(e: E) -> int64 {
    return match e {
        A => 1
        B => 2,
    }
}

func main() -> int32 {
    println(pick(E.A))
    return 0
}
