// Interface dispatch returns an unsigned value whose signed reading would be
// negative, proving the method result keeps unsigned type information.
@paradigm oop
@paradigm procedural

interface Source {
    value() -> uint32
}

struct High {
    n: uint32,
}

impl Source for High {
    func value() -> uint32 {
        return self.n
    }
}

func show(src: Source) -> void {
    v: uint32 = src.value()
    println(v)
    if v > 0u32 { println("unsigned_dispatch") }
}

func main() -> int32 {
    show(High { n: 2147483648u32 })
    return 0
}
