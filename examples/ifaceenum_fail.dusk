@paradigm oop
@paradigm procedural

// An enum handed where an interface is expected. An interface erases to the checker's
// wildcard in the lowered arena, so the ordinary argument comparison agrees with anything
// and the conformance check is the one place the pairing is judged; its struct arm let an
// enum fall straight through, and the value reached codegen where the method call had no
// vtable to read. An enum can never carry the impl either, since a method on an enum is
// refused where it is written.
interface Sized {
    size() -> int64
}

enum Opt {
    Some(v: int64),
    None,
}

func hear(s: Sized) -> int64 {
    return s.size()
}

func main() -> int32 {
    o: Opt = Opt.Some(7)
    println(hear(o))
    return 0
}
