// An index through a *raw char is pointer arithmetic over a buffer with no length,
// not a string index, so a buffer with no NUL anywhere reads at every offset.
@paradigm procedural

func main() -> int32 {
    buf: *raw char = alloc_bytes(16)
    for i in 0..16 {
        buf[i] = 65 + i
    }
    mut sum: int64 = 0
    for i in 0..16 {
        sum += int64(buf[i])
    }
    println(sum)
    println(int64(buf[15]))
    free(buf)
    return 0
}
