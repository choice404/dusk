@paradigm procedural
@import std.string
@import std.vector

struct Wrap<T> { items: *Vector<T> }
struct Pair<A, B> { first: A, second: Wrap<B> }

func main() -> int32 {
    words: Pair<int64, string> = Pair { first: 7, second: Wrap { items: alloc(vec_new()) } }
    vec_push(words.second.items, substring("held", 0, 4))
    text := vec_get(words.second.items, 0)
    println(text)
    taken := vec_take(words.second.items, 0)
    free(taken)
    vec_free(words.second.items)
    free(words.second.items)
    numbers: Wrap<int64> = Wrap { items: alloc(vec_new()) }
    vec_push(numbers.items, 42)
    number := vec_get(numbers.items, 0)
    println(move(number))
    println(move(vec_get(numbers.items, 0)))
    vec_free(numbers.items)
    free(numbers.items)
    return 0
}
