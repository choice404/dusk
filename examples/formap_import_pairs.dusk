@paradigm procedural
@import std.map
@import formap_pairmod

// Calling an imported function that runs a map pair loop, exercising the loader's copy
// of the for's second binder.
func main() -> int64 {
    m: *Map<string, int64> = alloc(map_new())
    map_put(m, "a", 1)
    map_put(m, "b", 2)
    show_pairs(m)
    map_free(m)
    free(m)
    return 0
}
