// Accept twin of summary_relation_branch_relink_fail: the branch relinks the sink to a
// second holder the frame allocated itself, so every holder the sink may reach is
// frame owned and the store is legal. Prints 444
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fill() -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    spare: *Holder = alloc(Holder { rows: heap_rows() })
    if local[0] > 0 { relink(s, spare) }
    s.keep(local[0..4])
    println((*(*s).h).rows[3])
}

func main() -> int32 {
    fill()
    return 0
}
