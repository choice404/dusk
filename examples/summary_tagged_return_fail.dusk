// Compile-fail: a helper's sink is built around its own parameter, so the sink's
// value already carries that parameter, and an alias of the sink's holder is read
// before the view is stored through the sink. The helper returns that alias, so a
// caller handing the result back out with a view of its frame array inside is refused
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder, tag: int64[] }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func make(xs: int64[]) -> *Holder {
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }), tag: xs })
    held: *Holder = (*s).h
    s.keep(xs)
    return held
}

func outer() -> *Holder {
    local: int64[4] = [111, 222, 333, 444]
    return make(local[0..4])
}

func main() -> int32 {
    r: *Holder = outer()
    println((*r).rows[0])
    return 0
}
