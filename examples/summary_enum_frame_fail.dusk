@paradigm procedural
@paradigm oop
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe

func wrap(values: *Vector<int64[]>) -> Maybe<int64[]> {
    return Maybe.Some(vec_get(values, 0))
}

func make() -> Maybe<int64[]> {
    local: int64[4] = [111, 222, 333, 444]
    values: *Vector<int64[]> = alloc(vec_new())
    vec_push(values, local[0..4])
    return wrap(values)
}

func main() -> int32 {
    rows: int64[] = unwrap_or(make(), [])
    println(rows[0])
    return 0
}
