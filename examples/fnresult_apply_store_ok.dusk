// A call through a function value whose declared result is an int64 returns nothing
// the value captured, so its result may be stored into a parameter's vector, pushed
// directly, or bound first and stored after
@paradigm procedural
@paradigm functional
@import std.vector
struct Acc { total: int64 }
func apply(f: (int64) -> int64, x: int64) -> int64 { return f(x) }
func run(out: *Vector<int64>, acc: *Acc, k: int64) -> void {
    vec_push(out, apply(lambda (x: int64) -> int64 { return x + k }, 2))
    r: int64 = apply(lambda (x: int64) -> int64 { return x * k }, 4)
    vec_push(out, r)
    (*acc).total = apply(lambda (x: int64) -> int64 { return x - k }, 10)
}
func main() -> int32 {
    out: *Vector<int64> = alloc(vec_new())
    acc: *Acc = alloc(Acc { total: 0 })
    run(out, acc, 3)
    println(vec_get(out, 0))
    println(vec_get(out, 1))
    println((*acc).total)
    return 0
}
