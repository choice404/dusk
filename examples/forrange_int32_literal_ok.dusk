@paradigm procedural

// What a legal bound looks like. An untyped integer literal is one, an int64
// variable is one, and a narrower integer becomes one through the cast the
// refusal names, so int64(m) is accepted where a bare int32 is not.
func main() -> int32 {
    n: int64 = 4
    m: int32 = 2
    mut sum: int64 = 0
    for i in 1..n {
        sum = sum + i
    }
    for i in 0..3 {
        sum = sum + i
    }
    for i in 0..int64(m) {
        sum = sum + i
    }
    println(sum)
    return 0
}
