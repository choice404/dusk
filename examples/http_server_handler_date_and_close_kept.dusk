// The server adds a Date field only when the handler set none, and a handler's own
// Connection: close ends the stream after its response, so the second request here is
// never read and the count is 1.
@paradigm procedural
@import std.net.http.server
@import std.fmt

func handle(req: *Request, ctx: int64) -> *Response {
    resp := response_new(200)
    headers_set((*resp).headers, "Date", "Sun, 06 Nov 1994 08:49:37 GMT")
    headers_set((*resp).headers, "Connection", "close")
    response_set_body(resp, "x")
    return resp
}

func main() -> int32 {
    s := http_server_new(-1)
    c: *StringReader = alloc(string_reader_new("GET /a HTTP/1.1\r\nHost: h\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\n"))
    out: *StringBuilder = alloc(sb_new())
    count, e := http_serve_stream(s, string_reader(c), sb_writer(out), 0, handle)
    println(count)
    println(e.exists())
    q: string = format("%q", [arg_str(sb_cstr(out))])
    println(q)
    free(q)
    sb_free(out)
    free(out)
    free(c)
    free(s)
    return 0
}
