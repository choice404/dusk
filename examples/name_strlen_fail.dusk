@paradigm procedural

@import std.string

// An export "C" function keeps its C name, and strlen is a C library function the
// compiler declares under that name in every module, so an export "C" strlen would
// be the module's strlen. A plain dusk function may be named strlen; see
// name_runtime_names_ok.dusk.
export "C" func strlen(s: string) -> int64 {
    return str_len(s)
}

func main() -> int32 {
    println(strlen("abc"))
    return 0
}
