@paradigm procedural

@import name_foreign_mismatch_mod

// Two foreign declarations of one C function are one symbol, so they must agree;
// this file and the imported one declare getpid with different results.
foreign "C" {
    func getpid() -> int64
}

func main() -> int32 {
    println(getpid() > 0)
    println(pid_positive())
    return 0
}
