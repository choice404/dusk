@paradigm procedural

// Return position preserves the distinct prefix and postfix yielded values.
func prefix(input: int64) -> int64 {
    mut n := input
    return ++n
}

func postfix(input: int64) -> int64 {
    mut n := input
    return n++
}

func main() -> int32 {
    println(prefix(7))
    println(postfix(7))
    return 0
}
