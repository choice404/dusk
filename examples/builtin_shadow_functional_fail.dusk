// The functional builtins are reserved in every paradigm, one coherent rule: a procedural
// file cannot define a top-level `map` any more than a functional one can, since the name
// resolves to the builtin. The declaration is refused rather than left silently dead.
@paradigm procedural

func map(x: int64) -> int64 {
    return x * 2
}

func main() -> int32 {
    println("{}", map(3))
    return 0
}
