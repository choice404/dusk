// Interim responses before the final one are read whole and dropped: the raw server
// thread writes a 100 Continue and a 103 Early Hints with a field of its own, then the
// 200, and the client hands back the 200 alone.
@paradigm procedural
@import std.net.http.client
@import std.fmt

// Reads one request head off the connection and drops it
func drain_head(b: *BufReader) -> void {
    line, le := read_line_capped(b, 1024)
    le.ignore()
    free(line)
    h: *Vector<Header> = headers_new()
    he := read_headers(b, h, 4096, 32)
    he.ignore()
    headers_free(h)
    free(h)
}

func serve(lfd: int64) -> void {
    cfd, peer, ae := net_accept(lfd)
    if ae.exists() {
        printerr(ae)
        return
    }
    b: *BufReader = bufreader_new(fd_reader(cfd), 1024)
    drain_head(b)
    w: Writer = fd_writer(cfd)
    e1 := write_string(w, "HTTP/1.1 100 Continue\r\n\r\n")
    e1.ignore()
    e2 := write_string(w, "HTTP/1.1 103 Early Hints\r\nLink: </s.css>; rel=preload\r\n\r\n")
    e2.ignore()
    e3 := write_string(w, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
    e3.ignore()
    ce := net_close(cfd)
    ce.ignore()
    bufreader_free(b)
    free(b)
    if addr_port(peer) == 0 {
        printerr("unexpected peer")
    }
}

func main() -> int32 {
    lfd, le := net_listen(addr_loopback(0), 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    bound, be := net_local_addr(lfd)
    be.ignore()
    t, te := spawn(lambda () -> void {
        serve(lfd)
    })
    if te.exists() {
        printerr(te)
        return 1
    }
    url: string = format("http://127.0.0.1:%d/", [arg_int(addr_port(bound))])
    resp, e := http_get(url)
    if e.exists() {
        println(e)
    }
    println((*resp).status)
    println(response_text(resp))
    if headers_has((*resp).headers, "Link") {
        println("an interim field leaked")
    }
    response_free(resp)
    free(resp)
    free(url)
    je := join(t)
    je.ignore()
    lc := net_close(lfd)
    lc.ignore()
    return 0
}
