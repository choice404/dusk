@paradigm procedural
@paradigm oop
@paradigm functional
struct A { rows: int64[] }
struct B { n: int64 }
impl A { func get() -> int64[] { return self.rows } }
impl B { func get() -> int64[] {
    seed: int64[1] = [self.n]
    return map(seed[0..1], lambda (x: int64) -> int64 { return x })
} }
func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}
func get_rows(r: A, flag: bool) -> int64[] {
    if flag {
        r: B = B { n: 1 }
        println(r.n)
    }
    return r.get()
}
func make() -> int64[] {
    local: int64[4] = [111, 222, 333, 444]
    return get_rows(A { rows: local[0..4] }, false)
}
func main() -> int32 {
    xs: int64[] = make()
    println(noise(1, 2))
    println(xs[0])
    return 0
}
