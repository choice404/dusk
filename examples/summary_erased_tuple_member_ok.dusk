// A generic scanner returns its element beside a concrete stats struct, and the helper
// one call down reads both. Only the position naming the type parameter is unknown to
// the caller, the stats member keeps its type, so a frame array handed in runs
@paradigm procedural
@paradigm oop
struct Stats { n: int64 }
impl Stats { func total() -> int64 { return self.n } }
func scan<T>(xs: T[]) -> (T, Stats) { return (xs[0], Stats { n: 4 }) }
func helper(xs: int64[]) -> int64 {
    first, st := scan(xs)
    return first + st.total()
}
func main() -> int32 {
    local: int64[4] = [111, 222, 333, 444]
    println(helper(local[0..4]))
    return 0
}
