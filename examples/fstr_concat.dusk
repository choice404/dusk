// An f-string is an ordinary string (the + concat class), so its result feeds the
// string + operator directly. f"a{n}" allocates on the generational heap exactly
// like cool_str_concat, so the following + reclaims and rebuilds like any string.
@paradigm procedural

func main() -> int64 {
    n: int64 = 7
    s: string = "!"
    r: string = f"a{n}" + s
    println(r)
    return 0
}
