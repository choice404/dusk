// A spawned lambda borrows the strings it captures: the spawning frame still holds
// the text and frees it after the join.
@paradigm procedural
@import std.string

func main() -> int32 {
    msg: string = substring("hello", 0, 5)
    t, e := spawn(lambda () -> void {
        println(msg)
        free(msg)
    })
    e.ignore()
    je := join(t)
    je.ignore()
    free(msg)
    return 0
}
