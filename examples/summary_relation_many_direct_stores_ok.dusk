// Many holders in one function, each frame-owned and each written a view of the same
// frame array directly. The escape summary builds the function's frame relation once
// and reuses it for every store, so checking stays fast however many stores it holds
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

