// A Writer over descriptor 1 writes through the C stdout stream, the same stream println
// writes, so the two land in program order instead of one buffer flushing past the other.
@paradigm procedural

@import std.io

func main() -> int32 {
    println("a")
    e := write_line(stdout_writer(), "b")
    e.ignore()
    println("c")
    return 0
}
