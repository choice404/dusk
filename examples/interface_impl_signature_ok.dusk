@paradigm procedural
@paradigm oop

interface Add {
    add(value: int64) -> int64
}

struct Base {
    value: int64,
}

impl Add for Base {
    func add(value: int64) -> int64 {
        return self.value + value
    }
}

func main() -> int32 {
    base: Base = Base { value: 40 }
    value: Add = base
    println(value.add(2))
    return 0
}
