@paradigm procedural

// An if used as a value hands one pointer out of two branches, so the branches must agree
// on who owns it. The then branch hands back the pointer the caller still owns while the
// else branch allocates a fresh one, so the result can be neither uniformly freed nor
// uniformly left alone. The odd branch is named exactly as an odd match arm is.
func first(c: bool, held: *int64) -> *int64 {
    x: *int64 = if c { held } else { alloc(0) }
    return x
}

func main() -> int32 {
    return 0
}
