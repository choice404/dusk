// Compile-fail: a sink pushed into a local vector is relinked to the caller's holder
// through the for binder, then a direct assignment through the sink stores a view of
// a frame array into the caller's holder
@paradigm procedural
@paradigm functional
@import std.vector

struct Holder { rows: int64[] }
struct Sink { h: *Holder }

func same(s: *Sink) -> *Sink { return s }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    v: *Vector<*Sink> = alloc(vec_new())
    vec_push(v, same(s))
    for t in v { (*t).h = h }
    (*(*s).h).rows = local[0..4]
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
