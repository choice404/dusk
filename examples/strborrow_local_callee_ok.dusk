@paradigm procedural
@import std.string
@import std.vector

func make() -> *Vector<string> { return alloc(vec_new()) }

func main() -> int32 {
    make := lambda () -> *Vector<string> {
        names: *Vector<string> = alloc(vec_new())
        vec_push(names, substring("held", 0, 4))
        return names
    }
    names := make()
    text := vec_get(names, 0)
    println(text)
    taken := vec_take(names, 0)
    free(taken)
    vec_free(names)
    free(names)
    return 0
}
