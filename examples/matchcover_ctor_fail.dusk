@paradigm procedural

// A match that leaves a variant uncovered, over a binding a constructor initialized.
// A constructor infers unknown on the surface, and the coverage check used to return
// on an unknown scrutinee, so this match was never judged: at run time the value takes
// no arm, nothing is bound, and control walks past the match. The binding records
// which enum its constructor built, so coverage is judged and the missing variant is
// named. The accept twin is matchcover_ok.
enum Opt { Some(n: int64), None }

func pick(o: Opt) -> int64 {
    match o {
        Some(n) => { return n }
        None => { return 0 }
    }
}

func main() -> int32 {
    o := Opt.Some(7)
    match o {
        Some(n) => { println(n) }
    }
    println(pick(o))
    return 0
}
