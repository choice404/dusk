// An argument reaches a format call as an Arg, never as a bare value: the type has to
// travel with it, so a raw integer in the slice is refused at check rather than rendering
// a marker at run time.
@paradigm procedural

@import std.fmt

func main() -> int64 {
    s: string = format("%d", [5])
    println(s)
    free(s)
    return 0
}
