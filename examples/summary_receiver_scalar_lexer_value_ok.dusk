@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Lexer { src: int64[], toks: *Vector<int64>, pos: int64 }
impl Lexer {
    func reset(src: int64[]) -> void {
        self.src = src
        self.pos = 0
    }
    func run() -> void {
        for i in 0..self.src.len { vec_push(self.toks, self.src[i] * 2) }
    }
}
func main() -> int32 {
    local: int64[4] = [1, 2, 3, 4]
    toks: *Vector<int64> = alloc(vec_new())
    lx: Lexer = Lexer { src: local[0..4], toks: toks, pos: 0 }
    lx.run()
    println(vec_get(lx.toks, 3))
    return 0
}
