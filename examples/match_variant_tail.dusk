@paradigm procedural

enum Src { Num(v: int64), Zero }
enum Res { Ok(v: int64), None }

func main() -> int32 {
    e := Src.Num(7)
    r := match e {
        Num(v) => Res.Ok(v),
        Zero => Res.None,
    }
    s := match r {
        Ok(v) => v,
        None => 0,
    }
    println(s)
    return 0
}
