@paradigm procedural

// The rule follows the binding a name resolves to. An inner scope that binds the
// name again to a heap string frees that string, and the outer literal binding is
// never freed.
func main() -> int32 {
    s := "outer literal"
    if str_len(s) > 0 {
        s := "inner " + "heap"
        println(s)
        free(s)
    }
    println(s)
    return 0
}

func str_len(s: string) -> int64 {
    mut n: int64 = 0
    while s[n] != 0 {
        n++
    }
    return n
}
