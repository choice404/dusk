// A match expression whose arms yield range slices. A range index is not an element
// read, it is a slice, so the result carries { pointer, length } and an arm over a
// string yields a slice of chars the same way an arm over an array yields a slice of
// its elements.
@paradigm procedural

enum K { X, Y }

func main() -> int32 {
    k: K = K.X
    arr: int64[4] = [10, 20, 30, 40]
    sl: int64[] = match k { X => { arr[0..2] }, Y => { arr[1..3] } }
    println(sl.len)
    println(sl[0])
    sl2: int64[] = match k { X => { arr[1..3] }, Y => { arr[0..2] } }
    println(sl2[0])
    s: string = "hello"
    t: char[] = match k { X => { s[2..4] }, Y => { s[0..2] } }
    println(t.len)
    println(t[0])
    return 0
}
