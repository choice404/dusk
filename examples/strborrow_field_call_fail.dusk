// A string a call reads out of a struct it was handed still belongs to that struct,
// so freeing the result frees the field the struct frees again.
@paradigm procedural
@import std.string

struct Rec { name: string }

func field_of(r: *Rec) -> string {
    return (*r).name
}

func main() -> int32 {
    r: *Rec = alloc(Rec { name: substring("hello", 0, 5) })
    x := field_of(r)
    println(x)
    free(x)
    free((*r).name)
    free(r)
    return 0
}
