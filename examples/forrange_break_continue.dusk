@paradigm procedural

// The termination pin. The binder advances before the body, so a continue, which
// jumps to the loop condition, has already stepped past the current value: the
// loop skips the evens and breaks at 8 rather than spinning on the first continue.
// A step placed at the bottom of the body hangs here instead of printing.
func main() -> int32 {
    for i in 0..20 {
        if i == 8 {
            break
        }
        if i % 2 == 0 {
            continue
        }
        println(i)
    }
    return 0
}
