@paradigm procedural
@paradigm oop

// An impl block has no visibility of its own: a method is reachable exactly where its
// receiver type is, so the export belongs on the type.
interface Reader {
    read() -> int64
}

struct Doc {
    n: int64,
}

export impl Reader for Doc {
    func read() -> int64 {
        return self.n
    }
}

func main() -> int32 {
    d: Doc = Doc { n: 1 }
    println(d.read())
    return 0
}
