@paradigm procedural

// The expression form writes its place, so it needs the same `mut` the compound
// assignment needs, and it earns the same two messages an immutable target has always
// earned: the resolver names the write and the type pass names the fix.
func main() -> int32 {
    x: int64 = 5
    y := x++
    println(y)
    return 0
}
