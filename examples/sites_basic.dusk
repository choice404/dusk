@paradigm procedural

@import std.vector

// A --heap-sites build reports at exit every block still live, grouped by the line
// that allocated it. Three joined strings from one line, a vector from another, and
// the vector's buffer from a third are never freed here.
func main() -> int32 {
    for i in 0..3 {
        s := "left" + "right"
        println(s)
    }
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 7)
    println(vec_len(v))
    return 0
}
