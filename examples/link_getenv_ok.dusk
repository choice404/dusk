@paradigm procedural

@import std.string
@import std.os

// A dusk function named for a C library function is only ever the dusk function.
// env reads the variable through the runtime, which calls the C library's getenv;
// every dusk function but main has internal linkage, so this getenv cannot answer
// for that call. A dusk call to it still reaches it, once.
func getenv(name: string) -> string {
    println("hijacked")
    return "the dusk getenv"
}

func main() -> int32 {
    println(getenv("x"))
    p := env("PATH")
    if str_len(p) > 0 {
        println(1)
    } else {
        println(0)
    }
    free(p)
    return 0
}
