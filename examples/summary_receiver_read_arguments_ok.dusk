@paradigm procedural
@paradigm oop

struct Reader { offset: int64 }
impl Reader {
    func read(rows: int64[], index: int64) -> int64 { return rows[index] + self.offset }
}
func main() -> int32 {
    rows: int64[2] = [11, 22]
    reader: Reader = Reader { offset: 3 }
    println(reader.read(rows[0..2], 1))
    return 0
}
