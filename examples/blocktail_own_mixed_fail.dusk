// 1.10.1 X3 twin: a block-tail match that yields a borrow and a sibling arm that yields an
// owner disagree on ownership. The A arm value-izes into a nested all-borrow match, the
// Empty arm allocates a fresh owner, so the arms cannot agree on the result's ownership.
@paradigm procedural

enum Node {
    Leaf(v: *int64),
    Empty,
}

func main() -> int64 {
    p := alloc(42)
    t := alloc(Node.Leaf(p))
    ref rt := t
    ref b := p
    x := match *rt {
        Leaf(q) => {
            println(0)
            match *rt {
                Leaf(w) => w,
                Empty => b,
            }
        },
        Empty => alloc(1),
    }
    println(*x)
    free(t)
    return 0
}
