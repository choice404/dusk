// A bare literal operand takes the other operand's type, so it is ranged against
// that type: the operator positions are the one place a literal reaches a narrow
// width with no annotation to check it against, and a value the width cannot hold
// wraps to the top of the range or truncates instead.
@paradigm procedural

func main() -> int32 {
    u: uint32 = 5
    b: uint8 = 3
    s: int8 = 3
    w: uint16 = 9
    big: uint64 = 7
    println(-1 + u)
    println(300 + b)
    println(s * 300)
    if w == -2 { println(1) } else { println(0) }
    println(big & -3)
    return 0
}
