@paradigm procedural

// A bool has no arithmetic at all, so decrementing one has nothing to mean. The prefix
// form is judged by the same rule as the postfix form: they differ only in which value
// they hand back, never in what they are allowed to step.
func main() -> int32 {
    mut b: bool = true
    y := --b
    println(y)
    return 0
}
