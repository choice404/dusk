@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Buf { rows: int64[] }
impl Buf {
    func set(rows: int64[]) -> void { self.rows = rows }
    func first() -> int64 { return self.rows[0] }
}
func main() -> int32 {
    local: int64[4] = [1, 2, 3, 4]
    b: *Buf = alloc(Buf { rows: [] })
    b.set(local[0..4])
    println(b.first())
    free(b)
    return 0
}
