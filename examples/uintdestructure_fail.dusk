// A destructuring binder's annotation ranges the tuple literal member it binds,
// the same as a single binding ranges its value. The member type the arity walk
// derives is the literal's own width 0 type, which adapts to anything, so the
// annotation is the only thing that can say the written value does not fit.
@paradigm procedural

func main() -> int32 {
    n: uint8, m: int64 := (256, 0)
    p: int8, q: int64 := (300, 1)
    neg: uint16, rest: int64 := (-1, 2)
    println(n)
    println(m)
    println(p)
    println(q)
    println(neg)
    println(rest)
    return 0
}
