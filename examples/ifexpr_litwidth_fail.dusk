@paradigm procedural

// A literal branch adapts to whatever width the branches agreed on, so the agreement alone
// let this through: the then branch pins int8, the else branch's 300 adapted to it, codegen
// sized the result slot from the first branch, and the program printed 44 for a value it
// spells 300. The annotated twin, `y: int8 = if c { 300 } else { a }`, always refused it;
// an inferred binding hands no target, so the literal is ranged against the agreement.
func main() -> int32 {
    c: bool = false
    a: int8 = 5
    y := if c { a } else { 300 }
    println(y)
    return 0
}
