// A parameter that names one enum refuses another enum's constructor. The argument
// carries the constructor's own enum now, so the mismatch reads at the call rather
// than reaching codegen as two different layouts in one slot.
@paradigm procedural

enum Opt {
    Some(v: int64),
    None,
}

enum Tag {
    Hi(n: int64),
    Lo,
}

func take(o: Opt) -> int64 {
    match o {
        Some(v) => return v,
        None => return 0,
    }
}

func main() -> int32 {
    println(take(Tag.Hi(1)))
    return 0
}
