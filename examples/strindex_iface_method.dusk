// An interface method's string result is a string whether the call goes through an
// interface parameter or an interface typed struct field.
@paradigm procedural
@paradigm oop

interface Named { nm() -> string }

struct R { name: string }

impl Named for R {
    func nm() -> string { return self.name }
}

struct Holder { inner: Named }

impl Holder {
    func last() -> int64 {
        s := self.inner.nm()
        return int64(s[2])
    }
}

func show(n: Named) -> int64 {
    s := n.nm()
    return int64(s[1])
}

func main() -> int32 {
    r: R = R { name: "abc" }
    println(show(r))
    h: Holder = Holder { inner: r }
    println(h.last())
    t := h.inner.nm()
    println(int64(t[0]))
    return 0
}
