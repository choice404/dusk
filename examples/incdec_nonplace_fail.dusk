@paradigm procedural

// The operator writes its operand back, so the operand has to be storage. A sum is a
// value with no address, and before this rule the write had nowhere to land: the
// diagnostic names the four spellings that do have one.
func main() -> int32 {
    mut a: int64 = 1
    mut b: int64 = 2
    y := (a + b)++
    println(y)
    return 0
}
