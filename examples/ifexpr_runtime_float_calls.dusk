@paradigm procedural

// If branches can yield float results from both named and closure calls.
func scale(n: float64) -> float64 {
    return n * 2.0
}

func main() -> int32 {
    c: bool = true
    f := lambda (n: float64) -> float64 { return n + 0.5 }
    from_func: float64 = if c { scale(1.5) } else { scale(9.0) }
    from_closure: float64 = if c { f(2.0) } else { f(7.0) }
    println(from_func)
    println(from_closure)
    return 0
}
