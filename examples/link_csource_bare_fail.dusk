@paradigm procedural

// A C source reaches a dusk function by name only through export "C". A plain
// export is visibility between dusk files and says nothing to the linker, so the
// function here has internal linkage and the C file's call to it does not link.
@csource "link_csource_call.c"

foreign "C" {
    func c_calls_dusk(x: int64) -> int64
}

export func dusk_twice(x: int64) -> int64 {
    return x * 2
}

func main() -> int32 {
    println(c_calls_dusk(20))
    return 0
}
