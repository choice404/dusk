// A request with chunked set goes out in chunked coding. The raw server thread reads the
// head, then the raw body bytes up to the last chunk's ending, since the client keeps its
// side open for the response, prints those bytes with %q so every CR LF shows, and only
// then answers.
@paradigm procedural
@import std.net.http.client
@import std.fmt

// Reads one request head off the connection and drops it
func drain_head(b: *BufReader) -> void {
    line, le := read_line_capped(b, 1024)
    le.ignore()
    free(line)
    h: *Vector<Header> = headers_new()
    he := read_headers(b, h, 4096, 32)
    he.ignore()
    headers_free(h)
    free(h)
}

// The raw bytes after the head, byte by byte until the last chunk's 0 CR LF CR LF or 256
// bytes, whichever comes first
func read_chunked_bytes(b: *BufReader) -> string {
    sb: *StringBuilder = alloc(sb_new())
    mut going: bool = true
    while going && sb_size(sb) < 256 {
        c, ok := bufreader_read_byte(b)
        if ok {
            sb_push_char(sb, c)
            going = !ends_with(sb_cstr(sb), "\r\n0\r\n\r\n")
        } else {
            going = false
        }
    }
    out: string = substring(sb_cstr(sb), 0, sb_size(sb))
    sb_free(sb)
    free(sb)
    return out
}

func serve(lfd: int64) -> void {
    cfd, peer, ae := net_accept(lfd)
    if ae.exists() {
        printerr(ae)
        return
    }
    b: *BufReader = bufreader_new(fd_reader(cfd), 1024)
    drain_head(b)
    raw: string = read_chunked_bytes(b)
    q: string = format("%q", [arg_str(raw)])
    println(q)
    we := write_string(fd_writer(cfd), "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")
    we.ignore()
    ce := net_close(cfd)
    ce.ignore()
    free(q)
    free(raw)
    bufreader_free(b)
    free(b)
    if addr_port(peer) == 0 {
        printerr("unexpected peer")
    }
}

func main() -> int32 {
    lfd, le := net_listen(addr_loopback(0), 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    bound, be := net_local_addr(lfd)
    be.ignore()
    t, te := spawn(lambda () -> void {
        serve(lfd)
    })
    if te.exists() {
        printerr(te)
        return 1
    }
    url: string = format("http://127.0.0.1:%d/u", [arg_int(addr_port(bound))])
    req: *Request = request_new("POST", "/u")
    (*req).chunked = true
    request_set_body(req, "hello world")
    resp, e := http_send(url, req)
    if e.exists() {
        println(e)
    }
    println((*resp).status)
    response_free(resp)
    free(resp)
    request_free(req)
    free(req)
    free(url)
    je := join(t)
    je.ignore()
    lc := net_close(lfd)
    lc.ignore()
    return 0
}
