// A fallible scanner hands back a view of its input beside an error, and the helper
// one call down asks the error whether it exists before reading the view. The error's
// own methods tie nothing, so the caller keeps its buffer on its frame and it runs
@paradigm procedural
func skip_zeros(xs: int64[]) -> (int64[], error) {
    if xs[0] != 0 { return (xs, error { message: "no leading zero" }) }
    return (xs[1..4], error {})
}
func first_after_zeros(xs: int64[]) -> int64 {
    rest, e := skip_zeros(xs)
    if e.exists() { return -1 }
    return rest[0]
}
func main() -> int32 {
    buf: int64[4] = [0, 7, 8, 9]
    println(first_after_zeros(buf[0..4]))
    return 0
}
