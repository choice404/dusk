// A bracketed host is an IPv6 literal: hex digits, colons, and dots for an IPv4 tail, with
// at least one colon. A bracketed IPv4 address and a bracketed name are url: bad host
// rather than a host the brackets would hide, and the empty brackets stay url: empty host.
@paradigm procedural
@import std.url

func show(text: string) -> void {
    u, e := url_parse(text)
    if e.exists() {
        println(e)
    } else {
        h := url_host_header(u)
        println(h)
        free(h)
    }
    url_free(u)
    free(u)
}

func main() -> int32 {
    show("http://[127.0.0.1]/")
    show("http://[localhost]/")
    show("http://[::1%25eth0]/")
    show("http://[]/")
    show("http://[::ffff:127.0.0.1]:8/")
    show("http://[2001:DB8::a]/")
    return 0
}
