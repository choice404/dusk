// An IPv6 literal host is read between its brackets and stored without them, and the
// Host value puts them back around it, followed by the port that is not the default.
@paradigm procedural
@import std.url

func main() -> int32 {
    u, e := url_parse("http://[::1]:9/p")
    if e.exists() {
        println(e)
        return 1
    }
    println((*u).host)
    println((*u).port)
    host := url_host_header(u)
    println(host)
    free(host)
    url_free(u)
    free(u)
    return 0
}
