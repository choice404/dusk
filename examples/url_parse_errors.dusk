// Each malformed shape is refused with its own sentence, and the Url beside the error
// is a real one with empty heap fields, released like any other.
@paradigm procedural
@import std.url

func show(text: string) -> void {
    u, e := url_parse(text)
    if e.exists() {
        println(e)
    } else {
        println("parsed")
    }
    url_free(u)
    free(u)
}

func main() -> int32 {
    show("example.com/x")
    show("http:///x")
    show("http://u@h/")
    show("http://h:99999/")
    show("http://[::1/")
    show("http://h/a b")
    return 0
}
