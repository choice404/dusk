@paradigm procedural

// The bounds are signed int64, so a negative low bound counts up through zero.
// -3..1 yields -3, -2, -1, 0, four iterations, and the comparison is a signed
// one rather than the unsigned compare an index loop would be tempted into.
func main() -> int32 {
    for i in -3..1 {
        println(i)
    }
    return 0
}
