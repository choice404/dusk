// The five markers. A format call has no error channel: a mistake in the literal renders
// a marker into the output and the program keeps running, so a wrong call shows up in
// what it printed rather than as a fault or a condition the caller has to resolve.
@paradigm procedural

@import std.fmt

func show(f: string, args: Arg[]) -> void {
    s: string = format(f, args)
    println(s)
    free(s)
}

func main() -> int64 {
    show("%d", [])
    show("%d", [arg_str("hello")])
    show("%z", [arg_int(5)])
    show("end%", [])
    show("%d", [arg_int(1), arg_int(5), arg_str("x")])
    return 0
}
