@paradigm procedural
@paradigm oop
@import std.vector
struct Lexer { src: int64[], toks: *Vector<int64[]> }
impl Lexer {
    func keep() -> void { vec_push(self.toks, self.src) }
}
func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}
func fillit(toks: *Vector<int64[]>) -> void {
    local: int64[4] = [111, 222, 333, 444]
    lx: Lexer = Lexer { src: local[0..4], toks: toks }
    lx.keep()
}
func main() -> int32 {
    toks: *Vector<int64[]> = alloc(vec_new())
    fillit(toks)
    println(noise(1, 2))
    println(vec_get(toks, 0)[0])
    return 0
}
