@paradigm procedural

// A foreign declaration may restate a runtime function the compiler declares, the
// way the standard library restates the collector's counters, but only the same
// way: one symbol cannot be declared with two prototypes in one module.
foreign "C" {
    func cool_gen_alloc(n: int32) -> int64
}

func main() -> int32 {
    println("hi")
    return 0
}
