// eprint and eprintln are not builtins: a user may define eprintln, and its string argument
// is an ordinary string, not a format, so an escaped brace decodes to one literal brace and
// is never doubled by the format cook.
@paradigm procedural
func eprintln(s: string) -> void {
    println(s)
}
func main() -> int32 {
    eprintln("\u{7b}ok\u{7d}")
    return 0
}
