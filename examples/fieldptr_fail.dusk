@paradigm procedural

// A field read through a pointer, with no dereference. Codegen has no lowering for the
// form at all, so it died as `unsupported field expression` naming no file and no line
// whether or not the field existed, while the matching store `p.n = 1` has been named for
// releases. The read now earns the store's own message, and `(*p).n` is the spelling that
// lowers.
struct S { n: int64 }

func main() -> int32 {
    p: *S = alloc(S { n: 42 })
    println(p.n)
    free(p)
    return 0
}
