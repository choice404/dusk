@paradigm procedural

// The same uncovered match over a payload free constructor, the shape that really
// walks off the end: o is None, the only arm names Some, and before the coverage check
// reached here the program built and printed 42 with the match doing nothing. A bare
// qualified constructor is a field expression rather than a call, so the binding
// recorded no enum at all; both constructor forms are recorded now.
enum Opt { Some(n: int64), None }

func main() -> int32 {
    o := Opt.None
    match o {
        Some(n) => { println(n) }
    }
    println(42)
    return 0
}
