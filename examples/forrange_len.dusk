@paradigm procedural

// The index loop the counted form exists for: `0..s.len` walks every position of
// a slice, and the binder indexes it. The length is a bound like any other, read
// once at the top, so the loop covers exactly the slice it started on.
func main() -> int32 {
    xs: int64[4] = [5, 6, 7, 8]
    s: int64[] = xs[0..xs.len]
    mut sum: int64 = 0
    for i in 0..s.len {
        sum = sum + s[i]
    }
    println(sum)
    return 0
}
