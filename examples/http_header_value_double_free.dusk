// Compile-fail: a value from headers_get is a borrow into the list, which owns it and
// frees it in headers_free. The checker records the call's string result as a borrow,
// so freeing it here is refused at check, `cannot free a borrowed string; only its
// owner frees it`, where through 1.17.2 it passed and the list's own free of the same
// block was the runtime's double free fault.
@paradigm procedural
@import std.net.http

func main() -> int32 {
    h := headers_new()
    headers_add(h, "a", "b")
    v, ok := headers_get(h, "a")
    if ok {
        println(v)
        free(v)
    }
    headers_free(h)
    free(h)
    return 0
}
