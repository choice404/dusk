// An if used as a value whose branches yield freshly allocated pointers, through both
// spellings of the form. The pointee of an alloc of a bare literal is the literal's own
// type, so the branch result is a real pointer and dereferencing it reads a real value.
@paradigm procedural

func main() -> int32 {
    c: bool = true
    d: bool = false
    x := if c { alloc(1) } else { alloc(2) }
    println(*x)
    free(x)
    y := d ? alloc(3u32) : alloc(4u32)
    println(*y)
    free(y)
    f := if c { alloc(1.5) } else { alloc(2.5) }
    println(*f)
    free(f)
    return 0
}
