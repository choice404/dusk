@paradigm procedural

// The accept twin: a literal arm that does fit the width the arms agreed on still adapts
// and still runs, so ranging the literal tails refuses only what a narrow slot cannot hold.
enum Pick { A, B }

func main() -> int32 {
    p := Pick.B
    a: int8 = 5
    y := match p {
        A => a,
        B => 7,
    }
    println(y)
    return 0
}
