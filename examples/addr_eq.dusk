// addr_eq compares by value: the same IPv4 address and port, a different port,
// two unix paths held in different strings with the same bytes, and the IPv4
// loopback against the IPv6 one.
@paradigm procedural
@import std.net.addr
@import std.string

func main() -> int64 {
    println(addr_eq(addr_ip4(10, 0, 0, 7, 22), addr_ip4(10, 0, 0, 7, 22)))
    println(addr_eq(addr_loopback(80), addr_loopback(81)))
    path := substring("/tmp/eq.sock", 0, 12)
    println(addr_eq(addr_unix(path), addr_unix("/tmp/eq.sock")))
    println(addr_eq(addr_loopback(80), addr_loopback6(80)))
    free(path)
    return 0
}
