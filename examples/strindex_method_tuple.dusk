// A string destructured out of a method's tuple result keeps its string type.
@paradigm procedural
@paradigm oop

struct R { name: string }

impl R {
    func pair() -> (string, int64) { return (self.name, 1) }
}

func main() -> int32 {
    r: R = R { name: "abc" }
    a, b := r.pair()
    println(int64(a[b]))
    return 0
}
