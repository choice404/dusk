@paradigm procedural
@import std.map

// `for k, v in m` binds each key and its value together, the two-binder form that
// is map-only. Both binders are borrows the map still owns.
func main() -> int64 {
    m: *Map<string, int64> = alloc(map_new())
    map_put(m, "a", 1)
    map_put(m, "b", 2)
    map_put(m, "c", 3)
    map_put(m, "b", 20)
    map_remove(m, "a")
    for k, v in m {
        print(k)
        print("=")
        println(v)
    }
    map_free(m)
    free(m)
    return 0
}
