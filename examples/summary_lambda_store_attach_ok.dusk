// The same lambda store with the fresh holder kept local: the caller's sink never
// sees it, so a frame array's view is accepted and runs
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func keepvia(q: *Sink, xs: int64[]) -> void {
    inner: *Holder = alloc(Holder { rows: heap_rows() })
    s: *Sink = alloc(Sink { h: inner })
    one: int64[1] = [1]
    foreach(one[0..1], lambda (x: int64) -> void { s.keep(xs) })
    println((*inner).rows[1])
}

func fill(q: *Sink) -> void {
    local: int64[4] = [111, 222, 333, 444]
    keepvia(q, local[0..4])
}

func main() -> int32 {
    q: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    fill(q)
    println((*(*q).h).rows[0])
    return 0
}
