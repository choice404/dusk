// write_string hands back an error, so leaving the result of a call unbound is refused by
// the must handle rule.
@paradigm procedural

@import std.io
@import std.string

func main() -> int32 {
    b: *StringBuilder = alloc(sb_new())
    write_string(sb_writer(b), "x")
    sb_free(b)
    free(b)
    return 0
}
