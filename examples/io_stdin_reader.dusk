// stdin_reader reads descriptor 0 directly, not through the C stdin buffer the read_line
// builtin uses, so a program picks one of the two paths for its whole run.
@paradigm procedural

@import std.io

func main() -> int32 {
    text, e := read_to_end(stdin_reader())
    e.ignore()
    print(text)
    free(text)
    return 0
}
