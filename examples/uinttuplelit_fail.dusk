// A tuple literal's members are ranged against the member types of the tuple they
// are written into, in a binding and in return position alike. Both spellings reach
// codegen as a store per member, so an unranged member lands wrapped in the half of
// the tuple that named the narrow width.
@paradigm procedural

func edges() -> (uint8, uint16) {
    return (250, -1)
}

func main() -> int32 {
    t: (uint8, int8) = (-1, 300)
    a, b := t
    println(a)
    println(b)
    c, d := edges()
    println(c)
    println(d)
    return 0
}
