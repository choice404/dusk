@paradigm procedural

@import std.process

// run_capture hands back one string and keeps nothing else live, so a heap sites
// build of a program that frees what it is handed prints no report at exit.
func main() -> int32 {
    out, code, e := run_capture("printf 'one\\ntwo\\nthree\\n'")
    if e.exists() {
        printerr(e)
        return 1
    }
    println(out)
    println(code)
    free(out)
    return 0
}
