@paradigm procedural
@import std.vector

struct Cell { rows: int64[] }
struct Outer { inner: *Cell }

func main() -> int32 {
    cell: *Cell = alloc(Cell { rows: [] })
    cells: *Vector<*Cell> = alloc(vec_new())
    vec_push(cells, cell)
    fill := lambda () -> void {
        local: int64[4] = [111, 222, 333, 444]
        ref alias := vec_get(cells, 0)
        (*alias).rows = local[0..4]
    }
    fill()
    println((*cell).rows[0])
    return 0
}
