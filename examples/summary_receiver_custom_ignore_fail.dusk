@paradigm procedural
@paradigm oop

struct Holder { rows: int64[] }
struct Sink { holder: *Holder, rows: int64[] }
impl Sink {
    func ignore() -> void { (*self.holder).rows = self.rows }
}
func fill(holder: *Holder) -> void {
    local: int64[2] = [111, 222]
    sink: Sink = Sink { holder: holder, rows: local[0..2] }
    sink.ignore()
}
func main() -> int32 {
    holder: *Holder = alloc(Holder { rows: [] })
    fill(holder)
    println((*holder).rows[0])
    return 0
}
