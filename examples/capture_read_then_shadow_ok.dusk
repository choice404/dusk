@paradigm procedural

// A lambda that reads the enclosing x and then binds an x of its own captures the
// enclosing one for the read before the binding, and the binding shadows it after.
func main() -> int32 {
    x: int64 = 7
    g := lambda () -> int64 {
        y: int64 = x + 1
        x: int64 = 100
        return y + x
    }
    println(g())
    println(x)
    return 0
}
