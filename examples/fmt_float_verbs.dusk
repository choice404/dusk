// The float verbs, one line per value. %f, %e, %E, %g, and %G are the C conversions at
// their C default precision of six, %v is %g at that same precision and so is what
// println already writes, and %r is the shortest form that reads back as the same double.
// The flags lay the result out: a width, a left justification, a zero pad that sits after
// the sign, a plus, and the alternate form that keeps %g's trailing zeros.
@paradigm procedural

@import std.fmt

func line(x: float64) -> void {
    s: string = format("%f|%.2f|%e|%E|%g|%G|%v|%r|%8.3f|%-8.3f|%08.3f|%+.1f|%#g", [
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x),
        arg_float(x)
    ])
    println(s)
    free(s)
}

func main() -> int64 {
    line(3.14159)
    line(1234567.0)
    return 0
}
