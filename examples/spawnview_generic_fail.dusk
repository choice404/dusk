// Compile-fail: the closure hides behind a generic argument. The checker sees
// an erased Vector, so the capture is refused once mono knows the element type.
@paradigm procedural
@import std.vector

func twice(x: int64) -> int64 { return x * 2 }

func main() -> int32 {
    fs: *Vector<(int64) -> int64> = alloc(vec_new())
    vec_push(fs, twice)
    t, e := spawn(lambda () -> void {
        println(vec_len(fs))
    })
    if e.exists() { return 1 }
    je := join(t)
    je.ignore()
    vec_free(fs)
    free(fs)
    return 0
}
