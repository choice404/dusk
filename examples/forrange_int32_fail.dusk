@paradigm procedural

// The bounds are int64, and a narrower signed integer is not widened for you: the
// mixed-width rule the rest of the language keeps holds in a loop head too, and
// the refusal names the cast that fixes it.
func main() -> int32 {
    n: int32 = 3
    for i in 0..n {
        println(i)
    }
    return 0
}
