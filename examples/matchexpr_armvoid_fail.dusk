// 1.10.1 X1: a match expression arm whose block ends in a statement that yields no value
// (here an `if` with no `else`) stores nothing into the result slot, so the outer binding
// once read an uninitialized slot and printed garbage. The every-arm-yields check rejects
// it: an arm must yield a value or diverge (return, break, continue).
@paradigm procedural

enum E {
    A(v: int64),
    B,
}

func main() -> int64 {
    e: E = E.A(5)
    x: int64 = match e {
        A(v) => {
            if v > 0 { println(v) }
        },
        B => 2,
    }
    println(x)
    return 0
}
