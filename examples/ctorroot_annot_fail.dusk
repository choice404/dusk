// A constructor call carries its enum's type, so a scalar annotation over one is a
// plain annotation mismatch. Before the constructor typed as itself the binding took
// the surface wildcard, agreed with int64, and died in clang storing an enum into an
// integer slot.
@paradigm procedural

enum Opt {
    Some(v: int64),
    None,
}

func main() -> int32 {
    x: int64 = Opt.Some(1)
    println(x)
    return 0
}
