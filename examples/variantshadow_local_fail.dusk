@paradigm procedural

// The same masking through a local closure rather than a function. The binding owns
// the name, so the call goes through the closure and carries its argument's view.
enum Tag { Some(n: int64), None }

func mk() -> int64[] {
    local: int64[4] = [1, 2, 3, 4]
    Some := lambda (xs: int64[]) -> int64[] { return xs }
    r := Some(local[0..4])
    return r
}

func main() -> int32 {
    v := mk()
    println(v[0])
    return 0
}
