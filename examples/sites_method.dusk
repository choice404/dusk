@paradigm procedural
@paradigm oop

// A method call and a call through an interface are bracketed like any other, so a
// block either one allocates names the method's line under the caller's.
interface Namer {
    name() -> string
}

struct Dog {
    age: int64,
}

impl Namer for Dog {
    func name() -> string {
        return "dog" + "!"
    }
}

impl Dog {
    func tag() -> string {
        return "tag" + "!"
    }
}

func describe(n: Namer) -> string {
    return n.name()
}

func main() -> int32 {
    d := Dog { age: 3 }
    t := d.tag()
    s := describe(d)
    println(t)
    println(s)
    return 0
}
