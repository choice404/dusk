@paradigm procedural
@paradigm oop
@import std.string
@import std.vector
struct Box { n: int64 }
struct Tag { label: string }
impl Tag {
    func first() -> string { return self.label }
}
func first<T>(v: *Vector<T>) -> T { return vec_get(v, 0) }
func main() -> int32 {
    v: *Vector<*Box> = alloc(vec_new())
    vec_push(v, alloc(Box { n: 7 }))
    ref b := first(v)
    println((*b).n)
    c := first(v)
    println((*c).n)
    return 0
}
