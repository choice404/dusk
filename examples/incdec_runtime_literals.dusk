@paradigm procedural

// Prefix and postfix increments are ordinary values inside aggregate literals.
struct Pair { first: int64, second: int64 }

func main() -> int32 {
    mut n: int64 = 2
    xs: int64[2] = [n++, ++n]
    p := Pair { first: n++, second: ++n }
    println(xs[0])
    println(xs[1])
    println(p.first)
    println(p.second)
    println(n)
    return 0
}
