// An interface value returned inside a tuple views the boxed concrete value, which is a
// frame local here, so the returned view dangles. Refused like a bare interface return.
@paradigm oop
interface Shape {
    area() -> int64
}
struct Sq { s: int64 }
impl Shape for Sq {
    func area() -> int64 { return self.s * self.s }
}
func mk() -> (Shape, int64) {
    q: Sq = Sq { s: 4 }
    v: Shape = q
    return (v, 2)
}
func main() -> int32 {
    s, n := mk()
    println("{}", s.area() + n)
    return 0
}
