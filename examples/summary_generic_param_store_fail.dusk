// Compile-fail: a generic helper stores its view into a fresh holder, then points the
// receiver it was given, whatever its type, at that holder. The receiver is the
// caller's sink, so a caller handing the helper a view of a frame array is refused
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

func keepvia<S>(q: S, xs: int64[]) -> void {
    inner: *Holder = alloc(Holder { rows: heap_rows() })
    s: *Sink = alloc(Sink { h: inner })
    s.keep(xs)
    q.point(inner)
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    q: *Sink = alloc(Sink { h: h })
    keepvia(q, local[0..4])
    (*h).rows = (*(*q).h).rows
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
