// A generic helper that stores its view into a holder of its own and only stashes a
// value of its type parameter into a cell outside that holder's class, so a view of
// a frame array is accepted and runs
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

struct Cell<T> { item: T }

func stash<T>(c: *Cell<T>, x: T) -> void { (*c).item = x }

func keepvia<T>(c: *Cell<T>, x: T, xs: int64[]) -> void {
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    s.keep(xs)
    stash(c, x)
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    c: *Cell<*Holder> = alloc(Cell { item: h })
    keepvia(c, h, local[0..4])
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
