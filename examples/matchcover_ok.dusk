@paradigm procedural

// The accept twin of the matchcover rejects. The same two constructor bound scrutinees
// are matched, one from a payload carrying constructor and one from a payload free
// one, and both matches cover every variant, so judging coverage on a scrutinee whose
// type is unknown must leave them legal. A wildcard arm counts as coverage too, which
// the third match pins.
enum Opt { Some(n: int64), None }
enum Three { A(n: int64), B, C }

func main() -> int32 {
    o := Opt.Some(7)
    match o {
        Some(n) => { println(n) }
        None => { println(0) }
    }
    e := Opt.None
    match e {
        Some(n) => { println(n) }
        None => { println(1) }
    }
    t := Three.B
    match t {
        A(n) => { println(n) }
        _ => { println(2) }
    }
    return 0
}
