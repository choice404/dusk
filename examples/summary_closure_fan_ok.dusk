// Closures that call closures ten deep, each calling the one below eight times: the
// summary walks each closure once and asks the frame relation once per store, so
// checking this stays linear in the program and finishes well under a second
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fresh() -> *Sink {
    return alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

func work(h: *Holder, xs: int64[]) -> void {
    s: *Sink = fresh()
    n: int64 = xs.len
    g1 := lambda () -> void { println((*(*s).h).rows[0]) }
    g2 := lambda () -> void { g1(); g1(); g1(); g1(); g1(); g1(); g1(); g1(); }
    g3 := lambda () -> void { g2(); g2(); g2(); g2(); g2(); g2(); g2(); g2(); }
    g4 := lambda () -> void { g3(); g3(); g3(); g3(); g3(); g3(); g3(); g3(); }
    g5 := lambda () -> void { g4(); g4(); g4(); g4(); g4(); g4(); g4(); g4(); }
    g6 := lambda () -> void { g5(); g5(); g5(); g5(); g5(); g5(); g5(); g5(); }
    g7 := lambda () -> void { g6(); g6(); g6(); g6(); g6(); g6(); g6(); g6(); }
    g8 := lambda () -> void { g7(); g7(); g7(); g7(); g7(); g7(); g7(); g7(); }
    g9 := lambda () -> void { g8(); g8(); g8(); g8(); g8(); g8(); g8(); g8(); }
    g10 := lambda () -> void { g9(); g9(); g9(); g9(); g9(); g9(); g9(); g9(); }
    if n > 100 { g10() }
    relink(s, h)
    println(n)
}

func fill(h: *Holder) -> void {
    work(h, heap_rows())
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
