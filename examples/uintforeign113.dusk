@paradigm procedural

// A uint64 crosses a C source boundary and comes back with its bits intact.
@csource "uintforeign113.c"

foreign "C" {
    func echo_u64(v: uint64) -> uint64
}

func main() -> int32 {
    v: uint64 = 9223372036854775808u64
    println(echo_u64(v))
    println(echo_u64(18446744073709551615u64))
    return 0
}
