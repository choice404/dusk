// Compile-fail: the twin with views of the function's own frame in the array, each
// pushed into the parameter's vector by the callback, which the frame outlives
@paradigm procedural
@paradigm oop
@paradigm functional

@import std.vector
@import std.map

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}
struct Cell<T> { item: T }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func gpoint<S>(q: S, h: *Holder) -> void { q.point(h) }

func push_all(out: *Vector<int64[]>) -> void {
    local: int64[4] = [111, 222, 333, 444]
    both: (int64[])[2] = [local[0..2], local[2..4]]
    foreach(both[0..2], lambda (x: int64[]) -> void { vec_push(out, x) })
}

func main() -> int32 {
    rows: *Vector<int64[]> = alloc(vec_new())
    push_all(rows)
    println(vec_get(rows, 0)[0])
    return 0
}
