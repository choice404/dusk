// A method called through a pointer, dereferenced or not, returns the same string
// its declaration names, and an index over it is a string index.
@paradigm procedural
@paradigm oop

struct R { name: string }

impl R {
    func nm() -> string { return self.name }
}

func main() -> int32 {
    r: *R = alloc(R { name: "abc" })
    n := (*r).nm()
    println(int64(n[1]))
    m := r.nm()
    println(int64(m[2]))
    free(r)
    return 0
}
