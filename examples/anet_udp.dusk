// A datagram round trip on the loop. Two sockets bound to 127.0.0.1:0 are set
// nonblocking; the receive task parks on udp_recv_async before the send task runs
// udp_send_async, so the datagram lands on an armed socket and the wake drives the
// recvfrom. The sender's address beside the count equals the sending socket's own
// local address.
@paradigm procedural
@import std.async.net
@import std.net
@import std.net.udp
@import std.async.future
@import std.async.loop

async func receiver(fd: int64, from_want: Addr) -> (int64, error) {
    buf: *raw char = alloc_bytes(16)
    n, from, e := await udp_recv_async(fd, buf, 16)
    if e.exists() {
        free(buf)
        return (0, e)
    }
    text: string = substring(cstr(buf), 0, n)
    free(buf)
    println(n)
    println(addr_eq(from, from_want))
    println(text)
    free(text)
    return (n, error {})
}

async func sender(fd: int64, to: Addr) -> (int64, error) {
    msg: *raw char = cbuf("pong")
    n, e := await udp_send_async(fd, msg, 4, to)
    free(msg)
    return (n, e)
}

async func amain() -> int32 {
    afd, abe := udp_bind(addr_loopback(0))
    bfd, bbe := udp_bind(addr_loopback(0))
    if abe.exists() || bbe.exists() {
        printerr("bind failed")
        return 1
    }
    ae := fd_nonblock(afd)
    ae.ignore()
    be := fd_nonblock(bfd)
    be.ignore()
    a_local, ale := net_local_addr(afd)
    ale.ignore()
    b_local, ble := net_local_addr(bfd)
    ble.ignore()
    rf := receiver(bfd, a_local)
    sn, se := await sender(afd, b_local)
    se.ignore()
    rn, re := await rf
    re.ignore()
    ac := net_close(afd)
    ac.ignore()
    bc := net_close(bfd)
    bc.ignore()
    if sn != 4 || rn != 4 {
        return 1
    }
    return 0
}

func main() -> int32 {
    le := loop_init()
    le.ignore()
    se := reactor_start()
    se.ignore()
    rc := async_run(amain())
    reactor_stop()
    loop_free()
    return rc
}
