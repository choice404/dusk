// %v is the rendering println already writes, so the same four values through print_fmt
// and through a println format string are the same two lines. An integer, an unsigned
// integer at a width where the signedness shows, a float through the six digit general
// layout, and a bool.
@paradigm procedural

@import std.fmt

func main() -> int64 {
    n: int64 = 0 - 3
    u: uint64 = 18446744073709551615u64
    x: float64 = 1234567.0
    print_fmt("%v %v %v %v\n", [arg_int(n), arg_uint(u), arg_float(x), arg_bool(true)])
    println("{} {} {} {}", n, u, x, true)
    return 0
}
