@paradigm procedural

// Expression spellings wrap signed int8 places at both edges.
func main() -> int32 {
    mut high_prefix: int8 = 127
    println(++high_prefix)
    mut high_postfix: int8 = 127
    println(high_postfix++)
    println(high_postfix)
    mut low_prefix: int8 = -128
    println(--low_prefix)
    mut low_postfix: int8 = -128
    println(low_postfix--)
    println(low_postfix)
    return 0
}
