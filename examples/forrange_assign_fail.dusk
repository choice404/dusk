@paradigm procedural

// The binder is immutable, the same as a container loop's. Assigning to it to
// steer the loop by hand is refused, so the cursor the lowering owns is the only
// thing that advances the count.
func main() -> int32 {
    for i in 0..3 {
        i = i + 1
        println(i)
    }
    return 0
}
