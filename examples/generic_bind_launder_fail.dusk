// A binding of a borrowed type-parameter value inherits the borrow, so freeing the alias
// rejects: y := x over a borrowed x keeps y a borrow, and free(y) is a double free at the
// managed instantiation.
@paradigm procedural
func sink<T>(x: T) -> void {
    y := x
    free(y)
}
func main() -> int32 {
    p: *int64 = alloc(5)
    sink(p)
    v: int64 = *p
    println("{}", v)
    return 0
}
