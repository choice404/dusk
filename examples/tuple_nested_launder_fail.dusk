// A borrow buried in a nested tuple survives the inner destructure chain: ((p, 1), 2)
// records the borrow at its path, so inner from inner, m := nest and then y from y, n :=
// inner is a borrow, and free(y) rejects.
@paradigm procedural
func take(p: *int64) -> void {
    nest := ((p, 1), 2)
    inner, m := nest
    y, n := inner
    println(m + n)
    free(y)
}
func main() -> int32 {
    p: *int64 = alloc(8)
    *p = 7
    take(p)
    println(*p)
    free(p)
    return 0
}
