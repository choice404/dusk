@paradigm procedural

// A binding that names itself, shadowing the outer one it copies. The binder is
// declared before its value is read, so asking which enum the value holds found the
// name being defined, stopped there, and answered with nothing: the match went
// unjudged and the missing variant went unreported. A self naming binding asks the
// scope outside its own.
enum Opt { Some(n: int64), None }

func main() -> int32 {
    o := Opt.Some(1)
    if true {
        o := o
        match o {
            Some(n) => { println(n) }
        }
    }
    println(42)
    return 0
}
