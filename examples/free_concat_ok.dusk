@paradigm procedural

// A concatenation allocates, so its result is a heap string the binding owns and
// frees, even when every operand is a literal. An if expression that mixes a
// literal with an allocation is not a literal on every path, so its free is left
// to run time, and here the branch taken, argc is at least 1, is the heap one.
func main(argc: int32, argv: string[]) -> int32 {
    s := "con" + "cat"
    println(s)
    free(s)
    t := if argc > 0 { "heap " + "branch" } else { "literal branch" }
    println(t)
    free(t)
    return 0
}
