// The accept twin of the unsigned rejects. A u suffix pins a literal that no
// signed width of the same size would hold, a bare literal adapts up to the
// unsigned top, an unsigned operand hands back an unsigned result, a cast of a
// negative is the deliberate wrap, and an unsigned value prints and hashes.
@paradigm procedural

func main() -> int32 {
    packed: uint8 = 200u8
    adapted: uint8 = 250
    big: uint64 = 9223372036854775807u64
    wrapped: uint8 = uint8(-1)
    sum: uint32 = 5u32 + 1
    shifted: uint32 = sum << 3
    println("{} {} {}", packed, adapted, big)
    println(f"{wrapped} {sum} {shifted}")
    println(hash(big))
    if sum < 10u32 {
        println(1)
    }
    return 0
}
