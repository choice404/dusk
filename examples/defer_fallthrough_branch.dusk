@paradigm procedural

func work(is_early: bool) -> void {
    value: int64 = 7
    defer println("done {}", value)
    if is_early {
        value: int64 = 1
        println("shadow {}", value)
        println("return")
        return
    } else {
        println("fallthrough")
    }
}

func both_return(is_first: bool) -> void {
    defer println("both return done")
    if is_first { return } else { return }
}

func both_fallthrough(is_first: bool) -> void {
    defer println("both fallthrough done")
    if is_first { println("first") } else { println("second") }
}

func main() -> int32 {
    work(true)
    work(false)
    both_return(true)
    both_return(false)
    both_fallthrough(true)
    both_fallthrough(false)
    return 0
}
