@paradigm procedural

// A callee that returns early leaves the site stack where it found it, so a block
// allocated after the call names its own line alone.
func pick(early: bool) -> string {
    if early {
        return "early" + "!"
    }
    return "late" + "!"
}

func main() -> int32 {
    a := pick(true)
    b := pick(false)
    c := "after" + "!"
    println(a)
    println(b)
    println(c)
    return 0
}
