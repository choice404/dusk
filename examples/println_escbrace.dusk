// A brace written as a Unicode escape is a literal brace in a format string, distinct from
// a placeholder brace typed directly. \u{7b} and \u{7d} each survive as one literal brace,
// two escapes give two braces (no fold), and a placeholder still expands between escaped
// braces. Before the raw-span cook, \u{7b}\u{7b} folded to one brace and A\u{7b}B was
// wrongly rejected as an unmatched placeholder.
@paradigm procedural

func main() -> int32 {
    println("A\u{7b}B")
    println("\u{7b}\u{7b}")
    println("open \u{7b} close \u{7d}")
    println("val=\u{7b}{}\u{7d}", 5)
    println("typed {{brace}} and {}", 9)
    return 0
}
