@paradigm procedural

// A semicolon ends a statement exactly as a newline does, and `return` reads that break
// the same way: `return;` returns no value, just as a `return` at the end of a line does,
// and `return x;` returns x.
func two() -> int64 {
    return 2;
}

func nothing() -> void {
    println("x");
    return;
}

func main() -> int32 {
    nothing()
    println(two())
    return 0
}
