// Expect: 100-continue. The client sends the head alone and waits; the server reads the
// head, answers HTTP/1.1 100 Continue before reading a byte of the body, and only once
// the client has read that interim line does it send the body, which the handler
// echoes back in the final reply.
@paradigm procedural
@import std.net.http.server
@import std.concurrent.thread
@import std.fmt

func handle(req: *Request, ctx: int64) -> *Response {
    resp := response_new(200)
    response_set_body_bytes(resp, (*req).body, (*req).body_len)
    return resp
}

// Reads the interim response, writes the body, and reads the final reply to the close
func client(fd: int64) -> void {
    w: Writer = fd_writer(fd)
    he := write_string(w, "POST /up HTTP/1.1\r\nHost: a\r\nExpect: 100-continue\r\nContent-Length: 2\r\nConnection: close\r\n\r\n")
    he.ignore()
    b: *BufReader = bufreader_new(fd_reader(fd), 64)
    status, se := read_line_capped(b, 256)
    se.ignore()
    println(status)
    free(status)
    blank, ble := read_line_capped(b, 256)
    ble.ignore()
    free(blank)
    be := write_string(w, "ab")
    be.ignore()
    rest, n, re := read_body_to_close(b, 4096)
    re.ignore()
    q: string = format("%q", [arg_str(cstr(rest))])
    println(q)
    println(n)
    free(q)
    free(rest)
    bufreader_free(b)
    free(b)
}

func main() -> int32 {
    lfd, le := net_listen(addr_loopback(0), 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    bound, be := net_local_addr(lfd)
    be.ignore()
    s := http_server_new(lfd)
    (*s).send_date = false
    t, te := spawn(lambda () -> void {
        e := http_serve_one(s, 0, handle)
        if e.exists() {
            println(e)
        }
    })
    if te.exists() {
        printerr(te)
        return 1
    }
    fd, de := net_dial(bound)
    if de.exists() {
        printerr(de)
        return 1
    }
    client(fd)
    je := join(t)
    je.ignore()
    ce := net_close(fd)
    ce.ignore()
    lc := net_close(lfd)
    lc.ignore()
    free(s)
    return 0
}
