// A capturing lambda builds an f-string whose holes read captured locals. The
// closure collection walk must recurse the f-string's kids, or name and ver would
// not be captured into the lambda environment and the hole would read garbage.
@paradigm procedural

func call0(f: () -> string) -> string { return f() }

func main() -> int64 {
    name: string = "dusk"
    ver: int64 = 11
    greet := lambda () -> string {
        return f"hi {name} v{ver}"
    }
    println(call0(greet))
    return 0
}
