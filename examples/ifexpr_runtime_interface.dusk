@paradigm oop
@paradigm procedural

// Both branches box a concrete struct into one interface-valued result.
interface Named {
    name() -> string
}

struct Left {}
struct Right {}

impl Named for Left {
    func name() -> string { return "left" }
}

impl Named for Right {
    func name() -> string { return "right" }
}

func main() -> int32 {
    c: bool = false
    left: Named = Left {}
    right: Named = Right {}
    value: Named = if c { left } else { right }
    println(value.name())
    return 0
}
