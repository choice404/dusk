@paradigm procedural

// A step pointed the wrong way for its bounds runs zero times rather than
// wrapping around: 0..10 by -1 counts down, so the `i > 10` test is false at the
// first look and the body never runs. The loop is not a fault, just empty.
func main() -> int32 {
    for i in 0..10 by -1 {
        println(i)
    }
    println("done")
    return 0
}
