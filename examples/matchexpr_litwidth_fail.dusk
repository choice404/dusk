@paradigm procedural

// The match twin of ifexpr_litwidth_fail, and the older of the two bugs: an inferred
// binding of a match whose first arm pins int8 took a 300 in the second arm, adapted it,
// and printed 44. The arms agree on type by the width 0 literal rule, so the agreement
// cannot see it; the literal is ranged against the type the arms agreed on instead.
enum Pick { A, B }

func main() -> int32 {
    p := Pick.B
    a: int8 = 5
    y := match p {
        A => a,
        B => 300,
    }
    println(y)
    return 0
}
