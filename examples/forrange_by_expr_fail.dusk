@paradigm procedural

// The step must be a literal, since its sign picks the comparison and that choice
// is made at compile time. A variable step would leave the direction unknown, so
// `by n` is refused even though n holds a fine step.
func main() -> int32 {
    n: int64 = 2
    for i in 0..6 by n {
        println(i)
    }
    return 0
}
