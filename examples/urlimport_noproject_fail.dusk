@paradigm procedural

// A quoted git import named a repository at the import itself and resolved against a
// machine wide clone cache with no reference and no lock behind it. A project has
// refused the form since 1.14.0, and since 1.15.1 a file with no package.dawn above it
// is refused the same way: nothing fills that cache any more, so the form named a
// dependency the build could not stand behind. The move is a @require for the
// repository and the import respelled through the alias.
@import "example.com/user/repo/mod"

func main() -> int32 {
    println("unreachable")
    return 0
}
