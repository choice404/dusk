@paradigm procedural

// A payload carrying variant named without its payload. `Opt.Some` alone is a
// constructor, not a value: it typed as the surface unknown, reached codegen, and
// lowered to a zeroed enum that still matched its own arm, so this printed a payload
// nobody ever supplied. The payload free form, `Opt.None`, stays legal.
enum Opt { Some(n: int64), None }

func main() -> int32 {
    match Opt.Some {
        Some(n) => { println(n) }
        None => { println(0) }
    }
    return 0
}
