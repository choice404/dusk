@paradigm procedural

// The for binder carries its element type, int64, so binding it to a narrower
// int32 is caught here instead of silently truncating at runtime. The compile-fail
// twin of the loop that used to print a truncated value.
func main() -> int64 {
    xs: int64[2] = [4294967296, 5000000000]
    for x in xs {
        y: int32 = x
        println(y)
    }
    return 0
}
