// udp_bind takes an IP address; a unix address is refused before any syscall and no
// socket file is created.
@paradigm procedural
@import std.net.udp

func main() -> int32 {
    fd, e := udp_bind(addr_unix("/tmp/dusk_udp_unix_refused.sock"))
    if e.exists() {
        println(e.toString())
    } else {
        println(fd)
    }
    return 0
}
