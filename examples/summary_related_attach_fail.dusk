// Compile-fail: a helper attaches a fresh node to the caller's list, then stores its
// own parameter's view into the node. The node lives on in the list, so a caller
// handing it a view of a frame array is refused
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fresh() -> *Sink {
    return alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

struct Node { rows: int64[] }
impl Node { func set_rows(xs: int64[]) -> void { self.rows = xs } }
struct List { head: *Node }

func add(list: *List, xs: int64[]) -> void {
    node: *Node = alloc(Node { rows: heap_rows() })
    (*list).head = node
    node.set_rows(xs)
}

func fill(list: *List) -> void {
    local: int64[4] = [111, 222, 333, 444]
    add(list, local[0..4])
}

func main() -> int32 {
    list: *List = alloc(List { head: alloc(Node { rows: heap_rows() }) })
    fill(list)
    println((*(*list).head).rows[0])
    return 0
}
