// Compile-fail: a spawned lambda captures a pointer to a struct with a slice
// field. The slice is heap backed now, but either thread could point the field
// at an array on its own stack, so the capture is refused by type.
@paradigm procedural
@paradigm functional

struct Rows { xs: int64[], n: int64 }

func heap3() -> int64[] {
    seed: int64[3] = [1, 2, 3]
    return map(seed[0..3], lambda (x: int64) -> int64 { return x })
}

func main() -> int32 {
    r: *Rows = alloc(Rows { xs: heap3(), n: 3 })
    t, e := spawn(lambda () -> void {
        println((*r).n)
    })
    if e.exists() { return 1 }
    je := join(t)
    je.ignore()
    free(r)
    return 0
}
