@paradigm procedural
@import std.map
@import forpairpriv_mod

// Calls the imported pair loop with one closure in the map, so the loop's own binder is
// the only thing that can answer: 5, not the module private v's 99.
func main() -> int32 {
    m: *Map<string, () -> int64> = alloc(map_new())
    map_put(m, "a", lambda () -> int64 { return 5 })
    println(sum_vals(m))
    return 0
}
