// An f-string is legal as a match arm's tail expression and inside an arm's own let
// block; the arm result types as a string either way, so the match yields a string.
@paradigm procedural

enum Pick {
    Yes,
    No,
}

func main() -> int64 {
    n: int64 = 7
    p: Pick = Pick.Yes
    direct: string = match p {
        Yes => f"yes {n}",
        No => f"no {n}",
    }
    println("{}", direct)
    q: Pick = Pick.No
    blocked: string = match q {
        Yes => {
            t := f"Y:{n}"
            t
        },
        No => {
            u := f"N:{n * 2}"
            u
        },
    }
    println("{}", blocked)
    return 0
}
