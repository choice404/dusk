@paradigm procedural

// The cursor counts in integers, so a float bound has no meaning here: there is no
// rounding rule the loop could pick that would not surprise someone. A float64
// high bound is refused by type.
func main() -> int32 {
    hi: float64 = 3.0
    for i in 0..hi {
        println(i)
    }
    return 0
}
