// Compile-fail: a lambda stores a view of its own array into memory its parameter
// reaches. The parameter is the caller's holder whichever function calls the lambda,
// so the view outlives the lambda's frame
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func make_store() -> (*Holder) -> void {
    return lambda (target: *Holder) -> void {
        local: int64[4] = [111, 222, 333, 444]
        (*target).rows = local[0..4]
    }
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    store := make_store()
    store(h)
    println((*h).rows[0])
    return 0
}
