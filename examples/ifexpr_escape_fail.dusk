@paradigm procedural

// The escape of an if used as a value is the join of its branch tails, so a branch that
// yields a view of this frame's array taints the whole result. Returning it would hand the
// caller a slice over storage the frame reclaims on the way out, and the join is what sees
// it: the other branch is a clean parameter slice, so before the join a value that could be
// either read as clean.
func pick(c: bool, given: int64[]) -> int64[] {
    local: int64[4] = [1, 2, 3, 4]
    return if c { local[0..2] } else { given }
}

func main() -> int32 {
    return 0
}
