@paradigm procedural
@paradigm oop
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe

func main() -> int32 {
    entries: *Map<string, string> = alloc(map_new())
    map_put(entries, "user", substring("hello", 0, 5))
    text := unwrap_or(map_get(entries, "user"), "")
    free(text)
    return 0
}
