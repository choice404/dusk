@paradigm procedural
@import std.vector

// Two loop names are the map-pair form; a vector yields elements, not key/value
// pairs, so binding two names over one rejects with the teach message.
func main() -> int64 {
    vv: *Vector<int64> = alloc(vec_new())
    vec_push(vv, 1)
    for k, v in vv {
        println(k)
    }
    return 0
}
