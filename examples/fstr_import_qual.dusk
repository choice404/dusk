// An import-qualified call resolves the same inside an interpolation hole as outside
// it: fstr_helper.triple(5) is 15 in a plain binding and in f"q:{...}" alike, and an
// f-string built inside the imported function itself works end to end.
@paradigm procedural

@import fstr_helper

func main() -> int64 {
    a: int64 = fstr_helper.triple(4)
    println("{}", a)
    s: string = f"q:{fstr_helper.triple(5)}"
    println("{}", s)
    println("{}", fstr_helper.fmt_in_import(9))
    return 0
}
