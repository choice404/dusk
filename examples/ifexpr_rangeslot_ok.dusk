// An if used as a value whose branches yield range slices, through both spellings of
// the form. The branch result is a slice, pointer and length together, not the single
// element an index without a range would read.
@paradigm procedural

func main() -> int32 {
    c: bool = true
    arr: int64[4] = [10, 20, 30, 40]
    sl: int64[] = c ? arr[0..2] : arr[1..3]
    println(sl.len)
    println(sl[0])
    sl2: int64[] = if c { arr[1..3] } else { arr[0..2] }
    println(sl2[0])
    s: string = "hello"
    t: char[] = c ? s[2..4] : s[0..2]
    println(t.len)
    println(t[0])
    return 0
}
