// The chunk-level escapes: doubled braces {{ and }} cook to single braces, the
// standard escapes (\n, \u) decode inside a chunk, adjacent holes leave empty
// chunks between them, a leading and trailing empty chunk render nothing, and a
// holeless f"abc" is still an f-string value, its chunk cooked through the builder.
@paradigm procedural

func main() -> int64 {
    a: int64 = 1
    b: int64 = 2
    println(f"lit {{ and }} braces")
    println(f"a={a}\nb={b}")
    println(f"{a}{b}")
    println(f"uni \u{41} end")
    holeless: string = f"abc"
    println(holeless)
    empty: string = f""
    println(f"[{empty}]")
    return 0
}
