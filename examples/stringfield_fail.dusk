// A string has no fields, so `s.len` is refused at check and named the builtin that
// answers it. Its bytes are read by index, `s[i]`, and counted by str_len; before
// this rule the field read passed `dusk check` clean and died in codegen as an
// `unsupported field expression` naming no file and no line.
@paradigm procedural

func main() -> int32 {
    s: string = "dusk"
    n: int64 = s.len
    println("{}", n)
    return 0
}
