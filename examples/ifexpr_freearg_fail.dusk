@paradigm procedural

// A free argument is a managed context, so an if used as a value handed to it earns the
// branch verdict. Both branches hand back a pointer the caller still owns, so freeing the
// result would free storage the caller frees again.
func drop(c: bool, a: *int64, b: *int64) -> void {
    free(if c { a } else { b })
}

func main() -> int32 {
    return 0
}
