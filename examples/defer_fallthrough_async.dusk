@paradigm procedural
@import std.async.future
@import std.async.loop
@import std.memory.allocator

async func value() -> int64 { return 7 }

async func work(using allocator: Debug) -> void {
    pointer: *int64 = alloc(1)
    defer free(pointer)
    defer println("async done {}", *pointer)
    defer println("async cleanup")
    println("async body")
    result := await value()
    *pointer = result
    println("async resumed")
}

async func release(using allocator: Debug) -> void {
    pointer: *int64 = alloc(2)
    defer free(pointer)
    result := await value()
    println("async free {}", result)
}

func main() -> int32 {
    loop_error := loop_init()
    loop_error.ignore()
    mut allocator := debug()
    async_run(work(allocator))
    async_run(release(allocator))
    println("leaks {}", debug_leaks())
    loop_free()
    return 0
}
