@paradigm procedural

// One C source calls a helper another defines, beside an unrelated dusk helper, and
// each call reaches its own side's function.
@csource "link_csource_sibling_a.c"
@csource "link_csource_sibling_b.c"

foreign "C" {
    func c_entry() -> int64
}

func helper() -> int64 {
    return 70
}

func main() -> int32 {
    println(c_entry())
    println(helper())
    return 0
}
