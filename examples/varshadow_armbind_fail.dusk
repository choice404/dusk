@paradigm procedural

// The match arm side of the same shared name. The arm binder s takes its type from
// the variant payload the pattern names, and reading that payload by bare variant
// name answers with Tally's scalar, which drops the frame view the binder really
// holds and lets the dead slice out through the return. The binder's type comes off
// the scrutinee enum's own variant slot instead. The declaration order twin is
// varshadow_armbindrev_fail.
enum Rows { Some(s: int64[]), None }
enum Tally { Some(n: int64), None }

func mk(fb: int64[]) -> int64[] {
    local: int64[4] = [1, 2, 3, 4]
    r: Rows = Rows.Some(local[0..4])
    match r {
        Some(s) => { return s }
        None => {}
    }
    return fb
}

func main() -> int32 {
    d: int64[3] = [7, 8, 9]
    v := mk(d[0..3])
    println(v[0])
    return 0
}
