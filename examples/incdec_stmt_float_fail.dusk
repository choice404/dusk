@paradigm procedural

// The statement spelling folds back into a compound assignment, since the value it
// yields is discarded, but it is still the operator that was written: the fold records
// which form it came from, so the place is judged by the operator's own rule and earns
// the operator's message, the same one `y := f++` earns.
func main() -> int32 {
    mut f: float64 = 1.5
    f++
    println(f)
    return 0
}
