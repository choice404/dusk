// 1.10.1 X3 twin: a value-ized block-tail match still enters the outer arm-type agreement.
// The A arm runs a statement then yields a nested match of strings, the B arm yields an
// integer, a disagreement the ground pass catches on the desugared tail.
@paradigm procedural

enum E {
    A(v: int64),
    B,
}

func main() -> int64 {
    e: E = E.A(5)
    x: int64 = match e {
        A(v) => {
            println(v)
            match e {
                A(w) => "yes",
                B => "no",
            }
        },
        B => 5,
    }
    println(x)
    return 0
}
