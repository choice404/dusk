// A by value buffer whose raw storage the frame allocated takes a view of a frame
// array through a method. Prints 222
@paradigm procedural
@paradigm oop

struct RBuf { data: *raw int64[], n: int64 }
impl RBuf {
    func put(xs: int64[]) -> void {
        self.data[self.n] = xs
        self.n = self.n + 1
    }
}

func main() -> int32 {
    local: int64[4] = [111, 222, 333, 444]
    mut b: RBuf = RBuf { data: alloc_bytes(64), n: 0 }
    b.put(local[0..4])
    println(b.data[0][1])
    return 0
}
