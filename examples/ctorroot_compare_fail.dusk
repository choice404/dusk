// Enums do not compare, so two constructor calls do not compare either. The typed
// constructor puts both operands in front of the comparison rule, which used to see
// two wildcards and accept an aggregate compare that had no meaning.
@paradigm procedural

enum Opt {
    Some(v: int64),
    None,
}

func main() -> int32 {
    if Opt.Some(1) == Opt.Some(1) {
        println(1)
    }
    return 0
}
