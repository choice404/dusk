// Compile-fail: a helper points its sink at the caller's holder through a ref alias,
// then stores its view through a call that hands the sink back. The store reaches
// the caller's holder, so a caller handing a view of a frame array is refused
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fresh() -> *Sink {
    return alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }
func id(s: *Sink) -> *Sink { return s }

func keepvia(h: *Holder, xs: int64[]) -> void {
    s: *Sink = fresh()
    ref t := s
    relink(t, h)
    (*(*id(s)).h).rows = xs
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    keepvia(h, local[0..4])
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
