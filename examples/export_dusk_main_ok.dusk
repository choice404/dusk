@paradigm procedural

// main's body is the internal main.d, so dusk__main, the name it took through
// 1.17.3, is free for an exported C function like any other name.
export "C" func dusk__main(x: int64) -> int64 {
    return x + 1
}

func main() -> int32 {
    println(dusk__main(41))
    return 0
}
