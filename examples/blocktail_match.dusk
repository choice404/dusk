// 1.10.1 X3: a match arm body that ends in a bare match value-izes into the enclosing match
// expression. Here the A arm runs a statement, binds y, then yields a nested match; the 1.9.0
// reject that once forced the inner match to be bound to a name is gone.
@paradigm procedural

enum E {
    A(v: int64),
    B,
}

func main() -> int64 {
    e: E = E.A(5)
    x: int64 = match e {
        A(v) => {
            y: int64 = v + 1
            match e {
                A(w) => y + w,
                B => 20,
            }
        },
        B => 30,
    }
    println(x)
    return 0
}
