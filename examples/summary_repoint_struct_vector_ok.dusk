@paradigm procedural
@paradigm oop
@paradigm functional
@import std.vector
// A local struct holding an owned vector of slices takes a frame slice through a
// helper that receives the struct by pointer; nothing repoints the vector, so the
// store stays inside the frame and the call is accepted.
struct Rows { items: *Vector<int64[]> }
impl Rows {
    func count() -> int64 { return vec_len(self.items) }
}
func rows_add(r: *Rows, xs: int64[]) -> void { vec_push((*r).items, xs) }
func main() -> int32 {
    local: int64[4] = [1, 2, 3, 4]
    items: *Vector<int64[]> = alloc(vec_new())
    r: *Rows = alloc(Rows { items: items })
    rows_add(r, local[0..4])
    println((*r).count())
    println(vec_get((*r).items, 0)[3])
    return 0
}
