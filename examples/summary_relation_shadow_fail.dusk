// Compile-fail: an inner scope shadows the sink's name with an unrelated pointer while
// a ref alias of the outer sink, which now holds the caller's holder, receives the
// frame view. The outer sink's relink to the caller's holder reaches every
// declaration of the name, the inner one included, so the store through the alias
// is refused
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}
struct Other { h: int64 }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    (*s).h = h
    ref p := s
    if local[0] > 0 {
        s: *Other = alloc(Other { h: 5 })
        p.keep(local[0..4])
        println((*s).h)
        free(s)
    }
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
