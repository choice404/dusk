@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Item { qty: int64, name: string, parts: string[] }
impl Item {
    func total() -> int64 { return self.qty + str_len(self.name) }
}
func main() -> int32 {
    items: *Vector<Item> = alloc(vec_new())
    vec_push(items, Item { qty: 4, name: "ab", parts: [] })
    vec_push(items, Item { qty: 4, name: "ab", parts: [] })
    n: int64 = vec_len(items)
    x := n == 2 ? vec_get(items, 0) : vec_get(items, 1)
    println(x.total())
    return 0
}
