// A `ref` destructuring binding borrows what it binds all the way down: a binder
// that holds a nested tuple hands the borrow to the names a second destructure
// takes out of it, so neither name may free what the source still owns.
@paradigm procedural

struct Box { n: int64 }

func main() -> int64 {
    owner: *Box = alloc(Box { n: 4 })
    ref inner, tag := ((owner, 1), 2)
    view, count := inner
    println((*view).n + count + tag)
    free(view)
    free(owner)
    return 0
}
