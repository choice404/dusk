@paradigm procedural

// A C source that calls the runtime's cool_gen_alloc reaches the runtime, beside a
// dusk function of the same name.
@csource "link_csource_runtime.c"

foreign "C" {
    func c_alloc() -> int64
}

func cool_gen_alloc(n: int64) -> int64 {
    return n + 1
}

func main() -> int32 {
    println(c_alloc())
    println(cool_gen_alloc(1))
    return 0
}
