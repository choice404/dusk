// Compile-fail: a helper puts its slice into a holder it allocates with a struct
// literal and returns the slice read back out of the holder. The result is the
// argument, so returning it over a view of a frame array is refused
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func pass(xs: int64[]) -> int64[] {
    c: *Holder = alloc(Holder { rows: xs })
    return (*c).rows
}

func outer() -> int64[] {
    local: int64[4] = [111, 222, 333, 444]
    return pass(local[0..4])
}

func main() -> int32 {
    r: int64[] = outer()
    println(r[0])
    return 0
}
