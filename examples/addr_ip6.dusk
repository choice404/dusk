// An IPv6 address from its two big endian halves formats in brackets with the
// canonical inet_ntop compression: ::1 from hi 0 and lo 1, and 2001:db8::1 from
// hi 0x20010db800000000 and lo 1.
@paradigm procedural
@import std.net.addr

func main() -> int64 {
    a := addr_ip6(0u64, 1u64, 443)
    s := addr_string(a)
    println(s)
    free(s)
    b := addr_ip6(2306139568115548160u64, 1u64, 0)
    t := addr_string(b)
    println(t)
    free(t)
    return 0
}
