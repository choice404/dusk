// writef renders and hands the whole rendering to a Writer as one write, here a Writer
// over a StringBuilder the program owns, and errorf wraps a rendering in an error whose
// message the error carries for as long as it is alive.
@paradigm procedural

@import std.fmt
@import std.io
@import std.string

func main() -> int64 {
    b: *StringBuilder = alloc(sb_new())
    e := writef(sb_writer(b), "%s=%d %s=%.2f\n", [
        arg_str("count"),
        arg_int(7),
        arg_str("rate"),
        arg_float(0.125)
    ])
    e.ignore()
    print(sb_cstr(b))
    sb_free(b)
    free(b)
    bad: error = errorf("bad %s at %d", [arg_str("token"), arg_int(12)])
    println(bad.toString())
    bad.ignore()
    return 0
}
