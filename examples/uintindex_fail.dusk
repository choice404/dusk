// An index and a range end are int64 offsets. An unsigned one is refused on the
// surface, where the cast is a one word fix, rather than left for the widening
// to pick an extension by a signedness the index position never states.
@paradigm procedural

func main() -> int32 {
    xs: int64[4] = [1, 2, 3, 4]
    at: uint32 = 1
    println(xs[at])
    from: uint64 = 0
    view: int64[] = xs[from..2]
    println(view[0])
    return 0
}
