// An enum has no print form, and a constructor call is an enum value, so printing one
// earns the same refusal an enum binding already earns. The wildcard used to let the
// constructor through print's own type check.
@paradigm procedural

enum Opt {
    Some(v: int64),
    None,
}

func main() -> int32 {
    println(Opt.Some(7))
    return 0
}
