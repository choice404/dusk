// An async func can take a `using` allocator. The parameter lands in the heap task frame
// like any other, and bare alloc inside the body resolves the ambient allocator by name
// through the frame, so the arena backs the allocation rather than the default heap. The
// arena reports the bytes it handed out.
@paradigm procedural

@import std.memory.arena
@import std.async.future
@import std.async.loop

async func fill(using a: Arena) -> int64 {
    p: *int64 = alloc(8)
    *p = 1
    return a.used
}

func main() -> int32 {
    ar: *Arena = alloc(arena_new(64))
    le := loop_init()
    le.ignore()
    r := async_run(fill(*ar))
    loop_free()
    println(r)
    arena_destroy(ar)
    free(ar)
    return 0
}
