// A helper imported by fstr_import_qual: an ordinary function called qualified from
// inside and outside an interpolation hole, and a function that itself returns an
// f-string, so an f-string in an imported body folds and lowers like any other.
@paradigm procedural

export func triple(x: int64) -> int64 {
    return x * 3
}

export func fmt_in_import(x: int64) -> string {
    return f"imp:{x + 1}"
}
