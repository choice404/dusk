// A walk over a long string checks every index against the string's length, and
// the runtime remembers how far it has measured, so the whole walk costs one pass
// over the bytes rather than a fresh measurement at every step. Four MiB walked
// three ways finishes in well under a second; a scan per index would take hours.
@paradigm procedural

@import std.string

func main() -> int32 {
    s: string = repeat("abcdefgh", 524288)
    mut n: int64 = 0
    while s[n] != 0 {
        n++
    }
    println(n)
    println(str_len(s))
    mut sum: int64 = 0
    mut i: int64 = n - 1
    while i >= 0 {
        sum += int64(s[i])
        i--
    }
    println(sum)
    free(s)
    return 0
}
