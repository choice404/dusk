// A call that hands back the string it was given returns the same borrow, so the
// result of passing a borrowed parameter through it is still the caller's text.
@paradigm procedural
@import std.string

func pass(s: string) -> string {
    return s
}

func show(param: string) -> void {
    y := pass(param)
    println(y)
    free(y)
}

func main() -> int32 {
    msg: string = substring("hello", 0, 5)
    show(msg)
    free(msg)
    return 0
}
