@paradigm procedural

@import std.string
@import std.vector

// A lambda run by vec_map allocates on its own line, under the line that called
// vec_map, and the vector vec_map returns is the caller's line too.
func main() -> int32 {
    nums: *Vector<int64> = alloc(vec_new())
    vec_push(nums, 1)
    vec_push(nums, 2)
    texts := vec_map(nums, lambda (x: int64) -> string {
        return "n" + int_to_string(x)
    })
    vec_free(nums)
    free(nums)
    println(vec_len(texts))
    return 0
}
