// Compile-fail: a generic function's result built over its own type parameter,
// `*Vector<Quiet>` from `vecq<Quiet>`, names that parameter in the callee's terms, so
// in the caller it is unknown rather than the declared `struct Quiet`. A method called
// on an element read back out of it is a call the summary cannot see into, the helper
// may keep its slice argument, and a caller handing it a frame slice is refused
@paradigm procedural
@paradigm oop
@paradigm functional
@import std.vector

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

struct Quiet { n: int64 }
impl Quiet {
    func keep(xs: int64[]) -> void { }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func vecq<Quiet>(q: Quiet) -> *Vector<Quiet> {
    v: *Vector<Quiet> = alloc(vec_new())
    vec_push(v, q)
    return v
}

func put(s: *Sink, xs: int64[]) -> void { vec_get(vecq(s), 0).keep(xs) }

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: h })
    put(s, local[0..4])
}

func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println(noise(1, 2))
    println((*h).rows[0])
    return 0
}
