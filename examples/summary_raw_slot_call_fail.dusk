// Compile-fail: a call handed a raw pointer's slot writes through what the slot holds.
// `keepvia` puts a fresh holder into a raw slot, hands the slot to `keepp`, which
// stores the slice argument into the holder, and points `q` at the same holder, so a
// caller handing it its own sink and a frame slice is refused at the call
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func keepp(h: *Holder, xs: int64[]) -> void { (*h).rows = xs }

func keepvia<S>(q: S, xs: int64[]) -> void {
    inner: *Holder = alloc(Holder { rows: heap_rows() })
    slots: *raw *Holder = alloc_bytes(64)
    slots[0] = inner
    keepp(slots[0], xs)
    q.point(inner)
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    q: *Sink = alloc(Sink { h: h })
    keepvia(q, local[0..4])
    (*h).rows = (*(*q).h).rows
}

func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println(noise(1, 2))
    println((*h).rows[0])
    return 0
}
