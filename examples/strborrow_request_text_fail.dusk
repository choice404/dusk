// request_text is a view of the request's body, which request_free releases, so
// freeing the view is a second free of the same block.
@paradigm procedural
@import std.net.http

func main() -> int32 {
    r := request_new("GET", "/")
    request_set_body(r, "ping")
    body := request_text(r)
    println(body)
    free(body)
    request_free(r)
    free(r)
    return 0
}
