@paradigm procedural

// The legal shapes of an if used as a value: a plain two branch form, an else if chain, a
// branch whose own tail is a complete if, a branch that diverges instead of yielding, a
// ternary, and an if in return position. Every branch either leaves a value of the same
// type in the result slot or never reaches the end of itself.
func rank(n: int64) -> int64 {
    return if n > 10 { 2 } else if n > 5 { 1 } else { 0 }
}

func main() -> int32 {
    c: bool = true
    x: int64 = if c { 1 } else { 2 }
    y: int64 = if c { if x > 0 { 10 } else { 20 } } else { 30 }
    z: int64 = c ? 5 : 6
    w: int64 = if c { 7 } else { return 1 }
    // A literal branch that fits the width the branches agreed on still adapts to it.
    narrow: int8 = 5
    n8 := if c { narrow } else { 7 }
    println(x)
    println(y)
    println(z)
    println(w)
    println(rank(12))
    println(n8)
    return 0
}
