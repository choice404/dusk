// A fold(...) result is its callback's result type, so a string accumulator indexes
// as a string.
@paradigm procedural
@paradigm functional

func main() -> int32 {
    xs: string[3] = ["abc", "def", "ghi"]
    f := fold(xs[0..3], "", lambda (acc: string, s: string) -> string { return s })
    println(int64(f[2]))
    return 0
}
