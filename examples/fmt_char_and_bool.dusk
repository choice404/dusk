// A char is one byte, so %v and %c write that byte, %d writes its code, and %q wraps it
// in single quotes. A scalar that needs more than one byte arrives as an int64 under %c,
// which encodes it as UTF-8 through the same path std.unicode's encoder writes.
@paradigm procedural

@import std.fmt

func main() -> int64 {
    s: string = format("%c %q %d %t %v %c", [
        arg_char(65),
        arg_char(65),
        arg_char(65),
        arg_bool(true),
        arg_bool(false),
        arg_int(955)
    ])
    println(s)
    free(s)
    return 0
}
