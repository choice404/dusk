// io_copy pumps a reader into a writer until end of stream and reports the byte count it
// wrote. Here the source is a string in memory and the sink is a builder.
@paradigm procedural

@import std.io
@import std.string

func main() -> int32 {
    c: *StringReader = alloc(string_reader_new("abcdefghijk"))
    b: *StringBuilder = alloc(sb_new())
    n, e := io_copy(sb_writer(b), string_reader(c))
    e.ignore()
    println(n)
    println(sb_cstr(b))
    sb_free(b)
    free(b)
    free(c)
    return 0
}
