// The compile-fail twin of arrlitlen_ok. A fixed array holds exactly the count its
// type declares and an array literal builds at its own length, so a literal of any
// other count is refused at every position the literal fit walk reaches: a binding
// that is short, a binding that is long, an element inside a nested literal, a
// struct field, an assignment, a call argument, and a return. Before the length
// rule each of these checked clean and handed clang a differently sized aggregate.
@paradigm procedural

struct Grid {
    cells: int64[4],
}

func take(xs: int64[3]) -> int64 {
    return xs[0]
}

func mk() -> int64[4] {
    return [1, 2]
}

func main() -> int32 {
    short: int64[8] = [0]
    long: int64[2] = [1, 2, 3]
    nested: int64[2][2] = [[1, 2], [3]]
    g := Grid { cells: [1, 2, 3] }
    mut m: int64[3] = [1, 2, 3]
    m = [9]
    copied: int64[4] = mk()
    println(short[0] + long[0] + nested[0][0])
    println(g.cells[0] + m[0] + copied[0])
    println(take([11, 12]))
    return 0
}
