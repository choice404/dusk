// A bool prints as true and false, in every sink that can print one: the value form of
// print and println, a {} placeholder, an interpolated string, and the error sink. The
// four go through one rendering, so f"{b}" and println("{}", b) write the same bytes,
// the parity the interpolation pin already holds for every other printable type.
@paradigm procedural

struct P { on: bool }

func main() -> int32 {
    t: bool = true
    f: bool = false
    println(t)
    println(f)
    print(t)
    print(" ")
    println(f)
    println("{} and {}", t, f)
    println(f"{t} and {f}")
    println(1 < 2)
    println(1 > 2)
    p: P = P { on: true }
    println(p.on)
    xs: bool[2] = [true, false]
    println(xs[0])
    println(xs[1])
    printerr(t)
    printerr(f)
    return 0
}
