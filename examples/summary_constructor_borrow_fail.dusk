@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe

func main() -> int32 {
    v: *Vector<string> = alloc(vec_new())
    vec_push(v, substring("hello", 0, 5))
    x: string = unwrap_or(Maybe.Some(vec_get(v, 0)), "")
    free(x)
    return 0
}
