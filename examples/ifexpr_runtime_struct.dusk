@paradigm procedural

// An if expression can yield a struct that is then passed by value.
struct Item { n: int64 }

func read(item: Item) -> int64 {
    return item.n
}

func main() -> int32 {
    c: bool = false
    chosen: Item = if c { Item { n: 4 } } else { Item { n: 9 } }
    println(chosen.n)
    println(read(if c { Item { n: 7 } } else { Item { n: 12 } }))
    return 0
}
