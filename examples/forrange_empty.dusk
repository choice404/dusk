@paradigm procedural

// Two ranges that yield nothing: an empty one where the bounds meet, and a
// backward one where the low bound is already past the high. Neither body runs
// with the default step of 1, and control reaches the line after both loops.
func main() -> int32 {
    for i in 3..3 {
        println(i)
    }
    for i in 5..2 {
        println(i)
    }
    println("done")
    return 0
}
