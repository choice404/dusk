// An index past the end of a string element of a map(...) result faults by name and
// line.
@paradigm procedural
@paradigm functional

@import std.string

func main() -> int32 {
    xs: string[2] = [substring("abcdef", 0, 3), substring("ghijkl", 0, 3)]
    zs := map(xs[0..2], lambda (s: string) -> string { return s })
    println(int64(zs[1][0]))
    far: int64 = 200
    println(int64(zs[1][far]))
    free(xs[0])
    free(xs[1])
    return 0
}
