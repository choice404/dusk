@paradigm procedural
@paradigm oop

interface Named { name() -> string }
struct Record { name: () -> *raw char, text: string }
impl Named for Record {
    func name() -> string { return self.text }
}
func rawBytes() -> *raw char { return alloc_bytes(4) }

func main() -> int32 {
    first: Named = Record { name: rawBytes, text: "abc" }
    second: Record = Record { name: rawBytes, text: "abc" }
    isFirst: bool = true
    text := (isFirst ? first : second).name()
    offset: int64 = 200
    println(int64(text[offset]))
    return 0
}
