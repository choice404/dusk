// A header list keeps every field in order, a repeated Set-Cookie included, and every
// lookup and removal compares names with ASCII case folded: the first Set-Cookie answers
// a get, and a remove of SET-COOKIE takes both and leaves Content-Type.
@paradigm procedural
@import std.net.http

func main() -> int32 {
    h := headers_new()
    headers_add(h, "Content-Type", "text/plain")
    headers_add(h, "Set-Cookie", "a=1")
    headers_add(h, "Set-Cookie", "b=2")
    ctype, ok1 := headers_get(h, "content-type")
    if ok1 {
        println(ctype)
    }
    cookie, ok2 := headers_get(h, "set-cookie")
    if ok2 {
        println(cookie)
    }
    println(vec_len(h))
    println(headers_remove(h, "SET-COOKIE"))
    println(vec_len(h))
    println(headers_has(h, "X"))
    headers_free(h)
    free(h)
    return 0
}
