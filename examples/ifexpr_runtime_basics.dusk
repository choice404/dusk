@paradigm procedural

// Plain, chained, and nested if-expression tails each yield their selected value.
func main() -> int32 {
    c: bool = true
    plain: int64 = if c { 10 } else { 20 }
    chain: int64 = if false { 1 } else if c { 2 } else { 3 }
    nested: int64 = if c {
        if false { 4 } else { 5 }
    } else {
        6
    }
    println(plain)
    println(chain)
    println(nested)
    return 0
}
