// Every part of a URL that writes all of them, then the two pieces an HTTP request
// rebuilds from it: the Host value keeps the explicit port, since 8080 is not http's
// default, and the target drops the fragment.
@paradigm procedural
@import std.url

func main() -> int32 {
    u, e := url_parse("http://example.com:8080/a/b?x=1&y=2#frag")
    if e.exists() {
        println(e)
        return 1
    }
    println((*u).scheme)
    println((*u).host)
    println((*u).port)
    println((*u).path)
    println((*u).query)
    println((*u).fragment)
    host := url_host_header(u)
    println(host)
    free(host)
    target := url_target(u)
    println(target)
    free(target)
    url_free(u)
    free(u)
    return 0
}
