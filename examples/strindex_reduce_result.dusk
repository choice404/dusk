// The value a reduce(...) hands back beside its error is the collection's element
// type, so a string element indexes as a string.
@paradigm procedural
@paradigm functional

func main() -> int32 {
    xs: string[3] = ["abc", "def", "ghi"]
    r, err := reduce(xs[0..3], lambda (a: string, b: string) -> string { return b })
    if err.exists() {
        println(0)
        return 1
    }
    println(int64(r[1]))
    return 0
}
