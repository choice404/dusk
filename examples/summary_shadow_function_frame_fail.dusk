@paradigm procedural
@paradigm functional

func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}
func step(xs: int64[]) -> int64[] { return map(xs, lambda (x: int64) -> int64 { return x }) }
func same(xs: int64[]) -> int64[] { return xs }
// The parameter, not the module function of the same name, is the callee
func apply(step: (int64[]) -> int64[], xs: int64[]) -> int64[] {
    return step(xs)
}
func make() -> int64[] {
    local: int64[4] = [111, 222, 333, 444]
    return apply(same, local[0..4])
}
func main() -> int32 {
    xs: int64[] = make()
    println(noise(1, 2))
    println(xs[0])
    return 0
}
