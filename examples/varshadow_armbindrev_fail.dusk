@paradigm procedural

// The declaration order twin of varshadow_armbind_fail, so the arm binder reject
// lands whichever enum declared Some last.
enum Tally { Some(n: int64), None }
enum Rows { Some(s: int64[]), None }

func mk(fb: int64[]) -> int64[] {
    local: int64[4] = [1, 2, 3, 4]
    r: Rows = Rows.Some(local[0..4])
    match r {
        Some(s) => { return s }
        None => {}
    }
    return fb
}

func main() -> int32 {
    d: int64[3] = [7, 8, 9]
    v := mk(d[0..3])
    println(v[0])
    return 0
}
