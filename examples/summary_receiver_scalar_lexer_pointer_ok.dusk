@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Lexer { src: int64[], toks: *Vector<int64>, pos: int64 }
impl Lexer {
    func run() -> void {
        for i in 0..self.src.len { vec_push(self.toks, self.src[i] * 2) }
    }
    func peek() -> int64 { return self.src[self.pos] }
    func note(m: *Map<string, int64>) -> void { map_put(m, "pos", self.pos) }
}
func main() -> int32 {
    local: int64[4] = [1, 2, 3, 4]
    toks: *Vector<int64> = alloc(vec_new())
    p: *Lexer = alloc(Lexer { src: [], toks: toks, pos: 0 })
    (*p).src = local[0..4]
    p.run()
    println(vec_get(toks, 3))
    free(p)
    return 0
}
