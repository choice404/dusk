@paradigm oop

interface Speak { say() -> int64; }
struct A { v: int64 }
impl Speak for A {
    func say() -> int64 { return self.v }
}
enum Which { X, Y }

func main() -> int32 {
    e := Which.X
    i: Speak = match e {
        X => A { v: 1 },
        Y => A { v: 2 },
    }
    println(i.say())
    return 0
}
