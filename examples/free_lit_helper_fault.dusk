@paradigm procedural

// A helper that may return a literal is not judged at check: which string it hands
// back is known only at run time. Freeing the literal it returned is still the run
// time fault, named at the free.
func pick(heap: bool) -> string {
    if heap {
        return "he" + "ap"
    }
    return "lit"
}

func main() -> int32 {
    h := pick(true)
    println(h)
    free(h)
    l := pick(false)
    println(l)
    free(l)
    println("unreachable")
    return 0
}
