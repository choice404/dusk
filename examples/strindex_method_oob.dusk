// An index past the end of a string a method returns faults by name and line, the
// same as an index past the end of any other string.
@paradigm procedural
@paradigm oop

@import std.string

struct R { name: string }

impl R {
    func nm() -> string { return self.name }
}

func main() -> int32 {
    r: R = R { name: substring("abcdef", 0, 3) }
    n := r.nm()
    println(int64(n[2]))
    far: int64 = 200
    println(int64(n[far]))
    free(r.name)
    return 0
}
