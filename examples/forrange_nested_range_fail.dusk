@paradigm procedural

// A range is not a value, so it cannot be a bound of another range. The head judges
// each bound by hand rather than inferring the range node, which is what keeps this a
// loop head diagnostic instead of the index rules talking about an index nobody wrote.
func main() -> int32 {
    for i in 0..(1..2) {
        println(i)
    }
    return 0
}
