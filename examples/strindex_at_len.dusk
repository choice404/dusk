// An index at a string's length reads its NUL terminator and stays legal, since a
// walk that stops on the NUL is how a string is read to its end.
@paradigm procedural

@import std.string

func main() -> int32 {
    s: string = substring("hello", 0, 5)
    println(int64(s[str_len(s)]))
    mut n: int64 = 0
    while s[n] != 0 {
        n++
    }
    println(n)
    lit: string = ""
    println(int64(lit[0]))
    free(s)
    return 0
}
