// The scheme is lowercased and the host keeps its case. With no port the scheme's
// default stands in, with no path the path is the empty string and the target is /, and
// the Host value omits the default port.
@paradigm procedural
@import std.url

func main() -> int32 {
    u, e := url_parse("HTTP://Example.com")
    if e.exists() {
        println(e)
        return 1
    }
    println((*u).scheme)
    println((*u).host)
    println((*u).port)
    println((*u).path)
    target := url_target(u)
    println(target)
    free(target)
    host := url_host_header(u)
    println(host)
    free(host)
    url_free(u)
    free(u)
    return 0
}
