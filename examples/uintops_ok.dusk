// The sign-sensitive operator set, each unsigned form printed next to its signed
// twin over the same bits. Divide, remainder, right shift, and the four ordered
// comparisons are the whole list; add, subtract, multiply, the bitwise operators,
// and equality are the same instruction under either signedness, so they answer
// the same and are here to say so. A lowering that dropped the flag would print
// the two lines of a pair as one value.
@paradigm procedural

func main() -> int32 {
    u: uint32 = 4000000000u32
    s: int32 = int32(u)

    println(u / 2u32)
    println(s / 2i32)
    println(u % 7u32)
    println(s % 7i32)

    top: uint32 = 2147483648u32
    stop: int32 = int32(top)
    println(top >> 1u32)
    println(stop >> 1i32)

    if 0u32 < u { println(1) } else { println(0) }
    if 0i32 < s { println(1) } else { println(0) }
    if u > 5u32 { println(1) } else { println(0) }
    if s > 5i32 { println(1) } else { println(0) }

    println(u + 1u32)
    println(u & 255u32)
    if u == 4000000000u32 { println(1) } else { println(0) }

    println("{} {}", u, top)
    println(f"{u} {top}")
    println(hash(u))
    println(hash(s))

    // An unsuffixed literal on the LEFT of an unsigned operand takes that
    // operand's type, the checker's own result rule. The subtraction wraps at
    // uint32 rather than going negative at 64 bits, and the divide, remainder,
    // and compares against a uint64 past int64's top answer by magnitude.
    println(5 - u)
    m: uint64 = 0u64 - 1u64
    println(5 / m)
    println(5 % m)
    if 5 > m { println(1) } else { println(0) }
    if 5 < m { println(1) } else { println(0) }
    return 0
}
