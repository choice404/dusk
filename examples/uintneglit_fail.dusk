// A bare literal adapts to an unsigned annotation the same way it adapts to a
// width, with the unsigned range: a negative literal has no unsigned value, so
// it is refused rather than wrapped to the top of the range behind the back of
// whoever wrote it.
@paradigm procedural

func main() -> int32 {
    counter: uint32 = -1
    println(counter)
    return 0
}
