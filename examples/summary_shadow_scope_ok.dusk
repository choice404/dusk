@paradigm procedural
@paradigm oop
@paradigm functional
struct Rows { rows: int64[] }
struct Count { rows: int64 }
impl Rows { func get() -> int64[] { return self.rows } }
impl Count {
    func get() -> int64[] {
        seed: int64[1] = [self.rows]
        return map(seed[0..1], lambda (value: int64) -> int64 { return value })
    }
}
func through_method(value: Rows) -> int64[] {
    if true {
        value: Count = Count { rows: 7 }
        println(value.get()[0])
    }
    return value.get()
}
func through_field(value: Rows) -> int64[] {
    if true {
        value := Count { rows: 8 }
        println(value.rows)
    }
    return value.rows
}
func main() -> int32 {
    seed: int64[2] = [111, 222]
    values := map(seed[0..2], lambda (value: int64) -> int64 { return value })
    rows: Rows = Rows { rows: values }
    println(through_method(rows)[0])
    println(through_field(rows)[0])
    return 0
}
