@paradigm procedural
@import std.vector

// The continue-terminates pin. The index advances before the body, so a continue,
// which jumps to the while condition, has already moved past the current element:
// the loop skips the evens and breaks at 8 instead of spinning forever on the first
// continue. Wrong increment placement infinite-loops here.
func main() -> int64 {
    v: *Vector<int64> = alloc(vec_new())
    mut i: int64 = 0
    while i < 10 {
        vec_push(v, i)
        i = i + 1
    }
    for x in v {
        if x == 8 {
            break
        }
        if x % 2 == 0 {
            continue
        }
        println(x)
    }
    vec_free(v)
    free(v)
    return 0
}
