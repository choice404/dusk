@paradigm procedural
@import std.vector

// The basic container for: `for x in v` over a *Vector<int64> lowers to the index
// loop a user would write against vec_len and vec_get, so codegen never learns the
// vector layout. The binder x is each element in order.
func main() -> int64 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 1)
    vec_push(v, 2)
    vec_push(v, 3)
    for x in v {
        println(x)
    }
    vec_free(v)
    free(v)
    return 0
}
