@paradigm procedural

@import std.vector
@import name_private_import_mod

// The imported file's private abort sits beside std.vector's foreign abort and
// both work: one is the file's own helper, the other the C library's.
func main() -> int32 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, private_abort_value())
    println(vec_get(v, 0))
    vec_free(v)
    free(v)
    return 0
}
