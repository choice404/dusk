// W5: free validated at ground. A generic value of type T carries no proof of being a
// heap pointer at the surface, so free(y) on a value of unknown type checks clean there;
// once mono grounds T to int64 the ground type pass sees free applied to a scalar, which
// would emit a cool_gen_free on an i64 and die in clang. The ground pass refuses it by
// type. The freed value is a local, not a parameter: a parameter is a borrow and freeing
// one rejects at the surface, a distinct earlier rule the borrow-side family added.
@paradigm procedural

func ident<T>(x: T) -> T {
    return x
}

func main() -> int32 {
    y := ident(5)
    free(y)
    return 0
}
