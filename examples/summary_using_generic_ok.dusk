// A generic helper takes a `using` allocator ahead of its type parameter, and the
// allocator is written at the call like any other argument, so the helper's result is
// the tally built over the caller's holder. Its add reads the frame slice and keeps
// only the sum, so a slice of a local array reaches it and the program runs
@paradigm procedural
@paradigm oop
interface Allocator {
    alloc(size: int64, align: int64) -> *void
    free(p: *void) -> void
}
struct Bump { base: *raw int8, used: int64 }
impl Allocator for Bump {
    func alloc(size: int64, align: int64) -> *void {
        off := self.used
        p := ptr_add(self.base, off)
        self.used = off + size
        return p
    }
    func free(p: *void) -> void { }
}
struct Holder { total: int64 }
struct Tally { h: *Holder }
impl Tally {
    func add(xs: int64[]) -> void { (*self.h).total = xs[0] + xs[3] }
}
func pass<T>(using a: Bump, x: T) -> T { return x }
func keep(h: *Holder, xs: int64[]) -> void {
    buf: *raw int8 = alloc_bytes(64)
    mut b := Bump { base: buf, used: 0 }
    pass(b, Tally { h: h }).add(xs)
}
func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    keep(h, local[0..4])
}
func main() -> int32 {
    h: *Holder = alloc(Holder { total: 0 })
    fill(h)
    println((*h).total)
    return 0
}
