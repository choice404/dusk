// Compile-fail: a range's bounds are expressions like any other, so a call written
// in one runs. Here the lower bound of a for range relinks the sink to the caller's
// holder before the loop starts, and the method then stores a view of a frame array
// through it, which outlives the frame
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func relink_at(s: *Sink, h: *Holder) -> int64 {
    (*s).h = h
    return 0
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    if local[0] > 0 {
        for i in relink_at(s, h)..1 { println(i) }
    }
    s.keep(local[0..4])
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
