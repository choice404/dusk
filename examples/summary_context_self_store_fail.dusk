// Compile-fail: a context struct holds the caller's slice and an output holder, and the
// step helper copies the slice into the holder. The function returns the holder, so a
// caller handing it a view of a frame array is refused
@paradigm procedural
@paradigm functional

struct Holder { rows: int64[] }
struct Lexer { src: int64[], pos: int64, out: *Holder }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func step(lx: *Lexer) -> void {
    (*(*lx).out).rows = (*lx).src
}

func tokenize(xs: int64[]) -> *Holder {
    o: *Holder = alloc(Holder { rows: heap_rows() })
    p: *Lexer = alloc(Lexer { src: xs, pos: 0, out: o })
    step(p)
    free(p)
    return o
}

func run() -> *Holder {
    buf: int64[4] = [10, 20, 30, 40]
    return tokenize(buf[0..4])
}

func main() -> int32 {
    v: *Holder = run()
    println((*v).rows[2])
    return 0
}
