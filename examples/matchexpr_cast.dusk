// A match arm whose tail is a cast in an arithmetic expression sizes its result from the
// cast and the operand types, so float64(n) / 2.0 gives a float result.
@paradigm procedural
enum E { A, B }
func main() -> int32 {
    e: E = E.A
    n: int64 = 5
    m: int64 = 7
    x := match e { A => float64(n) / 2.0, B => float64(m) / 2.0 }
    println("{}", x)
    return 0
}
