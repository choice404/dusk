@paradigm procedural

// A spawned thread starts with an empty site stack, so a block it allocates names
// the lambda's line alone.
func main() -> int32 {
    t, e := spawn(lambda () -> void {
        s := "thread" + "!"
        println(s)
    })
    e.ignore()
    j := join(t)
    j.ignore()
    return 0
}
