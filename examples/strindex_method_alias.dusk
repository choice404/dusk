// A method's string result passes its type on through an alias and an argument.
@paradigm procedural
@paradigm oop

struct R { name: string }

impl R {
    func nm() -> string { return self.name }
}

func second(s: string) -> int64 { return int64(s[1]) }

func main() -> int32 {
    r: R = R { name: "abc" }
    println(second(r.nm()))
    n := r.nm()
    m := n
    println(int64(m[1]))
    return 0
}
