@paradigm procedural

// Ternaries work in indexes, arguments, returns, and struct literal fields.
struct Box { n: int64 }

func echo(n: int64) -> int64 {
    return n
}

func choose(c: bool) -> int64 {
    return c ? 40 : 50
}

func main() -> int32 {
    c: bool = false
    xs: int64[2] = [7, 8]
    b := Box { n: c ? 11 : 12 }
    println(xs[c ? 0 : 1])
    println(echo(c ? 20 : 30))
    println(choose(c))
    println(b.n)
    return 0
}
