// The compile fail twin: a fold that leaves int64 has no value to name, so every
// target narrower than uint64 refuses it, and the reject names the overflow rather
// than the wrapped pattern the fold is holding. The last binding is the guard on the
// waiver: a fold that never overflowed and simply names a negative is refused at
// uint64 exactly as it was, since an unsigned type holds no negative value.
@paradigm procedural

func main() -> int64 {
    x: uint8 = 9223372036854775807 + 1
    y: int32 = 9223372036854775807 + 1
    w: uint32 = 9223372036854775807 * 4
    n: uint64 = 0 - 9223372036854775807 - 1
    println(uint64(x))
    println(int64(y))
    println(uint64(w))
    println(n)
    return 0
}
