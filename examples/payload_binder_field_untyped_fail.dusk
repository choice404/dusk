// Compile-fail: the same read through a binder whose scrutinee names no type, a
// field of a generic struct literal bound with no annotation, copied into the
// parameter's holder, which outlives the frame
@paradigm procedural
@paradigm oop
@paradigm functional

@import std.functional.maybe

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

struct Cell<T> { item: T }
struct Box<T> { m: Maybe<Cell<T>> }

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Holder = alloc(Holder { rows: local[0..4] })
    b := Box { m: Maybe.Some(Cell { item: s }) }
    match b.m {
        Some(y) => { (*h).rows = (*y.item).rows }
        None => { }
    }
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
