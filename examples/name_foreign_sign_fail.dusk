@paradigm procedural

@import name_foreign_sign_mod

// An int32 and a uint32 lower to the same i32, yet a call through one declaration
// reads a negative result where a call through the other reads a large one, so two
// declarations of one C name are compared by the dusk types they spell.
foreign "C" {
    func abs(n: int32) -> int32
}

func main() -> int32 {
    println(abs(-3))
    return 0
}
