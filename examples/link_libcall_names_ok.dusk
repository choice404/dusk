@paradigm procedural

// A dusk function named for a function the backend calls by name keeps its own body,
// and the backend's call still reaches the C library. Copying an array literal into a
// local lowers to memcpy, a float remainder to fmod, and a float power to pow. Each
// dusk function here has its own meaning and its own signature. Internal linkage alone
// would bind the backend's call inside the object to the dusk function of the name;
// the suffix on every dusk symbol is what keeps the two apart.
func memcpy(n: int64) -> int64 {
    return n + 1
}

func memset(n: int64) -> int64 {
    return n + 2
}

func memmove(n: int64) -> int64 {
    return n + 3
}

func fmod(a: float64, b: float64) -> float64 {
    return 42.0
}

// Counts down recursively, so the optimizer keeps it out of line
func pow(a: float64, b: float64) -> float64 {
    if b > 0.5 {
        return pow(a, b - 1.0)
    }
    return 7.0
}

func rem(a: float64, b: float64) -> float64 {
    return a % b
}

func main(argc: int32, argv: string[]) -> int32 {
    buf: char[300] = ""
    println(int64(buf[0]))
    println(int64(buf[299]))
    x: float64 = float64(argc) + 6.5
    println(rem(x, 2.0))
    y: float64 = float64(argc) + 2.0
    println(y ** y)
    println(memcpy(1))
    println(memset(1))
    println(memmove(1))
    println(fmod(x, 2.0))
    println(pow(y, y))
    return 0
}
