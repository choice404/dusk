// A slice read back out of a holder a struct literal filled: heap rows handed back
// to the caller, and a frame view read back and summed inside its own frame, both
// accepted and run
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func pass(xs: int64[]) -> int64[] {
    c: *Holder = alloc(Holder { rows: xs })
    return (*c).rows
}

func sum_local(h: *Holder) -> int64 {
    local: int64[4] = [111, 222, 333, 444]
    c: *Holder = alloc(Holder { rows: local[0..4] })
    r: int64[] = (*c).rows
    (*h).rows = pass(heap_rows())
    return r[0] + r[1]
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    println(sum_local(h))
    println((*h).rows[3])
    return 0
}
