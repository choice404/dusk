@paradigm procedural
@paradigm oop
@import std.string

struct Record { name: string }
impl Record {
    func name_of() -> string { return self.inner_name() }
    func inner_name() -> string { return self.name }
}

func main() -> int32 {
    record: *Record = alloc(Record { name: substring("hello", 0, 5) })
    free((*record).inner_name())
    return 0
}
