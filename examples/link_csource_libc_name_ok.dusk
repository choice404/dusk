@paradigm procedural

// A dusk function's symbol is internal, so a C source's call by the same bare name
// reaches C: here the C library's getuid, beside a dusk getuid that answers -7 to
// every dusk call.
@csource "link_csource_libc_name.c"

foreign "C" {
    func c_calls_getuid() -> int64
}

export func getuid() -> int32 {
    return -7
}

func main() -> int32 {
    println(getuid())
    println(c_calls_getuid() == -7)
    return 0
}
