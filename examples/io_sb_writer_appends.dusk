// A Writer over a StringBuilder appends instead of writing anywhere. The builder is the
// caller's: this writer borrows it and frees nothing.
@paradigm procedural

@import std.io
@import std.string

func main() -> int32 {
    b: *StringBuilder = alloc(sb_new())
    w: Writer = sb_writer(b)
    e1 := write_string(w, "hello")
    e1.ignore()
    e2 := write_char(w, 32)
    e2.ignore()
    e3 := write_line(w, "world")
    e3.ignore()
    println(sb_cstr(b))
    sb_free(b)
    free(b)
    return 0
}
