@paradigm procedural
@import std.vector
@import std.string

// A container for inside a generic function. Mono stamps one copy of the loop and
// its vec_len/vec_get per element type, so counting a Vector<int64> and a
// Vector<string> both work off the same source.
func count_them<T>(v: *Vector<T>) -> int64 {
    mut n: int64 = 0
    for x in v {
        n = n + 1
    }
    return n
}

func main() -> int64 {
    vi: *Vector<int64> = alloc(vec_new())
    vec_push(vi, 10)
    vec_push(vi, 20)
    vs: *Vector<string> = alloc(vec_new())
    vec_push(vs, "a")
    vec_push(vs, "b")
    vec_push(vs, "c")
    println(count_them(vi))
    println(count_them(vs))
    vec_free(vi)
    free(vi)
    vec_free(vs)
    free(vs)
    return 0
}
