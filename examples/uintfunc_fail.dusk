// The four unsigned width names double as the cast builtins, so a top-level
// function cannot take one: the call form would be ambiguous between the cast
// and the user function. The signed widths carry the same rule.
@paradigm procedural

func uint32(v: int64) -> int64 { return v }

func main() -> int32 {
    println(uint32(1))
    return 0
}
