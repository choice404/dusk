// The same generic body is instantiated separately at uint32 and int32, so the
// division and remainder inside it keep the signedness chosen by each call.
@paradigm procedural

func half<T>(v: T, d: T) -> T {
    return v / d
}

func rem<T>(v: T, d: T) -> T {
    return v % d
}

func main() -> int32 {
    u: uint32 = uint32(int32(-2))
    s: int32 = int32(u)
    println(half(u, 2u32))
    println(rem(u, 3u32))
    println(half(s, 2i32))
    println(rem(s, 3i32))
    return 0
}
