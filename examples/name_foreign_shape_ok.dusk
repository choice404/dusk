@paradigm procedural

@import name_foreign_shape_mod

// Two foreign declarations of one C function that returns a struct by value agree
// when they spell the same types, here the same imported struct, and both calls
// reach the one C function.
foreign "C" {
    func div(n: int32, d: int32) -> DivT
}

func main() -> int32 {
    q := div(17, 5)
    println(q.quot)
    println(remainder(17, 5))
    return 0
}
