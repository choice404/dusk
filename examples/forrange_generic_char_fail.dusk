@paradigm procedural

// A char laundered through a generic reaches the loop head as a type the surface pass
// cannot ground, so the head stays permissive and the rewritten bound binding judges it
// once mono makes it concrete. The type rules let a char stand in for an integer
// everywhere else, which is exactly why the bound rule is stricter than the annotation
// it rides on: counting from 0 to 'A' is a loop nobody wrote.
func bound<T>(x: T) -> T {
    return x
}

func main() -> int32 {
    for i in 0..bound('A') {
        println(i)
    }
    return 0
}
