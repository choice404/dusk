@paradigm procedural
@import std.vector
@import std.map
@import std.functional.maybe

func identity<T>(value: T) -> T { return value }

func main() -> int32 {
    numbers: *Vector<int64> = alloc(vec_new())
    vec_push(numbers, 40)
    mut number := vec_get(numbers, 0)
    number += 2
    moved := move(number)
    println(moved)
    nested := identity(vec_get(numbers, 0))
    println(move(nested))
    println(move(vec_get(numbers, 0)))
    values: *Map<int64, int64> = alloc(map_new())
    map_put(values, 1, 7)
    value := map_val_at(values, 0)
    println(move(value))
    maybe: Maybe<int64> = Maybe.Some(9)
    unwrapped := unwrap_or(maybe, 0)
    println(move(unwrapped))
    map_free(values)
    free(values)
    vec_free(numbers)
    free(numbers)
    return 0
}
