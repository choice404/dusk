@paradigm procedural

@import std.string
@import std.vector
@import std.map

// Every allocation a standard library function makes is attributed to the line of
// the program that called it, never to a line inside lib/std: a concatenation, an
// f-string, a split, and a map with one entry, each left live on its own line.
func main() -> int32 {
    joined := "ab" + "cd"
    n := 42
    formatted := f"n is {n}"
    parts := str_split("a,b,c", ",")
    m: *Map<string, int64> = alloc(map_new())
    map_put(m, "key", 1)
    println(joined)
    println(formatted)
    println(vec_len(parts))
    println(map_len(m))
    return 0
}
