@paradigm procedural
@paradigm oop
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe

func make() -> Maybe<int64[]> {
    local: int64[4] = [111, 222, 333, 444]
    entries: *Map<string, int64[]> = alloc(map_new())
    map_put(entries, "user", local[0..4])
    return map_get(entries, "user")
}

func main() -> int32 {
    rows: int64[] = unwrap_or(make(), [])
    println(rows[0])
    return 0
}
