// A `ref` destructuring binding hands out a view of what the value already owns.
// Both binders read through the borrow, the scalar member copies as it always
// does, and the original name stays the single owner that frees.
@paradigm procedural

struct Box { n: int64 }

func main() -> int64 {
    owner: *Box = alloc(Box { n: 41 })
    ref view, tag := (owner, 1)
    println((*view).n + tag)
    println((*owner).n)
    free(owner)
    return 0
}
