@paradigm procedural
@paradigm oop

struct R { rows: int64[] }
struct Holder { rows: int64[] }
impl R {
    func me() -> R { return R { rows: self.rows } }
    func stash(h: *Holder) -> void { (*h).rows = self.rows }
}
func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}

// The receiver is a call result, so its type comes from the method chain
func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    r: R = R { rows: local[0..4] }
    r.me().stash(h)
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: [] })
    fill(h)
    println(noise(1, 2))
    println((*h).rows[0])
    free(h)
    return 0
}
