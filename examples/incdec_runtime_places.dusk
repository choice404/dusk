@paradigm procedural

// Field, index, and dereference places yield their old values in postfix expressions.
struct Pair { f: int64 }

func main() -> int32 {
    mut p := Pair { f: 4 }
    mut xs: int64[2] = [8, 9]
    mut i: int64 = 1
    mut heap: *int64 = alloc(12)
    println(p.f++)
    println(xs[i]++)
    println((*heap)++)
    println(p.f)
    println(xs[i])
    println(*heap)
    free(heap)
    return 0
}
