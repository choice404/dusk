// A string that is a null pointer, here a view of what getenv answers for a name
// that is not set, faults by name and line when indexed instead of dying by signal.
@paradigm procedural

@import std.string

foreign "C" {
    func getenv(name: *raw char) -> *raw char
}

func main() -> int32 {
    name: *raw char = cbuf("DUSK_STRINDEX_UNSET_VARIABLE")
    v: string = cstr(getenv(name))
    free(name)
    println(int64(v[0]))
    return 0
}
