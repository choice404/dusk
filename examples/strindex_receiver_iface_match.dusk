@paradigm procedural
@paradigm oop

interface Named { name() -> string }
struct Record { text: string }
struct Outer { inner: Record }
impl Named for Record {
    func name() -> string { return self.text }
}
func makePointer() -> *Record { return alloc(Record { text: "abc" }) }
func makeOuter() -> Outer { return Outer { inner: Record { text: "abc" } } }

enum Pick { First, Second }

func main() -> int32 {
    first: Named = Record { text: "abc" }
    second: Named = Record { text: "xyz" }
    text := (match Pick.First { First => first, Second => second }).name()
    offset: int64 = 1
    println(int64(text[offset]))
    return 0
}
