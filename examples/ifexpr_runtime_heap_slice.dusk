@paradigm procedural
@paradigm functional

// A heap-backed slice survives an if-expression selection and remains indexable.
func heap3() -> int64[] {
    seed: int64[3] = [4, 5, 6]
    return map(seed[0..3], lambda (n: int64) -> int64 { return n })
}

func main() -> int32 {
    c: bool = true
    chosen: int64[] = if c { heap3() } else { heap3() }
    println(chosen[0])
    println(chosen[2])
    return 0
}
