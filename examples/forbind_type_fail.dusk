@paradigm procedural

// The for binder is typed as the array element, int64, so binding it to a string
// is a type mismatch caught at check time rather than a value that dies in clang.
func main() -> int64 {
    xs: int64[3] = [1, 2, 3]
    for x in xs {
        s: string = x
        println(s)
    }
    return 0
}
