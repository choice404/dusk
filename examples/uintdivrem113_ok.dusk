// Division and remainder read the all-ones-high value as unsigned. The signed
// twin over the same bits would divide and remainder as a negative number.
@paradigm procedural

func main() -> int32 {
    x: uint32 = uint32(int32(-2))
    s: int32 = int32(x)
    println(x / 2u32)
    println(x % 3u32)
    println(s / 2i32)
    println(s % 3i32)
    return 0
}
