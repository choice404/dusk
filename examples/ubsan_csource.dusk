@paradigm procedural

// --sanitize=undefined instruments C: the runtime and every @csource. Here the C
// file overflows a signed int, which UndefinedBehaviorSanitizer reports by line.
// Dusk code itself carries no UBSan checks; its own arithmetic is defined.
@csource "ubsan_csource.c"

foreign "C" {
    func c_add_one(x: int32) -> int32
}

func main() -> int32 {
    println(c_add_one(2147483647))
    return 0
}
