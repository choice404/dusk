// An index past the end of a string an interface method returns faults by name and
// line, so a call that dispatches through an interface value is checked too.
@paradigm procedural
@paradigm oop

@import std.string

interface Named { nm() -> string }

struct R { name: string }

impl Named for R {
    func nm() -> string { return self.name }
}

func byte_at(n: Named, i: int64) -> int64 {
    s := n.nm()
    return int64(s[i])
}

func main() -> int32 {
    r: R = R { name: substring("abcdef", 0, 3) }
    println(byte_at(r, 0))
    println(byte_at(r, 200))
    free(r.name)
    return 0
}
