// max_requests caps the requests one connection carries. At 2, the second response of
// three pipelined requests says Connection: close and the stream ends cleanly after it,
// so the third is never read and the handler runs twice. At 0 there is no limit and all
// three are answered; the default is 1000.
@paradigm procedural
@import std.net.http.server
@import std.fmt

// The handler's state, behind the context pointer the server passes on every call
struct Counter {
    n: int64,
}

func handle(req: *Request, calls: *Counter) -> *Response {
    (*calls).n = (*calls).n + 1
    resp := response_new(200)
    response_set_body(resp, (*req).path)
    return resp
}

func serve(limit: int64) -> void {
    text := "GET /1 HTTP/1.1\r\nHost: h\r\n\r\nGET /2 HTTP/1.1\r\nHost: h\r\n\r\nGET /3 HTTP/1.1\r\nHost: h\r\n\r\n"
    s := http_server_new(-1)
    (*s).send_date = false
    (*s).max_requests = limit
    calls: *Counter = alloc(Counter { n: 0 })
    c: *StringReader = alloc(string_reader_new(text))
    out: *StringBuilder = alloc(sb_new())
    count, e := http_serve_stream(s, string_reader(c), sb_writer(out), calls, handle)
    println(count)
    println(e.exists())
    println((*calls).n)
    q: string = format("%q", [arg_str(sb_cstr(out))])
    println(q)
    free(q)
    sb_free(out)
    free(out)
    free(c)
    free(calls)
    free(s)
}

func main() -> int32 {
    d := http_server_new(-1)
    println((*d).max_requests)
    free(d)
    serve(2)
    serve(0)
    return 0
}
