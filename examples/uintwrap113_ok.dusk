// Unsigned arithmetic wraps in its own width, including add, subtract,
// multiply, and exponentiation. Negative source values enter through explicit
// casts so the literal-fit rule stays out of the way.
@paradigm procedural

func main() -> int32 {
    a: uint8 = 255u8 + 1u8
    b: uint8 = uint8(0) - uint8(1)
    c: uint64 = 18446744073709551615u64
    d: uint8 = 20u8 * 13u8
    e: uint64 = 2u64 ** 3u64
    f: uint32 = 65536u32 ** 2u32
    println(a)
    println(b)
    println(c)
    println(d)
    println(e)
    println(f)
    return 0
}
