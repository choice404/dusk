// The error read_line_capped returns must be handled: binding it and never reading it is
// refused at check.
@paradigm procedural
@import std.net.http.wire

func main() -> int32 {
    c: *StringReader = alloc(string_reader_new("a\r\n"))
    b: *BufReader = bufreader_new(string_reader(c), 64)
    line, e := read_line_capped(b, 10)
    println(line)
    free(line)
    bufreader_free(b)
    free(b)
    free(c)
    return 0
}
