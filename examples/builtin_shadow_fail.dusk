// A top-level function cannot take a builtin call name. A user `move` is silently shadowed
// by the builtin the checker and codegen resolve first, so its body is dead code; the
// declaration is refused instead. The same rule covers alloc, free, sizeof, hash, the
// print family, and the functional builtins.
@paradigm procedural

func move(x: int64) -> int64 {
    return x + 1
}

func main() -> int32 {
    r := move(5)
    println("{}", r)
    return 0
}
