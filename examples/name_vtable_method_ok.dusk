@paradigm oop

// The table an interface value of type d dispatches through, and a method m of a
// struct named vtable, take symbols that can never meet.
interface m {
    go() -> int64
}

struct d { x: int64, }

impl m for d {
    func go() -> int64 { return self.x }
}

struct vtable { y: int64, }

impl vtable {
    func m() -> int64 { return self.y }
    func d() -> int64 { return self.y + 1 }
}

func run(v: m) -> int64 { return v.go() }

func main() -> int32 {
    a := d { x: 5 }
    println(run(a))
    t := vtable { y: 7 }
    println(t.m())
    println(t.d())
    return 0
}
