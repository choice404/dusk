@paradigm procedural

// Pointer arithmetic is not a thing in dusk, so a pointer place has no step either. The
// pointer is still freed, so the file's only fault is the one the operator earns.
func main() -> int32 {
    mut p: *int64 = alloc(7)
    y := p++
    println(y)
    free(p)
    return 0
}
