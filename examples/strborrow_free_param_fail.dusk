// A string parameter is the caller's text, so the callee may read it but never free
// it: the caller still holds it and frees it itself.
@paradigm procedural
@import std.string

func shout(s: string) -> void {
    println(s)
    free(s)
}

func main() -> int32 {
    msg: string = substring("hello", 0, 5)
    shout(msg)
    free(msg)
    return 0
}
