@paradigm procedural
@import std.vector

// vec_take inside the body is legal: the taken element is the caller's own. Taking
// from the front while iterating forward shifts the survivors down, so the forward
// index skips the shifted successor. This pins that documented skip: the binder
// visits 10 then 30, never 20, and one element is left.
func main() -> int64 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 10)
    vec_push(v, 20)
    vec_push(v, 30)
    for x in v {
        t: int64 = vec_take(v, 0)
        print("x=")
        println(x)
        print("took=")
        println(t)
    }
    print("left=")
    println(vec_len(v))
    vec_free(v)
    free(v)
    return 0
}
