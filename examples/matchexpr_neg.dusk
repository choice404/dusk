// A match arm yielding a tuple with a negated literal sizes each member from the operand's
// type, so the negated member is int64 rather than a void slot.
@paradigm procedural
enum E { A, B }
func main() -> int32 {
    e: E = E.A
    x := match e { A => (-1, 2), B => (3, 4) }
    a, b := x
    println("{} {}", a, b)
    return 0
}
