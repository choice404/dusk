@paradigm procedural

// Prefix and postfix stepping wrap at each unsigned binding width.
func main() -> int32 {
    mut down8: uint8 = 0u8
    println(--down8)
    mut up8: uint8 = 255u8
    println(up8++)
    println(up8)
    mut up32: uint32 = 4294967295u32
    println(++up32)
    mut down64: uint64 = 0u64
    println(down64--)
    println(down64)
    return 0
}
