@paradigm procedural
@paradigm oop

struct Record { rows: int64[] }
impl Record {
    func rows_of() -> int64[] { return self.rows }
}

func get_rows(record: *Record) -> int64[] { return (*record).rows_of() }

func make() -> int64[] {
    local: int64[4] = [111, 222, 333, 444]
    record: *Record = alloc(Record { rows: local[0..4] })
    return get_rows(record)
}

func main() -> int32 {
    rows: int64[] = make()
    println(rows[0])
    return 0
}
