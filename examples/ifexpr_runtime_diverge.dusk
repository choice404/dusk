@paradigm procedural

// A return or break branch may diverge while its peer supplies the selection value.
func early(c: bool) -> int64 {
    return if c { return 99 } else { 7 }
}

func main() -> int32 {
    println(early(false))
    println(early(true))
    mut i: int64 = 0
    while true {
        value: int64 = if i == 2 { break } else { i + 10 }
        println(value)
        i++
    }
    println(i)
    return 0
}
