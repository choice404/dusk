// The frame-0-only defer rule composes with a lambda's own frame. The lambda
// registers `defer println(n)` with n = 3 in its frame, an if-block shadows n
// with 30 and returns from inside that block, flushing the defer while the shadow
// is live. Before the frame-0-only replay the lambda's own flat locals map still
// held the inner 30, so the defer reprinted 30; the fix resolves the defer in the
// lambda frame: the block prints 30, the defer prints 3, the lambda returns 1.
@paradigm procedural

func run(f: (bool) -> int64) -> int64 { return f(true) }

func main() -> int64 {
    r: int64 = run(lambda (c: bool) -> int64 {
        n: int64 = 3
        defer println(n)
        if c {
            n: int64 = 30
            println(n)
            return 1
        }
        return 7
    })
    println(r)
    return 0
}
