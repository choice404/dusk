@paradigm procedural
@import std.string
@import std.vector

struct Box { n: int64 }
struct Rec { name: string, pointer: *Box }

func main() -> int32 {
    records: *Vector<Rec> = alloc(vec_new())
    vec_push(records, Rec { name: substring("owned", 0, 5), pointer: alloc(Box { n: 7 }) })
    record := move(vec_take(records, 0))
    println(record.name)
    println((*record.pointer).n)
    free(record.name)
    free(record.pointer)
    vec_free(records)
    free(records)
    return 0
}
