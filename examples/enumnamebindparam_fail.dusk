// Reject: the parameter and binder half of the enum name reservation, the twin of
// enumnamebind_fail's value positions. A parameter, a lambda parameter, a match arm
// payload binder, and a match arm catch all binder each take a name, and each one that
// takes an enum's name is refused: through a parameter the same shape passed check with
// a payload of the wrong type, because `Opt.Some` inside the body read as the declared
// enum's constructor no matter what the caller passed. A payload free arm that names a
// variant of the scrutinee's own enum binds nothing and stays legal, which is what
// enumnamebind_ok proves.
@paradigm procedural
@paradigm functional

enum Opt { Some(n: int64), None }
enum Held { Up, Down }
enum Tally { Zero, One }
enum Sel { Left, Right }

func g(Held: int64) -> int64 {
    return Held
}

func main() -> int32 {
    f := lambda (Tally: int64) -> int64 { return Tally }
    o := Opt.Some(1)
    match o {
        Some(Opt) => { println(Opt) }
        None => { println(0) }
    }
    match o {
        Sel => { println(9) }
    }
    println(g(1))
    println(f(2))
    return 0
}
