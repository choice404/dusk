@paradigm procedural
@import std.functional.maybe

struct Rows { rows: int64[] }

func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}
// The arm binder shadows the parameter only inside its arm
func rows_after_match(value: Rows, count: Maybe<int64>) -> int64[] {
    match count {
        Some(value) => { println(value) }
        None => { }
    }
    return value.rows
}
func make() -> int64[] {
    local: int64[4] = [111, 222, 333, 444]
    return rows_after_match(Rows { rows: local[0..4] }, Maybe.Some(5))
}
func main() -> int32 {
    xs: int64[] = make()
    println(noise(1, 2))
    println(xs[0])
    return 0
}
