// Compile-fail: a helper hands back the caller's vector header by value, and the local
// allocated from it shares the caller's buffer, so a set through the local stores the
// frame view where the caller reads it
@paradigm procedural
@import std.vector

func header(pv: *Vector<int64[]>) -> Vector<int64[]> { return *pv }

func fill(pv: *Vector<int64[]>) -> void {
    local: int64[4] = [111, 222, 333, 444]
    v: *Vector<int64[]> = alloc(header(pv))
    vec_set(v, 0, local[0..4])
}

func main() -> int32 {
    pv: *Vector<int64[]> = alloc(vec_new())
    vec_push(pv, [7, 7])
    fill(pv)
    println((*pv).data[0][0])
    return 0
}
