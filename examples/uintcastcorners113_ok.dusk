// Cast corners not already pinned together: explicit negative casts wrap,
// narrowing truncates, widening follows the source signedness, float casts
// saturate or NaN to zero, and a large uint64 survives its float round trip as
// the implementation defines it.
@paradigm procedural

func nan() -> float64 {
    z: float64 = 0.0
    return z / z
}

func main() -> int32 {
    wide_signed: int8 = -1
    maxu: uint64 = 18446744073709551615u64
    println(uint8(300))
    println(uint8(-1))
    println(uint64(wide_signed))
    println(uint8(maxu))
    println(uint8(300.7))
    println(uint8(-5.2))
    println(uint8(nan()))
    f: float64 = float64(maxu)
    println(f)
    println(uint64(f))
    return 0
}
