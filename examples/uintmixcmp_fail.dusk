// A comparison across signedness is the same reject arithmetic gets. The two
// orderings genuinely differ, since the signed compare reads the top bit as a
// sign and the unsigned one reads it as magnitude.
@paradigm procedural

func main() -> int32 {
    unsigned: uint32 = 5
    signed: int32 = 7
    if unsigned == signed {
        println(1)
    }
    return 0
}
