@paradigm procedural
@import std.vector
struct Box { n: int64 }
func mk() -> *Vector<*Box> {
    v: *Vector<*Box> = alloc(vec_new())
    vec_push(v, alloc(Box { n: 7 }))
    return v
}
func main() -> int32 {
    w: *Vector<int64> = alloc(vec_new())
    vec_push(w, 1)
    if vec_len(w) > 0 {
        w := mk()
        q := vec_get(w, 0)
        free(q)
        q2 := vec_get(w, 0)
        println((*q2).n)
    }
    return 0
}
