// url_encode escapes every byte outside the unreserved set as uppercase %XX and keeps ~,
// url_decode undoes it byte for byte, and a % not followed by two hex digits is refused.
@paradigm procedural
@import std.url

func main() -> int32 {
    enc := url_encode("a b/c~d%")
    println(enc)
    dec, e := url_decode(enc)
    if e.exists() {
        println(e)
    } else {
        println(dec)
    }
    free(dec)
    free(enc)
    bad, be := url_decode("%zz")
    if be.exists() {
        println(be)
    } else {
        println(bad)
    }
    free(bad)
    return 0
}
