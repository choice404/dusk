// A Response from http_get is the caller's, released in two steps, response_free for its
// parts and free for the block, and after the second one it is gone. The raw server
// thread is joined first so nothing else runs when the read of the freed Response is
// named by the generational check and aborts.
@paradigm procedural
@import std.net.http.client
@import std.fmt

// Reads one request head off the connection and drops it
func drain_head(b: *BufReader) -> void {
    line, le := read_line_capped(b, 1024)
    le.ignore()
    free(line)
    h: *Vector<Header> = headers_new()
    he := read_headers(b, h, 4096, 32)
    he.ignore()
    headers_free(h)
    free(h)
}

func serve(lfd: int64) -> void {
    cfd, peer, ae := net_accept(lfd)
    if ae.exists() {
        printerr(ae)
        return
    }
    b: *BufReader = bufreader_new(fd_reader(cfd), 1024)
    drain_head(b)
    we := write_string(fd_writer(cfd), "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello")
    we.ignore()
    ce := net_close(cfd)
    ce.ignore()
    bufreader_free(b)
    free(b)
    if addr_port(peer) == 0 {
        printerr("unexpected peer")
    }
}

func main() -> int32 {
    lfd, le := net_listen(addr_loopback(0), 0)
    if le.exists() {
        printerr(le)
        return 1
    }
    bound, be := net_local_addr(lfd)
    be.ignore()
    t, te := spawn(lambda () -> void {
        serve(lfd)
    })
    if te.exists() {
        printerr(te)
        return 1
    }
    url: string = format("http://127.0.0.1:%d/", [arg_int(addr_port(bound))])
    resp, e := http_get(url)
    if e.exists() {
        println(e)
    }
    free(url)
    je := join(t)
    je.ignore()
    lc := net_close(lfd)
    lc.ignore()
    println(response_text(resp))
    response_free(resp)
    free(resp)
    println(response_text(resp))
    return 0
}
