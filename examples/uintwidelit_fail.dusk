// One past the unsigned top has no 64 bit pattern at all, so it stays the lex fault
// a literal past int64's top is for the signed widths. The suffix widens the bound
// the digits are ranged against, it does not remove it.
@paradigm procedural

func main() -> int32 {
    over: uint64 = 18446744073709551616u64
    println(over)
    return 0
}
