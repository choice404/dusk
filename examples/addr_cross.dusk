// An Addr is a plain value: it sits in a Vector beside another family, is
// captured by a spawned thread that formats it, and enters and leaves an async
// func.
@paradigm procedural
@import std.net.addr
@import std.vector
@import std.concurrent.thread
@import std.async.future
@import std.async.loop

async func bump(a: Addr) -> Addr {
    return addr_with_port(a, addr_port(a) + 1)
}

async func amain() -> int32 {
    b := await bump(addr_loopback6(442))
    s := addr_string(b)
    println(s)
    free(s)
    return 0
}

func main() -> int32 {
    v: *Vector<Addr> = alloc(vec_new())
    vec_push(v, addr_ip4(192, 168, 1, 9, 53))
    vec_push(v, addr_unix("/tmp/x.sock"))
    a := vec_get(v, 0)
    t, e := spawn(lambda () -> void {
        s := addr_string(a)
        println(s)
        free(s)
    })
    if e.exists() {
        printerr(e)
        return 1
    }
    je := join(t)
    je.ignore()
    u := addr_string(vec_get(v, 1))
    println(u)
    free(u)
    vec_free(v)
    free(v)
    le := loop_init()
    le.ignore()
    rc := async_run(amain())
    loop_free()
    return rc
}
