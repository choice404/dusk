@paradigm procedural

// The operator steps a place by one, and only an integer has a step every width agrees
// on, so a float place is refused where it is written. The message names the operator and
// the type it was handed. The statement spelling `f++` folds back into `f += 1` in the
// parser, since its value is discarded, but the fold records which operator was written,
// so it earns this same message rather than the arithmetic of the synthesized `+ 1`.
func main() -> int32 {
    mut f: float64 = 1.5
    y := f++
    println(y)
    return 0
}
