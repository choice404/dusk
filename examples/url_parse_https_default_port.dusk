// https defaults to 443, and the Host value leaves a default port off.
@paradigm procedural
@import std.url

func main() -> int32 {
    u, e := url_parse("https://h/")
    if e.exists() {
        println(e)
        return 1
    }
    println((*u).port)
    host := url_host_header(u)
    println(host)
    free(host)
    url_free(u)
    free(u)
    return 0
}
