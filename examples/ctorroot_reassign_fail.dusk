// A mut binding takes the enum of the constructor that initialized it, so assigning
// a different enum's constructor over it is an assignment type mismatch. Both enums
// declare a payload variant, and before the constructor typed as itself the two sides
// were one wildcard: the assignment passed check and clang rejected the store.
@paradigm procedural

enum Opt {
    Some(v: int64),
    None,
}

enum Tag {
    Hi(n: int64),
    Lo,
}

func main() -> int32 {
    mut o := Opt.Some(3)
    o = Tag.Hi(1)
    match o {
        Some(v) => println(v),
        None => println(0),
    }
    return 0
}
