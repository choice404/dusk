// A u suffixed literal above int64's top is stored as a bit pattern, and only
// uint64 holds every pattern: the same digits under a narrower unsigned suffix do
// not fit. The reject spells the value the way it was written rather than as the
// negative its pattern reads as.
@paradigm procedural

func main() -> int32 {
    narrow: uint32 = 18446744073709551615u32
    println(narrow)
    return 0
}
