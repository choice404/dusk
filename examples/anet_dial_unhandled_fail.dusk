// The error net_dial_async hands back must be handled: binding it and never reading it
// is refused at check.
@paradigm procedural
@import std.async.net
@import std.async.loop

async func amain() -> int32 {
    fd, e := await net_dial_async(addr_loopback(1))
    println(fd)
    return 0
}

func main() -> int32 {
    le := loop_init()
    le.ignore()
    rc := async_run(amain())
    loop_free()
    return rc
}
