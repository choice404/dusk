@paradigm procedural
@import std.string
@import std.vector

func identity<T>(value: T) -> T { return value }

func show(text: string) -> void {
    alias := identity(text)
    println(alias)
}

func main() -> int32 {
    text := substring("hello", 0, 5)
    show(text)
    alias := identity(text)
    println(alias)
    free(alias)
    fresh := identity(substring("fresh", 0, 5))
    println(fresh)
    free(fresh)
    names: *Vector<string> = alloc(vec_new())
    vec_push(names, substring("taken", 0, 5))
    borrowed := identity(vec_get(names, 0))
    println(borrowed)
    taken := identity(vec_take(names, 0))
    free(taken)
    vec_free(names)
    free(names)
    return 0
}
