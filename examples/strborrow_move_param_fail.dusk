// A string parameter is borrowed, so moving it out hands over text the caller still
// owns and still frees.
@paradigm procedural
@import std.string
@import std.vector

func keep(v: *Vector<string>, s: string) -> void {
    vec_push(v, move(s))
}

func main() -> int32 {
    v: *Vector<string> = alloc(vec_new())
    msg: string = substring("hello", 0, 5)
    keep(v, msg)
    free(msg)
    return 0
}
