@paradigm procedural

// A bound whose type is a bare type parameter is not known to be int64, and the
// surface pass says so rather than waiting for mono to stamp a copy that happens
// to work. The refusal lands once, on the generic, not once per instantiation.
func sum_to<T>(n: T) -> int64 {
    mut s: int64 = 0
    for i in 0..n {
        s = s + i
    }
    return s
}

func main() -> int32 {
    println(sum_to(3))
    return 0
}
