@paradigm procedural

// Right association makes the final conditional the false fallback of the first.
func pick(a: bool, c: bool) -> int64 {
    return a ? 10 : c ? 20 : 30
}

func main() -> int32 {
    println(pick(true, true))
    println(pick(false, true))
    println(pick(false, false))
    return 0
}
