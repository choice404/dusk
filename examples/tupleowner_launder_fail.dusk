// A tuple literal member that names an owner hands the binder a borrow, since the
// source name still owns the allocation and still frees it. The binder that took the
// member cannot free it, the same refusal the copy of an owner earns at a single
// binding; `move(owner)` in the member position is how the ownership comes along.
@paradigm procedural

struct Box { n: int64 }

func main() -> int64 {
    owner: *Box = alloc(Box { n: 1 })
    a, b := (owner, 7)
    println((*a).n + b)
    free(a)
    free(owner)
    return 0
}
