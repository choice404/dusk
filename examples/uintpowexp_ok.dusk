// An unsigned exponent is a magnitude at every value: a literal with the top
// bit set is legal where the signed twin would be a negative-exponent reject,
// and the power still wraps at the operand width.
@paradigm procedural

func main() -> int64 {
    println(1u64 ** 9223372036854775808u64)
    println(2u64 ** 64u64)
    println(3u64 ** 3u64)
    e: uint64 = 18446744073709551615u64
    println(1u64 ** e)
    return 0
}
