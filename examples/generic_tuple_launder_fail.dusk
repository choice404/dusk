// A borrow laundered through a tuple binding and back out by destructure stays a borrow:
// pair := (x, 1) records member 0's borrow, so y from y, n := pair rejects the free.
@paradigm procedural
func sink<T>(x: T) -> void {
    pair := (x, 1)
    y, n := pair
    if n > 0 { free(y) }
}
func main() -> int32 {
    p: *int64 = alloc(5)
    sink(p)
    v: int64 = *p
    println("{}", v)
    return 0
}
