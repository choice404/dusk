// Compile-fail: an unannotated bind of a generic returning call leaves the element
// type open on the surface pass, but a single binding whose type is still open records
// a borrow when its callee reads the result back out of an argument, so q below is a
// borrow of the container's element and its free is refused at check, `cannot free a
// borrowed pointer; only its owner frees it`. Through 1.17.2 this free passed the
// checker and the stale read of r after it was the runtime's named fault; the lines
// past the free stay to show what the refusal now prevents.
@paradigm procedural
@import std.vector

func main() -> int32 {
    v: *Vector<*int64> = alloc(vec_new())
    vec_push(v, alloc(5))
    q := vec_get(v, 0)             // unannotated: surface leaves the return type open
    println(*q)                    // reads 5, still live
    free(q)                        // refused: q is a borrow of the container's element
    r: *int64 = vec_get(v, 0)      // the container still holds the pointer
    println(*r)                    // would read the freed block had the free passed
    return 0
}
