// The reason phrases RFC 9110 gives the codes a client and a server meet most, the four
// a server's own error responses carry among them.
@paradigm procedural
@import std.net.http

func main() -> int32 {
    codes: int64[11] = [200, 204, 301, 400, 404, 413, 414, 431, 500, 501, 505]
    for i in 0..11 {
        println(status_text(codes[i]))
    }
    return 0
}
