// An f-string is a value, not a format string (I8). println(f"x{n}") passes one
// already-rendered string argument down the value path, never the format
// placeholder expansion, so no {} in the f-string is a placeholder and there is no
// argument list.
@paradigm procedural

func main() -> int64 {
    n: int64 = 3
    println(f"x{n}")
    return 0
}
