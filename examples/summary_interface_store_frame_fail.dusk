@paradigm procedural
@paradigm oop

struct R { rows: int64[] }
struct Holder { rows: int64[] }
interface Stasher { stash(h: *Holder) -> void }
impl Stasher for R { func stash(h: *Holder) -> void { (*h).rows = self.rows } }
func noise(a: int64, b: int64) -> int64 {
    e: int64[8] = [9, 9, 9, 9, 9, 9, 9, 9]
    return a + b + e[0]
}

// The receiver's frame view lands in the caller's holder through the interface call
func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    r: R = R { rows: local[0..4] }
    s: Stasher = r
    s.stash(h)
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: [] })
    fill(h)
    println(noise(1, 2))
    println((*h).rows[0])
    free(h)
    return 0
}
