@paradigm procedural

// Postfix binds the old value while prefix binds the new value at signed and unsigned widths.
func main() -> int32 {
    mut signed: int64 = 4
    old_signed := signed++
    new_signed := ++signed
    mut unsigned: uint32 = 4u32
    old_unsigned := unsigned++
    new_unsigned := ++unsigned
    println(old_signed)
    println(new_signed)
    println(old_unsigned)
    println(new_unsigned)
    return 0
}
