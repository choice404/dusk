@paradigm procedural

enum Light {
    Red,
    Green,
}

// A match expression whose every arm ends in a literal yields a literal on every
// path, so the binding it initializes holds a literal.
func main() -> int32 {
    l := Light.Green
    name := match l {
        Red => "red",
        Green => "green",
    }
    println(name)
    free(name)
    return 0
}
