// vec_fold and a user fold over a parameter vector take a lambda that captures a
// parameter. The accumulator is an int64, so the fold's result holds nothing the
// lambda captured and the function may return it
@paradigm procedural
@paradigm functional
@import std.vector
func fold_i(v: *Vector<int64>, init: int64, f: (int64, int64) -> int64) -> int64 {
    mut acc: int64 = init
    for x in v { acc = f(acc, x) }
    return acc
}
func total(v: *Vector<int64>, k: int64) -> int64 {
    return vec_fold(v, 0, lambda (acc: int64, x: int64) -> int64 { return acc + x * k })
}
func user_total(v: *Vector<int64>, k: int64) -> int64 {
    return fold_i(v, 0, lambda (acc: int64, x: int64) -> int64 { return acc + x * k })
}
func main() -> int32 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 5)
    vec_push(v, 7)
    println(total(v, 2))
    println(user_total(v, 3))
    return 0
}
