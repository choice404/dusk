@paradigm procedural

// Both bounds are evaluated exactly once, before the first iteration, low bound
// first. Each bound is a call that prints, so a bound re-read per iteration or
// evaluated out of order shows up in the output rather than hiding in the IR.
func lo() -> int64 {
    println("lo")
    return 1
}

func hi() -> int64 {
    println("hi")
    return 4
}

func main() -> int32 {
    for i in lo()..hi() {
        println(i)
    }
    return 0
}
