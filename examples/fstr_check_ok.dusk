// Every legal shape of an interpolated string type-checks and runs: scalars, a
// bool, a float, a string, adjacent holes, empty chunks, a holeless f-string,
// doubled braces, a field chain through a pointer, an arithmetic hole, a nested
// plain string in a hole, a Display struct, and concatenation with the result.
// Each is built with an f-string and printed, so the golden output is exactly the
// bytes each interpolation renders.
@paradigm oop
@paradigm procedural

interface Display {
    toString() -> string
}

struct Point {
    x: int64,
    y: int64,
}

impl Display for Point {
    func toString() -> string {
        return "point"
    }
}

func main() -> int64 {
    n: int64 = 5
    b: bool = true
    fl: float64 = 3.5
    s: string = "hi"
    scalars: string = f"n={n} b={b} f={fl} s={s}"
    plain: string = f"no holes at all"
    adjacent: string = f"{n}{n}"
    single: string = f"{n}"
    braces: string = f"a {{lit}} b {n} c"
    arith: string = f"sum={n + n}"
    nested: string = f"joined {s + s}"
    p: *Point = alloc(Point { x: 1, y: 2 })
    field: string = f"px={(*p).x}"
    disp: string = f"here is {(*p)}"
    concat: string = f"a{n}" + s
    free(p)
    println("{}", scalars)
    println("{}", plain)
    println("{}", adjacent)
    println("{}", single)
    println("{}", braces)
    println("{}", arith)
    println("{}", nested)
    println("{}", field)
    println("{}", disp)
    println("{}", concat)
    return 0
}
