@paradigm procedural

@import name_foreign_variadic_mod

// A variadic declaration and a fixed one of the same C name pass arguments by
// different conventions, so the pair is refused at check like any other mismatch.
foreign "C" {
    func snprintf(buf: *raw char, size: int64, fmt: *raw char, ...) -> int32
}

func main() -> int32 {
    println(mod_touch())
    return 0
}
