@paradigm procedural

// A branch of an if used as a value has to leave something in the result slot. The then
// branch here ends in an assignment, which is a statement and yields nothing, so the
// binding would read a slot nobody wrote. The two ways out are the two a match arm has:
// end the branch in an expression, or never reach the end of it.
func main() -> int32 {
    c: bool = true
    mut k: int64 = 0
    n: int64 = if c { k = 1 } else { 2 }
    println(n + k)
    return 0
}
