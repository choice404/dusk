// Compile-fail: a closure points its own fresh sink at a captured holder through a
// call that hands the sink back, then stores its parameter's view through the sink.
// Calling it with a view of a frame array leaves that view in the caller's holder
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fresh() -> *Sink {
    return alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

func same(s: *Sink) -> *Sink { return s }

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    put := lambda (xs: int64[]) -> void {
        s: *Sink = fresh()
        relink(same(s), h)
        s.keep(xs)
    }
    put(local[0..4])
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
