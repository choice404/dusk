// A lambda parameter of a bare type parameter is a borrow, so freeing it inside the lambda
// rejects, the same rule a function parameter follows.
@paradigm procedural
func drop_it<T>(p: T) -> void {
    g := lambda (q: T) -> void {
        free(q)
    }
    g(p)
}
func main() -> int64 {
    n: *int64 = alloc(7)
    drop_it(n)
    println(*n)
    free(n)
    return 0
}
