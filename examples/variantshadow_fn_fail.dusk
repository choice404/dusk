@paradigm procedural

// A top level function whose name repeats a variant name. The escape model asked only
// whether the callee's name appears in the variant payload table, so this call was
// modeled as Tag's constructor: Tag.Some carries a scalar, a scalar payload embeds no
// view, and the call handed back a slice into a dead frame with nothing reported. A
// name a function or a local owns is that callee, not a constructor, exactly as the
// call check already decides it. The accept twin is variantshadow_ok.
enum Tag { Some(n: int64), None }

func Some(xs: int64[]) -> int64[] {
    return xs
}

func mk() -> int64[] {
    local: int64[4] = [1, 2, 3, 4]
    r := Some(local[0..4])
    return r
}

func main() -> int32 {
    v := mk()
    println(v[0])
    return 0
}
