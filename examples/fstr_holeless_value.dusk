// A holeless interpolated string is a value, not a format string: its doubled braces
// cook to single braces, and as the sole println argument it prints its own bytes
// rather than being re-scanned as a format placeholder.
@paradigm procedural

func main() -> int64 {
    x: int64 = 5
    println(f"holed {x} {{}} end")
    println(f"holeless {{}} end")
    v1: string = f"holed {x} {{}} end"
    v2: string = f"holeless {{}} end"
    println("{}", v1)
    println("{}", v2)
    return 0
}
