// The string verbs. A width and a precision both count bytes rather than scalars, so a
// six byte string carrying one two byte scalar pads to ten with four spaces and truncates
// at three bytes in the middle of nothing, and %q wraps the text in double quotes with
// the quote, the backslash, and the control bytes escaped while the UTF-8 passes through.
@paradigm procedural

@import std.fmt

func main() -> int64 {
    s: string = format("%s|%10s|%-10s|%.3s", [
        arg_str("héllo"),
        arg_str("héllo"),
        arg_str("héllo"),
        arg_str("héllo")
    ])
    println(s)
    free(s)
    q: string = format("%q", [arg_str("héllo \"w\"\n")])
    println(q)
    free(q)
    return 0
}
