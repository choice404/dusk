// A local binding shadows a top-level of the same name, so sizeof of a tuple built from
// such locals is a value size, not a phantom tuple-type reject.
@paradigm procedural
func a() -> int64 { return 1 }
func b() -> int64 { return 2 }
func main() -> int32 {
    a := 5
    b := 6
    println("{}", sizeof((a, b)))
    println("{}", a + b)
    return 0
}
