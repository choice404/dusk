// A literal in an unsigned context is checked against [0, 2^w - 1], so a value
// past the top of the range is refused the same way a signed literal past its
// own top is.
@paradigm procedural

func main() -> int32 {
    small: uint8 = 256
    medium: uint16 = 70000
    large: uint32 = 5000000000
    println(small)
    println(medium)
    println(large)
    return 0
}
