@paradigm procedural

// The declaration order twin of varshadow_wrap_fail, so the summary's returns view
// judgment does not depend on which enum declared Some last.
enum Tally { Some(n: int64), None }
enum Rows { Some(s: int64[]), None }

func wrap(s: int64[]) -> Rows {
    return Rows.Some(s)
}

func mk() -> Rows {
    local: int64[4] = [1, 2, 3, 4]
    return wrap(local[0..4])
}

func main() -> int32 {
    r := mk()
    match r {
        Some(s) => { println(s[0]) }
        None => { println(0) }
    }
    return 0
}
