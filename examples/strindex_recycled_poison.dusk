// A post free index measures a parked block, then a shorter string
// takes the same address. Reuse moves the stamp again, so the old measurement cannot
// answer for the new tenant and the read past its end faults
@paradigm procedural
@import std.string

func main() -> int32 {
    src: string = repeat("abcdefghij", 10)
    s: string = substring(src, 0, 100)
    println(int64(s[99]))
    free(s)
    println(int64(s[98]))
    t: string = substring(src, 0, 97)
    println(int64(t[96]))
    println(int64(t[99]))
    free(t)
    free(src)
    return 0
}
