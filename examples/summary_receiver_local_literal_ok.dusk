@paradigm procedural
@paradigm oop
struct Holder { rows: int64[] }
struct Sink { holder: *Holder }
func keep_value(sink: Sink, rows: int64[]) -> void { (*sink.holder).rows = rows }
func main() -> int32 {
    local: int64[4] = [1, 2, 3, 4]
    h: *Holder = alloc(Holder { rows: [] })
    keep_value(Sink { holder: h }, local[0..4])
    println((*h).rows[0])
    free(h)
    return 0
}
