// The four unsigned widths are real types: an annotation names one, a u suffix
// pins a literal to one, and an unsigned value crosses a struct field, an array,
// a slice, a tuple, and a function boundary the same way a signed one does.
@paradigm procedural

struct Counter { hits: uint32, tag: uint8 }

func total(c: Counter, extra: uint32) -> uint32 {
    return c.hits + extra
}

func first(xs: uint8[]) -> uint8 {
    return xs[0]
}

func widths(p: (uint16, uint64)) -> uint64 {
    small, big := p
    println(small)
    return big
}

func main() -> int32 {
    c := Counter { hits: 40u32, tag: 7u8 }
    println(total(c, 2u32))
    println(c.tag)
    xs: uint8[3] = [1u8, 2u8, 3u8]
    println(first(xs[0..3]))
    w: uint16 = 300
    println(w)
    println(widths((11u16, 9u64)))
    if 9u64 > 4u64 { println(1) } else { println(0) }
    return 0
}
