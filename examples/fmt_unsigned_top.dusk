// An unsigned value at the top of its range keeps its own signedness through every verb:
// %d and %v print unsigned decimal rather than the -1 a signed reading would give, and %x
// prints the whole word.
@paradigm procedural

@import std.fmt

func main() -> int64 {
    top: uint64 = 18446744073709551615u64
    s: string = format("%d %x %v", [arg_uint(top), arg_uint(top), arg_uint(top)])
    println(s)
    free(s)
    return 0
}
