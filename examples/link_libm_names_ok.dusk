@paradigm procedural

// A dusk function named for a C math function keeps its own body at every
// optimization level. Every dusk function carries nobuiltin, so the optimizer never
// reads a call to this sqrt, abs, or floor as the library function and folds it;
// through 1.17.3 a build at -O2 printed 2, 3, and 2 here.
func sqrt(x: float64) -> float64 {
    return x + 1.0
}

func abs(x: int32) -> int32 {
    return x + 100
}

func floor(x: float64) -> float64 {
    return x + 0.25
}

func main() -> int32 {
    println(sqrt(4.0))
    println(abs(-3))
    println(floor(2.5))
    return 0
}
