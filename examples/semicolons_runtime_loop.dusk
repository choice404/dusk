@paradigm procedural

// `continue;` and `break;` terminate their control-flow statements normally.
func main() -> int32 {
    mut i: int64 = 0
    mut sum: int64 = 0
    while i < 6 {
        i++
        if i == 2 { continue; }
        if i == 5 { break; }
        sum = sum + i
    }
    println(sum)
    println(i)
    return 0
}
