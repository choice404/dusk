// The signedness rule is one arm of type compatibility, so it seals every place
// the width rule already sealed: an annotated bind, an argument, and the result
// type an unsigned operand hands back, which stays unsigned even when the other
// operand was a bare literal.
@paradigm procedural

func want(v: uint32) -> uint32 { return v }

func main() -> int32 {
    signed: int32 = 4
    crossed: uint32 = signed
    println(want(signed))
    narrowed: int32 = 5u32 + 1
    println(crossed)
    println(narrowed)
    return 0
}
