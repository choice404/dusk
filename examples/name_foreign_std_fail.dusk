@paradigm procedural

@import std.vector

// std.vector declares the C library's abort, and a foreign name is reserved across
// the whole program, the standard library's declarations included.
func abort() -> void {
    println("my abort")
}

func main() -> int32 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 1)
    println(vec_len(v))
    vec_free(v)
    free(v)
    abort()
    return 0
}
