// Compile-fail: a helper relinks a fresh sink to the caller's holder through a
// passthrough call, then a direct assignment through the sink stores a view of a frame
// array. The function's escape summary records the store into memory its parameter
// reaches
@paradigm procedural
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }
func same(s: *Sink) -> *Sink { return s }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
    relink(same(s), h)
    (*(*s).h).rows = local[0..4]
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
