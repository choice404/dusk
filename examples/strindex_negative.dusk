// A negative string index is out of bounds like one past the end, so it faults by
// name and line instead of reading the byte before the string.
@paradigm procedural

@import std.string

func main() -> int32 {
    s: string = substring("abcdef", 1, 4)
    mut i: int64 = 1
    println(int64(s[i]))
    i = i - 2
    println(int64(s[i]))
    free(s)
    return 0
}
