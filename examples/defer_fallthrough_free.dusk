@paradigm procedural
@import std.memory.allocator

func work(using allocator: Debug) -> void {
    value: *int64 = alloc(8)
    *value = 7
    defer println("last")
    defer free(value)
    defer println("first")
}

func main() -> int32 {
    mut allocator := debug()
    work(allocator)
    println("leaks {}", debug_leaks())
    return 0
}
