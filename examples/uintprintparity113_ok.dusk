// Plain formatting and f-string formatting render unsigned widths as the same
// decimal byte sequence, including the uint64 top.
@paradigm procedural

func main() -> int32 {
    a: uint8 = 255u8
    b: uint32 = 4000000000u32
    c: uint64 = 18446744073709551615u64
    println("{}", a)
    println(f"{a}")
    println("{}", b)
    println(f"{b}")
    println("{}", c)
    println(f"{c}")
    return 0
}
