@paradigm procedural
@import std.string
@import std.vector

func read_name(names: *Vector<string>) -> (string, int64) {
    return (vec_get(names, 0), 7)
}

func main() -> int32 {
    names: *Vector<string> = alloc(vec_new())
    vec_push(names, substring("hello", 0, 5))
    text, count := read_name(names)
    println(count)
    free(text)
    return 0
}
