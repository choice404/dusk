// writer_close never closes a standard stream. Descriptor 0, 1, and 2 are flushed and
// left open, so a write after one still lands.
@paradigm procedural

@import std.io

func main() -> int32 {
    ce := writer_close(stdout_writer())
    ce.ignore()
    e := write_line(stdout_writer(), "after")
    e.ignore()
    return 0
}
