// The return twin of ctorroot_annot_fail: a constructor handed back from a function
// declared to return a scalar is refused against the declared return, where it used
// to pass check on the surface wildcard and die in clang.
@paradigm procedural

enum Opt {
    Some(v: int64),
    None,
}

func pick() -> int64 {
    return Opt.Some(1)
}

func main() -> int32 {
    println(pick())
    return 0
}
