// The legal twin: the same helper storing heap rows through its sink before pointing
// the caller's sink at the holder through a struct literal member, a conditional, and
// a fresh allocation. No view of a frame reaches the holder, so it runs
@paradigm procedural
@paradigm oop
@paradigm functional

@import std.vector
@import std.map

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}
struct Cell<T> { item: T }

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func gpoint<S>(q: S, h: *Holder) -> void { q.point(h) }

func keepvia<S>(q: S, xs: int64[]) -> void {
    inner: *Holder = alloc(Holder { rows: heap_rows() })
    s: *Sink = alloc(Sink { h: inner })
    s.keep(heap_rows())
    pick: bool = xs[0] > 0
    g := lambda (w: S) -> void { w.point(inner) }
    g(pick ? q : q)
    gpoint(Cell { item: q }.item, inner)
    (*alloc(Cell { item: q })).item.point(inner)
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    q: *Sink = alloc(Sink { h: h })
    keepvia(q, local[0..4])
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
