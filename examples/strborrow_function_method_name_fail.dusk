@paradigm procedural
@paradigm oop
@import std.string
@import std.vector

struct Counter { n: int64 }
impl Counter {
    func first() -> int64 { return self.n }
}
func first<T>(v: *Vector<T>) -> T { return vec_get(v, 0) }
func main() -> int32 {
    v: *Vector<string> = alloc(vec_new())
    vec_push(v, substring("alice-in-wonderland", 0, 19))
    x := first(v)
    free(x)
    t: string = substring("s3cr3t-s3cr3t-s3cr3", 0, 19)
    println(vec_get(v, 0))
    free(t)
    return 0
}
