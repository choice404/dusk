// Compile-fail: a for binder over a vector holding a fresh sink relinks it to the
// caller's holder, so the later store through the sink itself reaches that holder
@paradigm procedural
@paradigm oop
@paradigm functional
@import std.vector

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fresh() -> *Sink {
    return alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

func keepvia(h: *Holder, xs: int64[]) -> void {
    s: *Sink = fresh()
    all: *Vector<*Sink> = alloc(vec_new())
    vec_push(all, s)
    for each in all { relink(each, h) }
    s.keep(xs)
}

func fill(h: *Holder) -> void {
    local: int64[4] = [111, 222, 333, 444]
    keepvia(h, local[0..4])
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    fill(h)
    println((*h).rows[0])
    return 0
}
