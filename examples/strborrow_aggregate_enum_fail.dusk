@paradigm procedural
@import std.string

enum Opt { Some(s: string), None }
func get(o: Opt) -> string {
    match o {
        Some(s) => { return s }
        None => { return "" }
    }
    return ""
}
func main() -> int32 {
    m: string = substring("hello", 0, 5)
    o: Opt = Opt.Some(m)
    x := get(o)
    free(x)
    free(m)
    return 0
}
