// Compile-fail: a slice read through a match payload binder out of an option over a
// holder of a frame view, returned out of the frame
@paradigm procedural
@paradigm oop
@paradigm functional

@import std.functional.maybe

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func rows_of() -> int64[] {
    local: int64[4] = [111, 222, 333, 444]
    s: *Holder = alloc(Holder { rows: local[0..4] })
    m: Maybe<*Holder> = Maybe.Some(s)
    match m {
        Some(y) => { return (*y).rows }
        None => { }
    }
    return heap_rows()
}

func main() -> int32 {
    r: int64[] = rows_of()
    println(r[0])
    return 0
}
