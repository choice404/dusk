@paradigm procedural

// The operator writes its place back, so a field chain and an index chain each need the
// `mut` their root binding carries. Neither root is declared `mut`, so both earn the
// through-a-chain message rather than the bare-name one an immutable name earns.
struct Counter {
    n: int64
}

func main() -> int32 {
    c: Counter = Counter{ n: 1 }
    println(c.n++)

    xs: int64[2] = [4, 9]
    println(xs[0]++)
    return 0
}
