@paradigm procedural

// The binder is a fresh immutable value per iteration, so a lambda that captures it
// and is called inside the body, which is what this does, sees that iteration's
// number rather than the cursor's later value. A lambda stored past the loop and
// called afterwards reads the last iteration's value, the same as one capturing any
// other loop body local: the capture rides the frame slot, and the counted loop
// changes nothing about that.
func main() -> int32 {
    for i in 0..3 {
        f := lambda () -> int64 { return i * 10 }
        println(f())
    }
    return 0
}
