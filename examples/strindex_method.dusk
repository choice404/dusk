// A string a method returns is a string like any other: bound with :=, its index
// is held to the string's length, so the program builds and reads its bytes.
@paradigm procedural
@paradigm oop

@import std.string

struct R { name: string }

impl R {
    func nm() -> string { return self.name }
}

func main() -> int32 {
    r: R = R { name: substring("abcdef", 0, 3) }
    n := r.nm()
    println(int64(n[1]))
    println(int64(n[str_len(n)]))
    free(r.name)
    return 0
}
