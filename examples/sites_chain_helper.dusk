@paradigm procedural

// One helper line reached from two callers is two groups in the report, each with
// the chain of calls that led to it.
func make(tag: string) -> string {
    return tag + "!"
}

func first() -> string {
    return make("first")
}

func second() -> string {
    return make("second")
}

func main() -> int32 {
    a := first()
    b := second()
    println(a)
    println(b)
    return 0
}
