@paradigm procedural

// `by` is contextual, not a keyword: a parameter and a local may still be named
// `by`, and one may even be a bound. Here `0..by by 2` reads the local as the
// high bound and then takes the step, so both uses stand in one loop head.
func addto(by: int64, n: int64) -> int64 {
    return n + by
}

func main() -> int32 {
    by: int64 = 4
    mut sum: int64 = 0
    for i in 0..by by 2 {
        sum = sum + addto(by, i)
    }
    println(sum)
    return 0
}
