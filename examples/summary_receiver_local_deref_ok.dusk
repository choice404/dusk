@paradigm procedural
@paradigm oop
struct Buf { rows: int64[] }
impl Buf {
    func set(rows: int64[]) -> void { self.rows = rows }
}
func main() -> int32 {
    local: int64[4] = [1, 2, 3, 4]
    p: *Buf = alloc(Buf { rows: [] })
    (*p).set(local[0..4])
    println((*p).rows[0])
    free(p)
    return 0
}
