// Unsigned right shift is logical, and ordered comparisons use unsigned order
// for values whose signed reading would be negative.
@paradigm procedural

func main() -> int32 {
    top: uint32 = 2147483648u32
    small_top: uint8 = 128u8
    all: uint32 = uint32(int32(-1))
    zero: uint32 = 0u32
    one: uint32 = 1u32

    println(top >> 1u32)
    println(small_top >> 7u8)
    if all > zero { println("all_gt_zero") } else { println("bad") }
    if zero < one { println("zero_lt_one") } else { println("bad") }
    if top > one { println("top_after_one") } else { println("bad") }
    if all >= top { println("all_after_top") } else { println("bad") }
    return 0
}
