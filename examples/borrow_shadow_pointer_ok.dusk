@paradigm procedural
@import std.string
@import std.vector
struct Box { n: int64 }
func mk() -> *Vector<*Box> {
    v: *Vector<*Box> = alloc(vec_new())
    vec_push(v, alloc(Box { n: 7 }))
    return v
}
func main() -> int32 {
    names: *Vector<string> = alloc(vec_new())
    vec_push(names, "a")
    if vec_len(names) > 0 {
        names := mk()
        b := vec_get(names, 0)
        println((*b).n)
    }
    return 0
}
