// Fact-9 orthogonality: the per-block scope chain composes with the async state
// machine. An inner x shadows an outer x inside an if-block whose binding crosses
// an await, then the outer x is read after the block. The async frame keeps each
// binding in its own slot, and the scope chain retires the inner x at the branch
// end, so the outer x prints 1. Before scoping the flat locals map clobbered the
// outer slot's resolution and the trailing read returned the inner value.
@paradigm procedural
@import std.async.future
@import std.async.loop

async func val(n: int64) -> int64 {
    return n
}

async func amain() -> int32 {
    x := 1
    if true {
        x := await val(2)
        println(x)
    }
    println(x)
    return 0
}

func main() -> int32 {
    le := loop_init()
    le.ignore()
    rc := async_run(amain())
    loop_free()
    return rc
}
