@paradigm procedural
@paradigm oop
@paradigm functional
@import std.string
@import std.vector
@import std.map
@import std.functional.maybe
struct Lexer { src: int64[], toks: *Vector<int64>, pos: int64 }
impl Lexer {
    func run() -> void {
        for i in 0..self.src.len { vec_push(self.toks, self.src[i] * 2) }
    }
    func peek() -> int64 { return self.src[self.pos] }
    func note(m: *Map<string, int64>) -> void { map_put(m, "pos", self.pos) }
}
func lex_run(lx: Lexer) -> void { for i in 0..lx.src.len { vec_push(lx.toks, lx.src[i] * 2) } }
func lex_runp(lx: *Lexer) -> void { for i in 0..(*lx).src.len { vec_push((*lx).toks, (*lx).src[i] * 2) } }
func main() -> int32 {
    local: int64[4] = [1, 2, 3, 4]
    toks: *Vector<int64> = alloc(vec_new())
    lx: Lexer = Lexer { src: local[0..4], toks: toks, pos: 0 }
    lex_run(lx)
    println(vec_get(toks, 3))
    return 0
}
