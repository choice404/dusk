@paradigm procedural

// The declaration order twin of varshadow_ctor_fail: the scalar Some is declared
// first and the slice one second. A name keyed payload read is order sensitive,
// wrong in one order and right in the other by accident, so both orders are pinned.
enum Tally { Some(n: int64), None }
enum Rows { Some(s: int64[]), None }

func mk() -> Rows {
    local: int64[4] = [1, 2, 3, 4]
    return Rows.Some(local[0..4])
}

func main() -> int32 {
    r := mk()
    match r {
        Some(s) => { println(s[0]) }
        None => { println(0) }
    }
    return 0
}
