// The stdlib map accepts uint64 keys, including keys whose signed reading would
// be negative, and hash accepts unsigned values directly.
@paradigm procedural
@import std.map
@import std.functional.maybe

func main() -> int32 {
    m: *Map<uint64, int64> = alloc(map_new())
    a: uint64 = 0u64
    b: uint64 = 9223372036854775808u64
    c: uint64 = 18446744073709551615u64
    map_put(m, a, 10)
    map_put(m, b, 20)
    map_put(m, c, 30)
    println(map_len(m))
    println(unwrap_or(map_get(m, a), -1))
    println(unwrap_or(map_get(m, b), -1))
    println(unwrap_or(map_get(m, c), -1))
    println(hash(b))
    println(hash(c))
    map_free(m)
    free(m)
    return 0
}
