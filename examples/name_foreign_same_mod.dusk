@paradigm procedural

// Declares abs and snprintf exactly as the importing file does.
foreign "C" {
    func abs(n: int32) -> int32
    func snprintf(buf: *raw char, size: int64, fmt: *raw char, ...) -> int32
}

export func mod_abs(n: int32) -> int32 {
    return abs(n)
}

// Formats 42 with %d and returns the length snprintf reports.
export func mod_format() -> int32 {
    fmt: *raw char = alloc_bytes(4)
    fmt[0] = 37
    fmt[1] = 100
    fmt[2] = 0
    out: *raw char = alloc_bytes(16)
    n: int32 = snprintf(out, 16, fmt, 42)
    free(fmt)
    free(out)
    return n
}
