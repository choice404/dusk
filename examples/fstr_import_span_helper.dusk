// An imported function whose f-string hole holds a managed pointer, an unprintable
// value. Merged into the root, its spans are remapped per file, so the diagnostic
// must still caret this file's own hole rather than a shifted offset in the root.
@paradigm procedural

// padding to shift this file's offsets away from the root's
// second padding line

export func bad_hole(x: int64) -> string {
    p: *int64 = alloc(55)
    defer free(p)
    return f"oops:{p}"
}
