// Compile-fail: a recursive call's result is what the function returns, the caller's
// holder among it, and a fresh sink is pointed at that result. Storing a view of a
// frame array through the sink reaches the caller's holder
@paradigm procedural
@paradigm oop
@paradigm functional

struct Holder { rows: int64[] }
struct Sink { h: *Holder }
impl Sink {
    func keep(xs: int64[]) -> void { (*self.h).rows = xs }
    func point(h: *Holder) -> void { self.h = h }
}

func heap_rows() -> int64[] {
    seed: int64[4] = [1, 2, 3, 4]
    return map(seed[0..4], lambda (value: int64) -> int64 { return value })
}

func fresh() -> *Sink {
    return alloc(Sink { h: alloc(Holder { rows: heap_rows() }) })
}

func relink(s: *Sink, h: *Holder) -> void { (*s).h = h }

func same(s: *Sink) -> *Sink { return s }

func walk(h: *Holder, n: int64) -> *Holder {
    if n == 0 { return h }
    local: int64[4] = [111, 222, 333, 444]
    s: *Sink = fresh()
    relink(same(s), walk(h, n - 1))
    (*(*s).h).rows = local[0..4]
    return h
}

func main() -> int32 {
    h: *Holder = alloc(Holder { rows: heap_rows() })
    r: *Holder = walk(h, 1)
    println((*r).rows[0])
    return 0
}
