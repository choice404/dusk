// For-loop variable shadow: the loop variable i shadows an outer i. Before the
// scope chain the loop binding clobbered the outer slot in the flat map, so the
// print after the loop read the last iteration value instead of the outer 50.
// The for construct now owns a scope around its loop variable, so the outer i
// prints 50 after the loop.
@paradigm procedural

func main() -> int64 {
    i: int64 = 50
    xs: int64[3] = [1, 2, 3]
    for i in xs {
        println(i)
    }
    println(i)
    return 0
}
