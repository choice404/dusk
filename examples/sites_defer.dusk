@paradigm procedural

// A deferred call runs at the return and is attributed to its defer's line, and the
// line of the code after it is unchanged.
func note(s: string) -> void {
    kept := s + "!"
    println(kept)
}

func work() -> int64 {
    defer note("deferred")
    x := "body" + "!"
    println(x)
    free(x)
    return 1
}

func main() -> int32 {
    r := work()
    after := "after" + "!"
    println(r)
    println(after)
    return 0
}
