@paradigm procedural
@import std.vector

// `by` steps a counted range, not a container. A vector already yields its
// elements in order, so a step over one has nothing to mean and is refused in the
// head with the form that does take a step.
func main() -> int32 {
    v: *Vector<int64> = alloc(vec_new())
    vec_push(v, 1)
    for x in v by 2 {
        println(x)
    }
    vec_free(v)
    free(v)
    return 0
}
