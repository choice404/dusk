// response_new copies the reason phrase from the status table, and a code the table does
// not know gets the empty reason. A body set from text reads back as text, and body_len
// is its byte count.
@paradigm procedural
@import std.net.http

func main() -> int32 {
    r := response_new(404)
    println((*r).reason)
    u := response_new(299)
    println((*u).reason)
    response_set_body(u, "hi")
    println(response_text(u))
    println((*u).body_len)
    response_free(u)
    free(u)
    response_free(r)
    free(r)
    return 0
}
