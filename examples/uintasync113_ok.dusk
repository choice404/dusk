// An unsigned value with its top bit set is carried across an await point and
// printed after the task resumes.
@paradigm procedural
@import std.async.future
@import std.async.loop

async func tick() -> int64 {
    return 1
}

async func carry() -> int32 {
    v: uint32 = 2147483648u32
    n := await tick()
    println(v)
    println(n)
    return 0
}

func main() -> int32 {
    le := loop_init()
    le.ignore()
    rc := async_run(carry())
    loop_free()
    return rc
}
