@paradigm procedural
@import std.vector

struct Cell { rows: int64[] }
struct Outer { inner: *Cell }

func main() -> int32 {
    cell: *Cell = alloc(Cell { rows: [] })
    holders: (*Cell, int64) = (cell, 7)
    fill := lambda () -> void {
        local: int64[4] = [111, 222, 333, 444]
        alias, count := holders
        println(count)
        (*alias).rows = local[0..4]
    }
    fill()
    println((*cell).rows[0])
    return 0
}
