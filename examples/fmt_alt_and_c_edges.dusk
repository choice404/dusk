@paradigm procedural
@import std.fmt

// The alternate form keeps the decimal point even when no digit follows it, the C
// rule for %#.0f, %#.0e, and %#g, and %c refuses a scalar outside Unicode before it
// narrows the integer, so a value above 2^32 renders U+FFFD instead of the low 32 bits
// of itself (which for 2^32 exactly would have been a NUL that cut the string short).
func main() -> int32 {
    a := format("%#.0f|%#.0e|%#.1g|%#g|%#.1G", [arg_float(3.0), arg_float(3.0), arg_float(1.0), arg_float(123456.0), arg_float(100000000.0)])
    println(a)
    b := format("[%c|%c|%c|%c]", [arg_int(4294967361), arg_uint(4294967296u64), arg_int(0 - 4294967231), arg_int(65)])
    println(b)
    c := format("[%c|%c]", [arg_int(1114112), arg_int(55296)])
    println(c)
    return 0
}
