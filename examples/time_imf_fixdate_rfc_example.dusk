// The IMF fixdate of the instant RFC 9110 uses as its own example, and of the epoch.
@paradigm procedural
@import std.time

func main() -> int32 {
    a := format_imf_fixdate(civil_from_unix(784111777))
    println(a)
    free(a)
    b := format_imf_fixdate(civil_from_unix(0))
    println(b)
    free(b)
    return 0
}
