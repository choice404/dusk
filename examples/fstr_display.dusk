// A Display struct in a hole renders through its toString, the same path
// println("{}", t) takes for a struct, so f"{t}" and the format twin agree.
@paradigm oop
@paradigm procedural

interface Display {
    toString() -> string
}

struct Temp {
    c: int64,
}

impl Display for Temp {
    func toString() -> string {
        return "warm"
    }
}

func main() -> int64 {
    t: Temp = Temp { c: 25 }
    println(f"today is {t}")
    return 0
}
