@paradigm procedural

@import std.string

// Under --sanitize=address the generational heap really frees, so a string read
// after its free is AddressSanitizer's heap use after free report, with the stacks
// of the read, the free, and the allocation, each through its dusk function. A
// plain build parks the block and the read prints a stale byte.
func make(n: int64) -> string {
    return "abc" + int_to_string(n)
}

func reader(s: string) -> int64 {
    return s[1]
}

func main() -> int32 {
    s := make(7)
    println(s)
    free(s)
    println(reader(s))
    return 0
}
