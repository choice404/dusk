/** std.string: helpers over NUL terminated strings. Length and comparison, signed integer
 *  parsing and formatting, a growable StringBuilder, the raw buffer bridge a foreign call
 *  reads, and the float constant formatting the compiler emits its IR through. The byte
 *  oriented toolkit at the end searches, trims, splits, joins, replaces, repeats, and
 *  ASCII case folds, each returning a fresh heap string the caller owns and frees. A
 *  string is a NUL terminated raw byte view, so every operation here is byte oriented and
 *  case folding is ASCII only; see std.unicode for scalar aware decoding. */

@import std.vector

foreign "C" {
    func cool_f64_bits(x: float64) -> int64
    func cool_f32_bits(x: float64) -> int64
}

/** Copies a string into a fresh NUL terminated raw byte buffer the C boundary can read,
 *  since a string view is typed apart from a raw pointer and a foreign signature takes
 *  only a scalar, a *raw T, or a *void. s is borrowed.
 *  @param s the string to copy
 *  @return a fresh NUL terminated buffer the caller owns and frees once the call that
 *  reads it has returned */
export func cbuf(s: string) -> *raw char {
    n: int64 = str_len(s)
    buf: *raw char = alloc_bytes(n + 1)
    mut i: int64 = 0
    while i < n {
        buf[i] = s[i]
        i = i + 1
    }
    buf[n] = 0
    return buf
}

/** The length of s in bytes, not scalars, counting up to but not including the NUL
 *  terminator. s is borrowed.
 *  @param s the string to measure
 *  @return the byte length of s */
export func str_len(s: string) -> int64 {
    mut n: int64 = 0
    while s[n] != 0 {
        n = n + 1
    }
    return n
}

/** Whether a and b hold the same bytes, comparing up to the NUL terminator. Both are
 *  borrowed.
 *  @param a the first string
 *  @param b the second string
 *  @return true when a and b are byte for byte equal */
export func str_eq(a: string, b: string) -> bool {
    mut i: int64 = 0
    while a[i] != 0 {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return b[i] == 0
}

/** Whether s begins with prefix, comparing NUL terminated bytes. The empty prefix is a
 *  prefix of every string. A prefix longer than s fails at the byte where s runs into its
 *  own NUL, so s is never read past its terminator. Both are borrowed.
 *  @param s the string to test
 *  @param prefix the prefix to look for
 *  @return true when s begins with prefix */
export func starts_with(s: string, prefix: string) -> bool {
    mut i: int64 = 0
    while prefix[i] != 0 {
        if s[i] != prefix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/** A fresh heap string of the bytes s[lo, hi), lo included and hi excluded. The range is
 *  clamped to the string, so a lo below 0 becomes 0, a hi past the length becomes the
 *  length, and a lo above hi yields the empty string; the call never faults on an out of
 *  range index. s is borrowed.
 *  @param s the source string
 *  @param lo the inclusive start byte offset, clamped to [0, str_len(s)]
 *  @param hi the exclusive end byte offset, clamped to [0, str_len(s)]
 *  @return a fresh NUL terminated string the caller owns and frees with free */
export func substring(s: string, lo: int64, hi: int64) -> string {
    n: int64 = str_len(s)
    mut a: int64 = lo
    mut b: int64 = hi
    if a < 0 {
        a = 0
    }
    if b > n {
        b = n
    }
    if a > b {
        a = b
    }
    count: int64 = b - a
    d: *raw char = alloc_bytes(count + 1)
    mut i: int64 = 0
    while i < count {
        d[i] = s[a + i]
        i = i + 1
    }
    d[count] = 0
    return cstr(d)
}

/** The base ten text of a signed integer. The value is accumulated in the non positive
 *  range, where the most negative int64 needs no negation, so it never overflows the way
 *  negating it would.
 *  @param n the value to format
 *  @return the base ten text as a fresh heap string the caller owns and frees */
export func int_to_string(n: int64) -> string {
    if n == 0 {
        d: *raw char = alloc_bytes(2)
        d[0] = 48
        d[1] = 0
        return cstr(d)
    }
    neg: bool = n < 0
    mut m: int64 = n
    if n > 0 {
        m = 0 - n
    }
    // m is non positive here, so count the digits of its magnitude.
    mut count: int64 = 0
    mut t: int64 = m
    while t != 0 {
        count = count + 1
        t = t / 10
    }
    mut total: int64 = count
    if neg {
        total = total + 1
    }
    d: *raw char = alloc_bytes(total + 1)
    d[total] = 0
    mut i: int64 = total - 1
    while m != 0 {
        digit: int64 = 0 - (m % 10)
        d[i] = 48 + digit
        m = m / 10
        i = i - 1
    }
    if neg {
        d[0] = 45
    }
    return cstr(d)
}

/** The 0x prefixed, 16 digit, uppercase hex text of n read as a raw 64 bit word. A
 *  negative n is its two's complement word, FFFFFFFFFFFFFFFF for -1, never a signed form,
 *  so this reproduces a 0x016X format of a float constant's bits byte for byte. Each
 *  nibble is masked out after an arithmetic shift, so the sign fill of the high nibbles is
 *  discarded.
 *  @param n the raw 64 bit word to format
 *  @return the 0x prefixed 16 digit hex text as a fresh heap string the caller owns */
export func int_to_hex16(n: int64) -> string {
    d: *raw char = alloc_bytes(19)
    d[0] = 48
    d[1] = 120
    mut i: int64 = 0
    while i < 16 {
        shift: int64 = 4 * (15 - i)
        nib: int64 = (n >> shift) & 15
        mut ch: int64 = 48 + nib
        if nib >= 10 {
            ch = 55 + nib
        }
        d[2 + i] = ch
        i = i + 1
    }
    d[18] = 0
    return cstr(d)
}

/** The IR constant token for a float64 value: 0x followed by the 16 hex digits of its
 *  IEEE 754 bits. The compiler lowers a float literal as the 016X hex of its bits, so this
 *  reproduces the same token for the same value, which is what the compiler emits for a
 *  float64 constant.
 *  @param x the value to format
 *  @return the IR constant token as a fresh heap string the caller owns */
export func f64_to_ir_hex(x: float64) -> string {
    return int_to_hex16(cool_f64_bits(x))
}

/** The IR constant token a float32 literal rounds to, as the exact double it equals: 0x
 *  followed by the 16 hex digits of the double that x narrowed to float and widened back
 *  equals. The compiler emits a float32 constant as the f64 bits of the parsed value and
 *  narrows it with a later fptrunc, so a byte for byte match of the emitted token uses
 *  f64_to_ir_hex; this returns the post rounding value for a consumer that wants the double
 *  a float32 constant actually holds.
 *  @param x the value to round to float32 and format
 *  @return the IR constant token as a fresh heap string the caller owns */
export func f32_to_ir_hex(x: float64) -> string {
    return int_to_hex16(cool_f32_bits(x))
}

// The value of byte c as a digit in the given base, or -1 when c is not a digit
// the base accepts. '0' to '9' map to 0 to 9 and letters to 10 to 35, upper or
// lower case.
func digit_val(c: int64, base: int64) -> int64 {
    mut v: int64 = -1
    if c >= 48 {
        if c <= 57 {
            v = c - 48
        }
    }
    if c >= 65 {
        if c <= 90 {
            v = c - 55
        }
    }
    if c >= 97 {
        if c <= 122 {
            v = c - 87
        }
    }
    if v >= base {
        return -1
    }
    return v
}

/** Parses a signed integer in the given base, from 2 to 36. An optional sign leads. A base
 *  with a canonical prefix accepts it, 0x or 0X for 16, 0o or 0O for 8, and 0b or 0B for 2,
 *  but the base is never inferred from the prefix; a prefix that does not match the base,
 *  like 0x under base 10, is read as digits and fails on the bad digit. s is borrowed.
 *  @param s the text to parse
 *  @param base the numeric base, from 2 to 36
 *  @return the parsed value paired with an error; on success the error is empty, and a
 *  failure returns 0 with one of "base must be between 2 and 36", "invalid digit for base",
 *  "integer overflow", or "no digits to parse" */
export func parse_int_radix(s: string, base: int64) -> (int64, error) {
    if base < 2 {
        return (0, error { message: "base must be between 2 and 36" })
    }
    if base > 36 {
        return (0, error { message: "base must be between 2 and 36" })
    }
    mut i: int64 = 0
    mut neg: bool = false
    sign: int64 = s[0]
    if sign == 45 {
        neg = true
        i = 1
    }
    if sign == 43 {
        i = 1
    }
    lead: int64 = s[i]
    if lead == 48 {
        nx: int64 = s[i + 1]
        if base == 16 {
            if nx == 120 {
                i = i + 2
            }
            if nx == 88 {
                i = i + 2
            }
        }
        if base == 8 {
            if nx == 111 {
                i = i + 2
            }
            if nx == 79 {
                i = i + 2
            }
        }
        if base == 2 {
            if nx == 98 {
                i = i + 2
            }
            if nx == 66 {
                i = i + 2
            }
        }
    }
    mut acc: int64 = 0
    mut count: int64 = 0
    while s[i] != 0 {
        cc: int64 = s[i]
        dv: int64 = digit_val(cc, base)
        if dv < 0 {
            return (0, error { message: "invalid digit for base" })
        }
        if acc > (9223372036854775807 - dv) / base {
            return (0, error { message: "integer overflow" })
        }
        acc = acc * base + dv
        count = count + 1
        i = i + 1
    }
    if count == 0 {
        return (0, error { message: "no digits to parse" })
    }
    if neg {
        acc = 0 - acc
    }
    return (acc, error {})
}

/** Parses a signed base ten integer. A 0x, 0o, or 0b prefix is not base ten, so it fails
 *  on the prefix letter; use parse_int_radix for another base. s is borrowed.
 *  @param s the text to parse
 *  @return the parsed value paired with an error; on success the error is empty, and a
 *  failure returns 0 with the error set */
export func parse_int(s: string) -> (int64, error) {
    return parse_int_radix(s, 10)
}

/** A growable, heap backed string as a buffer, a length, and a capacity. data points at
 *  the backing buffer, len is the character count, and cap is the buffer size. The buffer
 *  always holds a NUL after the last character, so sb_cstr hands back a valid string view
 *  with no extra work. Build one on the heap with alloc(sb_new()) and pass it by pointer
 *  so growth persists; the builder owns data and sb_free releases it. */
export struct StringBuilder {
    data: *raw char,
    len: int64,
    cap: int64,
}

/** A fresh empty builder with a small buffer already allocated and NUL terminated. Build
 *  one on the heap with alloc(sb_new()) and pass it by pointer so pushes persist.
 *  @return an empty StringBuilder
 *  @example
 *  b: *StringBuilder = alloc(sb_new())
 *  sb_push(b, "hello, ")
 *  sb_push(b, name)
 *  out: string = substring(sb_cstr(b), 0, sb_size(b))
 *  sb_free(b)
 *  free(b) */
export func sb_new() -> StringBuilder {
    d: *raw char = alloc_bytes(8)
    d[0] = 0
    return StringBuilder { data: d, len: 0, cap: 8 }
}

/** Appends one character to s, growing the buffer when the character and its NUL would not
 *  fit. The NUL terminator is rewritten after every push, so s stays a valid string view.
 *  @param s the builder to append to, borrowed and grown in place
 *  @param c the character byte to append */
export func sb_push_char(s: *StringBuilder, c: char) -> void {
    if (*s).len + 1 >= (*s).cap {
        mut nc: int64 = (*s).cap * 2
        if nc < 8 {
            nc = 8
        }
        nd: *raw char = alloc_bytes(nc)
        mut i: int64 = 0
        while i < (*s).len {
            nd[i] = (*s).data[i]
            i = i + 1
        }
        free((*s).data)
        (*s).data = nd
        (*s).cap = nc
    }
    (*s).data[(*s).len] = c
    (*s).len = (*s).len + 1
    (*s).data[(*s).len] = 0
}

/** Appends every byte of t to s, up to but not including t's NUL. t is borrowed.
 *  @param s the builder to append to, borrowed and grown in place
 *  @param t the string to append */
export func sb_push(s: *StringBuilder, t: string) -> void {
    mut i: int64 = 0
    while t[i] != 0 {
        sb_push_char(s, t[i])
        i = i + 1
    }
}

/** Appends the base ten text of n straight into s, with no intermediate string. The value
 *  is accumulated in the non positive range, the same guard int_to_string uses, so the
 *  most negative int64 needs no negation and never overflows.
 *  @param s the builder to append to, borrowed and grown in place
 *  @param n the value to format and append */
export func sb_push_int(s: *StringBuilder, n: int64) -> void {
    if n == 0 {
        sb_push_char(s, 48)
        return
    }
    if n < 0 {
        sb_push_char(s, 45)
    }
    mut m: int64 = n
    if n > 0 {
        m = 0 - n
    }
    // m <= -1 here. Grow div to the highest power of ten at or below the
    // magnitude, then walk it back down emitting one digit each step.
    mut div: int64 = 1
    while (m / div) <= -10 {
        div = div * 10
    }
    while div > 0 {
        digit: int64 = 0 - ((m / div) % 10)
        sb_push_char(s, 48 + digit)
        div = div / 10
    }
}

/** The number of characters in s, its length, not its capacity.
 *  @param s the builder to measure, borrowed
 *  @return the character count */
export func sb_size(s: *StringBuilder) -> int64 {
    return (*s).len
}

/** The built bytes viewed as a string. The buffer is always NUL terminated, so this is a
 *  zero cost reinterpret, not a copy: the view borrows s's buffer and is valid only until
 *  s next grows or is freed. Copy it with substring when it must outlive the builder.
 *  @param s the builder to view, borrowed
 *  @return a borrowed string view of s's buffer, valid until s grows or is freed */
export func sb_cstr(s: *StringBuilder) -> string {
    return cstr((*s).data)
}

/** Frees s's backing buffer and nothing else. After this the buffer is stale and must not
 *  be read; the caller frees the StringBuilder allocation itself when it was heap
 *  allocated.
 *  @param s the builder whose buffer to release, borrowed */
export func sb_free(s: *StringBuilder) -> void {
    free((*s).data)
}

/** Concatenates two strings into a fresh heap builder. Both arguments are borrowed.
 *  @param a the first string
 *  @param b the second string
 *  @return a fresh heap builder holding a followed by b, which the caller frees with
 *  sb_free and then free */
export func concat(a: string, b: string) -> *StringBuilder {
    s: *StringBuilder = alloc(sb_new())
    sb_push(s, a)
    sb_push(s, b)
    return s
}

/** The byte offset of the first occurrence of needle in s, or -1 when absent. The empty
 *  needle matches at offset 0, the convention strstr follows. Both are borrowed.
 *  @param s the string to search
 *  @param needle the substring to find
 *  @return the byte offset of the first match, or -1 when needle is not present */
export func str_find(s: string, needle: string) -> int64 {
    n: int64 = str_len(s)
    m: int64 = str_len(needle)
    if m == 0 {
        return 0
    }
    if m > n {
        return -1
    }
    mut i: int64 = 0
    while i <= n - m {
        mut j: int64 = 0
        mut hit: bool = true
        while j < m && hit {
            if s[i + j] != needle[j] {
                hit = false
            }
            j = j + 1
        }
        if hit {
            return i
        }
        i = i + 1
    }
    return -1
}

/** Whether needle occurs anywhere in s. Both are borrowed.
 *  @param s the string to search
 *  @param needle the substring to look for
 *  @return true when needle occurs in s */
export func str_contains(s: string, needle: string) -> bool {
    return str_find(s, needle) >= 0
}

/** Copies a char slice into a fresh heap string. It is the bridge from stack text back to
 *  the dynamic string world: a char array slices to char[] and lands here. cs is borrowed
 *  and its bytes are copied.
 *  @param cs the char slice to copy
 *  @return a fresh heap string of the slice's bytes the caller owns and frees */
export func str_from_chars(cs: char[]) -> string {
    s: *StringBuilder = alloc(sb_new())
    mut i: int64 = 0
    while i < cs.len {
        sb_push_char(s, cs[i])
        i = i + 1
    }
    out: string = substring(sb_cstr(s), 0, sb_size(s))
    sb_free(s)
    free(s)
    return out
}

/** Whether s ends with suffix, comparing NUL terminated bytes, the tail mirror of
 *  starts_with. The empty suffix is a suffix of every string. A suffix longer than s fails
 *  without reading past either terminator. Both are borrowed.
 *  @param s the string to test
 *  @param suffix the suffix to look for
 *  @return true when s ends with suffix */
export func ends_with(s: string, suffix: string) -> bool {
    n: int64 = str_len(s)
    m: int64 = str_len(suffix)
    if m > n {
        return false
    }
    mut i: int64 = 0
    while i < m {
        if s[n - m + i] != suffix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/** The byte offset of the last occurrence of needle in s, or -1 when absent. The empty
 *  needle matches at the end, str_len(s), the tail mirror of str_find returning 0 for the
 *  empty needle at the start. Both are borrowed.
 *  @param s the string to search
 *  @param needle the substring to find
 *  @return the byte offset of the last match, or -1 when needle is not present */
export func str_rfind(s: string, needle: string) -> int64 {
    n: int64 = str_len(s)
    m: int64 = str_len(needle)
    if m == 0 {
        return n
    }
    if m > n {
        return -1
    }
    mut i: int64 = n - m
    while i >= 0 {
        mut j: int64 = 0
        mut hit: bool = true
        while j < m && hit {
            if s[i + j] != needle[j] {
                hit = false
            }
            j = j + 1
        }
        if hit {
            return i
        }
        i = i - 1
    }
    return -1
}

/** Compares a and b as sequences of unsigned bytes, lexicographically. Bytes read
 *  unsigned, so a byte of a multibyte UTF-8 sequence orders above ASCII rather than below
 *  it, and a shorter string that is a prefix of a longer one sorts first at the NUL. It is
 *  shaped as an int32 comparator to pass straight to vec_sort. Both are borrowed.
 *  @param a the first string
 *  @param b the second string
 *  @return negative when a sorts before b, zero when the two are equal, positive when a
 *  sorts after
 *  @example
 *  vec_sort(names, str_cmp) */
export func str_cmp(a: string, b: string) -> int32 {
    mut i: int64 = 0
    mut result: int32 = 0
    mut done: bool = false
    while !done {
        ca: int64 = int64(a[i])
        cb: int64 = int64(b[i])
        if ca != cb {
            if ca < cb {
                result = -1
            } else {
                result = 1
            }
            done = true
        } else {
            if ca == 0 {
                done = true
            }
        }
        i = i + 1
    }
    return result
}

// Whether c is one of the four ASCII whitespace bytes trim recognizes: space,
// horizontal tab, carriage return, and line feed. Not exported; the trim family's
// own predicate.
func is_ascii_ws(c: char) -> bool {
    if c == 32 {
        return true
    }
    if c == 9 {
        return true
    }
    if c == 13 {
        return true
    }
    if c == 10 {
        return true
    }
    return false
}

/** Strips ASCII whitespace, space, tab, carriage return, and line feed, from the front of
 *  s. The result is always a fresh string, a copy of s when nothing strips. s is borrowed.
 *  @param s the string to trim
 *  @return the front trimmed text as a fresh heap string the caller owns and frees */
export func trim_start(s: string) -> string {
    n: int64 = str_len(s)
    mut lo: int64 = 0
    while lo < n && is_ascii_ws(s[lo]) {
        lo = lo + 1
    }
    return substring(s, lo, n)
}

/** Strips ASCII whitespace, space, tab, carriage return, and line feed, from the end of
 *  s. The result is always a fresh string, a copy of s when nothing strips. s is borrowed.
 *  @param s the string to trim
 *  @return the end trimmed text as a fresh heap string the caller owns and frees */
export func trim_end(s: string) -> string {
    n: int64 = str_len(s)
    mut hi: int64 = n
    while hi > 0 && is_ascii_ws(s[hi - 1]) {
        hi = hi - 1
    }
    return substring(s, 0, hi)
}

/** Strips ASCII whitespace, space, tab, carriage return, and line feed, from both ends of
 *  s. An all whitespace string trims to the empty string, still a fresh allocation. s is
 *  borrowed.
 *  @param s the string to trim
 *  @return the trimmed text as a fresh heap string the caller owns and frees */
export func trim(s: string) -> string {
    n: int64 = str_len(s)
    mut lo: int64 = 0
    while lo < n && is_ascii_ws(s[lo]) {
        lo = lo + 1
    }
    mut hi: int64 = n
    while hi > lo && is_ascii_ws(s[hi - 1]) {
        hi = hi - 1
    }
    return substring(s, lo, hi)
}

/** Splits s on every occurrence of sep, returning the pieces in order. Adjacent separators
 *  yield an empty string between them, and a leading or trailing separator yields a leading
 *  or trailing empty element. An empty sep is not scanned for, since it would match between
 *  every byte, so the result is then a single element vector holding a copy of s. Both
 *  arguments are borrowed.
 *  @param s the string to split
 *  @param sep the separator to split on
 *  @return a fresh heap vector of fresh heap strings, the vector and every element owned by
 *  the caller; free each element, then vec_free and free the vector
 *  @example
 *  parts := str_split("a,b,c", ",")
 *  while vec_len(parts) > 0 {
 *      free(vec_take(parts, vec_len(parts) - 1))
 *  }
 *  vec_free(parts)
 *  free(parts) */
export func str_split(s: string, sep: string) -> *Vector<string> {
    v: *Vector<string> = alloc(vec_new())
    m: int64 = str_len(sep)
    n: int64 = str_len(s)
    if m == 0 {
        vec_push(v, substring(s, 0, n))
        return v
    }
    mut start: int64 = 0
    mut i: int64 = 0
    while i <= n - m {
        mut j: int64 = 0
        mut hit: bool = true
        while j < m && hit {
            if s[i + j] != sep[j] {
                hit = false
            }
            j = j + 1
        }
        if hit {
            vec_push(v, substring(s, start, i))
            i = i + m
            start = i
        } else {
            i = i + 1
        }
    }
    vec_push(v, substring(s, start, n))
    return v
}

/** Concatenates the elements of parts with sep between each adjacent pair. An empty vector
 *  yields the empty string, and a single element yields a copy of that element with no
 *  separator. The elements are read, never taken, so parts and its strings stay the
 *  caller's to free. parts and sep are borrowed.
 *  @param parts the strings to join, borrowed and left unchanged
 *  @param sep the separator placed between adjacent elements
 *  @return the joined text as a fresh heap string the caller owns and frees */
export func str_join(parts: *Vector<string>, sep: string) -> string {
    sb: *StringBuilder = alloc(sb_new())
    n: int64 = vec_len(parts)
    mut i: int64 = 0
    while i < n {
        if i > 0 {
            sb_push(sb, sep)
        }
        sb_push(sb, vec_get(parts, i))
        i = i + 1
    }
    out: string = substring(sb_cstr(sb), 0, sb_size(sb))
    sb_free(sb)
    free(sb)
    return out
}

/** Replaces every non overlapping occurrence of old in s with new_s, scanning left to
 *  right. After a match the scan resumes past the whole matched run, so replacements never
 *  overlap. An empty old is not scanned for, since it would match between every byte, so
 *  the result is then a fresh copy of s; a missing old also yields a fresh copy of s. All
 *  three arguments are borrowed.
 *  @param s the string to scan
 *  @param old the substring to replace
 *  @param new_s the replacement text
 *  @return the replaced text as a fresh heap string the caller owns and frees */
export func replace_all(s: string, old: string, new_s: string) -> string {
    m: int64 = str_len(old)
    n: int64 = str_len(s)
    if m == 0 {
        return substring(s, 0, n)
    }
    sb: *StringBuilder = alloc(sb_new())
    mut i: int64 = 0
    while i < n {
        mut hit: bool = false
        if i <= n - m {
            mut j: int64 = 0
            hit = true
            while j < m && hit {
                if s[i + j] != old[j] {
                    hit = false
                }
                j = j + 1
            }
        }
        if hit {
            sb_push(sb, new_s)
            i = i + m
        } else {
            sb_push_char(sb, s[i])
            i = i + 1
        }
    }
    out: string = substring(sb_cstr(sb), 0, sb_size(sb))
    sb_free(sb)
    free(sb)
    return out
}

/** s concatenated n times. A count of zero or less yields the empty string, still a fresh
 *  allocation. s is borrowed.
 *  @param s the string to repeat
 *  @param n the repeat count; zero or less yields the empty string
 *  @return the repeated text as a fresh heap string the caller owns and frees */
export func repeat(s: string, n: int64) -> string {
    sb: *StringBuilder = alloc(sb_new())
    mut i: int64 = 0
    while i < n {
        sb_push(sb, s)
        i = i + 1
    }
    out: string = substring(sb_cstr(sb), 0, sb_size(sb))
    sb_free(sb)
    free(sb)
    return out
}

/** Uppercases the ASCII letters a to z of s, leaving every other byte unchanged. Only
 *  ASCII folds: a byte of a multibyte UTF-8 sequence is 128 or above and passes through
 *  untouched, so non ASCII text copies verbatim. This is ASCII only on purpose; a full
 *  Unicode case fold is out of scope here. s is borrowed.
 *  @param s the string to uppercase
 *  @return the uppercased text as a fresh heap string the caller owns and frees */
export func to_upper(s: string) -> string {
    n: int64 = str_len(s)
    d: *raw char = alloc_bytes(n + 1)
    mut i: int64 = 0
    while i < n {
        c: int64 = int64(s[i])
        if c >= 97 && c <= 122 {
            d[i] = c - 32
        } else {
            d[i] = s[i]
        }
        i = i + 1
    }
    d[n] = 0
    return cstr(d)
}

/** Lowercases the ASCII letters A to Z of s, leaving every other byte unchanged. Only
 *  ASCII folds: a byte of a multibyte UTF-8 sequence is 128 or above and passes through
 *  untouched, so non ASCII text copies verbatim. This is ASCII only on purpose; a full
 *  Unicode case fold is out of scope here. s is borrowed.
 *  @param s the string to lowercase
 *  @return the lowercased text as a fresh heap string the caller owns and frees */
export func to_lower(s: string) -> string {
    n: int64 = str_len(s)
    d: *raw char = alloc_bytes(n + 1)
    mut i: int64 = 0
    while i < n {
        c: int64 = int64(s[i])
        if c >= 65 && c <= 90 {
            d[i] = c + 32
        } else {
            d[i] = s[i]
        }
        i = i + 1
    }
    d[n] = 0
    return cstr(d)
}
