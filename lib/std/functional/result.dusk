/** std.functional.result: Result<T, E>, an Ok value or an Err. Ok carries the
 *  success value, Err carries the failure. The monad below fixes E to string,
 *  the common case, since a generic E cannot flow through `do` inference; a
 *  caller needing a different error type works with the plain constructors and
 *  helpers below instead of `do Result { ... }`. */

@paradigm functional

/** A success or a failure: Ok carries a T, Err carries an E. The mapping and
 *  chaining helpers act on the Ok value and pass an Err through untouched. */
export enum Result<T, E> {
    Ok(v: T),
    Err(e: E),
}

// The Result monad, string errors only. `do Result { ... }` threads Ok values
// and short-circuits on the first Err.
monad Result {
    /** Runs the continuation on an Ok value; an Err passes straight through.
     *  @param m the source Result
     *  @param f the continuation, run on an Ok value to yield the next Result
     *  @return f(a) when m is Ok, else the original Err */
    export func bind<A, B>(m: Result<A, string>, f: (A) -> Result<B, string>) -> Result<B, string> {
        match m {
            Ok(a) => return f(a),
            Err(e) => return Result.Err(e),
        }
    }
    /** Lifts a plain value into Ok.
     *  @param x the value to lift
     *  @return Ok(x) */
    export func unit<A>(x: A) -> Result<A, string> {
        return Result.Ok(x)
    }
}

/** Lifts a plain value into Ok. Named surface unit for use outside `do`.
 *  @param v the success value
 *  @return Ok(v) */
export func result_ok<T>(v: T) -> Result<T, string> {
    return Result.Ok(v)
}

/** Lifts a message into Err. msg does not carry T, so annotate the binding, or
 *  call this where the surrounding context (a return, a declared parameter)
 *  pins T, the same rule any uninferable enum constructor already follows.
 *  @param msg the failure message
 *  @return Err(msg) with T pinned by the surrounding context */
export func result_err<T>(msg: string) -> Result<T, string> {
    return Result.Err(msg)
}

/** Bridges a (value, error) pair, the shape a fallible call returns, into a
 *  Result: Ok(v) when e carries nothing, Err(e.toString()) when it does. The e
 *  parameter is declared error, so handing a bound error here discharges the
 *  caller's must-handle obligation the same way a bare return or a sink call
 *  does.
 *  @param v the value returned beside the error
 *  @param e the error to inspect, discharged here
 *  @return Ok(v) when e carries nothing, else Err of its message
 *  @example
 *  line, e := read_line()
 *  r := result_from(line, e)
 *  text := result_unwrap_or(r, "") */
export func result_from<T>(v: T, e: error) -> Result<T, string> {
    if e.exists() {
        return Result.Err(e.toString())
    }
    return Result.Ok(v)
}

/** Whether r is the Ok case.
 *  @param r the value to test
 *  @return true when r is Ok, false when it is Err */
export func is_ok<T, E>(r: Result<T, E>) -> bool {
    match r {
        Ok(v) => return true,
        Err(e) => return false,
    }
}

/** Whether r is the Err case.
 *  @param r the value to test
 *  @return true when r is Err, false when it is Ok */
export func is_err<T, E>(r: Result<T, E>) -> bool {
    match r {
        Ok(v) => return false,
        Err(e) => return true,
    }
}

/** The Ok value, or fallback when r is Err.
 *  @param r the value to inspect
 *  @param fallback the T returned when r is Err
 *  @return r's Ok value, or fallback */
export func result_unwrap_or<T, E>(r: Result<T, E>, fallback: T) -> T {
    match r {
        Ok(v) => return v,
        Err(e) => return fallback,
    }
}

/** Maps f over the Ok value, passing an Err through unchanged.
 *  @param r the source Result
 *  @param f applied to an Ok value to produce the new value
 *  @return Ok(f(v)) when r is Ok, else the original Err */
export func result_map<T, E, U>(r: Result<T, E>, f: (T) -> U) -> Result<U, E> {
    match r {
        Ok(v) => return Result.Ok(f(v)),
        Err(e) => return Result.Err(e),
    }
}

/** Maps f over the Err value, passing an Ok through unchanged.
 *  @param r the source Result
 *  @param f applied to an Err value to produce the new error
 *  @return Err(f(e)) when r is Err, else the original Ok */
export func result_map_err<T, E, F>(r: Result<T, E>, f: (E) -> F) -> Result<T, F> {
    match r {
        Ok(v) => return Result.Ok(v),
        Err(e) => return Result.Err(f(e)),
    }
}

/** Chains f, which itself returns a Result, onto the Ok value; an Err passes
 *  through. The monadic bind under a plain name.
 *  @param r the source Result
 *  @param f applied to an Ok value to produce the next Result
 *  @return f(v) when r is Ok, else the original Err */
export func result_and_then<T, E, U>(r: Result<T, E>, f: (T) -> Result<U, E>) -> Result<U, E> {
    match r {
        Ok(v) => return f(v),
        Err(e) => return Result.Err(e),
    }
}

/** Recovers from an Err by running f, which returns a Result; an Ok passes
 *  through unchanged.
 *  @param r the source Result
 *  @param f applied to an Err value to produce a replacement Result
 *  @return the original Ok, else f(e) */
export func result_or_else<T, E, F>(r: Result<T, E>, f: (E) -> Result<T, F>) -> Result<T, F> {
    match r {
        Ok(v) => return Result.Ok(v),
        Err(e) => return f(e),
    }
}
