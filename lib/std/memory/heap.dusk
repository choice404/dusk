/** std.memory.heap: gauges for the generational heap, the heap every alloc, string,
 *  and container draws from when no allocator is named with `using`. The counters
 *  are kept by the runtime under the lock it already takes, so reading them is
 *  cheap and a program can watch its own live set: take a reading, run the code
 *  under suspicion, take another, and a delta that never returns to zero is a
 *  leak. The collected heap has its own gauges in std.memory.collector, and the
 *  Debug allocator counts its own blocks; neither is counted here. */

@paradigm procedural

foreign "C" {
    func cool_heap_live_blocks() -> int64
    func cool_heap_live_bytes() -> int64
    func cool_heap_held_bytes() -> int64
    func cool_heap_report() -> void
}

/** The number of generational blocks allocated and not yet freed, the program's
 *  own and the runtime's records of its futures and threads alike. A gauge.
 *  @return the count of live blocks
 *  @example
 *  before := heap_live_blocks()
 *  s := "abc" + "def"
 *  println(heap_live_blocks() - before)
 *  free(s) */
export func heap_live_blocks() -> int64 {
    return cool_heap_live_blocks()
}

/** The bytes the live blocks asked for, summed. A string counts its terminator, so
 *  "abc" + "def" is 7 bytes. A gauge.
 *  @return the requested bytes across the live blocks */
export func heap_live_bytes() -> int64 {
    return cool_heap_live_bytes()
}

/** The capacity of every block the heap has taken from the C allocator and still
 *  holds, live or freed and kept for reuse. A freed block stays with the heap, so
 *  this never shrinks; it is the number resident memory follows, and it is always
 *  at least heap_live_bytes. Under --sanitize=address the heap hands a freed block
 *  back to the C allocator, so there it drops with every free.
 *  @return the bytes the heap holds */
export func heap_held_bytes() -> int64 {
    return cool_heap_held_bytes()
}

/** Prints the live block and byte totals to stderr, after flushing stdout. The
 *  totals are recomputed from the heap itself and checked against the counters, so
 *  a disagreement prints a drift line. In a --heap-sites build the report also
 *  groups the live blocks by the line of the program that allocated each and the
 *  calls that led there; without the flag it says how to get that. */
export func heap_report() -> void {
    cool_heap_report()
}
