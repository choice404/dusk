/** std.vector: a growable array, generic over its element type, backed by a heap buffer
 *  that doubles on demand. Pass the vector by pointer so growth persists across a push.
 *  Element access is bounds checked and the raw buffer never escapes. vec_sort takes a
 *  closure comparator and sorts in place with a stable, deterministic merge; vec_contains
 *  and vec_index_of search by ==, legal only for a T that == itself accepts, a scalar or
 *  a string, never a pointer. A vector stores its elements by value: for a managed pointer
 *  element the vector holds the pointer and the caller owns the pointed to object, so
 *  vec_free releases the backing buffer only and never the elements. */

@paradigm procedural

foreign "C" {
    func abort() -> void
}

func vec_bounds_fault() -> void {
    printerr("fatal: vector index out of bounds")
    abort()
}

/** A growable array as a heap buffer, a length, and a capacity. data points at the
 *  backing buffer, len is the number of live elements, and cap is how many the buffer
 *  holds before it must double. Build one with vec_new and pass it by pointer so a push
 *  that grows the buffer is seen by every holder; the vector owns data and vec_free
 *  releases it. */
export struct Vector<T> {
    data: *raw T,
    len: int64,
    cap: int64,
}

/** A fresh empty vector with no backing buffer allocated yet; the first vec_push grows
 *  it. Build one on the heap with alloc(vec_new()) and pass it by pointer so pushes
 *  persist.
 *  @return an empty vector of length 0
 *  @example
 *  v: *Vector<int64> = alloc(vec_new())
 *  vec_push(v, 10)
 *  vec_push(v, 20)
 *  vec_free(v)
 *  free(v) */
export func vec_new<T>() -> Vector<T> {
    return Vector { data: alloc_bytes(0), len: 0, cap: 0 }
}

/** Appends x to the end of v, doubling the backing buffer first when it is full, four
 *  slots the first time it grows. x is stored by value; for a managed pointer element the
 *  vector takes the pointer and the caller still owns the object it points at.
 *  @param v the vector to append to, borrowed and grown in place
 *  @param x the element to append */
export func vec_push<T>(v: *Vector<T>, x: T) -> void {
    if (*v).len == (*v).cap {
        mut nc: int64 = (*v).cap * 2
        if nc == 0 {
            nc = 4
        }
        nd: *raw T = alloc_bytes(nc * sizeof(T))
        mut i: int64 = 0
        while i < (*v).len {
            nd[i] = (*v).data[i]
            i = i + 1
        }
        free((*v).data)
        (*v).data = nd
        (*v).cap = nc
    }
    (*v).data[(*v).len] = x
    (*v).len = (*v).len + 1
}

/** The element at index i, copied out by value. i is bounds checked: a negative index or
 *  one at or past the length prints "fatal: vector index out of bounds" and aborts. For a
 *  managed pointer element the copy is the same pointer the vector holds, an alias, not a
 *  new object, so freeing it while the vector still holds it is a double free.
 *  @param v the vector to read, borrowed
 *  @param i the index to read, in [0, vec_len(v))
 *  @return the element at i */
export func vec_get<T>(v: *Vector<T>, i: int64) -> T {
    if i < 0 {
        vec_bounds_fault()
    }
    if i >= (*v).len {
        vec_bounds_fault()
    }
    return (*v).data[i]
}

/** Overwrites the element at index i with x, in place. i is bounds checked exactly as
 *  vec_get: a negative index or one at or past the length prints "fatal: vector index out
 *  of bounds" and aborts. The prior element is overwritten in place and not freed, so a
 *  managed pointer element the caller means to replace must be freed before this call or
 *  its object leaks.
 *  @param v the vector to write, borrowed and mutated in place
 *  @param i the index to write, in [0, vec_len(v))
 *  @param x the replacement element */
export func vec_set<T>(v: *Vector<T>, i: int64, x: T) -> void {
    if i < 0 {
        vec_bounds_fault()
    }
    if i >= (*v).len {
        vec_bounds_fault()
    }
    (*v).data[i] = x
}

/** Drops the last element of v by shrinking its length by one, leaving the capacity and
 *  buffer as they are. The dropped element is not returned or freed, so a managed pointer
 *  element must be read with vec_get or removed with vec_take before this call if its
 *  object is to be freed. An empty vector is left unchanged, no fault.
 *  @param v the vector to shrink, borrowed and mutated in place */
export func vec_pop<T>(v: *Vector<T>) -> void {
    if (*v).len > 0 {
        (*v).len = (*v).len - 1
    }
}

/** Removes the element at index i and hands it back to the caller as its own value. i is
 *  bounds checked exactly as vec_get: a negative index or one at or past the length prints
 *  "fatal: vector index out of bounds" and aborts. The survivors keep their order, so
 *  every element after i shifts down one slot, a plain copy loop; taking the last index
 *  shifts nothing. The head declares owning, so the checker treats the result as the
 *  caller's own value and exempts it from the container alias condemnation: a direct free
 *  of the take, or a free of an owner binding of it, is legal, which is how a managed
 *  pointer element leaves the vector without a leak.
 *  @param v the vector to remove from, borrowed and mutated in place
 *  @param i the index to remove, in [0, vec_len(v))
 *  @return the removed element, now owned by the caller
 *  @example
 *  while vec_len(v) > 0 {
 *      x := vec_take(v, vec_len(v) - 1)
 *      free(x)
 *  } */
export owning func vec_take<T>(v: *Vector<T>, i: int64) -> T {
    if i < 0 {
        vec_bounds_fault()
    }
    if i >= (*v).len {
        vec_bounds_fault()
    }
    out: T = (*v).data[i]
    mut j: int64 = i
    while j + 1 < (*v).len {
        (*v).data[j] = (*v).data[j + 1]
        j = j + 1
    }
    (*v).len = (*v).len - 1
    return out
}

/** The number of live elements in v, its length, not its capacity.
 *  @param v the vector to measure, borrowed
 *  @return the element count */
export func vec_len<T>(v: *Vector<T>) -> int64 {
    return (*v).len
}

/** Frees v's backing buffer and nothing else. The elements are stored by value and are
 *  never freed here, so for a managed pointer element the caller drains and frees each
 *  element first, for example with vec_take in a loop, or every element object leaks.
 *  After this the vector holds a stale buffer pointer and must not be read again; the
 *  caller frees the Vector allocation itself when it was heap allocated.
 *  @param v the vector whose buffer to release, borrowed */
export func vec_free<T>(v: *Vector<T>) -> void {
    free((*v).data)
}

// Merges the two already sorted runs [lo, mid) and [mid, hi) of v's backing
// data into buf, a caller supplied scratch buffer at least as long as v.
// Ties favor the left run, cmp returning 0, which is what makes the bottom
// up passes in vec_sort stable: an element from the earlier run only ever
// yields to one from the later run on a strict cmp > 0, so two equal keys
// never swap the order they entered a run in. Not exported; vec_sort's own
// helper.
func vec_sort_merge_run<T>(v: *Vector<T>, buf: *raw T, lo: int64, mid: int64, hi: int64, cmp: (T, T) -> int32) -> void {
    mut a: int64 = lo
    mut b: int64 = mid
    mut k: int64 = lo
    while a < mid && b < hi {
        x: T = (*v).data[a]
        y: T = (*v).data[b]
        c: int32 = cmp(x, y)
        if c <= 0 {
            buf[k] = x
            a = a + 1
        } else {
            buf[k] = y
            b = b + 1
        }
        k = k + 1
    }
    while a < mid {
        buf[k] = (*v).data[a]
        a = a + 1
        k = k + 1
    }
    while b < hi {
        buf[k] = (*v).data[b]
        b = b + 1
        k = k + 1
    }
}

/** Sorts v in place with cmp, an ordering closure returning negative when its first
 *  argument sorts before its second, zero when the two are equal, and positive when the
 *  first sorts after. The sort is a bottom up merge sort, stable so equal elements keep
 *  the relative order they started in, and deterministic so two calls over the same data
 *  and cmp always produce the same order. A vector of fewer than two elements returns at
 *  once with cmp uncalled. The elements are reordered in place, not copied out, so
 *  ownership of every element is unchanged.
 *  @param v the vector to sort, borrowed and reordered in place
 *  @param cmp the ordering closure, negative for before, zero for equal, positive for
 *  after
 *  @example
 *  vec_sort(v, lambda (a: int64, b: int64) -> int32 { return int32(a - b) }) */
export func vec_sort<T>(v: *Vector<T>, cmp: (T, T) -> int32) -> void {
    n: int64 = (*v).len
    if n < 2 {
        return
    }
    buf: *raw T = alloc_bytes(n * sizeof(T))
    mut width: int64 = 1
    while width < n {
        mut i: int64 = 0
        while i < n {
            lo: int64 = i
            mut mid: int64 = i + width
            if mid > n {
                mid = n
            }
            mut hi: int64 = i + 2 * width
            if hi > n {
                hi = n
            }
            vec_sort_merge_run(v, buf, lo, mid, hi, cmp)
            i = i + 2 * width
        }
        mut k: int64 = 0
        while k < n {
            (*v).data[k] = buf[k]
            k = k + 1
        }
        width = width * 2
    }
    free(buf)
}

/** Whether x appears anywhere in v, tested by ==. Only legal for a T that == itself
 *  accepts, a scalar or a string, per dusk's own rule that pointers do not compare,
 *  compare the values they point to instead; a Vector<T> of a pointer typed T rejects
 *  vec_contains at the ground types only pass the same way any other illegal == does. v
 *  and x are borrowed.
 *  @param v the vector to search, borrowed
 *  @param x the value to look for
 *  @return true when some element of v equals x */
export func vec_contains<T>(v: *Vector<T>, x: T) -> bool {
    mut i: int64 = 0
    n: int64 = (*v).len
    mut found: bool = false
    while i < n {
        if (*v).data[i] == x {
            found = true
        }
        i = i + 1
    }
    return found
}

/** The index of the first element of v equal to x by ==, or -1 when none is. It carries
 *  the same == restriction on T as vec_contains: only a scalar or a string T is legal,
 *  never a pointer. v and x are borrowed.
 *  @param v the vector to search, borrowed
 *  @param x the value to look for
 *  @return the index of the first match, or -1 when x is not present */
export func vec_index_of<T>(v: *Vector<T>, x: T) -> int64 {
    mut i: int64 = 0
    n: int64 = (*v).len
    while i < n {
        if (*v).data[i] == x {
            return i
        }
        i = i + 1
    }
    return -1
}

/** Applies f once to each element of v, in index order, and collects the results into a
 *  fresh heap vector the caller owns. The source vector and its elements are not mutated
 *  or freed. Result ownership is exactly what f returned: when f allocates owning
 *  pointers, drain those elements, for example with vec_take in a loop, before vec_free
 *  and free of the outer vector; plain values and borrowed pointers need no handling
 *  beyond freeing the outer vector.
 *  @param v the source vector, borrowed and left unchanged
 *  @param f the mapping closure, applied once per element
 *  @return a fresh caller owned vector of f's results, in index order
 *  @example
 *  texts := vec_map(nums, lambda (x: int64) -> string { return int_to_string(x) }) */
export func vec_map<T, U>(v: *Vector<T>, f: (T) -> U) -> *Vector<U> {
    out: *Vector<U> = alloc(vec_new())
    mut i: int64 = 0
    n: int64 = (*v).len
    while i < n {
        vec_push(out, f((*v).data[i]))
        i = i + 1
    }
    return out
}

/** Calls p once on each element of v, in index order, and copies every element for which
 *  p returns true into a fresh heap vector the caller owns. The source vector is not
 *  mutated or freed and the selected elements are copied by value. When T is a managed
 *  pointer type the new vector holds the same pointers as the source, so both vectors
 *  alias the pointed to objects: freeing an element reachable through both is a double
 *  free, which dusk's ownership checker does not prevent across vec_filter, and the
 *  runtime generational free check is the backstop that faults a stale read.
 *  @param v the source vector, borrowed and left unchanged
 *  @param p the predicate closure, applied once per element
 *  @return a fresh caller owned vector of the elements p accepted, in index order */
export func vec_filter<T>(v: *Vector<T>, p: (T) -> bool) -> *Vector<T> {
    out: *Vector<T> = alloc(vec_new())
    mut i: int64 = 0
    n: int64 = (*v).len
    while i < n {
        x: T = (*v).data[i]
        if p(x) {
            vec_push(out, x)
        }
        i = i + 1
    }
    return out
}

/** Reduces v to a single value by folding f left to right over its elements in index
 *  order, starting from init. f is called exactly once per element, its first argument
 *  the accumulator so far and its second the current element, and its result becomes the
 *  next accumulator; the final accumulator is returned. An empty vector returns init
 *  unchanged with f uncalled. The source vector is not mutated or freed. The accumulator
 *  type A is independent of the element type T, so a vector of one type folds into a
 *  value of another, a running sum, a joined string, a built structure.
 *  @param v the source vector, borrowed and left unchanged
 *  @param init the starting accumulator, returned as is for an empty vector
 *  @param f the folding closure, taking the accumulator and an element and returning the
 *  next accumulator
 *  @return the accumulator after folding every element
 *  @example
 *  total := vec_fold(nums, 0, lambda (acc: int64, x: int64) -> int64 { return acc + x }) */
export func vec_fold<T, A>(v: *Vector<T>, init: A, f: (A, T) -> A) -> A {
    mut acc: A = init
    mut i: int64 = 0
    n: int64 = (*v).len
    while i < n {
        acc = f(acc, (*v).data[i])
        i = i + 1
    }
    return acc
}
