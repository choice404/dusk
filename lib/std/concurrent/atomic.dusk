/** std.concurrent.atomic: a sequentially consistent int64 atomic over a heap
 *  word. The only sanctioned way to share a mutable counter between threads
 *  before mutexes land. Handles copy freely; every copy names the same word. */

@paradigm procedural

foreign "C" {
    func cool_atomic_load(p: *raw int64) -> int64
    func cool_atomic_store(p: *raw int64, v: int64) -> void
    func cool_atomic_add(p: *raw int64, d: int64) -> int64
    func cool_atomic_cas(p: *raw int64, expect: int64, desired: int64) -> int64
}

/** An atomic counter, a one word handle over a heap int64. The handle copies by
 *  value and every copy names the same word, so a spawned thread that receives a
 *  copy increments the shared counter. */
export struct AtomicInt {
    p: *raw int64,
}

/** Allocates an atomic counter initialized to v. Exhaustion is fatal, the
 *  allocator's contract; free it with atomic_free once no thread touches it.
 *  @param v the initial value
 *  @return a counter every copy of which names the same word
 *  @example
 *  counter := atomic_new(0)
 *  worker := spawn increment_many(counter)
 *  atomic_add(counter, 1)
 *  join worker
 *  total := atomic_load(counter)
 *  atomic_free(counter) */
export func atomic_new(v: int64) -> AtomicInt {
    b: *raw int64 = alloc_bytes(8)
    b[0] = v
    return AtomicInt { p: b }
}

/** Reads the current value.
 *  @param a the counter to read
 *  @return the value observed at this point */
export func atomic_load(a: AtomicInt) -> int64 {
    return cool_atomic_load(a.p)
}

/** Overwrites the value.
 *  @param a the counter to write
 *  @param v the new value */
export func atomic_store(a: AtomicInt, v: int64) -> void {
    cool_atomic_store(a.p, v)
}

/** Adds d and returns the new value.
 *  @param a the counter to add into
 *  @param d the amount to add, which may be negative
 *  @return the value after the addition */
export func atomic_add(a: AtomicInt, d: int64) -> int64 {
    return cool_atomic_add(a.p, d)
}

/** Compare and swap. True when the swap happened.
 *  @param a the counter to swap
 *  @param expect the value the swap requires the counter to currently hold
 *  @param desired the value written when the counter holds expect
 *  @return true when the counter held expect and now holds desired */
export func atomic_cas(a: AtomicInt, expect: int64, desired: int64) -> bool {
    return cool_atomic_cas(a.p, expect, desired) == 1
}

/** Frees the counter's word. Freeing while any thread still touches it is fatal.
 *  @param a the counter to free */
export func atomic_free(a: AtomicInt) -> void {
    free(a.p)
}
