/** std.os: a thin wrapper over the process environment, the command shell, and errno.
 *  run shells a command out through the C library system, env reads an environment
 *  variable, quote wraps an argument in single quotes so a POSIX shell reads it as one
 *  literal word, and os_errno with errstr read back the last foreign call's failure.
 *  Every string argument crosses the C boundary through std.string's cbuf, a fresh NUL
 *  terminated raw byte buffer, since a string view is typed apart from a raw pointer and
 *  the C shims cannot take it directly. */

@import std.string

foreign "C" {
    func system(cmd: *void) -> int64
    func cool_env(name: *void) -> *raw char
    func cool_errno() -> int64
    func strerror(errnum: int32) -> *raw char
}

/** Runs cmd through the C library system, which hands it to /bin/sh -c, and returns the
 *  child's exit code. system returns the raw wait status word in the low 32 bits of its
 *  result: the low 7 bits hold the terminating signal, zero for a normal exit, and bits
 *  8 through 15 hold the exit code. A child killed by a signal reports 128 plus that
 *  signal, the shell convention, so a process the OS kills is never mistaken for a clean
 *  exit; a normal exit reports the status shifted down out of the signal byte. cmd is
 *  copied across the C boundary and the copy is freed here; the argument itself is
 *  borrowed. This runs a shell, so a caller that splices untrusted text into cmd must
 *  pass it through quote first.
 *  @param cmd the shell command line to run
 *  @return the child exit code on a normal exit, or 128 plus the signal number when a
 *  signal killed it
 *  @example
 *  code: int64 = run("ls -1 " + quote(dir))
 *  if code != 0 {
 *      printerr("ls failed")
 *  } */
export func run(cmd: string) -> int64 {
    buf: *raw char = cbuf(cmd)
    status: int64 = system(buf)
    free(buf)
    term: int64 = status & 127
    if term != 0 {
        return 128 + term
    }
    return (status & 65280) / 256
}

/** Reads the value of the environment variable name. An unset variable reads as the
 *  empty string, never a fault, so a caller tests the result with str_len or str_eq
 *  rather than a null check. name is borrowed; the copy crossing the C boundary is
 *  freed here.
 *  @param name the environment variable name to read
 *  @return the variable's value as a fresh heap string the caller owns and frees, or
 *  the empty string when the variable is unset */
export func env(name: string) -> string {
    buf: *raw char = cbuf(name)
    v: string = cstr(cool_env(buf))
    free(buf)
    return v
}

/** The C library's errno, read right after a foreign call that may have set it. dusk
 *  itself never sets errno, so a value here is always whatever the most recent foreign
 *  call left behind. Read it immediately after the call in question, before anything
 *  else crosses the C boundary and overwrites it.
 *  @return the current errno value */
export func os_errno() -> int64 {
    return cool_errno()
}

/** The message strerror reports for an errno value, for instance the result of
 *  os_errno() or a literal like 2 for ENOENT. strerror hands back a pointer into its
 *  own static buffer, good only until the next strerror call on this thread, so the
 *  bytes are copied out before returning.
 *  @param code the errno value to describe
 *  @return the message as a fresh heap string the caller owns and frees */
export func errstr(code: int64) -> string {
    v: string = cstr(strerror(int32(code)))
    return substring(v, 0, str_len(v))
}

/** Wraps arg in single quotes so a POSIX shell reads it as one literal word. Every
 *  embedded single quote is written as the four byte sequence close quote, escaped
 *  quote, reopen quote, which is the portable way to carry a quote through single
 *  quoting. Use it on any text spliced into a command line handed to run, so a shell
 *  metacharacter in the argument stays inert. arg is borrowed and not freed here.
 *  @param arg the word to quote
 *  @return the quoted word as a fresh heap string the caller owns and frees, safe to
 *  splice into a run command line */
export func quote(arg: string) -> string {
    b: *StringBuilder = alloc(sb_new())
    sb_push_char(b, 39)
    mut i: int64 = 0
    while arg[i] != 0 {
        c: char = arg[i]
        if c == 39 {
            sb_push_char(b, 39)
            sb_push_char(b, 92)
            sb_push_char(b, 39)
            sb_push_char(b, 39)
        } else {
            sb_push_char(b, c)
        }
        i = i + 1
    }
    sb_push_char(b, 39)
    out: string = substring(sb_cstr(b), 0, sb_size(b))
    sb_free(b)
    free(b)
    return out
}
