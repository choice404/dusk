/** std.map: a hash map generic over both its key type K and its value type V. It is open
 *  addressing with linear probing over heap buffers that double and rehash once the table
 *  is half full, which keeps an empty slot reachable so a probe always terminates. Pass
 *  the map by pointer so inserts and growth persist. A key is any hashable type, an
 *  integer of any width, a char, a rune, or a string; keys hash through the hash builtin
 *  and compare with ==, so a string key hashes and compares by its content and a scalar
 *  key by its value. The map stores keys and values by value: a string key is the
 *  caller's pointer and must outlive the map, and a scalar key carries no lifetime at
 *  all. Iteration follows insertion order, a pure function of the insert sequence rather
 *  than the hash layout. */

@import std.string
@import std.functional.maybe
@import std.vector

foreign "C" {
    func abort() -> void
}

func map_take_fault() -> void {
    printerr("fatal: map_take of a missing key")
    abort()
}

/** A hash map as parallel slot buffers and an insertion order record. used marks which
 *  slots hold a live entry, keys and vals are the parallel key and value buffers, len is
 *  the live entry count, and cap is the slot count that doubles when the table is half
 *  full. order lists the keys in first insertion order so iteration is deterministic. The
 *  map owns every buffer and the order vector; map_free releases them all. */
export struct Map<K, V> {
    used: *raw bool,
    keys: *raw K,
    vals: *raw V,
    len: int64,
    cap: int64,
    // Keys in insertion order, so iteration is a pure function of the insert
    // sequence rather than the hash layout. A key is recorded once, at its first
    // insertion; an overwrite does not touch this and a grow rehashes the table
    // without rebuilding it. The map owns this vector and map_free releases it.
    order: *Vector<K>,
}

/** The string hash the map used before the hash builtin existed, kept so an external
 *  caller of the old name keeps working. It forwards to the hash builtin, the same
 *  polynomial rolling hash computed over a string's content. s is borrowed.
 *  @param s the string to hash
 *  @return the hash of s */
export func map_hash(s: string) -> int64 {
    return hash(s)
}

/** A fresh empty map with a small backing table already allocated. Build one on the heap
 *  with alloc(map_new()) and pass it by pointer so inserts persist.
 *  @return an empty map with no entries
 *  @example
 *  m: *Map<string, int64> = alloc(map_new())
 *  map_put(m, "a", 1)
 *  map_free(m)
 *  free(m) */
export func map_new<K, V>() -> Map<K, V> {
    cap: int64 = 8
    u: *raw bool = alloc_bytes(cap * sizeof(bool))
    mut i: int64 = 0
    while i < cap {
        u[i] = false
        i = i + 1
    }
    k: *raw K = alloc_bytes(cap * sizeof(K))
    v: *raw V = alloc_bytes(cap * sizeof(V))
    o: *Vector<K> = alloc(vec_new())
    return Map { used: u, keys: k, vals: v, len: 0, cap: cap, order: o }
}

// The slot a key probes to, folded into range. A negative hash, from overflow,
// lands back in 0 to cap minus 1.
func map_slot<K, V>(m: *Map<K, V>, k: K) -> int64 {
    mut idx: int64 = hash(k) % (*m).cap
    if idx < 0 {
        idx = idx + (*m).cap
    }
    return idx
}

// Doubles the table and reinserts every live entry. The old buffers are freed
// after the move. len resets to zero and climbs again as the entries reinsert,
// staying under the new half full threshold so no nested grow fires.
func map_grow<K, V>(m: *Map<K, V>) -> void {
    old_used: *raw bool = (*m).used
    old_keys: *raw K = (*m).keys
    old_vals: *raw V = (*m).vals
    old_cap: int64 = (*m).cap
    ncap: int64 = old_cap * 2
    nu: *raw bool = alloc_bytes(ncap * sizeof(bool))
    mut i: int64 = 0
    while i < ncap {
        nu[i] = false
        i = i + 1
    }
    (*m).used = nu
    (*m).keys = alloc_bytes(ncap * sizeof(K))
    (*m).vals = alloc_bytes(ncap * sizeof(V))
    (*m).cap = ncap
    (*m).len = 0
    mut j: int64 = 0
    while j < old_cap {
        if old_used[j] {
            // Rehash into the new table only; the insertion order record is
            // preserved across a grow, so it is not rebuilt here. The bool result
            // is discarded because a grow never records a new key.
            map_place(m, old_keys[j], old_vals[j])
        }
        j = j + 1
    }
    free(old_used)
    free(old_keys)
    free(old_vals)
}

// Probes for k and places the pair, returning true when a fresh slot was filled
// and false when an existing key was overwritten. This only touches the table:
// the caller handles growth and the insertion order record, which keeps a grow's
// rehash from ever re recording a key.
func map_place<K, V>(m: *Map<K, V>, k: K, v: V) -> bool {
    mut idx: int64 = map_slot(m, k)
    while (*m).used[idx] {
        if (*m).keys[idx] == k {
            (*m).vals[idx] = v
            return false
        }
        idx = idx + 1
        if idx == (*m).cap {
            idx = 0
        }
    }
    (*m).used[idx] = true
    (*m).keys[idx] = k
    (*m).vals[idx] = v
    (*m).len = (*m).len + 1
    return true
}

/** Inserts the pair (k, v), or overwrites the value when k is already present. A first
 *  insertion records k in the insertion order, an overwrite leaves the order untouched.
 *  The table grows and rehashes first when it is half full. k and v are stored by value:
 *  an overwritten value is dropped in place and not freed, so a managed value the caller
 *  replaces must be freed first or its object leaks, and a string key must outlive the
 *  map.
 *  @param m the map to insert into, borrowed and grown in place
 *  @param k the key, stored by value
 *  @param v the value, stored by value */
export func map_put<K, V>(m: *Map<K, V>, k: K, v: V) -> void {
    if (*m).len * 2 >= (*m).cap {
        map_grow(m)
    }
    if map_place(m, k, v) {
        vec_push((*m).order, k)
    }
}

func map_forget_order<K, V>(m: *Map<K, V>, k: K) -> void {
    o: *Vector<K> = (*m).order
    mut write: int64 = 0
    mut read: int64 = 0
    while read < vec_len(o) {
        cur: K = vec_get(o, read)
        if !(cur == k) {
            if write != read {
                vec_set(o, write, cur)
            }
            write = write + 1
        }
        read = read + 1
    }
    (*o).len = write
}

/** Removes the entry for k, returning true when it was present and false when it was not.
 *  It clears the slot, repairs the probe cluster so later lookups still find their keys,
 *  and forgets k from the insertion order. The stored value is dropped in place and not
 *  freed, so a managed value must be read out with map_take rather than map_remove when
 *  the caller needs to free its object; the key bytes are left to whoever else holds them.
 *  @param m the map to remove from, borrowed and mutated in place
 *  @param k the key to remove
 *  @return true when k was a member before this call */
export func map_remove<K, V>(m: *Map<K, V>, k: K) -> bool {
    mut idx: int64 = map_slot(m, k)
    while (*m).used[idx] {
        if (*m).keys[idx] == k {
            (*m).used[idx] = false
            (*m).len = (*m).len - 1
            map_forget_order(m, k)
            idx = idx + 1
            if idx == (*m).cap {
                idx = 0
            }
            while (*m).used[idx] {
                rk: K = (*m).keys[idx]
                rv: V = (*m).vals[idx]
                (*m).used[idx] = false
                (*m).len = (*m).len - 1
                map_place(m, rk, rv)
                idx = idx + 1
                if idx == (*m).cap {
                    idx = 0
                }
            }
            return true
        }
        idx = idx + 1
        if idx == (*m).cap {
            idx = 0
        }
    }
    return false
}

/** Removes the entry for k and hands its value back to the caller as its own. It probes
 *  for k the way map_get does; on a hit it captures the value, reuses map_remove for the
 *  slot clear, cluster repair, and insertion order forget, and returns the captured
 *  value. The stored key is dropped from the table and the order record, but its heap
 *  bytes, a string key, are left to whoever else holds the string. On a miss it prints
 *  "fatal: map_take of a missing key" and aborts, so probe with map_has first when a key
 *  may be absent. The head declares owning, so the checker treats the removed value as the
 *  caller's own and exempts it from the container alias condemnation: a direct free of the
 *  take, or a free of an owner binding of it, is legal.
 *  @param m the map to remove from, borrowed and mutated in place
 *  @param k the key whose value to take; must be present
 *  @return the removed value, now owned by the caller
 *  @example
 *  if map_has(m, "a") {
 *      v := map_take(m, "a")
 *      free(v)
 *  } */
export owning func map_take<K, V>(m: *Map<K, V>, k: K) -> V {
    mut idx: int64 = map_slot(m, k)
    while (*m).used[idx] {
        if (*m).keys[idx] == k {
            out: V = (*m).vals[idx]
            map_remove(m, k)
            return out
        }
        idx = idx + 1
        if idx == (*m).cap {
            idx = 0
        }
    }
    map_take_fault()
    return (*m).vals[idx]
}

/** Looks up k, returning Maybe.Some of its value when present and Maybe.None when absent.
 *  The value inside Some is a copy the map still owns, a borrow for a managed pointer
 *  value, so do not free it while the map holds it; drain with map_take to take ownership.
 *  @param m the map to read, borrowed
 *  @param k the key to look up
 *  @return Maybe.Some of the value when k is present, Maybe.None otherwise */
export func map_get<K, V>(m: *Map<K, V>, k: K) -> Maybe<V> {
    mut idx: int64 = map_slot(m, k)
    while (*m).used[idx] {
        if (*m).keys[idx] == k {
            return Maybe.Some((*m).vals[idx])
        }
        idx = idx + 1
        if idx == (*m).cap {
            idx = 0
        }
    }
    return Maybe.None
}

/** Whether k has an entry in m, without reading its value.
 *  @param m the map to test, borrowed
 *  @param k the key to look for
 *  @return true when k is present */
export func map_has<K, V>(m: *Map<K, V>, k: K) -> bool {
    mut idx: int64 = map_slot(m, k)
    while (*m).used[idx] {
        if (*m).keys[idx] == k {
            return true
        }
        idx = idx + 1
        if idx == (*m).cap {
            idx = 0
        }
    }
    return false
}

/** The number of live entries in m.
 *  @param m the map to measure, borrowed
 *  @return the entry count */
export func map_len<K, V>(m: *Map<K, V>) -> int64 {
    return (*m).len
}

/** The key at insertion order position i, read straight from the map's own order record.
 *  Position i runs from 0 to map_len minus 1 and visits every live key exactly once in
 *  the order the keys first entered the map. The returned key is a borrow of the value
 *  the map still holds, a string it owns, so do not free it. i is bounds checked through
 *  vec_get, so an i outside the range faults rather than reads a stale slot. Pair with
 *  map_len to walk a map without allocating the copy map_keys returns.
 *  @param m the map to read, borrowed
 *  @param i the insertion order position, in [0, map_len(m))
 *  @return the key at position i, borrowed from the map
 *  @example
 *  mut i: int64 = 0
 *  while i < map_len(m) {
 *      k := map_key_at(m, i)
 *      v := map_val_at(m, i)
 *      i = i + 1
 *  } */
export func map_key_at<K, V>(m: *Map<K, V>, i: int64) -> K {
    return vec_get((*m).order, i)
}

/** The value stored for the key at insertion order position i. It reads that key from the
 *  order record, then probes the table for its slot the way map_get does and returns the
 *  value there. The returned value is a borrow the map still owns; drain with map_take
 *  when you need the value as your own. Under the map's order invariant every recorded key
 *  is live, so the probe always hits; a corrupted order record faults through
 *  "fatal: map_take of a missing key" rather than reading uninitialized memory.
 *  @param m the map to read, borrowed
 *  @param i the insertion order position, in [0, map_len(m))
 *  @return the value at position i, borrowed from the map */
export func map_val_at<K, V>(m: *Map<K, V>, i: int64) -> V {
    k: K = vec_get((*m).order, i)
    mut idx: int64 = map_slot(m, k)
    while (*m).used[idx] {
        if (*m).keys[idx] == k {
            return (*m).vals[idx]
        }
        idx = idx + 1
        if idx == (*m).cap {
            idx = 0
        }
    }
    map_take_fault()
    return (*m).vals[idx]
}

/** The keys in insertion order, as a fresh vector the caller owns and frees with vec_free
 *  and free. Each key is copied out of the map's own order record, so the returned vector
 *  is independent of the map: freeing it never touches the map and map_free never touches
 *  it, so there is no shared owner. The copied elements are the key values themselves; for
 *  a string key that is the string the map still owns, so freeing the returned vector
 *  releases its buffer only, never the key bytes. A key appears once, at its first
 *  insertion, so iterating the result visits every live entry exactly once in a
 *  deterministic order.
 *  @param m the map to enumerate, borrowed
 *  @return a fresh caller owned vector of the keys, in insertion order */
export func map_keys<K, V>(m: *Map<K, V>) -> *Vector<K> {
    out: *Vector<K> = alloc(vec_new())
    src: *Vector<K> = (*m).order
    mut i: int64 = 0
    while i < vec_len(src) {
        vec_push(out, vec_get(src, i))
        i = i + 1
    }
    return out
}

/** Frees the map's slot buffers and its order vector, and nothing else. Keys and values
 *  are stored by value and are never freed here, so for a managed key or value the caller
 *  drains and frees each first, for example by walking map_key_at and map_val_at or by
 *  map_take in a loop; a string key belongs to whoever else holds it. After this the caller
 *  frees the Map allocation itself when it was heap allocated.
 *  @param m the map whose buffers to release, borrowed */
export func map_free<K, V>(m: *Map<K, V>) -> void {
    free((*m).used)
    free((*m).keys)
    free((*m).vals)
    vec_free((*m).order)
    free((*m).order)
}
